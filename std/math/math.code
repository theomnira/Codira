// std/math/math.code
// Core mathematical functions for Codira.
// Provides trigonometric, exponential, logarithmic, rounding, and integer math
// operations for f32, f64, and integer types.
//
// ─────────────────────────────────────────────────────────────────────────────
// Where each operation comes from
// ─────────────────────────────────────────────────────────────────────────────
//
// Three sources, and which one an operation uses is not arbitrary:
//
//   1. `extern "codira-intrinsic"` -- the compiler emits these inline. Every
//      one has a hardware instruction on some target (`SQRTSD`, `FSQRT`,
//      `VFMADD`), and the backend falls back to a libm call only where the
//      instruction does not exist. Writing them in Codira would give up the
//      instruction everywhere.
//
//   2. `extern "C"` into libm -- for the operations LLVM has no intrinsic
//      for. There is no hardware instruction to lose, and libm's versions
//      are correctly rounded and well tested, which a hand-written series
//      expansion here would not be.
//
//   3. Ordinary Codira, built from the above -- `tan` from `sin`/`cos`,
//      `isinf` from a comparison against `inf()`.
//
// Infinity and NaN are built by reinterpreting their exact bit patterns.
// They have no source spelling, and the usual workarounds (`1.0 / 0.0`,
// `0.0 / 0.0`) are constant-folded by the optimiser into whatever it likes
// rather than reliably the value asked for.

extern "codira-intrinsic" {
    // Trigonometric, exponential and logarithmic.
    public func __intrinsic_sin_f64(x: f64) -> f64;
    public func __intrinsic_sin_f32(x: f32) -> f32;
    public func __intrinsic_cos_f64(x: f64) -> f64;
    public func __intrinsic_cos_f32(x: f32) -> f32;
    public func __intrinsic_sqrt_f64(x: f64) -> f64;
    public func __intrinsic_sqrt_f32(x: f32) -> f32;
    public func __intrinsic_pow_f64(base: f64, exponent: f64) -> f64;
    public func __intrinsic_pow_f32(base: f32, exponent: f32) -> f32;
    public func __intrinsic_exp_f64(x: f64) -> f64;
    public func __intrinsic_exp_f32(x: f32) -> f32;
    public func __intrinsic_exp2_f64(x: f64) -> f64;
    public func __intrinsic_exp2_f32(x: f32) -> f32;
    public func __intrinsic_log_f64(x: f64) -> f64;
    public func __intrinsic_log_f32(x: f32) -> f32;
    public func __intrinsic_log2_f64(x: f64) -> f64;
    public func __intrinsic_log2_f32(x: f32) -> f32;
    public func __intrinsic_log10_f64(x: f64) -> f64;
    public func __intrinsic_log10_f32(x: f32) -> f32;

    // Rounding and sign. `round` rounds halfway cases away from zero, which
    // is what `round` means everywhere that ships one -- `rint` would
    // follow the current rounding mode instead.
    public func __intrinsic_floor_f64(x: f64) -> f64;
    public func __intrinsic_floor_f32(x: f32) -> f32;
    public func __intrinsic_ceil_f64(x: f64) -> f64;
    public func __intrinsic_ceil_f32(x: f32) -> f32;
    public func __intrinsic_trunc_f64(x: f64) -> f64;
    public func __intrinsic_trunc_f32(x: f32) -> f32;
    public func __intrinsic_round_f64(x: f64) -> f64;
    public func __intrinsic_round_f32(x: f32) -> f32;
    public func __intrinsic_fabs_f64(x: f64) -> f64;
    public func __intrinsic_fabs_f32(x: f32) -> f32;
    public func __intrinsic_copysign_f64(magnitude: f64, sign: f64) -> f64;
    public func __intrinsic_copysign_f32(magnitude: f32, sign: f32) -> f32;

    // Fused multiply-add: one rounding, not two, and one instruction where
    // the target has it.
    public func __intrinsic_fma_f64(a: f64, b: f64, c: f64) -> f64;
    public func __intrinsic_fma_f32(a: f32, b: f32, c: f32) -> f32;

    // Reinterpretation, which is no instruction at run time.
    public func __intrinsic_bitcast_u64_f64(bits: u64) -> f64;
    public func __intrinsic_bitcast_u32_f32(bits: u32) -> f32;
    public func __intrinsic_bitcast_f64_u64(value: f64) -> u64;
    public func __intrinsic_bitcast_f32_u32(value: f32) -> u32;
}

extern "C" {
    // The operations LLVM has no intrinsic for, declared under the exact
    // names libm exports: an `extern "C"` function links by its Codira name
    // and there is no link-name attribute, so the spelling here *is* the
    // symbol.
    //
    // That is why these are the public entry points rather than sitting
    // behind wrappers. `asin` is already the name the API wants, and a
    // wrapper that only forwards to it would add a layer and no meaning.

    /// Arcsine -- inverse of sin. Returns a value in [-pi/2, pi/2].
    public func asin(x: f64) -> f64;
    /// Arccosine -- inverse of cos. Returns a value in [0, pi].
    public func acos(x: f64) -> f64;
    /// Arctangent -- inverse of tan. Returns a value in [-pi/2, pi/2].
    public func atan(x: f64) -> f64;
    /// Two-argument arctangent: the angle to the point (x, y), in [-pi, pi].
    public func atan2(y: f64, x: f64) -> f64;

    /// Arcsine (f32).
    public func asinf(x: f32) -> f32;
    /// Arccosine (f32).
    public func acosf(x: f32) -> f32;
    /// Arctangent (f32).
    public func atanf(x: f32) -> f32;
    /// Two-argument arctangent (f32).
    public func atan2f(y: f32, x: f32) -> f32;

    /// Cube root. Exact for perfect cubes, unlike `pow(x, 1.0/3.0)`.
    public func cbrt(x: f64) -> f64;
    /// `exp(x) - 1`, accurate for x near zero where `exp(x) - 1` cancels.
    public func expm1(x: f64) -> f64;
    /// `log(1 + x)`, accurate for x near zero for the same reason.
    public func log1p(x: f64) -> f64;
    /// `sqrt(x*x + y*y)` without the intermediate overflow.
    public func hypot(x: f64, y: f64) -> f64;
    /// IEEE remainder: `x - round(x/y) * y`.
    public func remainder(x: f64, y: f64) -> f64;
    /// Multiplies `x` by 2^exp, exactly.
    public func ldexp(x: f64, exp: i32) -> f64;
}

// ─────────────────────────────────────────────────────────────────────────────
// Non-finite values
// ─────────────────────────────────────────────────────────────────────────────

// Positive infinity: exponent all ones, significand zero.
public func inf() -> f64 {
    return __intrinsic_bitcast_u64_f64(9218868437227405312);
}

// Positive infinity, single precision.
public func inf_f32() -> f32 {
    return __intrinsic_bitcast_u32_f32(2139095040);
}

// A quiet NaN: exponent all ones with the significand's top bit set.
//
// Quiet rather than signalling on purpose -- a signalling NaN raises an
// exception the moment it is used in arithmetic, which is not what a
// function called `nan()` should hand back.
public func nan() -> f64 {
    return __intrinsic_bitcast_u64_f64(9221120237041090560);
}

// A quiet NaN, single precision.
public func nan_f32() -> f32 {
    return __intrinsic_bitcast_u32_f32(2143289344);
}

// ─────────────────────────────────────────────────────────────────────────────
// Trigonometric functions (f64)
// ─────────────────────────────────────────────────────────────────────────────

/// Sine of `x` (radians).
public func sin(x: f64) -> f64 {
    return __intrinsic_sin_f64(x);
}

/// Cosine of `x` (radians).
public func cos(x: f64) -> f64 {
    return __intrinsic_cos_f64(x);
}

/// Tangent of `x` (radians).
public func tan(x: f64) -> f64 {
    return sin(x) / cos(x);
}

// ── f32 trigonometric overloads ──────────────────────────────────────────────

/// Sine (f32).
public func sin_f32(x: f32) -> f32 {
    return __intrinsic_sin_f32(x);
}

/// Cosine (f32).
public func cos_f32(x: f32) -> f32 {
    return __intrinsic_cos_f32(x);
}

/// Tangent (f32).
public func tan_f32(x: f32) -> f32 {
    return __intrinsic_sin_f32(x) / __intrinsic_cos_f32(x);
}

/// Arcsine (f32).
public func asin_f32(x: f32) -> f32 {
    return asinf(x);
}

/// Arccosine (f32).
public func acos_f32(x: f32) -> f32 {
    return acosf(x);
}

/// Arctangent (f32).
public func atan_f32(x: f32) -> f32 {
    return atanf(x);
}

/// Two-argument arctangent (f32).
public func atan2_f32(y: f32, x: f32) -> f32 {
    return atan2f(y, x);
}

// ─────────────────────────────────────────────────────────────────────────────
// Hyperbolic functions
// ─────────────────────────────────────────────────────────────────────────────

/// Hyperbolic sine.
public func sinh(x: f64) -> f64 {
    return (exp(x) - exp(-x)) / 2.0;
}

/// Hyperbolic cosine.
public func cosh(x: f64) -> f64 {
    return (exp(x) + exp(-x)) / 2.0;
}

/// Hyperbolic tangent.
public func tanh(x: f64) -> f64 {
    let ex = exp(2.0 * x);
    return (ex - 1.0) / (ex + 1.0);
}

// ─────────────────────────────────────────────────────────────────────────────
// Exponential and logarithmic functions
// ─────────────────────────────────────────────────────────────────────────────

/// e raised to the power `x`.
public func exp(x: f64) -> f64 {
    return __intrinsic_exp_f64(x);
}

/// 2 raised to the power `x`.
public func exp2(x: f64) -> f64 {
    return __intrinsic_exp2_f64(x);
}

/// Natural logarithm (base e).
public func log(x: f64) -> f64 {
    return __intrinsic_log_f64(x);
}

/// Base-2 logarithm.
public func log2(x: f64) -> f64 {
    return __intrinsic_log2_f64(x);
}

/// Base-10 logarithm.
public func log10(x: f64) -> f64 {
    return __intrinsic_log10_f64(x);
}

/// Logarithm with arbitrary base: log_base(x).
public func log_base(x: f64, base: f64) -> f64 {
    return log(x) / log(base);
}

// ── f32 exponential/log overloads ────────────────────────────────────────────

public func exp_f32(x: f32) -> f32 {
    return __intrinsic_exp_f32(x);
}

public func exp2_f32(x: f32) -> f32 {
    return __intrinsic_exp2_f32(x);
}

public func log_f32(x: f32) -> f32 {
    return __intrinsic_log_f32(x);
}

public func log2_f32(x: f32) -> f32 {
    return __intrinsic_log2_f32(x);
}

public func log10_f32(x: f32) -> f32 {
    return __intrinsic_log10_f32(x);
}

// ─────────────────────────────────────────────────────────────────────────────
// Power and root functions
// ─────────────────────────────────────────────────────────────────────────────

/// `base` raised to the power `exponent`.
public func pow(base: f64, exponent: f64) -> f64 {
    return __intrinsic_pow_f64(base, exponent);
}

/// Square root.
public func sqrt(x: f64) -> f64 {
    return __intrinsic_sqrt_f64(x);
}

/// Reciprocal square root: 1 / sqrt(x).
public func rsqrt(x: f64) -> f64 {
    return 1.0 / sqrt(x);
}

// ── f32 overloads ────────────────────────────────────────────────────────────

public func pow_f32(base: f32, exponent: f32) -> f32 {
    return __intrinsic_pow_f32(base, exponent);
}

public func sqrt_f32(x: f32) -> f32 {
    return __intrinsic_sqrt_f32(x);
}

public func rsqrt_f32(x: f32) -> f32 {
    return 1.0 as f32 / __intrinsic_sqrt_f32(x);
}

// ─────────────────────────────────────────────────────────────────────────────
// Absolute value
// ─────────────────────────────────────────────────────────────────────────────

/// Absolute value (f64).
public func abs(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    return x;
}

/// Absolute value (f32).
public func abs_f32(x: f32) -> f32 {
    if x < 0.0 as f32 {
        return -x;
    }
    return x;
}

/// Absolute value (i32).
public func abs_i32(x: i32) -> i32 {
    if x < 0 {
        return -x;
    }
    return x;
}

/// Absolute value (i64).
public func abs_i64(x: i64) -> i64 {
    if x < 0 {
        return -x;
    }
    return x;
}

// ─────────────────────────────────────────────────────────────────────────────
// Min / Max
// ─────────────────────────────────────────────────────────────────────────────

/// Returns the smaller of `a` and `b`. If either is NaN, returns `b`.
public func min(a: f64, b: f64) -> f64 {
    if a < b {
        return a;
    }
    return b;
}

/// Returns the larger of `a` and `b`. If either is NaN, returns `b`.
public func max(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    return b;
}

/// Min for f32.
public func min_f32(a: f32, b: f32) -> f32 {
    if a < b {
        return a;
    }
    return b;
}

/// Max for f32.
public func max_f32(a: f32, b: f32) -> f32 {
    if a > b {
        return a;
    }
    return b;
}

/// Min for i64.
public func min_i64(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}

/// Max for i64.
public func max_i64(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    }
    return b;
}

/// Min for usize.
public func min_usize(a: usize, b: usize) -> usize {
    if a < b {
        return a;
    }
    return b;
}

/// Max for usize.
public func max_usize(a: usize, b: usize) -> usize {
    if a > b {
        return a;
    }
    return b;
}

// ─────────────────────────────────────────────────────────────────────────────
// Rounding
// ─────────────────────────────────────────────────────────────────────────────

/// Rounds toward negative infinity.
public func floor(x: f64) -> f64 {
    return __intrinsic_floor_f64(x);
}

/// Rounds toward positive infinity.
public func ceil(x: f64) -> f64 {
    return __intrinsic_ceil_f64(x);
}

/// Rounds to nearest integer, half away from zero.
public func round(x: f64) -> f64 {
    return __intrinsic_round_f64(x);
}

/// Truncates toward zero (discards fractional part).
public func trunc(x: f64) -> f64 {
    return __intrinsic_trunc_f64(x);
}

/// Fractional part: x - trunc(x).
public func fract(x: f64) -> f64 {
    return x - trunc(x);
}

// ── f32 rounding ─────────────────────────────────────────────────────────────

public func floor_f32(x: f32) -> f32 {
    return __intrinsic_floor_f32(x);
}

public func ceil_f32(x: f32) -> f32 {
    return __intrinsic_ceil_f32(x);
}

public func round_f32(x: f32) -> f32 {
    return __intrinsic_round_f32(x);
}

public func trunc_f32(x: f32) -> f32 {
    return __intrinsic_trunc_f32(x);
}

// ─────────────────────────────────────────────────────────────────────────────
// Fused multiply-add and related
// ─────────────────────────────────────────────────────────────────────────────

/// Fused multiply-add: (a * b) + c with a single rounding step.
public func fma(a: f64, b: f64, c: f64) -> f64 {
    return __intrinsic_fma_f64(a, b, c);
}

/// Fused multiply-add (f32).
public func fma_f32(a: f32, b: f32, c: f32) -> f32 {
    return __intrinsic_fma_f32(a, b, c);
}

/// Returns a value with the magnitude of `mag` and the sign of `sign`.
public func copysign(mag: f64, sign: f64) -> f64 {
    return __intrinsic_copysign_f64(mag, sign);
}

/// Splits `x` into a normalised fraction in [0.5, 1) and an integer exponent,
/// such that `x == fraction * 2^exponent`.
///
/// Built from the bit pattern rather than called out to libm, because C's
/// `frexp` returns the exponent through an `int *` out-parameter and Codira
/// has no way to spell that. Reading the fields directly is also exact:
/// there is no arithmetic here to round.
///
/// Zero, infinity and NaN are returned unchanged with an exponent of 0,
/// which is what C specifies for them.
public func frexp(x: f64) -> (f64, i32) {
    if x == 0.0 || isnan(x) || isinf(x) {
        return (x, 0);
    }

    let bits = __intrinsic_bitcast_f64_u64(x);
    let raw_exponent = (bits >> 52) & 2047;

    if raw_exponent == 0 {
        // Subnormal: no implicit leading 1, so the exponent field says
        // nothing useful. Scaling into the normal range first and then
        // correcting is exact -- multiplying by a power of two only moves
        // the exponent.
        let scaled = __intrinsic_bitcast_f64_u64(x * 18014398509481984.0);
        let scaled_exponent = (scaled >> 52) & 2047;
        let fraction_bits = (scaled & 9227875636482146303) | 4602678819172646912;
        return (
            __intrinsic_bitcast_u64_f64(fraction_bits),
            (scaled_exponent as i32) - 1022 - 54,
        );
    }

    // Replace the exponent field with the one that means [0.5, 1), keeping
    // the sign and the significand exactly as they are.
    let fraction_bits = (bits & 9227875636482146303) | 4602678819172646912;
    return (
        __intrinsic_bitcast_u64_f64(fraction_bits),
        (raw_exponent as i32) - 1022,
    );
}

// ─────────────────────────────────────────────────────────────────────────────
// Clamping
// ─────────────────────────────────────────────────────────────────────────────

/// Clamps `x` to the range [lo, hi].
public func clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

/// Clamps (f32).
public func clamp_f32(x: f32, lo: f32, hi: f32) -> f32 {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

/// Clamps (i64).
public func clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

/// Clamps (usize).
public func clamp_usize(x: usize, lo: usize, hi: usize) -> usize {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

// ─────────────────────────────────────────────────────────────────────────────
// Integer arithmetic
// ─────────────────────────────────────────────────────────────────────────────

/// Greatest common divisor (Euclidean algorithm).
public func gcd(a: i64, b: i64) -> i64 {
    let x = abs_i64(a);
    let y = abs_i64(b);
    while y != 0 {
        let t = y;
        y = x % y;
        x = t;
    }
    return x;
}

/// Least common multiple.
public func lcm(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 {
        return 0;
    }
    return abs_i64(a / gcd(a, b) * b);
}

/// Factorial of n (n!). Panics on negative input or overflow.
public func factorial(n: i64) -> i64 {
    if n < 0 {
        panic("factorial: negative input");
    }
    let result: i64 = 1;
    let i: i64 = 2;
    while i <= n {
        result = result * i;
        i = i + 1;
    }
    return result;
}

/// Integer power: base^exp for non-negative exp. Uses fast exponentiation.
public func ipow(base: i64, exp: u64) -> i64 {
    let result: i64 = 1;
    let b = base;
    let e = exp;
    while e > 0 {
        if (e & 1) == 1 {
            result = result * b;
        }
        b = b * b;
        e = e >> 1;
    }
    return result;
}

/// Unsigned integer log2 (floor). Returns the position of the highest set bit.
public func ilog2(x: u64) -> u32 {
    if x == 0 {
        panic("ilog2: zero");
    }
    let n: u32 = 0;
    let v = x;
    while v > 1 {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

/// Checks if `x` is a power of two.
public func is_power_of_two(x: u64) -> bool {
    return x > 0 && (x & (x - 1)) == 0;
}

/// Returns the next power of two >= x.
public func next_power_of_two_u64(x: u64) -> u64 {
    if x == 0 {
        return 1;
    }
    let v = x - 1;
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    v = v | (v >> 32);
    return v + 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// IEEE-754 classification
// ─────────────────────────────────────────────────────────────────────────────

/// Returns true if `x` is NaN.
public func isnan(x: f64) -> bool {
    return x != x;
}

/// Returns true if `x` is positive or negative infinity.
public func isinf(x: f64) -> bool {
    return x == inf() || x == -inf();
}

/// Returns true if `x` is neither NaN nor infinity.
public func isfinite(x: f64) -> bool {
    return !isnan(x) && !isinf(x);
}

/// Returns true if `x` is a normal (not zero, subnormal, infinity, or NaN).
public func isnormal(x: f64) -> bool {
    return isfinite(x) && abs(x) >= 2.2250738585072014e-308;
}

/// Classifiers for f32.
public func isnan_f32(x: f32) -> bool {
    return x != x;
}

public func isinf_f32(x: f32) -> bool {
    return x == inf_f32() || x == -inf_f32();
}

public func isfinite_f32(x: f32) -> bool {
    return !isnan_f32(x) && !isinf_f32(x);
}

// ─────────────────────────────────────────────────────────────────────────────
// Sign
// ─────────────────────────────────────────────────────────────────────────────

/// Returns -1.0, 0.0, or 1.0 according to the sign of `x`.
public func signum(x: f64) -> f64 {
    if x > 0.0 {
        return 1.0;
    }
    if x < 0.0 {
        return -1.0;
    }
    return 0.0;
}

/// Sign for i64.
public func signum_i64(x: i64) -> i64 {
    if x > 0 {
        return 1;
    }
    if x < 0 {
        return -1;
    }
    return 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// Linear interpolation
// ─────────────────────────────────────────────────────────────────────────────

/// Linearly interpolates between `a` and `b` by `t` in [0, 1].
public func lerp(a: f64, b: f64, t: f64) -> f64 {
    return fma(t, b - a, a);
}

/// Inverse lerp: returns `t` such that lerp(a, b, t) == value.
public func inverse_lerp(a: f64, b: f64, value: f64) -> f64 {
    return (value - a) / (b - a);
}

// ─────────────────────────────────────────────────────────────────────────────
// Iota — generate a sequence of values
// ─────────────────────────────────────────────────────────────────────────────

/// Returns a List of `count` values starting at `start` with a step of 1.
public func iota(start: i64, count: usize) -> List[i64] {
    let out = list_with_capacity(count);
    let i: usize = 0;
    while i < count {
        out = push(out, start + (i as i64));
        i = i + 1;
    }
    return out;
}

/// Returns a List of f64 values from `start` to `end` with `step`.
public func arange(start: f64, end: f64, step: f64) -> List[f64] {
    let out = list_new();
    let v = start;
    if step > 0.0 {
        while v < end {
            out = push(out, v);
            v = v + step;
        }
    } else if step < 0.0 {
        while v > end {
            out = push(out, v);
            v = v + step;
        }
    }
    return out;
}

/// Returns a List of `count` evenly-spaced f64 values from `start` to `end` (inclusive).
public func linspace(start: f64, end: f64, count: usize) -> List[f64] {
    let out = list_with_capacity(count);
    if count == 0 {
        return out;
    }
    if count == 1 {
        out = push(out, start);
        return out;
    }
    let step = (end - start) / ((count - 1) as f64);
    let i: usize = 0;
    while i < count {
        out = push(out, start + (i as f64) * step);
        i = i + 1;
    }
    return out;
}

// ─────────────────────────────────────────────────────────────────────────────
// Degrees / Radians conversion
// ─────────────────────────────────────────────────────────────────────────────

/// Converts degrees to radians.
public func to_radians(degrees: f64) -> f64 {
    return degrees * 3.141592653589793 / 180.0;
}

/// Converts radians to degrees.
public func to_degrees(radians: f64) -> f64 {
    return radians * 180.0 / 3.141592653589793;
}
