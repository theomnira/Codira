// std/math/polynomial.code
// Polynomial evaluation utilities for Codira.
// Primary method: Horner's scheme — O(n) multiplications with minimal round-off.

// ─────────────────────────────────────────────────────────────────────────────
// Horner's method
// ─────────────────────────────────────────────────────────────────────────────

/// Evaluates a polynomial at `x` using Horner's method.
///
/// Coefficients are stored highest-degree first:
///   coeffs = [a_n, a_{n-1}, ..., a_1, a_0]
///   result = a_n * x^n + a_{n-1} * x^{n-1} + ... + a_1 * x + a_0
///
/// This is computed as:
///   (...((a_n * x + a_{n-1}) * x + a_{n-2}) * x + ...) * x + a_0
///
/// Complexity: n multiplications and n additions for a degree-n polynomial.
public func polynomial_evaluate(coeffs: List[f64], x: f64) -> f64 {
    if coeffs.len == 0 {
        return 0.0;
    }
    let result = get(coeffs, 0);
    let i: usize = 1;
    while i < coeffs.len {
        result = result * x + get(coeffs, i);
        i = i + 1;
    }
    return result;
}

/// f32 variant.
public func polynomial_evaluate_f32(coeffs: List[f32], x: f32) -> f32 {
    if coeffs.len == 0 {
        return 0.0 as f32;
    }
    let result = get(coeffs, 0);
    let i: usize = 1;
    while i < coeffs.len {
        result = result * x + get(coeffs, i);
        i = i + 1;
    }
    return result;
}

/// FMA variant — uses fused multiply-add for each step, reducing round-off.
/// Requires hardware FMA support for best results.
public func polynomial_evaluate_fma(coeffs: List[f64], x: f64) -> f64 {
    if coeffs.len == 0 {
        return 0.0;
    }
    let result = get(coeffs, 0);
    let i: usize = 1;
    while i < coeffs.len {
        result = fma(result, x, get(coeffs, i));
        i = i + 1;
    }
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// Coefficients stored lowest-degree first
// ─────────────────────────────────────────────────────────────────────────────

/// Same as `polynomial_evaluate`, but coefficients are stored lowest-degree
/// first: coeffs = [a_0, a_1, ..., a_n].
public func polynomial_evaluate_ascending(coeffs: List[f64], x: f64) -> f64 {
    if coeffs.len == 0 {
        return 0.0;
    }
    // Horner from the back
    let result = get(coeffs, coeffs.len - 1);
    let i: isize = (coeffs.len as isize) - 2;
    while i >= 0 {
        result = result * x + get(coeffs, i as usize);
        i = i - 1;
    }
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// Polynomial derivative evaluation
// ─────────────────────────────────────────────────────────────────────────────

/// Evaluates both the polynomial and its first derivative at `x`.
/// coeffs are highest-degree first.
/// Returns (p(x), p'(x)).
/// Uses a single Horner pass with the derivative accumulator.
public func polynomial_evaluate_with_derivative(coeffs: List[f64], x: f64) -> (f64, f64) {
    if coeffs.len == 0 {
        return (0.0, 0.0);
    }
    let p  = get(coeffs, 0);
    let dp: f64 = 0.0;
    let i: usize = 1;
    while i < coeffs.len {
        dp = dp * x + p;
        p  = p  * x + get(coeffs, i);
        i = i + 1;
    }
    return (p, dp);
}

// ─────────────────────────────────────────────────────────────────────────────
// Compensated Horner (error-free transformations)
// ─────────────────────────────────────────────────────────────────────────────

/// Compensated Horner scheme — evaluates the polynomial with higher accuracy
/// by computing and compensating for rounding errors at each step.
/// Approximately doubles the effective precision compared to plain Horner.
public func polynomial_evaluate_compensated(coeffs: List[f64], x: f64) -> f64 {
    if coeffs.len == 0 {
        return 0.0;
    }
    let s = get(coeffs, 0);
    let c: f64 = 0.0;
    let i: usize = 1;
    while i < coeffs.len {
        // Two-product: s * x = prod + err_prod
        let prod = s * x;
        let err_prod = fma(s, x, -prod);
        // Two-sum: prod + coeffs[i] = sum + err_sum
        let coeff_i = get(coeffs, i);
        let sum = prod + coeff_i;
        let z = sum - prod;
        let err_sum = (prod - (sum - z)) + (coeff_i - z);
        // Accumulate compensation
        c = c * x + (err_prod + err_sum);
        s = sum;
        i = i + 1;
    }
    return s + c;
}

// ─────────────────────────────────────────────────────────────────────────────
// Estrin's scheme (parallelism-friendly)
// ─────────────────────────────────────────────────────────────────────────────

/// Evaluates a polynomial using Estrin's method.
/// Allows instruction-level parallelism for superscalar CPUs.
/// coeffs are highest-degree first.
/// Falls back to Horner for <= 4 coefficients.
public func polynomial_evaluate_estrin(coeffs: List[f64], x: f64) -> f64 {
    let n = coeffs.len;
    if n == 0 {
        return 0.0;
    }
    if n <= 4 {
        return polynomial_evaluate(coeffs, x);
    }
    // Build a mutable copy of values — we reduce pairs iteratively
    let vals = list_with_capacity(n);
    let i: usize = 0;
    while i < n {
        vals = push(vals, get(coeffs, i));
        i = i + 1;
    }
    let pow_x = x;
    let count = n;
    while count > 1 {
        let new_count = (count + 1) / 2;
        let new_vals = list_with_capacity(new_count);
        let j: usize = 0;
        while j + 1 < count {
            // Pair (j, j+1): result = vals[j] * pow_x + vals[j+1]
            let combined = get(vals, j) * pow_x + get(vals, j + 1);
            new_vals = push(new_vals, combined);
            j = j + 2;
        }
        if j < count {
            // Odd element left over
            new_vals = push(new_vals, get(vals, j));
        }
        vals = new_vals;
        count = new_count;
        pow_x = pow_x * pow_x;
    }
    return get(vals, 0);
}

// ─────────────────────────────────────────────────────────────────────────────
// Utility: polynomial from roots
// ─────────────────────────────────────────────────────────────────────────────

/// Constructs polynomial coefficients (highest-degree first) from roots.
/// Given roots [r0, r1, ..., r_{n-1}], the polynomial is
///   (x - r0)(x - r1)...(x - r_{n-1})
public func polynomial_from_roots(roots: List[f64]) -> List[f64] {
    // Start with [1.0]  (the constant polynomial "1")
    let coeffs = list_new();
    let c = push(coeffs, 1.0);
    let i: usize = 0;
    while i < roots.len {
        let r = get(roots, i);
        // Multiply current polynomial by (x - r)
        let new_len = c.len + 1;
        let new_c = list_with_capacity(new_len);
        // Leading coefficient
        new_c = push(new_c, get(c, 0));
        let j: usize = 1;
        while j < c.len {
            new_c = push(new_c, get(c, j) - r * get(c, j - 1));
            j = j + 1;
        }
        new_c = push(new_c, -r * get(c, c.len - 1));
        c = new_c;
        i = i + 1;
    }
    return c;
}
