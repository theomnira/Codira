// =============================================================================
// std/math/constants.code — Mathematical constants for Codira
// =============================================================================
// All values are f64 (double precision IEEE 754) unless noted otherwise.
//
// Each constant is a niladic function, called as `PI()` rather than named
// as `PI`. That is not a style preference: a module-level `public let PI:
// f64 = ...;` parses, but the compiler rejects it ("module-level `let` is
// not supported yet"), so no name could refer to it. A niladic function is
// the closest honest equivalent: callable today, and folded to its value by
// the optimiser. When module-level constants are supported these become
// `public let` bindings.
// =============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// Fundamental constants
// ─────────────────────────────────────────────────────────────────────────────

// Pi — ratio of a circle's circumference to its diameter.
public func PI() -> f64 {
    3.14159265358979323846
}

// Tau — 2 * pi (full turn in radians).
public func TAU() -> f64 {
    6.28318530717958647692
}

// Euler's number — base of the natural logarithm.
public func E() -> f64 {
    2.71828182845904523536
}

// Golden ratio phi = (1 + sqrt(5)) / 2.
public func PHI() -> f64 {
    1.61803398874989484820
}

// ─────────────────────────────────────────────────────────────────────────────
// Pi-derived fractions
// ─────────────────────────────────────────────────────────────────────────────

// Pi / 2 — quarter turn.
public func FRAC_PI_2() -> f64 {
    1.57079632679489661923
}

// Pi / 3.
public func FRAC_PI_3() -> f64 {
    1.04719755119659774615
}

// Pi / 4.
public func FRAC_PI_4() -> f64 {
    0.78539816339744830962
}

// Pi / 6.
public func FRAC_PI_6() -> f64 {
    0.52359877559829887308
}

// Pi / 8.
public func FRAC_PI_8() -> f64 {
    0.39269908169872415481
}

// 1 / Pi.
public func FRAC_1_PI() -> f64 {
    0.31830988618379067154
}

// 2 / Pi.
public func FRAC_2_PI() -> f64 {
    0.63661977236758134308
}

// 2 / sqrt(Pi).
public func FRAC_2_SQRT_PI() -> f64 {
    1.12837916709551257390
}

// ─────────────────────────────────────────────────────────────────────────────
// Square roots
// ─────────────────────────────────────────────────────────────────────────────

// Square root of 2.
public func SQRT_2() -> f64 {
    1.41421356237309504880
}

// 1 / sqrt(2)  =  sqrt(2) / 2.
public func FRAC_1_SQRT_2() -> f64 {
    0.70710678118654752440
}

// Square root of 3.
public func SQRT_3() -> f64 {
    1.73205080756887729353
}

// ─────────────────────────────────────────────────────────────────────────────
// Logarithmic constants
// ─────────────────────────────────────────────────────────────────────────────

// Natural logarithm of 2.
public func LN_2() -> f64 {
    0.69314718055994530942
}

// Natural logarithm of 10.
public func LN_10() -> f64 {
    2.30258509299404568402
}

// Base-2 logarithm of e.
public func LOG2_E() -> f64 {
    1.44269504088896340736
}

// Base-10 logarithm of e.
public func LOG10_E() -> f64 {
    0.43429448190325182765
}

// Base-2 logarithm of 10.
public func LOG2_10() -> f64 {
    3.32192809488736234787
}

// Base-10 logarithm of 2.
public func LOG10_2() -> f64 {
    0.30102999566398119521
}

// ─────────────────────────────────────────────────────────────────────────────
// Special IEEE-754 values
// ─────────────────────────────────────────────────────────────────────────────
//
// Infinity and NaN have no source spelling, and `1.0 / 0.0` or `0.0 / 0.0`
// is constant-folded by the optimiser into whatever it likes, so they are
// built from their exact IEEE 754 bit patterns, as `std.math.math` builds
// `inf()` and `nan()`.

extern "codira-intrinsic" {
    func __intrinsic_bitcast_u64_f64(bits: u64) -> f64;
}

// Positive infinity (f64).
public func INF() -> f64 {
    // Exponent all ones, significand zero: 0x7FF0000000000000.
    __intrinsic_bitcast_u64_f64(9218868437227405312)
}

// Negative infinity (f64).
public func NEG_INF() -> f64 {
    // Sign, then exponent all ones: 0xFFF0000000000000.
    __intrinsic_bitcast_u64_f64(18442240474082181120)
}

// Not-a-Number (quiet NaN, f64).
public func NAN() -> f64 {
    // Exponent all ones, top significand bit set: 0x7FF8000000000000.
    __intrinsic_bitcast_u64_f64(9221120237041090560)
}

// ─────────────────────────────────────────────────────────────────────────────
// Machine epsilon and limits
// ─────────────────────────────────────────────────────────────────────────────

// The difference between 1.0 and the next larger f64 (2^-52). Not the
// smallest x with 1.0 + x != 1.0, which is about half of it.
public func F64_EPSILON() -> f64 {
    2.2204460492503131e-16
}

// Smallest positive normal f64.
public func F64_MIN_POSITIVE() -> f64 {
    2.2250738585072014e-308
}

// Largest finite f64.
public func F64_MAX() -> f64 {
    1.7976931348623157e+308
}

// The difference between 1.0 and the next larger f32 (2^-23).
public func F32_EPSILON() -> f32 {
    1.1920929e-7
}

// Smallest positive normal f32.
public func F32_MIN_POSITIVE() -> f32 {
    1.17549435e-38
}

// Largest finite f32.
public func F32_MAX() -> f32 {
    3.40282347e+38
}

// ─────────────────────────────────────────────────────────────────────────────
// Integer limits
// ─────────────────────────────────────────────────────────────────────────────

public func I8_MIN() -> i8 {
    -128
}

public func I8_MAX() -> i8 {
    127
}

public func U8_MAX() -> u8 {
    255
}

public func I16_MIN() -> i16 {
    -32768
}

public func I16_MAX() -> i16 {
    32767
}

public func U16_MAX() -> u16 {
    65535
}

public func I32_MIN() -> i32 {
    -2147483648
}

public func I32_MAX() -> i32 {
    2147483647
}

public func U32_MAX() -> u32 {
    4294967295
}

public func I64_MIN() -> i64 {
    -9223372036854775808
}

public func I64_MAX() -> i64 {
    9223372036854775807
}

public func U64_MAX() -> u64 {
    18446744073709551615
}

public func I128_MIN() -> i128 {
    -170141183460469231731687303715884105728
}

public func I128_MAX() -> i128 {
    170141183460469231731687303715884105727
}

public func U128_MAX() -> u128 {
    340282366920938463463374607431768211455
}
