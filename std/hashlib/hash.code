// The built-in `String`, hashed as its bytes: a `str` and a `String` with
// the same bytes hash alike. `hash_value` is the `String`'s own `hash()`
// (FNV-1a), computed here without a call.
extend String: Hashable {
    func hash_value(self) -> u64 {
        let len = self.len();
        if len == 0 {
            return 0xCBF29CE484222325;
        }
        fnv1a(string_data(self), len)
    }
    func hash_keyed(self, key: HashKey) -> u64 {
        let len = self.len();
        if len == 0 {
            return sip_bytes(key.k0, key.k1, 0, 0, 1, 3);
        }
        sip_bytes(key.k0, key.k1, string_data(self), len, 1, 3)
    }
}
