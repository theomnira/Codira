// std/hashlib/hash.code
// Core hashing infrastructure for Codira.
// Provides the Hashable trait, a default hash function, and hash combiners.
//
// NOT CRYPTOGRAPHIC. FNV-1a and the combiners here are for hash tables and
// fingerprints of trusted data: collisions are easy to construct, so never
// use them for integrity, signatures, passwords or keys, or for a table an
// adversary fills. `std.crypto.hash` has SHA-256, SHA-512 and BLAKE3.
//
// Byte sequences are the language's arrays (`[u8]`, `[u64]`).
// `hash_string` is in `std.hashlib.string_hash`: it takes a `String`, which
// does not check yet.

extern "codira-intrinsic" {
    func __intrinsic_bitcast_f64_u64(value: f64) -> u64;
}

// ---------------------------------------------------------------------------
// Hashable trait
// Any type that can be hashed must implement this trait.
// ---------------------------------------------------------------------------
public trait Hashable {
    // Returns the hash value for this instance.
    func hash_value(self) -> u64;
}

// ---------------------------------------------------------------------------
// hash
// Convenience function that hashes any Hashable value: it returns the
// type's own `hash_value`, whatever algorithm that uses (the `hash_*`
// functions below use FNV-1a 64-bit).
// ---------------------------------------------------------------------------
public func hash[T: Hashable](value: T) -> u64 {
    return value.hash_value();
}

// ---------------------------------------------------------------------------
// combine_hash
// Combines two hash values into a single hash using a mixing function
// inspired by boost::hash_combine. This is useful when hashing composite
// types (structs with multiple fields, tuples, etc.).
//
// The magic constant 0x9E3779B97F4A7C15 is derived from the golden ratio.
// The mixing is weak: `value` enters by one addition, so a change in it
// can leave most output bits unchanged (no avalanche). Fine for combining
// hashes that are already well mixed; not a hash function by itself.
// ---------------------------------------------------------------------------
public func combine_hash(seed: u64, value: u64) -> u64 {
    let golden: u64 = 0x9E3779B97F4A7C15;
    let mut mixed: u64 = value;
    mixed = mixed + golden + (seed << 6) + (seed >> 2);
    return seed ^ mixed;
}

// ---------------------------------------------------------------------------
// combine_hash_ordered
// Combines a sequence of hash values in order. The result depends on the
// order in which the hashes are fed in.
// ---------------------------------------------------------------------------
public func combine_hash_ordered(hashes: [u64]) -> u64 {
    let mut result: u64 = 0;
    let mut i: usize = 0;
    while i < hashes.len() {
        result = combine_hash(result, hashes[i]);
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// combine_hash_unordered
// Combines a sequence of hash values in an order-independent manner using
// XOR. Suitable for sets and other unordered collections.
// ---------------------------------------------------------------------------
public func combine_hash_unordered(hashes: [u64]) -> u64 {
    let mut result: u64 = 0;
    let mut i: usize = 0;
    while i < hashes.len() {
        result = result ^ hashes[i];
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// hash_bytes
// Hashes a raw byte slice using FNV-1a.
// ---------------------------------------------------------------------------
public func hash_bytes(data: [u8]) -> u64 {
    let fnv_offset: u64 = 0xCBF29CE484222325;
    let fnv_prime: u64 = 0x00000100000001B3;
    let mut h: u64 = fnv_offset;
    let mut i: usize = 0;
    while i < data.len() {
        h = h ^ (data[i] as u64);
        h = h * fnv_prime;
        i = i + 1;
    }
    return h;
}

// ---------------------------------------------------------------------------
// hash_i64
// Hashes a signed 64-bit integer by treating it as unsigned bytes.
// ---------------------------------------------------------------------------
public func hash_i64(value: i64) -> u64 {
    let v: u64 = value as u64;
    let mut h: u64 = 0xCBF29CE484222325;
    let prime: u64 = 0x00000100000001B3;
    let mut i: u32 = 0;
    while i < 8 {
        let byte: u64 = (v >> ((i * 8) as u64)) & 0xFF;
        h = h ^ byte;
        h = h * prime;
        i = i + 1;
    }
    return h;
}

// ---------------------------------------------------------------------------
// hash_u64
// Hashes an unsigned 64-bit integer.
// ---------------------------------------------------------------------------
public func hash_u64(value: u64) -> u64 {
    let mut h: u64 = 0xCBF29CE484222325;
    let prime: u64 = 0x00000100000001B3;
    let mut i: u32 = 0;
    while i < 8 {
        let byte: u64 = (value >> ((i * 8) as u64)) & 0xFF;
        h = h ^ byte;
        h = h * prime;
        i = i + 1;
    }
    return h;
}

// ---------------------------------------------------------------------------
// hash_f64
// Hashes a 64-bit float by reinterpreting its bits as u64.
// Values that compare equal hash the same: negative zero hashes as zero,
// and every NaN as the one quiet NaN 0x7FF8000000000000.
// ---------------------------------------------------------------------------
public func hash_f64(value: f64) -> u64 {
    // Normalize negative zero to positive zero.
    var bits: u64 = __intrinsic_bitcast_f64_u64(value);
    if value == 0.0 {
        bits = 0;
    }
    if value != value {
        bits = 9221120237041090560;
    }
    return hash_u64(bits);
}

// ---------------------------------------------------------------------------
// hash_bool
// Hashes a boolean value.
// ---------------------------------------------------------------------------
public func hash_bool(value: bool) -> u64 {
    if value {
        return hash_u64(1);
    }
    return hash_u64(0);
}

// ---------------------------------------------------------------------------
// mix64
// Scrambles all 64 bits of `value` into every bit of the result (the
// finalizer of MurmurHash3): a bijection, five operations. What the
// integer `Hashable` implementations below use, so that keys differing in
// a few bits, or only in their high bits, spread over a table.
// ---------------------------------------------------------------------------
public func mix64(value: u64) -> u64 {
    var x: u64 = value;
    x = x ^ (x >> 33);
    x = x * 0xFF51AFD7ED558CCD;
    x = x ^ (x >> 33);
    x = x * 0xC4CEB9FE1A85EC53;
    return x ^ (x >> 33);
}

// ---------------------------------------------------------------------------
// Hashable for the primitive types: integers through `mix64`, floats as
// `hash_f64` normalizes them (so equal values hash the same), `bool` as 0
// or 1, `str` with FNV-1a over its bytes. NOT DoS-resistant: the hashes are
// fixed and unseeded, so anyone who chooses the keys can make them collide.
// ---------------------------------------------------------------------------
extern "codira-intrinsic" {
    func str_data(s: str) -> usize;
    func str_len(s: str) -> usize;
    func load_u8(addr: usize) -> u8;
}

extend i8: Hashable { func hash_value(self) -> u64 { mix64(self as i64 as u64) } }
extend i16: Hashable { func hash_value(self) -> u64 { mix64(self as i64 as u64) } }
extend i32: Hashable { func hash_value(self) -> u64 { mix64(self as i64 as u64) } }
extend i64: Hashable { func hash_value(self) -> u64 { mix64(self as u64) } }
extend isize: Hashable { func hash_value(self) -> u64 { mix64(self as u64) } }
extend u8: Hashable { func hash_value(self) -> u64 { mix64(self as u64) } }
extend u16: Hashable { func hash_value(self) -> u64 { mix64(self as u64) } }
extend u32: Hashable { func hash_value(self) -> u64 { mix64(self as u64) } }
extend u64: Hashable { func hash_value(self) -> u64 { mix64(self) } }
extend usize: Hashable { func hash_value(self) -> u64 { mix64(self as u64) } }
extend bool: Hashable { func hash_value(self) -> u64 { if self { mix64(1) } else { mix64(0) } } }
extend f64: Hashable { func hash_value(self) -> u64 { hash_f64(self) } }
extend f32: Hashable { func hash_value(self) -> u64 { hash_f64(self as f64) } }
extend str: Hashable {
    func hash_value(self) -> u64 {
        let data = str_data(self);
        let len = str_len(self);
        var h: u64 = 0xCBF29CE484222325;
        var i: usize = 0;
        while i < len {
            h = (h ^ (load_u8(data + i) as u64)) * 0x00000100000001B3;
            i = i + 1;
        }
        return h;
    }
}
// The built-in `String`'s own FNV-1a hash, so a `str` and a `String` with
// the same bytes hash alike.
extend String: Hashable { func hash_value(self) -> u64 { self.hash() } }
