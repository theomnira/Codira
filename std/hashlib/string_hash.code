// std/hashlib/string_hash.code
// Hashing a `String` (FNV-1a 64 over its UTF-8 bytes). Not cryptographic,
// and not resistant to hash flooding: an attacker who chooses the keys of a
// table hashed with it can make them all collide. For hash tables and
// fingerprints of trusted data only.
//
// Kept apart from `std.hashlib.hash` so that `[u8]` hashing does not pull
// in strings.

import root.hashlib.hash.{hash_bytes};

// The FNV-1a 64 hash of the string's bytes: equal to
// `hash_bytes(value.bytes())`, without copying them.
public func hash_string(value: String) -> u64 {
    return value.hash();
}

// The same hash computed through `hash_bytes`, over a copy of the bytes.
public func hash_string_bytes(value: String) -> u64 {
    return hash_bytes(value.bytes());
}
