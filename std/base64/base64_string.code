// std/base64/base64_string.code
// Base64, Base32 and Base16 between byte arrays and strings, with the
// standard alphabets (RFC 4648) and `=` padding.
//
// The encodings themselves are `std.base64.base64`'s, over `[u8]`; this
// module only converts: an encoded text is ASCII, so it is always a valid
// `String`, and decoding reads the string's bytes. As there, decoding skips
// bytes outside the alphabet and returns an empty array for invalid input.

import root.base64.base64.{b64_encode, b64_decode, b32_encode, b32_decode, b16_encode, b16_decode};

// `data` as Base64 text.
public func b64encode(data: [u8]) -> String {
    return string_from_utf8(b64_encode(data))!;
}

// The bytes of the Base64 text `encoded`.
public func b64decode(encoded: String) -> [u8] {
    return b64_decode(encoded.bytes());
}

// `data` as Base32 text.
public func b32encode(data: [u8]) -> String {
    return string_from_utf8(b32_encode(data))!;
}

// The bytes of the Base32 text `encoded`.
public func b32decode(encoded: String) -> [u8] {
    return b32_decode(encoded.bytes());
}

// `data` as upper-case hexadecimal text.
public func b16encode(data: [u8]) -> String {
    return string_from_utf8(b16_encode(data))!;
}

// The bytes of the hexadecimal text `encoded` (either case).
public func b16decode(encoded: String) -> [u8] {
    return b16_decode(encoded.bytes());
}

// The text `s` encoded as Base64 (of its UTF-8 bytes).
public func b64encode_string(s: String) -> String {
    return b64encode(s.bytes());
}

// The text whose UTF-8 bytes the Base64 text `encoded` holds, or `nil` when
// they are not UTF-8.
public func b64decode_string(encoded: String) -> String? {
    return string_from_utf8(b64decode(encoded));
}
