// std/base64/base64.code
// Base64, Base32, and Base16 encoding/decoding for Codira.
// Implements RFC 4648 standard alphabets.

// ===========================================================================
// Base64
// ===========================================================================

// Standard Base64 alphabet (RFC 4648 Table 1).
let B64_ALPHABET: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
let B64_PAD: u8 = 61; // '='

// ---------------------------------------------------------------------------
// b64encode
// Encodes a byte array into a Base64-encoded string.
// ---------------------------------------------------------------------------
public func b64encode(data: Array[u8]) -> String {
    let mut result: String = "";
    let len: usize = data.len();
    let mut i: usize = 0;

    while i < len {
        let b0: u32 = data[i] as u32;
        let b1: u32 = if i + 1 < len { data[i + 1] as u32 } else { 0 };
        let b2: u32 = if i + 2 < len { data[i + 2] as u32 } else { 0 };

        let triple: u32 = (b0 << 16) | (b1 << 8) | b2;

        result = result + char_at(B64_ALPHABET, ((triple >> 18) & 0x3F) as usize);
        result = result + char_at(B64_ALPHABET, ((triple >> 12) & 0x3F) as usize);

        if i + 1 < len {
            result = result + char_at(B64_ALPHABET, ((triple >> 6) & 0x3F) as usize);
        } else {
            result = result + "=";
        }

        if i + 2 < len {
            result = result + char_at(B64_ALPHABET, (triple & 0x3F) as usize);
        } else {
            result = result + "=";
        }

        i = i + 3;
    }
    return result;
}

// ---------------------------------------------------------------------------
// b64decode
// Decodes a Base64-encoded string into a byte array.
// Ignores whitespace. Returns an empty array on invalid input.
// ---------------------------------------------------------------------------
public func b64decode(encoded: String) -> Array[u8] {
    // Build reverse lookup.
    let mut result: Array[u8] = Array.new();
    let mut buf: Array[u8] = Array.new();

    // Strip whitespace and collect valid base64 chars.
    let mut i: usize = 0;
    while i < encoded.len() {
        let ch: u8 = encoded.byte_at(i);
        if b64_char_value(ch) >= 0 || ch == B64_PAD {
            buf.push(ch);
        }
        i = i + 1;
    }

    i = 0;
    while i + 3 < buf.len() {
        let v0: i32 = b64_char_value(buf[i]);
        let v1: i32 = b64_char_value(buf[i + 1]);
        let v2: i32 = if buf[i + 2] == B64_PAD { 0 } else { b64_char_value(buf[i + 2]) };
        let v3: i32 = if buf[i + 3] == B64_PAD { 0 } else { b64_char_value(buf[i + 3]) };

        if v0 < 0 || v1 < 0 {
            return Array.new(); // invalid
        }

        let triple: u32 = ((v0 as u32) << 18) | ((v1 as u32) << 12) | ((v2 as u32) << 6) | (v3 as u32);
        result.push(((triple >> 16) & 0xFF) as u8);
        if buf[i + 2] != B64_PAD {
            result.push(((triple >> 8) & 0xFF) as u8);
        }
        if buf[i + 3] != B64_PAD {
            result.push((triple & 0xFF) as u8);
        }
        i = i + 4;
    }
    return result;
}

// Returns the 6-bit value for a base64 character, or -1 if invalid.
func b64_char_value(ch: u8) -> i32 {
    if ch >= 65 && ch <= 90  { return (ch - 65) as i32; }       // A-Z
    if ch >= 97 && ch <= 122 { return (ch - 97 + 26) as i32; }  // a-z
    if ch >= 48 && ch <= 57  { return (ch - 48 + 52) as i32; }  // 0-9
    if ch == 43 { return 62; }  // +
    if ch == 47 { return 63; }  // /
    return -1;
}

// ===========================================================================
// Base16 (Hex)
// ===========================================================================

let HEX_ALPHABET: String = "0123456789ABCDEF";

// ---------------------------------------------------------------------------
// b16encode
// Encodes a byte array as a hexadecimal string (uppercase).
// ---------------------------------------------------------------------------
public func b16encode(data: Array[u8]) -> String {
    let mut result: String = "";
    let mut i: usize = 0;
    while i < data.len() {
        let hi: u8 = (data[i] >> 4) & 0x0F;
        let lo: u8 = data[i] & 0x0F;
        result = result + char_at(HEX_ALPHABET, hi as usize);
        result = result + char_at(HEX_ALPHABET, lo as usize);
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// b16decode
// Decodes a hexadecimal string into a byte array.
// Case-insensitive. Returns empty array on invalid input.
// ---------------------------------------------------------------------------
public func b16decode(encoded: String) -> Array[u8] {
    let mut result: Array[u8] = Array.new();
    let len: usize = encoded.len();
    if len % 2 != 0 {
        return result; // invalid: odd length
    }
    let mut i: usize = 0;
    while i < len {
        let hi: i32 = hex_char_value(encoded.byte_at(i));
        let lo: i32 = hex_char_value(encoded.byte_at(i + 1));
        if hi < 0 || lo < 0 {
            return Array.new(); // invalid character
        }
        result.push(((hi << 4) | lo) as u8);
        i = i + 2;
    }
    return result;
}

func hex_char_value(ch: u8) -> i32 {
    if ch >= 48 && ch <= 57  { return (ch - 48) as i32; }       // 0-9
    if ch >= 65 && ch <= 70  { return (ch - 65 + 10) as i32; }  // A-F
    if ch >= 97 && ch <= 102 { return (ch - 97 + 10) as i32; }  // a-f
    return -1;
}

// ===========================================================================
// Base32
// ===========================================================================

let B32_ALPHABET: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
let B32_PAD: u8 = 61; // '='

// ---------------------------------------------------------------------------
// b32encode
// Encodes a byte array into a Base32-encoded string (RFC 4648).
// ---------------------------------------------------------------------------
public func b32encode(data: Array[u8]) -> String {
    let mut result: String = "";
    let len: usize = data.len();
    let mut i: usize = 0;

    while i < len {
        // Collect up to 5 bytes into a 40-bit buffer.
        let mut buf: u64 = 0;
        let mut bytes_in_group: u32 = 0;
        let mut j: u32 = 0;
        while j < 5 {
            buf = buf << 8;
            if i + (j as usize) < len {
                buf = buf | (data[i + (j as usize)] as u64);
                bytes_in_group = bytes_in_group + 1;
            }
            j = j + 1;
        }

        // Determine how many output characters this group produces.
        let output_chars: u32 = if bytes_in_group == 5 { 8 }
            else if bytes_in_group == 4 { 7 }
            else if bytes_in_group == 3 { 5 }
            else if bytes_in_group == 2 { 4 }
            else { 2 };

        // Extract 5-bit groups from the 40-bit buffer.
        let mut k: u32 = 0;
        while k < 8 {
            if k < output_chars {
                let shift: u32 = (7 - k) * 5;
                let idx: u64 = (buf >> shift) & 0x1F;
                result = result + char_at(B32_ALPHABET, idx as usize);
            } else {
                result = result + "=";
            }
            k = k + 1;
        }

        i = i + 5;
    }
    return result;
}

// ---------------------------------------------------------------------------
// b32decode
// Decodes a Base32-encoded string into a byte array.
// Case-insensitive for letters. Returns empty array on invalid input.
// ---------------------------------------------------------------------------
public func b32decode(encoded: String) -> Array[u8] {
    let mut result: Array[u8] = Array.new();
    let mut buf: u64 = 0;
    let mut bits: u32 = 0;

    let mut i: usize = 0;
    while i < encoded.len() {
        let ch: u8 = encoded.byte_at(i);
        if ch == B32_PAD {
            break;
        }
        let val: i32 = b32_char_value(ch);
        if val < 0 {
            i = i + 1;
            continue; // skip whitespace / invalid
        }
        buf = (buf << 5) | (val as u64);
        bits = bits + 5;
        if bits >= 8 {
            bits = bits - 8;
            result.push(((buf >> bits) & 0xFF) as u8);
        }
        i = i + 1;
    }
    return result;
}

func b32_char_value(ch: u8) -> i32 {
    if ch >= 65 && ch <= 90  { return (ch - 65) as i32; }       // A-Z
    if ch >= 97 && ch <= 122 { return (ch - 97) as i32; }       // a-z
    if ch >= 50 && ch <= 55  { return (ch - 50 + 26) as i32; }  // 2-7
    return -1;
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
func char_at(s: String, index: usize) -> String {
    return char_from_byte(s.byte_at(index));
}

extern func char_from_byte(b: u8) -> String;
