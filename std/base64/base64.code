// std/base64/base64.code
// Base64, Base32 and Base16 (hex) encoding and decoding over byte arrays:
// the standard alphabets with `=` padding (base64 `A-Z a-z 0-9 + /`,
// base32 `A-Z 2-7`, base16 `0-9 A-F`), as the IETF standard for these
// encodings defines them. Not the URL-safe base64 alphabet.
//
// Bytes in, bytes out: the encoded text is the ASCII bytes of the encoding,
// in a `[u8]`. Decoding follows `std.base64.base64_string` exactly:
//
//   - `b64_decode` skips every byte that is neither in the alphabet nor `=`
//     (so whitespace and line breaks are ignored), decodes complete groups
//     of four, ignores an incomplete group at the end, and returns an empty
//     array when a group starts with `=` in either of its first two places.
//   - `b16_decode` accepts both cases and returns an empty array for an odd
//     length or a byte that is not a hex digit.
//   - `b32_decode` accepts both cases, skips bytes outside the alphabet, and
//     stops at the first `=`.
//
// An empty array is also the decoding of empty input, so a caller that must
// tell invalid input from empty input checks for empty input first.

// `=`, the padding byte.
func PAD() -> u8 { 61 }

func empty() -> [u8] {
    array_filled(0 as u8, 0)
}

// ===========================================================================
// Base64
// ===========================================================================

// The base64 symbol for a 6-bit value.
func b64_symbol(v: u32) -> u8 {
    if v < 26 { return (65 + v) as u8; }        // A-Z
    if v < 52 { return (97 + v - 26) as u8; }   // a-z
    if v < 62 { return (48 + v - 52) as u8; }   // 0-9
    if v == 62 { return 43; }                   // +
    return 47;                                  // /
}

// The 6-bit value of a base64 symbol, or -1.
func b64_value(ch: u8) -> i32 {
    if ch >= 65 && ch <= 90  { return (ch - 65) as i32; }       // A-Z
    if ch >= 97 && ch <= 122 { return (ch - 97 + 26) as i32; }  // a-z
    if ch >= 48 && ch <= 57  { return (ch - 48 + 52) as i32; }  // 0-9
    if ch == 43 { return 62; }  // +
    if ch == 47 { return 63; }  // /
    return -1;
}

// The length of the base64 encoding of `n` bytes: four symbols for every
// three bytes or part of three.
public func b64_encoded_len(n: usize) -> usize {
    ((n + 2) / 3) * 4
}

// Encodes `data` as base64, padded with `=` to a multiple of four.
public func b64_encode(data: [u8]) -> [u8] {
    let len: usize = data.len();
    var out = array_filled(0 as u8, b64_encoded_len(len));
    var i: usize = 0;
    var o: usize = 0;
    while i < len {
        let b0: u32 = data[i] as u32;
        let b1: u32 = if i + 1 < len { data[i + 1] as u32 } else { 0 };
        let b2: u32 = if i + 2 < len { data[i + 2] as u32 } else { 0 };
        let triple: u32 = (b0 << 16) | (b1 << 8) | b2;

        out[o] = b64_symbol((triple >> 18) & 0x3F);
        out[o + 1] = b64_symbol((triple >> 12) & 0x3F);
        out[o + 2] = if i + 1 < len { b64_symbol((triple >> 6) & 0x3F) } else { PAD() };
        out[o + 3] = if i + 2 < len { b64_symbol(triple & 0x3F) } else { PAD() };

        i = i + 3;
        o = o + 4;
    }
    out
}

// Decodes base64 `encoded` (see the top of this file for what is skipped
// and what is invalid).
public func b64_decode(encoded: [u8]) -> [u8] {
    // The symbols and padding, without anything else.
    var kept: usize = 0;
    for ch in encoded {
        if b64_value(ch) >= 0 || ch == PAD() { kept = kept + 1; }
    }
    var buf = array_filled(0 as u8, kept);
    var k: usize = 0;
    for ch in encoded {
        if b64_value(ch) >= 0 || ch == PAD() {
            buf[k] = ch;
            k = k + 1;
        }
    }

    // How many bytes the complete groups decode to.
    var size: usize = 0;
    var i: usize = 0;
    while i + 3 < kept {
        size = size + 1;
        if buf[i + 2] != PAD() { size = size + 1; }
        if buf[i + 3] != PAD() { size = size + 1; }
        i = i + 4;
    }

    var out = array_filled(0 as u8, size);
    var o: usize = 0;
    i = 0;
    while i + 3 < kept {
        let v0: i32 = b64_value(buf[i]);
        let v1: i32 = b64_value(buf[i + 1]);
        let v2: i32 = if buf[i + 2] == PAD() { 0 } else { b64_value(buf[i + 2]) };
        let v3: i32 = if buf[i + 3] == PAD() { 0 } else { b64_value(buf[i + 3]) };
        if v0 < 0 || v1 < 0 {
            return empty();
        }
        let triple: u32 = ((v0 as u32) << 18) | ((v1 as u32) << 12) | ((v2 as u32) << 6) | (v3 as u32);
        out[o] = ((triple >> 16) & 0xFF) as u8;
        o = o + 1;
        if buf[i + 2] != PAD() {
            out[o] = ((triple >> 8) & 0xFF) as u8;
            o = o + 1;
        }
        if buf[i + 3] != PAD() {
            out[o] = (triple & 0xFF) as u8;
            o = o + 1;
        }
        i = i + 4;
    }
    out
}

// ===========================================================================
// Base16 (hex)
// ===========================================================================

// The upper-case hex digit for a 4-bit value.
func hex_symbol(v: u8) -> u8 {
    if v < 10 { return 48 + v; }   // 0-9
    return 65 + v - 10;            // A-F
}

// The value of a hex digit (either case), or -1.
func hex_value(ch: u8) -> i32 {
    if ch >= 48 && ch <= 57  { return (ch - 48) as i32; }       // 0-9
    if ch >= 65 && ch <= 70  { return (ch - 65 + 10) as i32; }  // A-F
    if ch >= 97 && ch <= 102 { return (ch - 97 + 10) as i32; }  // a-f
    return -1;
}

// Encodes `data` as upper-case hex, two digits per byte.
public func b16_encode(data: [u8]) -> [u8] {
    var out = array_filled(0 as u8, data.len() * 2);
    var i: usize = 0;
    while i < data.len() {
        out[2 * i] = hex_symbol((data[i] >> 4) & 0x0F);
        out[2 * i + 1] = hex_symbol(data[i] & 0x0F);
        i = i + 1;
    }
    out
}

// Decodes hex in either case; empty for an odd length or a non-digit.
public func b16_decode(encoded: [u8]) -> [u8] {
    let len: usize = encoded.len();
    if len % 2 != 0 {
        return empty();
    }
    var out = array_filled(0 as u8, len / 2);
    var i: usize = 0;
    while i < len {
        let hi: i32 = hex_value(encoded[i]);
        let lo: i32 = hex_value(encoded[i + 1]);
        if hi < 0 || lo < 0 {
            return empty();
        }
        out[i / 2] = ((hi << 4) | lo) as u8;
        i = i + 2;
    }
    out
}

// ===========================================================================
// Base32
// ===========================================================================

// The base32 symbol for a 5-bit value.
func b32_symbol(v: u64) -> u8 {
    if v < 26 { return (65 + v) as u8; }      // A-Z
    return (50 + v - 26) as u8;               // 2-7
}

// The 5-bit value of a base32 symbol (either case), or -1.
func b32_value(ch: u8) -> i32 {
    if ch >= 65 && ch <= 90  { return (ch - 65) as i32; }       // A-Z
    if ch >= 97 && ch <= 122 { return (ch - 97) as i32; }       // a-z
    if ch >= 50 && ch <= 55  { return (ch - 50 + 26) as i32; }  // 2-7
    return -1;
}

// The length of the base32 encoding of `n` bytes: eight symbols for every
// five bytes or part of five.
public func b32_encoded_len(n: usize) -> usize {
    ((n + 4) / 5) * 8
}

// Encodes `data` as base32, padded with `=` to a multiple of eight.
public func b32_encode(data: [u8]) -> [u8] {
    let len: usize = data.len();
    var out = array_filled(0 as u8, b32_encoded_len(len));
    var i: usize = 0;
    var o: usize = 0;
    while i < len {
        // Up to five bytes in a 40-bit group.
        var group: u64 = 0;
        var bytes_in_group: u32 = 0;
        var j: usize = 0;
        while j < 5 {
            group = group << 8;
            if i + j < len {
                group = group | (data[i + j] as u64);
                bytes_in_group = bytes_in_group + 1;
            }
            j = j + 1;
        }

        // 1, 2, 3, 4 or 5 bytes are 2, 4, 5, 7 or 8 symbols.
        let symbols: u32 = if bytes_in_group == 5 { 8 }
            else if bytes_in_group == 4 { 7 }
            else if bytes_in_group == 3 { 5 }
            else if bytes_in_group == 2 { 4 }
            else { 2 };

        var k: u32 = 0;
        while k < 8 {
            if k < symbols {
                let shift: u64 = ((7 - k) * 5) as u64;
                out[o] = b32_symbol((group >> shift) & 0x1F);
            } else {
                out[o] = PAD();
            }
            o = o + 1;
            k = k + 1;
        }
        i = i + 5;
    }
    out
}

// Decodes base32 in either case: skips bytes outside the alphabet and
// stops at the first `=`.
public func b32_decode(encoded: [u8]) -> [u8] {
    // How many symbols come before the first `=`: every eight bits of them
    // is a byte.
    var bits_total: usize = 0;
    for ch in encoded {
        if ch == PAD() { break; }
        if b32_value(ch) >= 0 { bits_total = bits_total + 5; }
    }

    var out = array_filled(0 as u8, bits_total / 8);
    var o: usize = 0;
    var acc: u64 = 0;
    var bits: u64 = 0;
    for ch in encoded {
        if ch == PAD() { break; }
        let val: i32 = b32_value(ch);
        if val >= 0 {
            acc = (acc << 5) | (val as u64);
            bits = bits + 5;
            if bits >= 8 {
                bits = bits - 8;
                out[o] = ((acc >> bits) & 0xFF) as u8;
                o = o + 1;
            }
        }
    }
    out
}
