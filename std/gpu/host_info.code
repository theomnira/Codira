// Placeholder for when no GPU is available.
public let NoGPU: GPUInfo = GPUInfo {
    name: "NoGPU",
    api: "none",
    arch_name: "no_gpu",
    compute: 0.0,
    version: "",
    sm_count: 0,
    warp_size: 0,
    threads_per_multiprocessor: 0,
    shared_memory_per_multiprocessor: 0,
    max_registers_per_block: 0,
    max_thread_block_size: 0,
};

