// =============================================================================
// GPU classification helpers
// =============================================================================

// True for any Blackwell datacenter GPU (B100, B200, B300).
public func _is_sm10x_gpu(info: GPUInfo) -> bool {
    return info.arch_name == "blackwell" && info.compute >= 10.0 && info.compute < 11.0;
}

// True for any Blackwell consumer GPU (sm_120 / sm_121).
public func _is_sm12x_gpu(info: GPUInfo) -> bool {
    return info.compute >= 12.0 && info.compute < 13.0;
}