//
// This module defines hardware-specific constants like warp size and thread
// block limits that are used throughout the GPU programming interface.  It
// handles both NVIDIA and AMD GPU architectures, automatically detecting and
// configuring the appropriate values based on the available hardware.
//
// The constants are resolved at compile time based on the target GPU
// architecture and are used to optimize code generation and ensure hardware
// compatibility.
// =============================================================================

import std.builtin.types;
import std.sys.info;
import std.gpu.host_info;

// =============================================================================
// WARP_SIZE
// =============================================================================

// The number of threads that execute in lockstep within a warp on the GPU.
//
// This constant represents the hardware warp size, the number of threads
// that execute instructions synchronously as a unit.  The value is
// architecture-dependent:
//   - 32 threads per warp on NVIDIA GPUs
//   - 32 threads per warp on AMD RDNA GPUs
//   - 64 threads per warp on AMD CDNA GPUs
//   - 0 if no GPU is detected
//
// The warp size is a fundamental parameter that affects thread scheduling,
// memory-access coalescing, synchronization primitives, and overall
// performance optimization.
public let WARP_SIZE: usize = _resolve_warp_size();

// Resolve the warp size for the active compilation target.
public func _resolve_warp_size() -> usize {
    if info.is_nvidia_gpu() {
        return 32;
    }
    if info._is_amd_rdna() {
        return 32;
    }
    if info.is_amd_gpu() {
        return 64;
    }
    if info.is_apple_gpu() {
        return 32;
    }
    if info._accelerator_arch() == "" {
        return 0;
    }
    return host_info.GPUInfo.from_name(info._accelerator_arch()).warp_size;
}

// =============================================================================
// WARPGROUP_SIZE
// =============================================================================

// The number of threads in a warpgroup on NVIDIA GPUs.
//
// On NVIDIA GPUs after Hopper, a warpgroup consists of 4 subsequent warps,
// i.e. 128 threads.  The first warp id must be a multiple of 4.
//
// Warpgroup is used for wgmma instructions on Hopper and tcgen05.ld on
// Blackwell.
public let WARPGROUP_SIZE: usize = 128;

// =============================================================================
// MAX_THREADS_PER_BLOCK_METADATA
// =============================================================================

// Metadata tag used in conjunction with `__intrinsic_llvm_metadata` to give
// a hint to the compiler about the max threads per block that's used.
public let MAX_THREADS_PER_BLOCK_METADATA: String = _resolve_max_threads_per_block_metadata();

// Resolve the max-threads-per-block metadata key for the active target.
public func _resolve_max_threads_per_block_metadata() -> String {
    if info.is_nvidia_gpu() | info.has_nvidia_gpu_accelerator() {
        return "nvvm.maxntid";
    }
    if info.is_amd_gpu() | info.has_amd_gpu_accelerator() {
        return "rocdl.flat_work_group_size";
    }
    if info.is_apple_gpu() {
        // Attribute used to represent Metal's
        // `[[max_total_threads_per_threadgroup(x)]]`.
        return "pop.air.max_work_group_size";
    }
    info.unsupported_target_error("MAX_THREADS_PER_BLOCK_METADATA");
}
