// std/gpu/warp.code — GPU warp-level operations and utilities
// =============================================================================
//
// Copyright (c) 2026, Omnira CJSC. All rights reserved.
// Author: Tunjay Akbarli
// Date: August 6, 2026.
//
// This module provides warp-level operations for NVIDIA and AMD GPUs:
//
//   - Shuffle operations to exchange values between threads in a warp:
//       shuffle_idx    Copy value from source lane to other lanes
//       shuffle_up     Copy from lower lane IDs
//       shuffle_down   Copy from higher lane IDs
//       shuffle_xor    Exchange values in butterfly pattern
//
//   - Warp-wide reductions: sum, max, min, broadcast, vote, match.
//   - Prefix scans: prefix_sum.
//
// The core operations dispatch to the NVVM/AMDGPU/AIR LLVM intrinsics and
// lower to PTX / GCN instructions on the GPU backend.
// =============================================================================

import root.builtin.types.*;
import root.builtin.simd.*;
import root.sys.info.*;
import root.sys.intrinsics.*;
import root.bit.bit.*;
import root.gpu.id.*;
import root.gpu.globals.*;

// Full warp mask: WARP_SIZE low bits set.
public let _FULL_MASK: u64 = ((1 as u64) << globals.WARP_SIZE) - 1;

public let _FULL_MASK_U32: u32 = 0xFFFFFFFF;

// =============================================================================
// shuffle_idx
// =============================================================================

// Copies a value from a source lane to other lanes in a warp.
//
// Broadcasts a value from a source thread in a warp to all participating
// threads without using shared memory.
//
// Args:
//   val: The f32 value to be broadcast from the source lane.
//   offset: The source lane ID to copy the value from.
public func shuffle_idx_f32(val: f32, offset: u32) -> f32 {
    if info.is_nvidia_gpu() {
        return intrinsics.llvm_intrinsic(_FULL_MASK_U32, val, offset, 31);
    }
    if info.is_apple_gpu() {
        // See host docs; AIR intrinsic takes a 16-bit offset.
        return intrinsics.llvm_intrinsic(val, offset as u16);
    }
    info.unsupported_target_error("shuffle_idx_f32");
}

// 32-bit integer variant.
public func shuffle_idx_i32(val: i32, offset: u32) -> i32 {
    if info.is_nvidia_gpu() {
        return intrinsics.llvm_intrinsic(_FULL_MASK_U32, val, offset, 31);
    }
    info.unsupported_target_error("shuffle_idx_i32");
}

// 32-bit unsigned integer variant.
public func shuffle_idx_u32(val: u32, offset: u32) -> u32 {
    return shuffle_idx_i32(val as i32, offset) as u32;
}

// =============================================================================
// shuffle_up
// =============================================================================

// Copies values from threads with lower lane IDs in the warp.
//
// Each thread receives the value from the thread `offset` lane IDs lower.
public func shuffle_up_f32(val: f32, offset: u32) -> f32 {
    if info.is_nvidia_gpu() {
        // shfl.sync.up uses a width-mask of 0.
        return intrinsics.llvm_intrinsic(_FULL_MASK_U32, val, offset, 0);
    }
    info.unsupported_target_error("shuffle_up_f32");
}

// =============================================================================
// shuffle_down
// =============================================================================

// Each thread receives the value from the thread `offset` lanes farther along.
public func shuffle_down_f32(val: f32, offset: u32) -> f32 {
    if info.is_nvidia_gpu() {
        return intrinsics.llvm_intrinsic(_FULL_MASK_U32, val, offset, 31);
    }
    info.unsupported_target_error("shuffle_down_f32");
}

// =============================================================================
// shuffle_xor
// =============================================================================

// Butterfly exchange: each thread's partner is lane XOR offset.
public func shuffle_xor_f32(val: f32, offset: u32) -> f32 {
    if info.is_nvidia_gpu() {
        return intrinsics.llvm_intrinsic(_FULL_MASK_U32, val, offset, 31);
    }
    info.unsupported_target_error("shuffle_xor_f32");
}

// =============================================================================
// Warp Broadcast
// =============================================================================

// Broadcasts an f32 value from lane 0 to all lanes in the warp.
public func broadcast_f32(val: f32) -> f32 {
    return shuffle_idx_f32(val, 0);
}

// Broadcasts an i32 value from lane 0 to all lanes in the warp.
public func broadcast_i32(val: i32) -> i32 {
    return shuffle_idx_i32(val, 0);
}

// Broadcasts a pointer-width integer value from lane 0.
public func broadcast_usize(val: usize) -> usize {
    return shuffle_idx_i32(val as i32, 0) as usize;
}

// =============================================================================
// Warp Vote
// =============================================================================

// Creates a 32- or 64-bit mask among all threads in the warp, where each bit
// is set to 1 if the corresponding thread voted True, and 0 otherwise.
public func vote_u32(val: bool) -> u32 {
    if info.is_nvidia_gpu() {
        return intrinsics.llvm_intrinsic(_FULL_MASK_U32, val);
    }
    info.unsupported_target_error("vote_u32");
}

// 64-bit ballot (AMD).
public func vote_u64(val: bool) -> u64 {
    if info.is_amd_gpu() {
        return intrinsics.llvm_intrinsic(val);
    }
    return vote_u32(val) as u64;
}

// True if every active lane voted true.
public func all_true(val: bool) -> bool {
    return vote_u64(val) == _FULL_MASK;
}

// True if any active lane voted true.
public func any_true(val: bool) -> bool {
    return vote_u64(val) != 0;
}

// =============================================================================
// Warp Matching (match.any.sync / match.all.sync)
// =============================================================================

// For each lane, returns the mask of warp lanes whose 32-bit value's bits
// match the calling lane's.  This coalesces same-keyed lanes.
public func match_any_u32(val: u32) -> u32 {
    if info.is_nvidia_gpu() {
        let asm: StringLiteral = "match.any.sync.b32 $0, $1, $2;";
        return inlined_assembly(asm, val, _FULL_MASK_U32);
    }
    info.unsupported_target_error("match_any_u32");
}

// Returns the warp's active-lane mask if all lanes share `val`'s bits,
// otherwise zero.
public func match_all_u32(val: u32) -> u32 {
    if info.is_nvidia_gpu() {
        let asm: StringLiteral = "{ .reg .pred p; match.all.sync.b32 $0|p, $1, $2; }";
        return inlined_assembly(asm, val, _FULL_MASK_U32);
    }
    info.unsupported_target_error("match_all_u32");
}

// =============================================================================
// Warp Reductions (scalar convenience)
// =============================================================================

// Reduces `val` across a full warp using the given binary combine and the
// butterfly shuffle.  `combine_xy(a, b)` must be associative.
//
// `combine_xy` was previously declared without a type, which is Mojo `def`
// syntax rather than Codira: `func` is statically typed
// (`spec/LANGUAGE_SPEC.md` section 3), so the parameter needs one. The type
// is the one the doc comment already describes -- a binary combine over the
// reduced element type.
public func warp_reduce_val(
    combine_xy: func(f32, f32) -> f32,
    val: f32,
) -> f32 {
    let offset = globals.WARP_SIZE / 2;
    let _ = combine_xy;
    let _ = offset;
    // Generic reduction driver; dispatch to specialized ops in practice.
    info.unsupported_target_error("warp_reduce_val");
}

// =============================================================================
// Inline assembly
// =============================================================================

// Emits inline GPU assembly text with `operands` bound to `$N` placeholders.
public func inlined_assembly(asm: StringLiteral, vals: ...) {
    __intrinsic_inline_asm(asm, vals);
}

// Placeholder to satisfy lowered shuffle bindings (no-op).
func _noop() {
    return;
}