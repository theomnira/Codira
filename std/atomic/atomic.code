// std/atomic/atomic.code
// Atomic operations for Codira.
// Provides the Atomic struct and MemoryOrder enum for lock-free concurrent
// programming. Operations map directly to hardware atomic instructions via
// compiler intrinsics.

// ---------------------------------------------------------------------------
// MemoryOrder
// Specifies memory ordering constraints for atomic operations.
// Mirrors the C++11 / LLVM memory ordering model.
// ---------------------------------------------------------------------------
public struct MemoryOrder {
    _value: u8,
}

// Memory ordering constants.
public let RELAXED: MemoryOrder       = MemoryOrder { _value: 0 };
public let CONSUME: MemoryOrder       = MemoryOrder { _value: 1 };
public let ACQUIRE: MemoryOrder       = MemoryOrder { _value: 2 };
public let RELEASE: MemoryOrder       = MemoryOrder { _value: 3 };
public let ACQ_REL: MemoryOrder       = MemoryOrder { _value: 4 };
public let SEQ_CST: MemoryOrder       = MemoryOrder { _value: 5 };

// Returns a human-readable name for the ordering.
public func memory_order_name(order: MemoryOrder) -> String {
    if order._value == 0 { return "Relaxed"; }
    if order._value == 1 { return "Consume"; }
    if order._value == 2 { return "Acquire"; }
    if order._value == 3 { return "Release"; }
    if order._value == 4 { return "AcqRel"; }
    if order._value == 5 { return "SeqCst"; }
    return "Unknown";
}

// ---------------------------------------------------------------------------
// Atomic<T>
// A wrapper around a value that supports atomic load, store, and
// read-modify-write operations. T must be an integer type that fits in
// a machine word (u8, u16, u32, u64, i8, i16, i32, i64, usize, isize, bool).
// ---------------------------------------------------------------------------
public struct Atomic<T> {
    _value: T,
}

// ---------------------------------------------------------------------------
// atomic_new
// Creates a new Atomic with the given initial value.
// ---------------------------------------------------------------------------
public func atomic_new<T>(initial: T) -> Atomic<T> {
    return Atomic { _value: initial };
}

// ===========================================================================
// Atomic u64
// ===========================================================================

// load – atomically reads the current value.
public func atomic_load_u64(self: Atomic<u64>, order: MemoryOrder) -> u64 {
    return _intrinsic_atomic_load_u64(self._value, order._value);
}

// store – atomically writes a new value.
public func atomic_store_u64(self: mut Atomic<u64>, value: u64, order: MemoryOrder) {
    _intrinsic_atomic_store_u64(self._value, value, order._value);
}

// compare_exchange – atomically compares and conditionally swaps.
// If current value equals `expected`, stores `desired` and returns true.
// Otherwise stores the current value into `expected` and returns false.
public struct CasResult<T> {
    success: bool,
    old_value: T,
}

public func atomic_compare_exchange_u64(
    self: mut Atomic<u64>,
    expected: u64,
    desired: u64,
    success_order: MemoryOrder,
    failure_order: MemoryOrder,
) -> CasResult<u64> {
    let old: u64 = _intrinsic_atomic_cmpxchg_u64(
        self._value, expected, desired,
        success_order._value, failure_order._value,
    );
    return CasResult { success: old == expected, old_value: old };
}

// fetch_add – atomically adds `delta` to the value and returns the old value.
public func atomic_fetch_add_u64(self: mut Atomic<u64>, delta: u64, order: MemoryOrder) -> u64 {
    return _intrinsic_atomic_fetch_add_u64(self._value, delta, order._value);
}

// fetch_sub – atomically subtracts `delta` and returns the old value.
public func atomic_fetch_sub_u64(self: mut Atomic<u64>, delta: u64, order: MemoryOrder) -> u64 {
    return _intrinsic_atomic_fetch_sub_u64(self._value, delta, order._value);
}

// fetch_and – atomically performs bitwise AND and returns the old value.
public func atomic_fetch_and_u64(self: mut Atomic<u64>, mask: u64, order: MemoryOrder) -> u64 {
    return _intrinsic_atomic_fetch_and_u64(self._value, mask, order._value);
}

// fetch_or – atomically performs bitwise OR and returns the old value.
public func atomic_fetch_or_u64(self: mut Atomic<u64>, mask: u64, order: MemoryOrder) -> u64 {
    return _intrinsic_atomic_fetch_or_u64(self._value, mask, order._value);
}

// fetch_xor – atomically performs bitwise XOR and returns the old value.
public func atomic_fetch_xor_u64(self: mut Atomic<u64>, mask: u64, order: MemoryOrder) -> u64 {
    return _intrinsic_atomic_fetch_xor_u64(self._value, mask, order._value);
}

// exchange – atomically replaces the value and returns the old value.
public func atomic_exchange_u64(self: mut Atomic<u64>, value: u64, order: MemoryOrder) -> u64 {
    return _intrinsic_atomic_exchange_u64(self._value, value, order._value);
}

