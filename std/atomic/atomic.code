public func atomic_load_i64(self: Atomic<i64>, order: MemoryOrder) -> i64 {
    return _intrinsic_atomic_load_i64(self._value, order._value);
}

public func atomic_store_i64(self: mut Atomic<i64>, value: i64, order: MemoryOrder) {
    _intrinsic_atomic_store_i64(self._value, value, order._value);
}

public func atomic_fetch_add_i64(self: mut Atomic<i64>, delta: i64, order: MemoryOrder) -> i64 {
    return _intrinsic_atomic_fetch_add_i64(self._value, delta, order._value);
}

public func atomic_fetch_sub_i64(self: mut Atomic<i64>, delta: i64, order: MemoryOrder) -> i64 {
    return _intrinsic_atomic_fetch_sub_i64(self._value, delta, order._value);
}

public func atomic_compare_exchange_i64(
    self: mut Atomic<i64>,
    expected: i64,
    desired: i64,
    success_order: MemoryOrder,
    failure_order: MemoryOrder,
) -> CasResult<i64> {
    let old: i64 = _intrinsic_atomic_cmpxchg_i64(
        self._value, expected, desired,
        success_order._value, failure_order._value,
    );
    return CasResult { success: old == expected, old_value: old };
}

