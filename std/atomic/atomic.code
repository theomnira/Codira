// ===========================================================================
// Fence
// Issues a memory fence with the specified ordering.
// ===========================================================================
public func atomic_fence(order: MemoryOrder) {
    _intrinsic_atomic_fence(order._value);
}

// ===========================================================================
// Compiler intrinsic stubs (provided by the compiler backend).
// ===========================================================================
extern func _intrinsic_atomic_load_u64(addr: u64, order: u8) -> u64;
extern func _intrinsic_atomic_store_u64(addr: u64, value: u64, order: u8);
extern func _intrinsic_atomic_cmpxchg_u64(addr: u64, expected: u64, desired: u64, s: u8, f: u8) -> u64;
extern func _intrinsic_atomic_fetch_add_u64(addr: u64, delta: u64, order: u8) -> u64;
extern func _intrinsic_atomic_fetch_sub_u64(addr: u64, delta: u64, order: u8) -> u64;
extern func _intrinsic_atomic_fetch_and_u64(addr: u64, mask: u64, order: u8) -> u64;
extern func _intrinsic_atomic_fetch_or_u64(addr: u64, mask: u64, order: u8) -> u64;
extern func _intrinsic_atomic_fetch_xor_u64(addr: u64, mask: u64, order: u8) -> u64;
extern func _intrinsic_atomic_exchange_u64(addr: u64, value: u64, order: u8) -> u64;
extern func _intrinsic_atomic_load_i64(addr: i64, order: u8) -> i64;
extern func _intrinsic_atomic_store_i64(addr: i64, value: i64, order: u8);
extern func _intrinsic_atomic_fetch_add_i64(addr: i64, delta: i64, order: u8) -> i64;
extern func _intrinsic_atomic_fetch_sub_i64(addr: i64, delta: i64, order: u8) -> i64;
extern func _intrinsic_atomic_cmpxchg_i64(addr: i64, expected: i64, desired: i64, s: u8, f: u8) -> i64;
extern func _intrinsic_atomic_load_u32(addr: u32, order: u8) -> u32;
extern func _intrinsic_atomic_store_u32(addr: u32, value: u32, order: u8);
extern func _intrinsic_atomic_fetch_add_u32(addr: u32, delta: u32, order: u8) -> u32;
extern func _intrinsic_atomic_fetch_sub_u32(addr: u32, delta: u32, order: u8) -> u32;
extern func _intrinsic_atomic_load_bool(addr: bool, order: u8) -> bool;
extern func _intrinsic_atomic_store_bool(addr: bool, value: bool, order: u8);
extern func _intrinsic_atomic_exchange_bool(addr: bool, value: bool, order: u8) -> bool;
extern func _intrinsic_atomic_fence(order: u8);
