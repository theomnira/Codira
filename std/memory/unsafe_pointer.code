// =============================================================================
// std/memory/unsafe_pointer.code — Raw, unchecked pointer type
// =============================================================================
//
// UnsafePointer[T] is the low-level, unchecked pointer type.  It provides
// raw memory access without null checks, bounds checks, or lifetime
// tracking.  All operations on UnsafePointer are inherently unsafe — the
// caller is responsible for ensuring validity.
//
// Use cases:
//   - FFI / C interop
//   - Custom allocators
//   - Performance-critical inner loops where checks are hoisted
//   - Implementing safe abstractions (Array, HashMap, etc.)
//
// For everyday code, prefer Pointer[T] which provides safety checks.
// =============================================================================

import root.builtin.types.*;
import root.builtin.traits.*;

// A raw, unchecked pointer to a value of type T.
// No safety guarantees.  All operations are the caller's responsibility.
public struct UnsafePointer[T] {
    _addr: usize,
}

// =============================================================================
// Primitives this type is built from
// =============================================================================
//
// `load`/`store` need no help resolving `T`: a store's argument already has
// type `T`, and a load's `T` comes from the *caller's* expected type. This
// file declares its own copies rather than importing `pointer.code`'s,
// which would create a two-way dependency (`pointer.code` converts to
// `UnsafePointer` and this file converts back); an `extern "codira-intrinsic"`
// declaration has no linked symbol to collide over, so declaring the same
// primitive in both files costs nothing.
//
// `sizeof_of`/`alignof_of` need a value of type `T` to infer `T` from --
// `alloc(value: T)` in `pointer.code` has one. This file's element-stride
// methods (`offset`, `load_element`, `move_from`, the two static
// allocators, ...) do not: they have `self: UnsafePointer[T]` or nothing at
// all, never a bare `T`. `UnsafePointer[T]` cannot substitute for one --
// `extern` parameters are restricted to primitives, and a struct is
// rejected regardless of what it is generic over -- and there is no syntax
// in Codira today to *name* `T` explicitly at a call site (no turbofish, no
// bracketed generic arguments outside type position) to ask for its size
// with no value at hand. Those methods' `sizeof`/`alignof` calls are left
// genuinely unresolved below rather than given a name that would silently
// answer with the address's own size instead of the pointee's -- a
// generic-instantiation gap belongs on the list of things codegen cannot
// do yet, not disguised as a working computation that happens to be wrong.
extern "codira-intrinsic" {
    func __intrinsic_load[T](addr: usize) -> T;
    func __intrinsic_store[T](addr: usize, value: T);
    func __intrinsic_volatile_load[T](addr: usize) -> T;
    func __intrinsic_volatile_store[T](addr: usize, value: T);
}

extern "C" {
    // Rust's global allocator, exposed directly -- see
    // `codira_runtime_capi::alloc` for why this is raw and GC-independent.
    func codira_alloc(size: usize, align: usize) -> usize;
    func codira_alloc_zeroed(size: usize, align: usize) -> usize;
    func codira_dealloc(addr: usize, size: usize, align: usize);
}

// =============================================================================
// Construction
// =============================================================================

// Create a null UnsafePointer.
extend UnsafePointer[T] {
    public func null() -> UnsafePointer[T] {
        return UnsafePointer { _addr: 0 };
    }
}

// Create from a raw address.
extend UnsafePointer[T] {
    public func from_address(addr: usize) -> UnsafePointer[T] {
        return UnsafePointer { _addr: addr };
    }
}

// Create from a safe Pointer[T].
extend UnsafePointer[T] {
    public func from_pointer(ptr: Pointer[T]) -> UnsafePointer[T] {
        return UnsafePointer { _addr: ptr.address() };
    }
}

// Allocate raw memory for `count` elements of type T.
// Memory is uninitialized — reading before writing is undefined behavior.
//
// `sizeof_of_pointee`/`alignof_of_pointee` are not declared anywhere (see
// the note above): there is no value of type `T` in scope here to pin `T`
// with, and no syntax to name `T` explicitly instead. This is an honest
// "not found in this scope", tracking a real generic-instantiation gap,
// rather than a plausible-looking answer that would be wrong.
extend UnsafePointer[T] {
    public func alloc(count: usize) -> UnsafePointer[T] {
        let size = count * sizeof_of_pointee();
        let align = alignof_of_pointee();
        let addr = codira_alloc(size, align);
        return UnsafePointer { _addr: addr };
    }
}

// Allocate and zero-initialize memory for `count` elements.
extend UnsafePointer[T] {
    public func alloc_zeroed(count: usize) -> UnsafePointer[T] {
        let size = count * sizeof_of_pointee();
        let align = alignof_of_pointee();
        let addr = codira_alloc_zeroed(size, align);
        return UnsafePointer { _addr: addr };
    }
}

// =============================================================================
// Queries
// =============================================================================

// Return true if the pointer is null.
extend UnsafePointer[T] {
    public func is_null(self) -> bool {
        return self._addr == 0;
    }
}

// Return the raw address.
extend UnsafePointer[T] {
    public func address(self) -> usize {
        return self._addr;
    }
}

// =============================================================================
// Load / Store (no checks)
// =============================================================================

// Load the value at this pointer.
// UB if the pointer is null, dangling, or misaligned.
extend UnsafePointer[T] {
    public func load(self) -> T {
        return __intrinsic_load(self._addr);
    }
}

// Store a value through this pointer.
// UB if the pointer is null, dangling, or misaligned.
extend UnsafePointer[T] {
    public func store(self, value: T) {
        __intrinsic_store(self._addr, value);
    }
}

// Load from an element offset (self + index * sizeof(T)).
extend UnsafePointer[T] {
    public func load_element(self, index: usize) -> T {
        let addr = self._addr + index * sizeof_of_pointee();
        return __intrinsic_load(addr);
    }
}

// Store at an element offset.
extend UnsafePointer[T] {
    public func store_element(self, index: usize, value: T) {
        let addr = self._addr + index * sizeof_of_pointee();
        __intrinsic_store(addr, value);
    }
}

// Volatile load — prevents compiler reordering / elision.
extend UnsafePointer[T] {
    public func volatile_load(self) -> T {
        return __intrinsic_volatile_load(self._addr);
    }
}

// Volatile store.
extend UnsafePointer[T] {
    public func volatile_store(self, value: T) {
        __intrinsic_volatile_store(self._addr, value);
    }
}

// =============================================================================
// Pointer arithmetic
// =============================================================================

// Offset by `n` elements (positive or negative).
extend UnsafePointer[T] {
    public func offset(self, n: isize) -> UnsafePointer[T] {
        let byte_off = n * (sizeof_of_pointee() as isize);
        return UnsafePointer { _addr: (self._addr as isize + byte_off) as usize };
    }
}

// Advance by `n` elements.
extend UnsafePointer[T] {
    public func add(self, n: usize) -> UnsafePointer[T] {
        return self.offset(n as isize);
    }
}

// Move back by `n` elements.
extend UnsafePointer[T] {
    public func sub(self, n: usize) -> UnsafePointer[T] {
        return self.offset(0 - (n as isize));
    }
}

// Offset by raw bytes (not elements).
extend UnsafePointer[T] {
    public func byte_offset(self, bytes: isize) -> UnsafePointer[T] {
        return UnsafePointer { _addr: (self._addr as isize + bytes) as usize };
    }
}

// Distance in elements between two pointers.
extend UnsafePointer[T] {
    public func distance(self, other: UnsafePointer[T]) -> isize {
        return ((self._addr as isize) - (other._addr as isize)) / (sizeof_of_pointee() as isize);
    }
}

// =============================================================================
// Initialization / Destruction
// =============================================================================

// Initialize the memory at this pointer by moving `value` in.
// Call this exactly once on uninitialized memory.
extend UnsafePointer[T] {
    public func init_pointee_move(self, value: T) {
        __intrinsic_store(self._addr, value);
    }
}

// Initialize by copying from `value`.
extend UnsafePointer[T] {
    public func init_pointee_copy(self, value: T) {
        __intrinsic_store(self._addr, value);
    }
}

// Explicitly destroy the pointee (call its destructor if it has one).
// After this call, the memory is considered uninitialized.
//
// `__intrinsic_destroy` is not declared: there is no destructor/drop-glue
// framework in the code generator yet for it to call into. Left unresolved
// rather than turned into a no-op, which would silently skip cleanup a
// caller is relying on this to perform.
extend UnsafePointer[T] {
    public func destroy_pointee(self) {
        __intrinsic_destroy(self._addr);
    }
}

// Move the pointee out, leaving memory uninitialized.
extend UnsafePointer[T] {
    public func take_pointee(self) -> T {
        let val = __intrinsic_load(self._addr);
        __intrinsic_destroy(self._addr);
        return val;
    }
}

// =============================================================================
// Bulk operations
// =============================================================================

// Copy `count` elements from `src` to `self`.  Regions may overlap.
extend UnsafePointer[T] {
    public func move_from(self, src: UnsafePointer[T], count: usize) {
        let bytes = count * sizeof_of_pointee();
        __intrinsic_memmove(self._addr, src._addr, bytes);
    }
}

// Copy `count` elements from `src` to `self`.  Regions must NOT overlap.
extend UnsafePointer[T] {
    public func copy_from(self, src: UnsafePointer[T], count: usize) {
        let bytes = count * sizeof_of_pointee();
        __intrinsic_memcpy(self._addr, src._addr, bytes);
    }
}

// Set `count` elements to zero bytes.
extend UnsafePointer[T] {
    public func zero_memory(self, count: usize) {
        let bytes = count * sizeof_of_pointee();
        __intrinsic_memset(self._addr, 0, bytes);
    }
}

// =============================================================================
// Deallocation
// =============================================================================

// Free the memory.  `count` must match the original allocation size.
// After this call, the pointer is dangling.
extend UnsafePointer[T] {
    public func free(self, count: usize) {
        let size = count * sizeof_of_pointee();
        let align = alignof_of_pointee();
        codira_dealloc(self._addr, size, align);
    }
}

// Free a single element allocation.
extend UnsafePointer[T] {
    public func free_one(self) {
        self.free(1);
    }
}

// =============================================================================
// Casting
// =============================================================================

// Bitcast to a different UnsafePointer type.
extend UnsafePointer[T] {
    public func bitcast[U](self) -> UnsafePointer[U] {
        return UnsafePointer { _addr: self._addr };
    }
}

// Convert to a safe Pointer[T].
extend UnsafePointer[T] {
    public func to_safe(self) -> Pointer[T] {
        return Pointer.from_address(self._addr);
    }
}

// =============================================================================
// Comparison / Traits
// =============================================================================

extend UnsafePointer[T] {
    public func eq(self, other: UnsafePointer[T]) -> bool {
        return self._addr == other._addr;
    }
}

extend UnsafePointer[T] {
    public func ne(self, other: UnsafePointer[T]) -> bool {
        return self._addr != other._addr;
    }
}

extend UnsafePointer[T] {
    public func lt(self, other: UnsafePointer[T]) -> bool {
        return self._addr < other._addr;
    }
}

extend UnsafePointer[T] {
    public func to_string(self) -> String {
        if self._addr == 0 {
            return "UnsafePointer(null)";
        }
        return "UnsafePointer(0x" + __intrinsic_to_hex(self._addr) + ")";
    }
}

extend UnsafePointer[T] {
    public func copy(self) -> UnsafePointer[T] {
        return UnsafePointer { _addr: self._addr };
    }
}

extend UnsafePointer[T] {
    public func default() -> UnsafePointer[T] {
        return UnsafePointer.null();
    }
}
