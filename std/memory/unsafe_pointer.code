// =============================================================================
// std/memory/unsafe_pointer.code — Raw, unchecked pointer type
// =============================================================================
//
// UnsafePointer[T] is the low-level, unchecked pointer type.  It provides
// raw memory access without null checks, bounds checks, or lifetime
// tracking.  All operations on UnsafePointer are inherently unsafe — the
// caller is responsible for ensuring validity.
//
// Use cases:
//   - FFI / C interop
//   - Custom allocators
//   - Performance-critical inner loops where checks are hoisted
//   - Implementing safe abstractions (Array, HashMap, etc.)
//
// For everyday code, prefer Pointer[T] which provides safety checks.
// =============================================================================

import std.builtin.types;
import std.builtin.traits;

// A raw, unchecked pointer to a value of type T.
// No safety guarantees.  All operations are the caller's responsibility.
public struct UnsafePointer[T] {
    _addr: usize,
}

// =============================================================================
// Construction
// =============================================================================

// Create a null UnsafePointer.
extend UnsafePointer[T] {
    public func null() -> UnsafePointer[T] {
        return UnsafePointer[T] { _addr: 0 };
    }
}

// Create from a raw address.
extend UnsafePointer[T] {
    public func from_address(addr: usize) -> UnsafePointer[T] {
        return UnsafePointer[T] { _addr: addr };
    }
}

// Create from a safe Pointer[T].
extend UnsafePointer[T] {
    public func from_pointer(ptr: Pointer[T]) -> UnsafePointer[T] {
        return UnsafePointer[T] { _addr: ptr.address() };
    }
}

// Allocate raw memory for `count` elements of type T.
// Memory is uninitialized — reading before writing is undefined behavior.
extend UnsafePointer[T] {
    public func alloc(count: usize) -> UnsafePointer[T] {
        let size = count * __intrinsic_sizeof[T]();
        let align = __intrinsic_alignof[T]();
        let addr = __intrinsic_alloc(size, align);
        return UnsafePointer[T] { _addr: addr };
    }
}

// Allocate and zero-initialize memory for `count` elements.
extend UnsafePointer[T] {
    public func alloc_zeroed(count: usize) -> UnsafePointer[T] {
        let size = count * __intrinsic_sizeof[T]();
        let align = __intrinsic_alignof[T]();
        let addr = __intrinsic_alloc_zeroed(size, align);
        return UnsafePointer[T] { _addr: addr };
    }
}

// =============================================================================
// Queries
// =============================================================================

// Return true if the pointer is null.
extend UnsafePointer[T] {
    public func is_null(self) -> bool {
        return self._addr == 0;
    }
}

// Return the raw address.
extend UnsafePointer[T] {
    public func address(self) -> usize {
        return self._addr;
    }
}

// =============================================================================
// Load / Store (no checks)
// =============================================================================

// Load the value at this pointer.
// UB if the pointer is null, dangling, or misaligned.
extend UnsafePointer[T] {
    public func load(self) -> T {
        return __intrinsic_load[T](self._addr);
    }
}

// Store a value through this pointer.
// UB if the pointer is null, dangling, or misaligned.
extend UnsafePointer[T] {
    public func store(self, value: T) -> void {
        __intrinsic_store[T](self._addr, value);
    }
}

// Load from an element offset (self + index * sizeof(T)).
extend UnsafePointer[T] {
    public func load_element(self, index: usize) -> T {
        let addr = self._addr + index * __intrinsic_sizeof[T]();
        return __intrinsic_load[T](addr);
    }
}

// Store at an element offset.
extend UnsafePointer[T] {
    public func store_element(self, index: usize, value: T) -> void {
        let addr = self._addr + index * __intrinsic_sizeof[T]();
        __intrinsic_store[T](addr, value);
    }
}

// Volatile load — prevents compiler reordering / elision.
extend UnsafePointer[T] {
    public func volatile_load(self) -> T {
        return __intrinsic_volatile_load[T](self._addr);
    }
}

// Volatile store.
extend UnsafePointer[T] {
    public func volatile_store(self, value: T) -> void {
        __intrinsic_volatile_store[T](self._addr, value);
    }
}

// =============================================================================
// Pointer arithmetic
// =============================================================================

// Offset by `n` elements (positive or negative).
extend UnsafePointer[T] {
    public func offset(self, n: isize) -> UnsafePointer[T] {
        let byte_off = n * (__intrinsic_sizeof[T]() as isize);
        return UnsafePointer[T] { _addr: (self._addr as isize + byte_off) as usize };
    }
}

// Advance by `n` elements.
extend UnsafePointer[T] {
    public func add(self, n: usize) -> UnsafePointer[T] {
        return self.offset(n as isize);
    }
}

// Move back by `n` elements.
extend UnsafePointer[T] {
    public func sub(self, n: usize) -> UnsafePointer[T] {
        return self.offset(0 - (n as isize));
    }
}

// Offset by raw bytes (not elements).
extend UnsafePointer[T] {
    public func byte_offset(self, bytes: isize) -> UnsafePointer[T] {
        return UnsafePointer[T] { _addr: (self._addr as isize + bytes) as usize };
    }
}

// Distance in elements between two pointers.
extend UnsafePointer[T] {
    public func distance(self, other: UnsafePointer[T]) -> isize {
        return ((self._addr as isize) - (other._addr as isize)) / (__intrinsic_sizeof[T]() as isize);
    }
}

// =============================================================================
// Initialization / Destruction
// =============================================================================

// Initialize the memory at this pointer by moving `value` in.
// Call this exactly once on uninitialized memory.
extend UnsafePointer[T] {
    public func init_pointee_move(self, value: T) -> void {
        __intrinsic_store[T](self._addr, value);
    }
}

// Initialize by copying from `value`.
extend UnsafePointer[T] {
    public func init_pointee_copy(self, value: T) -> void {
        __intrinsic_store[T](self._addr, value);
    }
}

// Explicitly destroy the pointee (call its destructor if it has one).
// After this call, the memory is considered uninitialized.
extend UnsafePointer[T] {
    public func destroy_pointee(self) -> void {
        __intrinsic_destroy[T](self._addr);
    }
}

// Move the pointee out, leaving memory uninitialized.
extend UnsafePointer[T] {
    public func take_pointee(self) -> T {
        let val = __intrinsic_load[T](self._addr);
        __intrinsic_destroy[T](self._addr);
        return val;
    }
}

// =============================================================================
// Bulk operations
// =============================================================================

// Copy `count` elements from `src` to `self`.  Regions may overlap.
extend UnsafePointer[T] {
    public func move_from(self, src: UnsafePointer[T], count: usize) -> void {
        let bytes = count * __intrinsic_sizeof[T]();
        __intrinsic_memmove(self._addr, src._addr, bytes);
    }
}

// Copy `count` elements from `src` to `self`.  Regions must NOT overlap.
extend UnsafePointer[T] {
    public func copy_from(self, src: UnsafePointer[T], count: usize) -> void {
        let bytes = count * __intrinsic_sizeof[T]();
        __intrinsic_memcpy(self._addr, src._addr, bytes);
    }
}

// Set `count` elements to zero bytes.
extend UnsafePointer[T] {
    public func zero_memory(self, count: usize) -> void {
        let bytes = count * __intrinsic_sizeof[T]();
        __intrinsic_memset(self._addr, 0, bytes);
    }
}

// =============================================================================
// Deallocation
// =============================================================================

// Free the memory.  `count` must match the original allocation size.
// After this call, the pointer is dangling.
extend UnsafePointer[T] {
    public func free(self, count: usize) -> void {
        let size = count * __intrinsic_sizeof[T]();
        let align = __intrinsic_alignof[T]();
        __intrinsic_dealloc(self._addr, size, align);
    }
}

// Free a single element allocation.
extend UnsafePointer[T] {
    public func free_one(self) -> void {
        self.free(1);
    }
}

// =============================================================================
// Casting
// =============================================================================

// Bitcast to a different UnsafePointer type.
extend UnsafePointer[T] {
    public func bitcast[U](self) -> UnsafePointer[U] {
        return UnsafePointer[U] { _addr: self._addr };
    }
}

// Convert to a safe Pointer[T].
extend UnsafePointer[T] {
    public func to_safe(self) -> Pointer[T] {
        return Pointer[T].from_address(self._addr);
    }
}

// =============================================================================
// Comparison / Traits
// =============================================================================

extend UnsafePointer[T] {
    public func eq(self, other: UnsafePointer[T]) -> bool {
        return self._addr == other._addr;
    }
}

extend UnsafePointer[T] {
    public func ne(self, other: UnsafePointer[T]) -> bool {
        return self._addr != other._addr;
    }
}

extend UnsafePointer[T] {
    public func lt(self, other: UnsafePointer[T]) -> bool {
        return self._addr < other._addr;
    }
}

extend UnsafePointer[T] {
    public func to_string(self) -> String {
        if self._addr == 0 {
            return "UnsafePointer(null)";
        }
        return "UnsafePointer(0x" + __intrinsic_to_hex(self._addr) + ")";
    }
}

extend UnsafePointer[T] {
    public func copy(self) -> UnsafePointer[T] {
        return UnsafePointer[T] { _addr: self._addr };
    }
}

extend UnsafePointer[T] {
    public func default() -> UnsafePointer[T] {
        return UnsafePointer[T].null();
    }
}
