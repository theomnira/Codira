// =============================================================================
// std/memory/pointer.code — Safe pointer type
// =============================================================================
//
// Pointer[T] is a safe, bounds-aware pointer to a value of type T.
// Unlike UnsafePointer, a Pointer carries validity guarantees enforced by
// the compiler's borrow checker:
//   - A Pointer is always aligned for T.
//   - A Pointer is never null unless explicitly constructed via `Pointer.null()`.
//   - Dereferencing a null Pointer panics at runtime.
//
// Pointer is a value type (it is itself stored inline, not heap-allocated).
// The data it points TO lives wherever the referent was allocated.
//
// Examples:
//   let x: i32 = 42;
//   let p = Pointer[i32].address_of(&x);
//   let val = p.read();   // 42
// =============================================================================

import root.builtin.traits.*;
import root.builtin.types.*;

// A safe, typed pointer to a single value of type T.
public struct Pointer[T] {
    // Raw address stored as usize.  Zero represents null.
    _addr: usize,
}

// =============================================================================
// Construction
// =============================================================================

// Create a null pointer.
extend Pointer[T] {
    public func null() -> Pointer[T] {
        return Pointer[T] { _addr: 0 };
    }
}

// Create a pointer from a raw address.
// The caller asserts that `addr` is properly aligned for T and points to
// a valid, live object (or is null / zero).
extend Pointer[T] {
    public func from_address(addr: usize) -> Pointer[T] {
        return Pointer[T] { _addr: addr };
    }
}

// Take the address of a reference.
extend Pointer[T] {
    public func address_of(ref: &T) -> Pointer[T] {
        return Pointer[T] { _addr: __intrinsic_ref_to_addr(ref) };
    }
}

// Allocate a new value on the heap and return a pointer to it.
extend Pointer[T] {
    public func alloc(value: T) -> Pointer[T] {
        let addr = __intrinsic_alloc(__intrinsic_sizeof(), __intrinsic_alignof());
        let p = Pointer[T] { _addr: addr };
        p.write(value);
        return p;
    }
}

// =============================================================================
// Queries
// =============================================================================

// Return true if this pointer is null (address zero).
extend Pointer[T] {
    public func is_null(self) -> bool {
        return self._addr == 0;
    }
}

// Return true if this pointer is non-null.
extend Pointer[T] {
    public func is_valid(self) -> bool {
        return self._addr != 0;
    }
}

// Return the raw address as a usize.
extend Pointer[T] {
    public func address(self) -> usize {
        return self._addr;
    }
}

// =============================================================================
// Dereference
// =============================================================================

// Read the value at this pointer.
// Panics if the pointer is null.
extend Pointer[T] {
    public func read(self) -> T {
        if self._addr == 0 {
            __panic("Pointer.read: null pointer dereference");
        }
        return __intrinsic_load(self._addr);
    }
}

// Write a value through this pointer.
// Panics if the pointer is null.
extend Pointer[T] {
    public func write(self, value: T) {
        if self._addr == 0 {
            __panic("Pointer.write: null pointer dereference");
        }
        __intrinsic_store(self._addr, value);
    }
}

// Read without null check.  Caller MUST guarantee non-null.
extend Pointer[T] {
    public func read_unchecked(self) -> T {
        return __intrinsic_load(self._addr);
    }
}

// Write without null check.  Caller MUST guarantee non-null.
extend Pointer[T] {
    public func write_unchecked(self, value: T) {
        __intrinsic_store(self._addr, value);
    }
}

// =============================================================================
// Pointer arithmetic
// =============================================================================

// Return a pointer offset by `n` elements (each of size sizeof(T)).
// Positive n moves forward, negative n moves backward.
extend Pointer[T] {
    public func offset(self, n: isize) -> Pointer[T] {
        let byte_offset = n * (__intrinsic_sizeof() as isize);
        return Pointer[T] { _addr: (self._addr as isize + byte_offset) as usize };
    }
}

// Return a pointer advanced by `n` elements (non-negative offset).
extend Pointer[T] {
    public func add(self, n: usize) -> Pointer[T] {
        return self.offset(n as isize);
    }
}

// Return a pointer moved back by `n` elements.
extend Pointer[T] {
    public func sub(self, n: usize) -> Pointer[T] {
        return self.offset(0 - (n as isize));
    }
}

// Compute the element distance between two pointers: (self - other) / sizeof(T).
extend Pointer[T] {
    public func distance_to(self, other: Pointer[T]) -> isize {
        let byte_diff = (self._addr as isize) - (other._addr as isize);
        return byte_diff / (__intrinsic_sizeof() as isize);
    }
}

// =============================================================================
// Casting
// =============================================================================

// Bitcast this pointer to a pointer of a different type.
// No data conversion occurs — only the type tag changes.
extend Pointer[T] {
    public func bitcast[U](self) -> Pointer[U] {
        return Pointer[U] { _addr: self._addr };
    }
}

// Convert to an UnsafePointer (drops safety guarantees).
extend Pointer[T] {
    public func to_unsafe(self) -> UnsafePointer[T] {
        return UnsafePointer.from_address(self._addr);
    }
}

// =============================================================================
// Comparison
// =============================================================================

// Two pointers are equal when they point to the same address.
extend Pointer[T] {
    public func eq(self, other: Pointer[T]) -> bool {
        return self._addr == other._addr;
    }
}

extend Pointer[T] {
    public func ne(self, other: Pointer[T]) -> bool {
        return self._addr != other._addr;
    }
}

extend Pointer[T] {
    public func lt(self, other: Pointer[T]) -> bool {
        return self._addr < other._addr;
    }
}

extend Pointer[T] {
    public func le(self, other: Pointer[T]) -> bool {
        return self._addr <= other._addr;
    }
}

extend Pointer[T] {
    public func gt(self, other: Pointer[T]) -> bool {
        return self._addr > other._addr;
    }
}

extend Pointer[T] {
    public func ge(self, other: Pointer[T]) -> bool {
        return self._addr >= other._addr;
    }
}

// =============================================================================
// Trait implementations
// =============================================================================

extend Pointer[T] {
    public func to_string(self) -> String {
        if self._addr == 0 {
            return "Pointer(null)";
        }
        return "Pointer(0x" + __intrinsic_to_hex(self._addr) + ")";
    }
}

extend Pointer[T] {
    public func repr(self) -> String {
        return "Pointer[" + __intrinsic_type_name() + "](0x"
            + __intrinsic_to_hex(self._addr) + ")";
    }
}

extend Pointer[T] {
    public func hash(self, hasher: &Hasher) {
        hasher.write_usize(self._addr);
    }
}

extend Pointer[T] {
    public func copy(self) -> Pointer[T] {
        return Pointer[T] { _addr: self._addr };
    }
}

extend Pointer[T] {
    public func default() -> Pointer[T] {
        return Pointer.null();
    }
}

// =============================================================================
// Convenience: pointer-to-slice
// =============================================================================

// Construct a Slice[T] from this pointer and a length.
extend Pointer[T] {
    public func as_slice(self, len: usize) -> Slice[T] {
        return Slice.new(self, len);
    }
}
