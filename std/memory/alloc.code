// =============================================================================
// std/memory/alloc.code — Memory allocator interface and default allocator
// =============================================================================
//
// This module defines the Allocator trait (interface) and the global
// default allocator.  The default allocator delegates to the platform's
// aligned allocation API (posix_memalign / _aligned_malloc / mmap / etc.)
// via compiler intrinsics.
//
// Functions:
//   allocate(size, align)       — allocate aligned memory (returns address)
//   deallocate(addr, size, align) — free previously allocated memory
//   reallocate(addr, old_size, new_size, align) — grow or shrink
//   aligned_alloc(size, align)  — synonym for allocate
//   aligned_free(addr, size, align) — synonym for deallocate
// =============================================================================

import root.builtin.types.*;
import root.builtin.error.*;

// =============================================================================
// Allocator trait
// =============================================================================

// The Allocator trait abstracts over memory allocation strategies.
// Custom allocators (arena, pool, bump, etc.) implement this trait.
public trait Allocator {
    // Allocate at least `size` bytes with the given alignment.
    // Returns the address of the allocated block, or 0 on failure.
    // `align` must be a power of two and >= 1.
    func allocate(self, size: usize, align: usize) -> usize;

    // Deallocate a block previously allocated with the same size/align.
    func deallocate(self, addr: usize, size: usize, align: usize) ;

    // Resize a block.  May move it.  Returns the (possibly new) address.
    // If the block cannot be grown in place, a new block is allocated,
    // the data is copied, and the old block is freed.
    func reallocate(self, addr: usize, old_size: usize, new_size: usize, align: usize) -> usize;

    // Allocate and zero-initialize.
    func allocate_zeroed(self, size: usize, align: usize) -> usize;
}

// =============================================================================
// Layout — describes a memory allocation's size and alignment
// =============================================================================

// Describes the size and alignment requirements of a type or allocation.
public struct Layout {
    size: usize,
    align: usize,
}

// Create a layout from explicit size and alignment.
// Panics if `align` is not a power of two.
extend Layout {
    public func new(size: usize, align: usize) -> Layout {
        if align == 0 | (align & (align - 1)) != 0 {
            __panic("Layout.new: alignment must be a non-zero power of two");
        }
        return Layout { size: size, align: align };
    }
}

// Create a layout for a single value of type T.
//
// `sizeof`/`alignof` need a value of type `T` to infer `T` from, and there
// is none in scope here -- `of[T]()` is called precisely when the caller
// has no `T` value yet (before allocating one). Left genuinely unresolved:
// see `std/memory/pointer.code`'s note on why there is no honest way to
// answer this without a language feature (explicit generic call syntax)
// this compiler does not have yet.
extend Layout {
    public func of[T]() -> Layout {
        return Layout {
            size: sizeof_of_pointee(),
            align: alignof_of_pointee(),
        };
    }
}

// Create a layout for an array of `count` values of type T.
// Handles inter-element padding.
extend Layout {
    public func array[T](count: usize) -> Layout {
        let elem_size = sizeof_of_pointee();
        let elem_align = alignof_of_pointee();
        // Stride = size rounded up to alignment.
        let stride = (elem_size + elem_align - 1) & (0 - elem_align);
        return Layout {
            size: stride * count,
            align: elem_align,
        };
    }
}

// Pad layout size up to its alignment.
extend Layout {
    public func pad_to_align(self) -> Layout {
        let padded = (self.size + self.align - 1) & (0 - self.align);
        return Layout { size: padded, align: self.align };
    }
}

// Extend this layout with another, returning (combined_layout, offset_of_second).
extend Layout {
    public func extend(self, other: Layout) -> (Layout, usize) {
        let offset = (self.size + other.align - 1) & (0 - other.align);
        let new_align = self.align;
        if other.align > new_align {
            new_align = other.align;
        }
        let new_size = offset + other.size;
        return (Layout { size: new_size, align: new_align }, offset);
    }
}

extend Layout {
    public func to_string(self) -> String {
        return "Layout { size: " + __intrinsic_to_string(self.size)
            + ", align: " + __intrinsic_to_string(self.align) + " }";
    }
}

extend Layout {
    public func eq(self, other: Layout) -> bool {
        return self.size == other.size & self.align == other.align;
    }
}

// =============================================================================
// DefaultAllocator — the global system allocator
// =============================================================================

// The default system allocator.  Delegates to platform APIs.
public struct DefaultAllocator {}

extend DefaultAllocator {
    public func new() -> DefaultAllocator {
        return DefaultAllocator {};
    }
}

// Allocate `size` bytes aligned to `align`.
extend DefaultAllocator {
    public func allocate(self, size: usize, align: usize) -> usize {
        if size == 0 {
            return 0;
        }
        let addr = __intrinsic_alloc(size, align);
        if addr == 0 {
            __panic("DefaultAllocator.allocate: out of memory");
        }
        return addr;
    }
}

// Free a block.
extend DefaultAllocator {
    public func deallocate(self, addr: usize, size: usize, align: usize) {
        if addr == 0 {
            return;
        }
        __intrinsic_dealloc(addr, size, align);
    }
}

// Resize a block.
extend DefaultAllocator {
    public func reallocate(
        self,
        addr: usize,
        old_size: usize,
        new_size: usize,
        align: usize,
    ) -> usize {
        if addr == 0 {
            return self.allocate(new_size, align);
        }
        if new_size == 0 {
            self.deallocate(addr, old_size, align);
            return 0;
        }
        let new_addr = __intrinsic_realloc(addr, old_size, new_size, align);
        if new_addr == 0 {
            __panic("DefaultAllocator.reallocate: out of memory");
        }
        return new_addr;
    }
}

// Allocate zeroed memory.
extend DefaultAllocator {
    public func allocate_zeroed(self, size: usize, align: usize) -> usize {
        let addr = self.allocate(size, align);
        __intrinsic_memset(addr, 0, size);
        return addr;
    }
}

// =============================================================================
// Free-standing convenience functions (import the global default allocator)
// =============================================================================

// The global allocator instance.
let _global_allocator: DefaultAllocator = DefaultAllocator.new();

// Allocate `size` bytes with `align` alignment.
public func allocate(size: usize, align: usize) -> usize {
    return _global_allocator.allocate(size, align);
}

// Free a block.
public func deallocate(addr: usize, size: usize, align: usize) {
    _global_allocator.deallocate(addr, size, align);
}

// Resize a block.
public func reallocate(addr: usize, old_size: usize, new_size: usize, align: usize) -> usize {
    return _global_allocator.reallocate(addr, old_size, new_size, align);
}

// Convenience alias matching C-style naming.
public func aligned_alloc(size: usize, align: usize) -> usize {
    return allocate(size, align);
}

// Convenience alias.
public func aligned_free(addr: usize, size: usize, align: usize) {
    deallocate(addr, size, align);
}

// Allocate for a single T and return a typed pointer.
public func alloc_one[T]() -> Pointer[T] {
    let layout = Layout.of();
    let addr = allocate(layout.size, layout.align);
    return Pointer.from_address(addr);
}

// Allocate an array of `count` elements of T and return a typed pointer.
public func alloc_array[T](count: usize) -> Pointer[T] {
    let layout = Layout.array(count);
    let addr = allocate(layout.size, layout.align);
    return Pointer.from_address(addr);
}

// Free a single T allocation.
public func free_one[T](ptr: Pointer[T]) {
    let layout = Layout.of();
    deallocate(ptr.address(), layout.size, layout.align);
}

// Free an array allocation.
public func free_array[T](ptr: Pointer[T], count: usize) {
    let layout = Layout.array(count);
    deallocate(ptr.address(), layout.size, layout.align);
}
