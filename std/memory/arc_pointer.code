// =============================================================================
// std/memory/arc_pointer.code — Atomic reference-counted pointer
// =============================================================================
//
// ArcPointer[T] provides shared ownership of a heap-allocated value of
// type T.  The allocation is freed when the last ArcPointer clone is
// dropped.  Reference counting is performed with atomic operations, so
// ArcPointer is safe to share across threads.
//
// Layout:
//   The heap block stores a control block header (strong count + weak count)
//   followed by the payload of type T.
//
//   +------+------+---------+
//   |strong| weak | payload |
//   |count |count |  (T)    |
//   +------+------+---------+
//
// Cloning an ArcPointer increments the strong count atomically.
// Dropping decrements it; when it reaches zero the payload is destroyed.
// If weak count is also zero, the control block is freed.
//
// Example:
//   let a = ArcPointer[i32].new(42);
//   let b = a.clone();           // strong count = 2
//   let val = b.read();          // 42
//   // b dropped → count = 1
//   // a dropped → count = 0 → freed
// =============================================================================

import root.builtin.traits.*;
import root.builtin.types.*;
import root.memory.unsafe_pointer.*;

// Internal control block stored before the payload.
struct _ArcControlBlock {
    strong_count: u64,
    weak_count: u64,
}

// An atomically reference-counted, shared-ownership heap pointer.
public struct ArcPointer[T] {
    // Points to the start of the control block (not the payload).
    _block: UnsafePointer[_ArcControlBlock],
}

// =============================================================================
// Construction
// =============================================================================

// Allocate a new ArcPointer with the given value.  Initial strong = 1.
extend ArcPointer[T] {
    public func new(value: T) -> ArcPointer[T] {
        // Allocate combined block: control header + payload.
        let header_size = __intrinsic_sizeof();
        let payload_size = __intrinsic_sizeof();
        let payload_align = __intrinsic_alignof();
        let header_align = __intrinsic_alignof();
        let align = header_align;
        if payload_align > align {
            align = payload_align;
        }

        // Pad header to payload alignment.
        let padding = (align - (header_size % align)) % align;
        let total_size = header_size + padding + payload_size;

        let addr = __intrinsic_alloc(total_size, align);
        let block_ptr = UnsafePointer[_ArcControlBlock] { _addr: addr };

        // Initialize control block.
        block_ptr.store(_ArcControlBlock { strong_count: 1, weak_count: 0 });

        // Initialize payload.
        let payload_addr = addr + header_size + padding;
        let payload_ptr = UnsafePointer[T] { _addr: payload_addr };
        payload_ptr.init_pointee_move(value);

        return ArcPointer[T] { _block: block_ptr };
    }
}

// =============================================================================
// Internal helpers
// =============================================================================

// Return a pointer to the payload.
extend ArcPointer[T] {
    func _payload_ptr(self) -> UnsafePointer[T] {
        let header_size = __intrinsic_sizeof();
        let payload_align = __intrinsic_alignof();
        let header_align = __intrinsic_alignof();
        let align = header_align;
        if payload_align > align {
            align = payload_align;
        }
        let padding = (align - (header_size % align)) % align;
        let payload_addr = self._block.address() + header_size + padding;
        return UnsafePointer[T] { _addr: payload_addr };
    }
}

// Return the strong count (atomic load).
extend ArcPointer[T] {
    func _load_strong(self) -> u64 {
        return __intrinsic_atomic_load_u64(self._block.address());
    }
}

// Atomically increment the strong count and return the old value.
extend ArcPointer[T] {
    func _inc_strong(self) -> u64 {
        return __intrinsic_atomic_add_u64(self._block.address(), 1);
    }
}

// Atomically decrement the strong count and return the old value.
extend ArcPointer[T] {
    func _dec_strong(self) -> u64 {
        return __intrinsic_atomic_sub_u64(self._block.address(), 1);
    }
}

// =============================================================================
// Access
// =============================================================================

// Read the shared value.
extend ArcPointer[T] {
    public func read(self) -> T {
        return self._payload_ptr().load();
    }
}

// Borrow the value as an immutable reference.
extend ArcPointer[T] {
    public func borrow(self) -> &T {
        return __intrinsic_addr_to_ref(self._payload_ptr().address());
    }
}

// Get a raw pointer to the payload (no ownership transfer).
extend ArcPointer[T] {
    public func as_ptr(self) -> Pointer[T] {
        return self._payload_ptr().to_safe();
    }
}

// =============================================================================
// Reference count queries
// =============================================================================

// Return the current strong reference count.
extend ArcPointer[T] {
    public func strong_count(self) -> u64 {
        return self._load_strong();
    }
}

// Return true if this is the only strong reference.
extend ArcPointer[T] {
    public func is_unique(self) -> bool {
        return self._load_strong() == 1;
    }
}

// =============================================================================
// Cloning (shared ownership)
// =============================================================================

// Create a new ArcPointer that shares ownership of the same allocation.
// Atomically increments the strong count.
extend ArcPointer[T] {
    public func clone(self) -> ArcPointer[T] {
        self._inc_strong();
        return ArcPointer[T] { _block: self._block };
    }
}

// =============================================================================
// Make-mutable (copy-on-write pattern)
// =============================================================================

// If this is the only reference, return a mutable reference to the payload.
// Otherwise, clone the payload into a new allocation and return a mutable
// reference to that.  This implements copy-on-write (COW) semantics.
extend ArcPointer[T: Copyable] {
    public func make_unique(self) -> &T {
        if self.is_unique() {
            return __intrinsic_addr_to_ref(self._payload_ptr().address());
        }
        // Clone the payload into a new allocation.
        let val = self._payload_ptr().load();
        let new_arc = ArcPointer.new(val);
        // Decrement old block.
        self._dec_strong();
        // Adopt new block.
        self._block = new_arc._block;
        return __intrinsic_addr_to_ref(self._payload_ptr().address());
    }
}

// =============================================================================
// Extraction
// =============================================================================

// If this is the only strong reference, destroy the arc and return the
// value.  Otherwise returns an error.
extend ArcPointer[T] {
    public func try_unwrap(self) -> Result[T, ArcPointer[T]] {
        if self.is_unique() {
            let val = self._payload_ptr().take_pointee();
            // Free the control block.
            let total_size = __intrinsic_sizeof()
                + __intrinsic_sizeof()
                + 16; // generous padding
            __intrinsic_dealloc(self._block.address(), total_size, 8);
            self._block = UnsafePointer.null();
            return Result.ok(val);
        }
        return Result.err(self);
    }
}

// =============================================================================
// Destructor
// =============================================================================

// Decrement the strong count.  If it reaches zero, destroy the payload
// and free the allocation.
extend ArcPointer[T] {
    public func destroy(self) {
        if self._block.is_null() {
            return;
        }
        let old_count = self._dec_strong();
        if old_count == 1 {
            // We were the last strong reference.
            // Destroy payload.
            self._payload_ptr().destroy_pointee();

            // Free entire allocation.
            let header_size = __intrinsic_sizeof();
            let payload_size = __intrinsic_sizeof();
            let payload_align = __intrinsic_alignof();
            let header_align = __intrinsic_alignof();
            let align = header_align;
            if payload_align > align {
                align = payload_align;
            }
            let padding = (align - (header_size % align)) % align;
            let total_size = header_size + padding + payload_size;
            __intrinsic_dealloc(self._block.address(), total_size, align);
        }
        self._block = UnsafePointer.null();
    }
}

// =============================================================================
// Trait implementations
// =============================================================================

// ArcPointer is NOT Copyable — import clone() explicitly.
// ArcPointer IS Movable.
extend ArcPointer[T] {
    public func move(self) -> ArcPointer[T] {
        let moved = ArcPointer[T] { _block: self._block };
        self._block = UnsafePointer.null();
        return moved;
    }
}

// Stringable
extend ArcPointer[T: Stringable] {
    public func to_string(self) -> String {
        return "ArcPointer(strong="
            + __intrinsic_to_string(self._load_strong())
            + ", value="
            + self._payload_ptr().load().to_string()
            + ")";
    }
}

// EqualityComparable — compares payloads.
extend ArcPointer[T: EqualityComparable] {
    public func eq(self, other: ArcPointer[T]) -> bool {
        // Same allocation → always equal.
        if self._block.address() == other._block.address() {
            return true;
        }
        return self._payload_ptr().load() == other._payload_ptr().load();
    }
}

extend ArcPointer[T: EqualityComparable] {
    public func ne(self, other: ArcPointer[T]) -> bool {
        return !(self.eq(other));
    }
}

// ptr_eq — true if both point to the same heap allocation (identity check).
extend ArcPointer[T] {
    public func ptr_eq(self, other: ArcPointer[T]) -> bool {
        return self._block.address() == other._block.address();
    }
}

// Hashable
extend ArcPointer[T: Hashable] {
    public func hash(self, hasher: &Hasher) {
        self._payload_ptr().load().hash(hasher);
    }
}
