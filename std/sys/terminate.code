// =============================================================================
// std/sys/terminate.code — Process termination
// =============================================================================
//
// Provides functions to terminate the current process, either gracefully
// (exit) or abnormally (abort).
//
// These are low-level primitives.  Prefer returning Result/Error from
// main() when possible — import these only for truly unrecoverable situations.
// =============================================================================

// `Never` is in the prelude, but this module is *part of* what the prelude
// re-exports, so it names the source directly rather than relying on the
// prelude having finished assembling itself. (No standard-library module
// relies on the prelude: each imports what it uses, so that it can be
// imported by a program, which has no prelude.)
import root.builtin.type_aliases.{Never};

// =============================================================================
// The primitives underneath
// =============================================================================
//
// Terminating and reporting are not instructions, so they are not
// `codira-intrinsic`; they are calls into the runtime, which is what owns
// platform I/O and process control.
//
// Writing to standard error in particular cannot be declared any other way.
// The portable C spelling is `fwrite(buf, 1, n, stderr)`, and `stderr` is a
// macro rather than a symbol, so no `extern "C"` declaration can name it.
// Going around it by file descriptor means `write` on POSIX and `_write` on
// Windows -- a per-platform declaration in a standard library that has none
// anywhere else. The runtime hook is one symbol on every target.

extern "C" {
    func codira_write_stderr(buf: usize, count: usize);
    func codira_abort() -> Never;
    func codira_exit(code: i32) -> Never;
    func codira_is_debug() -> bool;
}

extern "codira-intrinsic" {
    // The two halves of a `str`. `str` is a compiler primitive, so it has
    // no fields for member access to reach.
    func str_data(s: str) -> usize;
    func str_len(s: str) -> usize;
}

// Writes a string to standard error, with no newline and no formatting.
//
// Public because a panic message is not the only thing worth reporting
// before a process gives up, and everything here is built on it.
public func write_stderr(message: str) {
    codira_write_stderr(str_data(message), str_len(message));
}

// =============================================================================
// exit — Graceful termination
// =============================================================================

// Terminate the process with the given exit code.
//
// The runtime ends the process with Rust's `std::process::exit`: the C
// library's atexit handlers run and the runtime's standard output is
// flushed, but no Codira code runs on the way out. Files opened through
// `std.fs` are closed by the operating system, not synced: call `fs_fsync`
// first for anything that must be durable.
//
// Convention:
//   code == 0  → success
//   code != 0  → failure (the specific non-zero value is application-defined)
//
// This function never returns.
//
//   exit(0);    // success
//   exit(1);    // generic failure
public func exit(code: i32) -> Never {
    codira_exit(code);
}

// Exit with code 0 (success).
public func exit_success() -> Never {
    codira_exit(0);
}

// Exit with code 1 (generic failure).
public func exit_failure() -> Never {
    codira_exit(1);
}

// =============================================================================
// abort — Abnormal termination
// =============================================================================

// Immediately terminate the process abnormally.
//
// This function:
//   - Does NOT run atexit handlers.
//   - Does NOT flush output streams.
//   - May produce a core dump (if OS is configured for it).
//   - Sends SIGABRT on POSIX systems.
//
// Use for truly unrecoverable internal errors (invariant violations,
// corrupted state, etc.).
//
// This function never returns.
//
//   abort();
public func abort() -> Never {
    codira_abort();
}

// =============================================================================
// panic — the primitive the rest of this module is written against
// =============================================================================

// Reports `message` on standard error and terminates abnormally.
//
// Spelled with leading underscores because it is what the *compiler* and the
// standard library call for a failed invariant; `panic` is the same thing
// under the name user code should use.
public func __panic(message: str) -> Never {
    write_stderr("panic: ");
    write_stderr(message);
    write_stderr("
");
    codira_abort();
}

// `__panic` with a context prefix, reported as `context: message`.
//
// Two parameters rather than one concatenated string because `str` is static
// bytes in the program image: joining two of them allocates, and allocating
// inside a panic handler is the last thing that should be happening. Writing
// them in sequence needs no memory at all.
public func __panic_in(context: str, message: str) -> Never {
    write_stderr("panic: ");
    write_stderr(context);
    write_stderr(": ");
    write_stderr(message);
    write_stderr("
");
    codira_abort();
}

// Abort with a diagnostic message printed to stderr before termination.
//
//   abort_with_message("invariant violated: count must be positive");
public func abort_with_message(message: str) -> Never {
    write_stderr("ABORT: ");
    write_stderr(message);
    write_stderr("\n");
    codira_abort();
}

// =============================================================================
// panic — Unrecoverable error with formatted message
// =============================================================================

// Terminate with a panic message: writes `panic: <message>` and a newline
// to stderr, then aborts. No source location is printed (unlike the
// compiler's own bounds and division checks, which print one).
//
//   panic("unexpected None value");
public func panic(message: str) -> Never {
    __panic(message);
}

// Panic with a formatted message.
// `context` typically carries function/module name for easier debugging.
//
//   panic_with_context("HashMap.get", "key not found");
public func panic_with_context(context: str, message: str) -> Never {
    __panic_in(context, message);
}

// =============================================================================
// Assertion helpers
// =============================================================================

// Assert that a condition is true.  If false, panic with a message.
//
//   assert_with(index < len, "index out of bounds");
public func assert_with(condition: bool, message: str) {
    if !condition {
        __panic_in("assertion failed", message);
    }
}

// Assert that a condition is true with no custom message.
public func assert(condition: bool) {
    if !condition {
        __panic("assertion failed");
    }
}

// Debug-only assertion: checked when `codira_is_debug()` is true, which
// says whether the *runtime* was built with debug assertions, not how the
// program was built. It is not compiled out: the condition is evaluated
// and the flag is read on every call.
public func debug_assert_with(condition: bool, message: str) {
    if codira_is_debug() {
        if !condition {
            __panic_in("debug assertion failed", message);
        }
    }
}

// Debug-only assertion with no custom message.
public func debug_assert(condition: bool) {
    if codira_is_debug() {
        if !condition {
            __panic("debug assertion failed");
        }
    }
}

// `assert_eq`, `assert_ne`, `assert_lt` and `assert_le` compare two values
// of a type parameter, so they are in `std.sys.assert_compare`, which needs
// what the compiler does not have yet; everything in this module is usable
// on its own.

// =============================================================================
// Unreachable
// =============================================================================

// Mark a code path as unreachable.  If reached at runtime, panics.
//
//   match value {
//       0 => ...,
//       1 => ...,
//       _ => unreachable("value must be 0 or 1"),
//   }
public func unreachable_with(message: str) -> Never {
    __panic_in("unreachable", message);
}

// Mark as unreachable with no message.
public func unreachable() -> Never {
    __panic("entered unreachable code");
}

// =============================================================================
// todo — Placeholder for unfinished code
// =============================================================================

// Mark code as not yet implemented.  Panics at runtime if reached.
//
//   func frobnicate() -> i32 {
//       todo("implement frobnication algorithm");
//   }
public func todo_with(message: str) -> Never {
    __panic_in("not yet implemented", message);
}

// Placeholder with no message.
public func todo() -> Never {
    __panic("not yet implemented");
}
