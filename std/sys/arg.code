// =============================================================================
// std/sys/arg.code — Command-line arguments and environment variables
// =============================================================================
//
// The process's command-line arguments and environment, as `String`s. They
// are the arguments of the process the program runs in: for a standalone
// executable (`codira build --exe`) its own; under `codira run`, the `codira`
// command line. Text that is not UTF-8 has each bad byte replaced by U+FFFD.
// The environment is read once, the first time it is asked for: a variable
// set after that is not seen.
//
// Functions:
//   argc()                 — number of arguments (the program name included)
//   argv(index)            — argument `index`, or `nil`
//   argv_all()             — every argument
//   program_name()         — argument 0, or "" when there is none
//   args()                 — the arguments after the program name
//   has_flag(name)         — whether an argument is exactly `name`
//   get_option(name)       — the value of `name=value` or `name value`
//   positional_arg(n)      — the n-th (1-based) argument not starting with '-'
//   env_get(name)          — an environment variable's value, or `nil`
// =============================================================================

extern "C" {
    func codira_args_count() -> i64;
    func codira_arg_len(index: i64) -> i64;
    func codira_arg_byte(index: i64, at: i64) -> i32;
    func codira_env_count() -> i64;
    func codira_env_entry_len(index: i64) -> i64;
    func codira_env_entry_byte(index: i64, at: i64) -> i32;
}

// The number of command-line arguments, the program name included (C's
// `argc`).
public func argc() -> i64 {
    return codira_args_count();
}

// Argument `index` (0 is the program name), or `nil` when there is none.
public func argv(index: i64) -> String? {
    let len = codira_arg_len(index);
    if len < 0 {
        return nil;
    }
    let bytes = array_filled(0u8, len as usize);
    var at: i64 = 0;
    while at < len {
        bytes[at] = codira_arg_byte(index, at) as u8;
        at += 1;
    }
    // The runtime hands out UTF-8 only.
    return string_from_utf8(bytes);
}

// Every argument, the program name first.
public func argv_all() -> [String] {
    return strings_from(0);
}

// The program name (argument 0), or "" when there is none.
public func program_name() -> String {
    if let name = argv(0) {
        return name;
    }
    return "".to_string();
}

// The arguments after the program name.
public func args() -> [String] {
    return strings_from(1);
}

// Whether some argument after the program name is exactly `flag_name`
// (`has_flag("--verbose")`).
public func has_flag(flag_name: String) -> bool {
    var i: i64 = 1;
    while i < argc() {
        if argv(i)! == flag_name {
            return true;
        }
        i += 1;
    }
    return false;
}

// The value of the option `name`, written `name=value` or as `name value`
// (two arguments), or `nil` when it is not given (or given last, without a
// value).
public func get_option(name: String) -> String? {
    let prefix = name + "=";
    let count = argc();
    var i: i64 = 1;
    while i < count {
        let arg = argv(i)!;
        if arg.starts_with(prefix) {
            return arg.slice(prefix.len(), arg.len());
        }
        if arg == name {
            return argv(i + 1);
        }
        i += 1;
    }
    return nil;
}

// The value of the option `name`, or `default_value`.
public func get_option_or(name: String, default_value: String) -> String {
    if let value = get_option(name) {
        return value;
    }
    return default_value;
}

// The `n`-th (1-based) argument after the program name that does not start
// with '-', or `nil`.
public func positional_arg(n: i64) -> String? {
    var seen: i64 = 0;
    var i: i64 = 1;
    while i < argc() {
        let arg = argv(i)!;
        if !arg.starts_with("-") {
            seen += 1;
            if seen == n {
                return arg;
            }
        }
        i += 1;
    }
    return nil;
}

// How many arguments after the program name do not start with '-'.
public func positional_count() -> i64 {
    var count: i64 = 0;
    var i: i64 = 1;
    while i < argc() {
        if !argv(i)!.starts_with("-") {
            count += 1;
        }
        i += 1;
    }
    return count;
}

// The value of the environment variable `name`, or `nil` when it is not
// set.
public func env_get(name: String) -> String? {
    let prefix = name + "=";
    var i: i64 = 0;
    while i < codira_env_count() {
        let entry = env_entry(i);
        if entry.starts_with(prefix) {
            return entry.slice(prefix.len(), entry.len());
        }
        i += 1;
    }
    return nil;
}

// The value of the environment variable `name`, or `default_value`.
public func env_get_or(name: String, default_value: String) -> String {
    if let value = env_get(name) {
        return value;
    }
    return default_value;
}

// Whether the environment variable `name` is set.
public func env_has(name: String) -> bool {
    return env_get(name) != nil;
}

// Environment entry `index`, as `NAME=value`.
func env_entry(index: i64) -> String {
    let len = codira_env_entry_len(index);
    let bytes = array_filled(0u8, len as usize);
    var at: i64 = 0;
    while at < len {
        bytes[at] = codira_env_entry_byte(index, at) as u8;
        at += 1;
    }
    return string_from_utf8(bytes)!;
}

// The arguments from `first` on, as a new array.
func strings_from(first: i64) -> [String] {
    let count = argc() - first;
    if count <= 0 {
        return "".to_string().lines();
    }
    // A `[String]` of `count` elements, overwritten below: the pieces of
    // `count - 1` commas are `count`.
    let out = ",".repeat(count - 1).split(",");
    var i: i64 = 0;
    while i < count {
        out[i] = argv(first + i)!;
        i += 1;
    }
    return out;
}
