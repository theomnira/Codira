// std/complex/complex_string.code
// The text form of a complex number: `complex_to_string`.
//
// Kept apart from `std.complex.complex` so that the arithmetic does not pull
// in strings.

import root.complex.complex.{Complex};

// `a+bi` or `a-bi`, each part as `print` writes a float (`1.0+2.5i`,
// `0.0-1.0i`).
public func complex_to_string(z: Complex) -> String {
    if z.imag >= 0.0 {
        return f"{z.real}+{z.imag}i";
    }
    return f"{z.real}{z.imag}i";
}
