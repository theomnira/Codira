// std/format/format.code
// String formatting and numeric base conversions for Codira.
// Provides printf-style formatting, integer-to-string in various bases,
// and related utilities.

// ---------------------------------------------------------------------------
// format
// Formats a string by substituting placeholders with the provided arguments.
// Placeholders import curly braces: "{}" for positional, "{0}", "{1}" for
// explicit indices.
//
// Example: format("Hello, {}! You are {} years old.", "Alice", 30)
//          -> "Hello, Alice! You are 30 years old."
// ---------------------------------------------------------------------------
public func format(template: String, args: Array<String>) -> String {
    let mut result: String = "";
    let mut i: usize = 0;
    let mut arg_index: usize = 0;

    while i < template.len() {
        let ch: u8 = template.byte_at(i);

        // Escape: {{ -> literal {
        if ch == 0x7B && i + 1 < template.len() && template.byte_at(i + 1) == 0x7B {
            result = result + "{";
            i = i + 2;
            continue;
        }

        // Escape: }} -> literal }
        if ch == 0x7D && i + 1 < template.len() && template.byte_at(i + 1) == 0x7D {
            result = result + "}";
            i = i + 2;
            continue;
        }

        // Placeholder: { ... }
        if ch == 0x7B {
            let start: usize = i + 1;
            // Find closing brace.
            let mut end: usize = start;
            while end < template.len() && template.byte_at(end) != 0x7D {
                end = end + 1;
            }
            let placeholder: String = template.slice(start, end);

            if placeholder.len() == 0 {
                // Auto-indexed: {}
                if arg_index < args.len() {
                    result = result + args[arg_index];
                    arg_index = arg_index + 1;
                } else {
                    result = result + "{}";
                }
            } else {
                // Explicitly indexed: {0}, {1}, ...
                let idx: usize = parse_usize(placeholder);
                if idx < args.len() {
                    result = result + args[idx];
                } else {
                    result = result + "{" + placeholder + "}";
                }
            }
            i = end + 1;
            continue;
        }

        // Regular character.
        result = result + char_from_byte(ch);
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// format_int
// Formats an integer value in the given base (2..36).
// Uses lowercase letters a-z for digits above 9.
// ---------------------------------------------------------------------------
public func format_int(value: i64, base: u32) -> String {
    if base < 2 || base > 36 {
        return "<invalid base>";
    }
    if value == 0 {
        return "0";
    }

    let digits: String = "0123456789abcdefghijklmnopqrstuvwxyz";
    let is_negative: bool = value < 0;
    let mut v: u64 = 0;
    if is_negative {
        v = (-value) as u64;
    } else {
        v = value as u64;
    }

    let mut result: String = "";
    while v > 0 {
        let remainder: u64 = v % (base as u64);
        result = char_from_byte(digits.byte_at(remainder as usize)) + result;
        v = v / (base as u64);
    }

    if is_negative {
        result = "-" + result;
    }
    return result;
}

// Unsigned overload.
public func format_uint(value: u64, base: u32) -> String {
    if base < 2 || base > 36 {
        return "<invalid base>";
    }
    if value == 0 {
        return "0";
    }

    let digits: String = "0123456789abcdefghijklmnopqrstuvwxyz";
    let mut v: u64 = value;
    let mut result: String = "";
    while v > 0 {
        let remainder: u64 = v % (base as u64);
        result = char_from_byte(digits.byte_at(remainder as usize)) + result;
        v = v / (base as u64);
    }
    return result;
}

// ---------------------------------------------------------------------------
// bin
// Returns the binary (base-2) string representation of `value`, prefixed
// with "0b".
// ---------------------------------------------------------------------------
public func bin(value: i64) -> String {
    if value == 0 {
        return "0b0";
    }
    if value < 0 {
        return "-0b" + format_int(-value, 2);
    }
    return "0b" + format_int(value, 2);
}

// Unsigned overload.
public func bin_u(value: u64) -> String {
    if value == 0 {
        return "0b0";
    }
    return "0b" + format_uint(value, 2);
}

// ---------------------------------------------------------------------------
// hex
// Returns the hexadecimal (base-16) string representation of `value`,
// prefixed with "0x".
// ---------------------------------------------------------------------------
public func hex(value: i64) -> String {
    if value == 0 {
        return "0x0";
    }
    if value < 0 {
        return "-0x" + format_int(-value, 16);
    }
    return "0x" + format_int(value, 16);
}

// Unsigned overload.
public func hex_u(value: u64) -> String {
    if value == 0 {
        return "0x0";
    }
    return "0x" + format_uint(value, 16);
}

// ---------------------------------------------------------------------------
// oct
// Returns the octal (base-8) string representation of `value`, prefixed
// with "0o".
// ---------------------------------------------------------------------------
public func oct(value: i64) -> String {
    if value == 0 {
        return "0o0";
    }
    if value < 0 {
        return "-0o" + format_int(-value, 8);
    }
    return "0o" + format_int(value, 8);
}

// Unsigned overload.
public func oct_u(value: u64) -> String {
    if value == 0 {
        return "0o0";
    }
    return "0o" + format_uint(value, 8);
}

// ---------------------------------------------------------------------------
// pad_left
// Pads `s` on the left with `fill` until it is at least `width` characters.
// ---------------------------------------------------------------------------
public func pad_left(s: String, width: usize, fill: u8) -> String {
    if s.len() >= width {
        return s;
    }
    let mut result: String = "";
    let count: usize = width - s.len();
    let mut i: usize = 0;
    while i < count {
        result = result + char_from_byte(fill);
        i = i + 1;
    }
    return result + s;
}

// ---------------------------------------------------------------------------
// pad_right
// Pads `s` on the right with `fill` until it is at least `width` characters.
// ---------------------------------------------------------------------------
public func pad_right(s: String, width: usize, fill: u8) -> String {
    if s.len() >= width {
        return s;
    }
    let mut result: String = s;
    let count: usize = width - s.len();
    let mut i: usize = 0;
    while i < count {
        result = result + char_from_byte(fill);
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// center
// Centers `s` within a field of `width` characters, padded with `fill`.
// ---------------------------------------------------------------------------
public func center(s: String, width: usize, fill: u8) -> String {
    if s.len() >= width {
        return s;
    }
    let total_pad: usize = width - s.len();
    let left_pad: usize = total_pad / 2;
    let right_pad: usize = total_pad - left_pad;
    let mut result: String = "";
    let mut i: usize = 0;
    while i < left_pad {
        result = result + char_from_byte(fill);
        i = i + 1;
    }
    result = result + s;
    i = 0;
    while i < right_pad {
        result = result + char_from_byte(fill);
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------

// Parses a decimal usize from a string.
func parse_usize(s: String) -> usize {
    let mut result: usize = 0;
    let mut i: usize = 0;
    while i < s.len() {
        let ch: u8 = s.byte_at(i);
        if ch >= 48 && ch <= 57 {
            result = result * 10 + (ch - 48) as usize;
        }
        i = i + 1;
    }
    return result;
}

extern func char_from_byte(b: u8) -> String;
