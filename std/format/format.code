// std/format/format.code
// String formatting and numeric base conversions.
//
// For text with values in it, an interpolated literal is usually simpler and
// is checked at compile time: `f"{name} is {age}"`. `format` is for a
// template that is only known at run time.

// ---------------------------------------------------------------------------
// format
// Substitutes the placeholders of `template` with `args`: `{}` takes the
// next argument, `{0}`, `{1}`, .. the argument at that index, and `{{` and
// `}}` are literal braces. A placeholder without an argument, or one that is
// not a number, is kept as written.
//
// Example: format("Hello, {}! You are {} years old.", ["Alice", "30"])
//          -> "Hello, Alice! You are 30 years old."
// ---------------------------------------------------------------------------
public func format(template: String, args: [String]) -> String {
    var result = "".to_string();
    var i: usize = 0;
    var arg_index: usize = 0;
    // The start of the text not yet copied: runs of plain text are appended
    // as one slice, not byte by byte.
    var copied: usize = 0;
    let n = template.len();

    while i < n {
        let ch = template.byte_at(i);
        let doubled = i + 1 < n && template.byte_at(i + 1) == ch;
        if (ch == 0x7Bu8 || ch == 0x7Du8) && doubled {
            result += template.slice(copied, i + 1);
            i += 2;
            copied = i;
            continue;
        }
        if ch == 0x7Bu8 {
            var end = i + 1;
            while end < n && template.byte_at(end) != 0x7Du8 {
                end += 1;
            }
            if end == n {
                // An unclosed brace: the rest is text.
                break;
            }
            result += template.slice(copied, i);
            let placeholder = template.slice(i + 1, end);
            if placeholder.is_empty() {
                if arg_index < args.len() {
                    result += args[arg_index];
                    arg_index += 1;
                } else {
                    result += "{}";
                }
            } else if let index = placeholder.parse_i64() {
                if index >= 0 && (index as usize) < args.len() {
                    result += args[index as usize];
                } else {
                    result += template.slice(i, end + 1);
                }
            } else {
                result += template.slice(i, end + 1);
            }
            i = end + 1;
            copied = i;
            continue;
        }
        i += 1;
    }
    result += template.slice(copied, n);
    return result;
}

// ---------------------------------------------------------------------------
// format_int / format_uint
// The integer in base 2..36, with lower-case letters for digits above 9.
// A base out of range gives "<invalid base>".
// ---------------------------------------------------------------------------
public func format_int(value: i64, base: u32) -> String {
    if value < 0 {
        // The magnitude of `i64::MIN` does not fit an `i64`; as a `u64` it
        // does (two's complement negation).
        let magnitude = (0u64 - (value as u64));
        let digits = format_uint(magnitude, base);
        if digits.starts_with("<") {
            return digits;
        }
        return "-" + digits;
    }
    return format_uint(value as u64, base);
}

public func format_uint(value: u64, base: u32) -> String {
    if base < 2 || base > 36 {
        return "<invalid base>".to_string();
    }
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz".to_string();
    // 64 binary digits at most, written from the end.
    let out = array_filled(0u8, 64);
    var at: usize = 64;
    var v = value;
    loop {
        at -= 1;
        out[at] = digits.byte_at((v % (base as u64)) as usize);
        v = v / (base as u64);
        if v == 0 {
            break;
        }
    }
    // The digits are ASCII: always valid UTF-8.
    let all = string_from_utf8(out)!;
    return all.slice(at, 64);
}

// ---------------------------------------------------------------------------
// bin / hex / oct (and the unsigned `_u` forms): the integer with a `0b`,
// `0x` or `0o` prefix, after the sign.
// ---------------------------------------------------------------------------
public func bin(value: i64) -> String {
    return prefixed(value, 2, "0b");
}

public func bin_u(value: u64) -> String {
    return "0b" + format_uint(value, 2);
}

public func hex(value: i64) -> String {
    return prefixed(value, 16, "0x");
}

public func hex_u(value: u64) -> String {
    return "0x" + format_uint(value, 16);
}

public func oct(value: i64) -> String {
    return prefixed(value, 8, "0o");
}

public func oct_u(value: u64) -> String {
    return "0o" + format_uint(value, 8);
}

func prefixed(value: i64, base: u32, prefix: String) -> String {
    let digits = format_int(value, base);
    if digits.starts_with("-") {
        return "-" + prefix + digits.slice(1, digits.len());
    }
    return prefix + digits;
}

// ---------------------------------------------------------------------------
// pad_left / pad_right / center
// `s` padded with copies of `fill` to at least `width` characters (code
// points), on the left, the right, or both (the extra one on the right).
// `fill` is one character, usually " " or "0".
// ---------------------------------------------------------------------------
public func pad_left(s: String, width: usize, fill: String) -> String {
    let chars = s.char_count();
    if chars >= width {
        return s;
    }
    return fill.repeat(width - chars) + s;
}

public func pad_right(s: String, width: usize, fill: String) -> String {
    let chars = s.char_count();
    if chars >= width {
        return s;
    }
    return s + fill.repeat(width - chars);
}

public func center(s: String, width: usize, fill: String) -> String {
    let chars = s.char_count();
    if chars >= width {
        return s;
    }
    let total = width - chars;
    let left = total / 2;
    return fill.repeat(left) + s + fill.repeat(total - left);
}
