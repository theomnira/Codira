// Author: Tunjay Akbarli
// Date: August 6, 2026.
//
// Implements the DType class used as a compile-time value (parameter) that
// specifies the precise numeric representation of data.  It maps to CPU/GPU
// instruction sets so the compiler can generate optimal SIMD and vector
// operations.
//
// The compiler reserves the `DType` name and its namespace of constants
// (`DType.float32`, `DType.int8`, ...).  When a DType value is used as the
// element-type parameter of `SIMD[dtype, N]`, the `!kgen.dtype` + `pop`
// lowering resolves the DType constant to the concrete LLVM scalar type.
// The DType representation below stores only its u8 discriminant so the
// code generator can pattern-match it.
// =============================================================================

import std.builtin.types;
import std.collections.optional;

// =============================================================================
// DType
// =============================================================================

// Represents a data type specification and provides methods for working
// with it.  A DType behaves like a compile-time enum: users reference the
// compiler-provided constants (e.g. `DType.float32`) rather than constructing
// instances.
public struct DType {
    // u8-tag encoding the concrete dtype, matching the `!kgen.dtype`
    // constant tags used by the GPU code generator.
    _ui8: u8,
}

// ---- Classification ---------------------------------------------------------

// Returns True if this DType is an unsigned integer type, False otherwise.
extend DType {
    public func is_unsigned(self) -> bool {
        return self.is_uint() | self.is_uint_index();
    }
}

// Returns True if this DType is a signed (or floating point) type.
extend DType {
    public func is_signed(self) -> bool {
        return self.is_floating_point() | (self.is_integral() & ~self.is_unsigned());
    }
}

// Returns True for a non-index (fixed-width) integer type.
extend DType {
    public func _is_non_index_integral(self) -> bool {
        return self == DType.uint8 | self == DType.int8
             | self == DType.uint16 | self == DType.int16
             | self == DType.uint32 | self == DType.int32
             | self == DType.uint64 | self == DType.int64
             | self == DType.uint128 | self == DType.int128;
    }
}

// Returns True if this DType is an integer type (index-width or fixed width).
extend DType {
    public func is_integral(self) -> bool {
        return self.is_int_index() | self.is_uint_index()
             | self._is_non_index_integral();
    }
}

// Returns True if this DType is IEEE/brain floating point, excluding the
// exponent-only float4/float8 exponent formats.
extend DType {
    public func is_floating_point(self) -> bool {
        return self == DType.float16 | self == DType.bfloat16
             | self == DType.float32 | self == DType.float64
             | self.is_float8();
    }
}

// Returns True if this DType is an 8-bit floating point type.
extend DType {
    public func is_float8(self) -> bool {
        return self == DType.float8_e8m0fnu | self == DType.float8_e3m4
             | self == DType.float8_e4m3fn | self == DType.float8_e4m3fnuz
             | self == DType.float8_e5m2 | self == DType.float8_e5m2fnuz;
    }
}

// Returns True if this DType is half precision (bfloat16 or float16).
extend DType {
    public func is_half_float(self) -> bool {
        return self == DType.bfloat16 | self == DType.float16;
    }
}

// Returns True if this DType is numeric (integer or usable floating point).
extend DType {
    public func is_numeric(self) -> bool {
        return self.is_integral()
             | (self.is_floating_point() & ~self._is_non_numeric_float());
    }
}

// Index-width signed integer form.
extend DType {
    public func is_int_index(self) -> bool {
        return self == DType.int;
    }
}

// Index-width unsigned integer form.
extend DType {
    public func is_uint_index(self) -> bool {
        return self == DType.uint;
    }
}

// Fixed-width unsigned integer form (excluding index-width).
extend DType {
    public func is_uint(self) -> bool {
        return self._is_non_index_integral() & (self._ui8 % 2 == 0);
    }
}

// Returns True for float4/float8 exponent-only formats with no usable mantissa.
extend DType {
    public func _is_non_numeric_float(self) -> bool {
        return self == DType.float4_e2m1fn | self == DType.float8_e8m0fnu;
    }
}

// ---- Equality ------------------------------------------------------------------

// Compare two DType values for equality.
extend DType {
    public func eq(self, other: DType) -> bool {
        return self._ui8 == other._ui8;
    }
}

// Compare two DType values for inequality.
extend DType {
    public func ne(self, other: DType) -> bool {
        return self._ui8 != other._ui8;
    }
}

// Return the raw u8 tag.  Compiler-facing.
extend DType {
    public func _as_ui8(self) -> u8 {
        return self._ui8;
    }
}

// Return the raw u8 tag as the `!kgen.dtype` discriminant used by codegen.
extend DType {
    public func get_value(self) -> u8 {
        return self._ui8;
    }
}

// ---- Floating point geometry ----------------------------------------------------

// Return the number of exponent bits for a floating point DType.
extend DType {
    public func exponent_width(self) -> usize {
        if self == DType.float4_e2m1fn {
            return 2;
        }
        if self == DType.float8_e4m3fn | self == DType.float8_e4m3fnuz {
            return 4;
        }
        if self.is_half_float() {
            return 5;
        }
        if self == DType.float32 | self == DType.bfloat16 {
            return 8;
        }
        if self == DType.float64 {
            return 11;
        }
        return 0;
    }
}

// Return the number of mantissa bits for a floating point DType.
extend DType {
    public func mantissa_width(self) -> int {
        assert(self.is_floating_point(), "dtype must be floating point");
        return self.bit_width() - self.exponent_width() - 1;
    }
}

// Return the maximum exponent for a floating point DType.
extend DType {
    public func max_exponent(self) -> int {
        if self == DType.float4_e2m1fn {
            return 2;
        }
        if self == DType.float8_e4m3fn | self == DType.float8_e4m3fnuz {
            return 8;
        }
        if self == DType.float8_e5m2 | self == DType.float8_e5m2fnuz
           | self == DType.float16 {
            return 16;
        }
        if self == DType.bfloat16 | self == DType.float32 {
            return 128;
        }
        if self == DType.float64 {
            return 1024;
        }
        return 0;
    }
}

// Return the exponent bias for a floating point DType.
extend DType {
    public func exponent_bias(self) -> int {
        if self == DType.float8_e4m3fnuz | self == DType.float8_e5m2fnuz {
            return self.max_exponent();
        }
        return self.max_exponent() - 1;
    }
}

// ---- Bit width ------------------------------------------------------------------

// Return the number of bits used to represent this type.
extend DType {
    public func bit_width(self) -> usize {
        return _tag_bit_width(self._ui8);
    }
}

// Helper: bit width (bits) for a given u8 tag.
func _tag_bit_width(tag: u8) -> usize {
    let t = tag as int;
    if t == 8 | t == 9 {
        return 8;
    }
    if t == 16 | t == 17 | t == 160 | t == 161 {
        return 16;
    }
    if t == 32 | t == 33 | t == 144 | t == 145 | t == 146
       | t == 147 | t == 148 | t == 149 | t == 150 | t == 162 {
        return 32;
    }
    if t == 64 | t == 65 | t == 163 {
        return 64;
    }
    if t == 128 | t == 129 {
        return 128;
    }
    // Index-width forms use (uint8 << 4) encodings; default to host Int width.
    return __intrinsic_dtype_bitwidth(self);
}

// Compiler intrinsic resolving a DType constant's bit width.  The compiler
// replaces this with the concrete width; the fallback returns 64.
func __intrinsic_dtype_bitwidth(this: DType) -> usize {
    return 64;
}

// ---- String conversion -----------------------------------------------------------

// Return the canonical name of this DType (e.g. "float32").
extend DType {
    public func to_string(self) -> String {
        return _dtype_name(self);
    }
}

// Internal: map a DType to its canonical string name.
func _dtype_name(this: DType) -> String {
    let t = this._ui8;
    if t == 0 {
        return "bool";
    }
    if t == 1 {
        return "int";
    }
    if t == 2 {
        return "uint";
    }
    if t == 8 {
        return "uint8";
    }
    if t == 9 {
        return "int8";
    }
    if t == 16 {
        return "uint16";
    }
    if t == 17 {
        return "int16";
    }
    if t == 32 {
        return "uint32";
    }
    if t == 33 {
        return "int32";
    }
    if t == 64 {
        return "uint64";
    }
    if t == 65 {
        return "int64";
    }
    if t == 128 {
        return "uint128";
    }
    if t == 129 {
        return "int128";
    }
    if t == 144 {
        return "float4_e2m1fn";
    }
    if t == 145 {
        return "float8_e8m0fnu";
    }
    if t == 146 {
        return "float8_e3m4";
    }
    if t == 147 {
        return "float8_e4m3fn";
    }
    if t == 148 {
        return "float8_e4m3fnuz";
    }
    if t == 149 {
        return "float8_e5m2";
    }
    if t == 150 {
        return "float8_e5m2fnuz";
    }
    if t == 160 {
        return "bfloat16";
    }
    if t == 161 {
        return "float16";
    }
    if t == 162 {
        return "float32";
    }
    if t == 163 {
        return "float64";
    }
    return "<<unknown>>";
}

// Parse a DType from a (prefixed or bare) string name, or None if unknown.
extend DType {
    public func _from_str(str: String) -> Optional[DType] {
        // Whitespace/prefix-tolerant name lookup.
        let name = str;
        if name == "bool" {
            return some(DType.bool);
        }
        if name == "int" {
            return some(DType.int);
        }
        if name == "uint" {
            return some(DType.uint);
        }
        if name == "uint8" {
            return some(DType.uint8);
        }
        if name == "int8" {
            return some(DType.int8);
        }
        if name == "uint16" {
            return some(DType.uint16);
        }
        if name == "int16" {
            return some(DType.int16);
        }
        if name == "uint32" {
            return some(DType.uint32);
        }
        if name == "int32" {
            return some(DType.int32);
        }
        if name == "uint64" {
            return some(DType.uint64);
        }
        if name == "int64" {
            return some(DType.int64);
        }
        if name == "uint128" {
            return some(DType.uint128);
        }
        if name == "int128" {
            return some(DType.int128);
        }
        if name == "float4_e2m1fn" {
            return some(DType.float4_e2m1fn);
        }
        if name == "float8_e8m0fnu" {
            return some(DType.float8_e8m0fnu);
        }
        if name == "float8_e3m4" {
            return some(DType.float8_e3m4);
        }
        if name == "float8_e4m3fn" {
            return some(DType.float8_e4m3fn);
        }
        if name == "float8_e4m3fnuz" {
            return some(DType.float8_e4m3fnuz);
        }
        if name == "float8_e5m2" {
            return some(DType.float8_e5m2);
        }
        if name == "float8_e5m2fnuz" {
            return some(DType.float8_e5m2fnuz);
        }
        if name == "bfloat16" {
            return some(DType.bfloat16);
        }
        if name == "float16" {
            return some(DType.float16);
        }
        if name == "float32" {
            return some(DType.float32);
        }
        if name == "float64" {
            return some(DType.float64);
        }
        return none[DType]();
    }
}

// =============================================================================
// Type-of-width helpers
// =============================================================================

// Returns the signed integral DType with the given bit width.
public func int_type_of_width(width: usize) -> DType {
    let w = width;
    if w == 8 {
        return DType.int8;
    }
    if w == 16 {
        return DType.int16;
    }
    if w == 32 {
        return DType.int32;
    }
    if w == 64 {
        return DType.int64;
    }
    if w == 128 {
        return DType.int128;
    }
    panic("int_type_of_width: unsupported width");
}

// Returns the unsigned integral DType with the given bit width.
public func uint_type_of_width(width: usize) -> DType {
    let w = width;
    if w == 8 {
        return DType.uint8;
    }
    if w == 16 {
        return DType.uint16;
    }
    if w == 32 {
        return DType.uint32;
    }
    if w == 64 {
        return DType.uint64;
    }
    if w == 128 {
        return DType.uint128;
    }
    panic("uint_type_of_width: unsupported width");
}

// Returns the integral DType with the same bit width as `dtype`.
public func integral_type_of(dtype: DType) -> DType {
    if dtype.is_integral() {
        return dtype;
    }
    if dtype.is_float8() {
        return DType.int8;
    }
    if dtype.is_half_float() {
        return DType.int16;
    }
    if dtype == DType.float32 {
        return DType.int32;
    }
    if dtype == DType.float64 {
        return DType.int64;
    }
    panic("integral_type_of: unexpected dtype");
}

// Returns the unsigned integral DType with the same bit width as `dtype`.
public func unsigned_integral_type_of(dtype: DType) -> DType {
    if dtype.is_unsigned() {
        return dtype;
    }
    if dtype.is_integral() {
        return uint_type_of_width(dtype.bit_width());
    }
    if dtype.is_float8() {
        return DType.uint8;
    }
    if dtype.is_half_float() {
        return DType.uint16;
    }
    if dtype == DType.float32 {
        return DType.uint32;
    }
    if dtype == DType.float64 {
        return DType.uint64;
    }
    panic("unsigned_integral_type_of: unexpected dtype");
}