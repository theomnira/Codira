// =============================================================================
// std/builtin/error.code — Error type
// =============================================================================
//
// The Error struct is the standard way to represent and propagate failures
// in Codira.  It carries a human-readable message and an optional numeric
// error code, similar to Mojo's Error type.
//
// Migration note (2026-08-20): rewritten from pre-redesign syntax -- verified
// to parse cleanly via codira_syntax::SourceFile::parse (zero SyntaxErrors).
// All `func Error.method(...)` declarations moved into one `extend Error { }`
// block. `&Hasher` lost its `&` (no reference sigil in the grammar). Two
// things were dropped, not just re-spelled:
//
// 1. `panic`/`panic_with_context` declared `-> !` (a Rust-style "never"
//    return type). `!` does not parse in type position at all (confirmed:
//    `func f() -> ! { ... }` fails with "expected type"); rewritten to
//    `-> void` since both functions unconditionally panic anyway --  this
//    loses the static "never returns" guarantee (which the language
//    doesn't check today regardless), not any actual behavior.
// 2. `into_result` returned `Result[T, Error]`. Per
//    agents/RUST_TO_CODIRA_MIGRATION.md §6, `Result[T, Error]` "does not
//    exist anywhere else in std/ or the spec" -- it was aspirational in
//    the original file, not a real type. Dropped rather than referencing
//    a type that isn't there.
// =============================================================================

import std.builtin.traits

// Represents an error with a message and an optional numeric code.
public struct Error {
    // Human-readable description of the error.
    message: String,

    // Machine-readable error code.  Zero conventionally means "no specific
    // code" or "generic error".
    code: i32,
}

extend Error {
    // ---- Construction ---------------------------------------------------

    // Create an Error from a message string with code 0.
    func new(message: String) -> Error {
        Error { message: message, code: 0 }
    }

    // Create an Error from a message and a numeric code.
    func with_code(message: String, code: i32) -> Error {
        Error { message: message, code: code }
    }

    // Create a generic "unknown error".
    func unknown() -> Error {
        Error { message: "unknown error", code: -1 }
    }

    // Create an "out of bounds" error with context about the index and length.
    func out_of_bounds(index: usize, length: usize) -> Error {
        let msg = "index out of bounds: index="
            + __intrinsic_to_string(index)
            + " length="
            + __intrinsic_to_string(length)
        Error { message: msg, code: 1 }
    }

    // Create an "invalid argument" error.
    func invalid_argument(detail: String) -> Error {
        Error { message: "invalid argument: " + detail, code: 2 }
    }

    // Create a "not found" error.
    func not_found(what: String) -> Error {
        Error { message: "not found: " + what, code: 3 }
    }

    // Create an "already exists" error.
    func already_exists(what: String) -> Error {
        Error { message: "already exists: " + what, code: 4 }
    }

    // Create a "permission denied" error.
    func permission_denied(detail: String) -> Error {
        Error { message: "permission denied: " + detail, code: 5 }
    }

    // Create a "not implemented" error.
    func not_implemented(feature: String) -> Error {
        Error { message: "not implemented: " + feature, code: 6 }
    }

    // Create an "overflow" error.
    func overflow(detail: String) -> Error {
        Error { message: "overflow: " + detail, code: 7 }
    }

    // Create a "timeout" error.
    func timeout(detail: String) -> Error {
        Error { message: "timeout: " + detail, code: 8 }
    }

    // ---- Accessors --------------------------------------------------------

    // Return the error message.
    func get_message(self) -> String {
        self.message
    }

    // Return the numeric error code.
    func get_code(self) -> i32 {
        self.code
    }

    // Return true if this error has a specific (non-zero) code.
    func has_code(self) -> bool {
        self.code != 0
    }

    // ---- Trait implementations ---------------------------------------------

    // Stringable — display the error for end-users.
    func to_string(self) -> String {
        if self.code != 0 {
            return "Error(" + __intrinsic_to_string(self.code) + "): " + self.message
        }
        "Error: " + self.message
    }

    // Representable — debug representation.
    func repr(self) -> String {
        "Error { message: \""
            + self.message
            + "\", code: "
            + __intrinsic_to_string(self.code)
            + " }"
    }

    // EqualityComparable — two errors are equal when both message and code match.
    func eq(self, other: Error) -> bool {
        self.code == other.code & self.message == other.message
    }

    func ne(self, other: Error) -> bool {
        !(self.eq(other))
    }

    // Copyable — Errors are copyable (the String inside may ref-count or COW).
    func copy(self) -> Error {
        Error { message: self.message, code: self.code }
    }

    // Hashable
    func hash(self, hasher: Hasher) -> void {
        hasher.write_i32(self.code)
        hasher.write_string(self.message)
    }

    // ---- Panic helpers ------------------------------------------------------

    // Raise this error as a panic, immediately terminating the program.
    // (See migration note above re: dropping the `!` never-return type.)
    func panic(self) -> void {
        __panic(self.to_string())
    }

    // Raise this error as a panic with an additional context message.
    func panic_with_context(self, context: String) -> void {
        __panic(context + ": " + self.to_string())
    }
}
