// =============================================================================
// std/builtin/bool.code — Boolean type and operations
// =============================================================================
//
// The Bool type wraps a single bit of logical state.  It is a value-type
// struct that implements the standard comparison, hashing, and formatting
// traits.
//
// Logical operations follow short-circuit semantics when used with the
// language-level `&&` and `||` operators; the method forms (`and`, `or`)
// always evaluate both operands.
//
// Migration note (2026-08-20): rewritten from pre-redesign syntax
// (`use`, `struct(value)`, `func Bool.method(...)` associated-function
// declarations outside any block) to the current grammar
// (spec/LANGUAGE_SPEC.md) -- verified to parse cleanly via
// codira_syntax::SourceFile::parse (zero SyntaxErrors). `func Type.method`
// at top level is not valid current syntax (only `extend Type { }` bodies
// may declare a type's functions -- agents/EMBEDDING_CODIRA.md §0); every
// method below moved into one `extend Bool { }` block, dropping the `Bool.`
// prefix. `&Hasher` lost its `&` (no reference sigil exists in the
// grammar). Call syntax for the non-`self` ("static") functions here
// (`from_u8`, `true_value`, `false_value`, `default`, `select`) is Tier 2
// -- they parse inside `extend`, but `Type.method(...)` call-site
// resolution is not confirmed to work yet
// (agents/RUST_TO_CODIRA_MIGRATION.md §4).
// =============================================================================

import std.builtin.traits

// A single boolean value — either `true` or `false`.
//
// Bool is a value type stored inline (1 byte, alignment 1).  The compiler
// may pack multiple Bools into a single byte when used inside bit-fields.
public struct Bool {
    // Internal storage: 0 = false, non-zero = true.
    _value: u8,
}

extend Bool {
    // --- Construction ---------------------------------------------------

    // Construct a Bool from a raw u8 value.
    // Any non-zero byte maps to `true`.
    func from_u8(v: u8) -> Bool {
        if v == 0 {
            return Bool { _value: 0 }
        }
        return Bool { _value: 1 }
    }

    // Construct the canonical `true` value.
    func true_value() -> Bool {
        Bool { _value: 1 }
    }

    // Construct the canonical `false` value.
    func false_value() -> Bool {
        Bool { _value: 0 }
    }

    // --- Logical operations -----------------------------------------------

    // Logical AND.  Returns true only when both self and other are true.
    //
    // Note: unlike `&&`, this method always evaluates `other`.
    func and(self, other: Bool) -> Bool {
        Bool { _value: self._value & other._value }
    }

    // Logical OR.  Returns true when at least one operand is true.
    //
    // Note: unlike `||`, this method always evaluates `other`.
    func or(self, other: Bool) -> Bool {
        if self._value != 0 {
            return Bool { _value: 1 }
        }
        if other._value != 0 {
            return Bool { _value: 1 }
        }
        Bool { _value: 0 }
    }

    // Logical NOT.  Inverts the boolean value.
    func not(self) -> Bool {
        if self._value == 0 {
            return Bool { _value: 1 }
        }
        Bool { _value: 0 }
    }

    // Logical XOR (exclusive-or).  Returns true when exactly one operand is true.
    func xor(self, other: Bool) -> Bool {
        Bool { _value: self._value ^ other._value }
    }

    // --- Equality ------------------------------------------------------

    // Returns true when self and other represent the same logical value.
    func eq(self, other: Bool) -> bool {
        self._value == other._value
    }

    // Returns true when self and other represent different logical values.
    func ne(self, other: Bool) -> bool {
        self._value != other._value
    }

    // --- Conversion ------------------------------------------------------

    // Convert to the native `bool` primitive.
    func to_bool(self) -> bool {
        self._value != 0
    }

    // Convert to an integer: 1 for true, 0 for false.
    func to_int(self) -> i64 {
        if self._value != 0 {
            return 1
        }
        0
    }

    // Convert to u8 (0 or 1).
    func to_u8(self) -> u8 {
        self._value
    }

    // --- Trait implementations --------------------------------------------

    // Stringable — human-readable representation.
    func to_string(self) -> String {
        if self._value != 0 {
            return "true"
        }
        "false"
    }

    // Representable — debug representation.
    func repr(self) -> String {
        if self._value != 0 {
            return "Bool(true)"
        }
        "Bool(false)"
    }

    // Hashable — fold into a hasher.
    func hash(self, hasher: Hasher) -> void {
        hasher.write_u8(self._value)
    }

    // Copyable — Bools are trivially copyable.
    func copy(self) -> Bool {
        Bool { _value: self._value }
    }

    // Defaultable — default Bool is false.
    func default() -> Bool {
        Bool { _value: 0 }
    }

    // --- Static helpers --------------------------------------------------

    // Select one of two values based on a condition.
    func select[T](cond: Bool, if_true: T, if_false: T) -> T {
        if cond._value != 0 {
            return if_true
        }
        if_false
    }

    // NAND gate — returns !(self & other).
    func nand(self, other: Bool) -> Bool {
        self.and(other).not()
    }

    // NOR gate — returns !(self | other).
    func nor(self, other: Bool) -> Bool {
        self.or(other).not()
    }

    // XNOR gate — returns !(self ^ other) — true when operands match.
    func xnor(self, other: Bool) -> Bool {
        self.xor(other).not()
    }

    // Implication: self → other.  False only when self=true and other=false.
    func implies(self, other: Bool) -> Bool {
        self.not().or(other)
    }
}
