// =============================================================================
// std/builtin/types.code — Core type aliases and scalar primitives
// =============================================================================
//
// This module defines the canonical type aliases used throughout the Codira
// standard library.  Every alias maps to a fixed-width primitive so that
// user code can refer to types with Mojo-style names while the compiler
// lowers them to native Codira primitives.
//
// Primitive width table
// ---------------------
//   Alias       Codira primitive   Bits
//   -----       ----------------   ----
//   Int8        i8                 8
//   Int16       i16                16
//   Int32       i32                32
//   Int64       i64                64
//   Int128      i128               128
//   UInt8       u8                 8
//   UInt16      u16                16
//   UInt32      u32                32
//   UInt64      u64                64
//   UInt128     u128               128
//   Float16     f16                16  (IEEE 754 half)
//   Float32     f32                32  (IEEE 754 single)
//   Float64     f64                64  (IEEE 754 double)
//   BFloat16    bf16               16  (brain-float)
//   ISize       isize              ptr-width
//   USize       usize              ptr-width
//
// Migration note (2026-08-20): verified to parse cleanly under the current
// grammar (codira_syntax::SourceFile::parse, zero SyntaxErrors) after one
// change: the "Helper constants" section used `public let NAME: TYPE =
// VALUE;` module-level bindings, which are not a valid top-level item in
// the current grammar (no top-level `let`/const item exists at all --
// confirmed empirically, see std/math/constants.code's migration note for
// the full explanation). Rewritten as niladic functions, called as
// `INT8_MAX()` rather than referenced as `INT8_MAX`. `type` aliases, the
// `enum` with positional (unnamed) payloads, and `__intrinsic_name[T]()`
// explicit-generic-argument calls were all already valid as written --
// checked directly rather than assumed.
// =============================================================================

// ---- Signed integer aliases -------------------------------------------------

// 8-bit signed integer.
public type Int8 = i8;

// 16-bit signed integer.
public type Int16 = i16;

// 32-bit signed integer.
public type Int32 = i32;

// 64-bit signed integer.
public type Int64 = i64;

// 128-bit signed integer.
public type Int128 = i128;

// ---- Unsigned integer aliases -----------------------------------------------

// 8-bit unsigned integer.
public type UInt8 = u8;

// 16-bit unsigned integer.
public type UInt16 = u16;

// 32-bit unsigned integer.
public type UInt32 = u32;

// 64-bit unsigned integer.
public type UInt64 = u64;

// 128-bit unsigned integer.
public type UInt128 = u128;

// ---- Floating-point aliases -------------------------------------------------

// IEEE 754 half-precision (16-bit) floating-point.
public type Float16 = f16;

// IEEE 754 single-precision (32-bit) floating-point.
public type Float32 = f32;

// IEEE 754 double-precision (64-bit) floating-point.
public type Float64 = f64;

// Google Brain 16-bit floating-point (8-bit exponent, 7-bit mantissa).
// BFloat16 keeps the same exponent range as Float32 at the cost of
// mantissa precision, making it popular for machine-learning workloads.
public type BFloat16 = bf16;

// ---- Pointer-width aliases --------------------------------------------------

// Signed integer whose width matches the platform pointer size.
public type ISize = isize;

// Unsigned integer whose width matches the platform pointer size.
public type USize = usize;

// ---- Scalar union type ------------------------------------------------------

// Scalar represents any single numeric value.  It is a sum type over
// every fixed-width numeric primitive.  The compiler may import it for
// generic numeric code and SIMD element types.
public enum Scalar {
    SI8(i8),
    SI16(i16),
    SI32(i32),
    SI64(i64),
    SI128(i128),
    UI8(u8),
    UI16(u16),
    UI32(u32),
    UI64(u64),
    UI128(u128),
    F16(f16),
    F32(f32),
    F64(f64),
    BF16(bf16),
}

// ---- Helper constants -------------------------------------------------------

// Maximum value for each signed integer type.
public func INT8_MAX() -> i8 {
    127
}

public func INT16_MAX() -> i16 {
    32767
}

public func INT32_MAX() -> i32 {
    2147483647
}

public func INT64_MAX() -> i64 {
    9223372036854775807
}

// Minimum value for each signed integer type.
public func INT8_MIN() -> i8 {
    -128
}

public func INT16_MIN() -> i16 {
    -32768
}

public func INT32_MIN() -> i32 {
    -2147483648
}

public func INT64_MIN() -> i64 {
    -9223372036854775808
}

// Maximum value for each unsigned integer type.
public func UINT8_MAX() -> u8 {
    255
}

public func UINT16_MAX() -> u16 {
    65535
}

public func UINT32_MAX() -> u32 {
    4294967295
}

public func UINT64_MAX() -> u64 {
    18446744073709551615
}

// ---- Type-query helpers -----------------------------------------------------

// Returns the size in bytes of the given type.
public func type_sizeof[T]() -> usize {
    __intrinsic_sizeof[T]()
}

// Returns the alignment in bytes of the given type.
public func type_alignof[T]() -> usize {
    __intrinsic_alignof[T]()
}

// Returns the bit-width of the given type.
public func type_bitwidth[T]() -> usize {
    __intrinsic_sizeof[T]() * 8
}
