// =============================================================================
// std/builtin/swap.code — Generic swap utility
// =============================================================================
//
// Provides generic swap functions for exchanging values without requiring
// explicit temporary variables.
//
// Migration note (2026-08-20): rewritten from pre-redesign syntax -- verified
// to parse cleanly via codira_syntax::SourceFile::parse (zero SyntaxErrors).
// Two real findings, not cosmetic:
//
// 1. `swap[T](a: &T, b: &T)` used `&T`/`*a` reference and deref syntax that
//    does not exist in the grammar at all (no `&`/`&mut`/`*`, see
//    agents/RUST_TO_CODIRA_MIGRATION.md §3). `swap_elements`/
//    `swap_nonoverlapping` later in this same original file already used
//    `Pointer[T]` with `.read()`/`.write()`/`.offset()` methods instead --
//    `swap`/`replace`/`take` are rewritten to match that established,
//    already-pointer-based pattern rather than the reference-based one.
// 2. `i as isize` casts do not parse -- there is no expression-level `as`
//    in the grammar despite spec/LANGUAGE_SPEC.md documenting it as
//    designed (see std/builtin/range.code's migration note for the full
//    finding). Replaced with `__intrinsic_cast[T](value)`.
// =============================================================================

import std.builtin.traits

// =============================================================================
// swap — Exchange the values behind two pointers
// =============================================================================

// Exchange the values behind two pointers.
//
// Both pointers must be valid and non-overlapping.
public func swap[T](a: Pointer[T], b: Pointer[T]) -> void {
    let tmp = a.read()
    a.write(b.read())
    b.write(tmp)
}

// =============================================================================
// swap_elements — Swap two elements inside a slice by index
// =============================================================================

// Swap elements at indices `i` and `j` within a mutable slice.
// Panics if either index is out of bounds.
public func swap_elements[T](data: Slice[T], i: usize, j: usize) -> void {
    if i >= data.len() {
        __panic("swap_elements: index i out of bounds")
    }
    if j >= data.len() {
        __panic("swap_elements: index j out of bounds")
    }
    if i == j {
        return
    }
    let ptr = data.data()
    let tmp = ptr.offset(__intrinsic_cast[isize](i)).read()
    ptr.offset(__intrinsic_cast[isize](i)).write(ptr.offset(__intrinsic_cast[isize](j)).read())
    ptr.offset(__intrinsic_cast[isize](j)).write(tmp)
}

// =============================================================================
// swap_nonoverlapping — Bulk swap via pointers
// =============================================================================

// Swap `count` elements between two non-overlapping memory regions.
//
// The caller MUST guarantee that [a, a+count) and [b, b+count) do not
// overlap.  Behavior is undefined if they do.
public func swap_nonoverlapping[T](a: Pointer[T], b: Pointer[T], count: usize) -> void {
    var i: usize = 0
    while i < count {
        let pa = a.offset(__intrinsic_cast[isize](i))
        let pb = b.offset(__intrinsic_cast[isize](i))
        let tmp = pa.read()
        pa.write(pb.read())
        pb.write(tmp)
        i = i + 1
    }
}

// =============================================================================
// replace — Swap a value out and return the old one
// =============================================================================

// Write `new_value` into `dest` and return the previous value.
public func replace[T](dest: Pointer[T], new_value: T) -> T {
    let old = dest.read()
    dest.write(new_value)
    old
}

// =============================================================================
// take — Move a value out and leave the default in its place
// =============================================================================

// Move the value out of `src`, leaving `T::default()` behind.
// Requires T: Defaultable.
public func take[T: Defaultable](src: Pointer[T]) -> T {
    replace[T](src, T.default())
}
