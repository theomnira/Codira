// =============================================================================
// std/builtin/tuple.code — Heterogeneous tuple types
// =============================================================================
//
// Tuples hold a fixed number of heterogeneously-typed elements.  This
// module defines explicit struct wrappers (Tuple2 through Tuple8) that
// carry named accessors and trait implementations, for import wherever the
// grammar's lack of an anonymous tuple *type* (see below) needs a
// workaround.
//
// All tuple structs are value types and satisfy Copyable when every
// element type is Copyable.
//
// Migration note (2026-08-20): rewritten from pre-redesign syntax -- verified
// to parse cleanly via codira_syntax::SourceFile::parse (zero SyntaxErrors).
// Findings from actually running the parser, not assumed:
//
// 1. `struct TupleN[...]` -> `struct TupleN[...]`; every
//    `func TupleN[...].method(...)` moved into one
//    `extend TupleN[...] { }` block per arity, dropping the `TupleN[...].`
//    prefix (top-level `func Type.method` is not valid current syntax).
// 2. `map_first`/`map_second` took a `func(A) -> C`-typed parameter --
//    Codira has no closure/function-value type at all (same finding as
//    std/collections/optional.code), so both are dropped.
// 3. The free `tuple(...)` constructor was overloaded three ways by arity.
//    Function overloading is actively rejected by the compiler today
//    (agents/RUST_TO_CODIRA_MIGRATION.md §5) -- renamed to
//    `tuple2`/`tuple3`/`tuple4`, and given the `[A, B]`-style generic
//    parameter lists the originals were missing (an original-file bug:
//    `func tuple(a: A, b: B) -> Tuple2[A, B]` used `A`/`B` without ever
//    declaring them as the function's own generic parameters).
// 4. `zip` declared `min_len` with `let` then reassigned it -- another
//    original-file bug (`let` is immutable; needs `var`), fixed here.
// 5. `unzip` returned `(Array[A], Array[B])` -- there is no anonymous
//    tuple *type* syntax in the grammar (same finding as `optional.code`'s
//    `replace`/`take`); dropped rather than faked.
// 6. `Tuple2[A, B].new(a, b)`-style explicit-generic-argument call syntax
//    does not parse once there is more than one generic argument
//    (confirmed via minimal probes: `Box[T].new(x)` parses, `Pair[A,
//    B].new(a, b)` does not -- "expected R_BRACKET" right at the comma).
//    The expression-position parser appears to only disambiguate
//    "index-or-generic-args" for a single bracketed argument. Every such
//    call site (the `tupleN` helpers, `zip`) drops the explicit type
//    arguments and relies on inference (`Tuple2.new(a, b)`), consistent
//    with the "no turbofish" rule already documented for other positions.
// =============================================================================

import root.builtin.traits.*;

// =============================================================================
// Tuple2 — pair
// =============================================================================

// A pair of two values of possibly different types.
public struct Tuple2[A, B] {
    _0: A,
    _1: B,
}

extend Tuple2[A, B] {
    func new(a: A, b: B) -> Tuple2[A, B] {
        Tuple2 { _0: a, _1: b }
    }

    func first(self) -> A {
        self._0
    }

    func second(self) -> B {
        self._1
    }

    func swap(self) -> Tuple2[B, A] {
        Tuple2 { _0: self._1, _1: self._0 }
    }

    func to_string(self) -> String {
        "("
            + __intrinsic_to_string(self._0)
            + ", "
            + __intrinsic_to_string(self._1)
            + ")"
    }

    func eq(self, other: Tuple2[A, B]) -> bool {
        self._0 == other._0 & self._1 == other._1
    }

    func ne(self, other: Tuple2[A, B]) -> bool {
        !(self.eq(other))
    }

    func copy(self) -> Tuple2[A, B] {
        Tuple2 { _0: self._0, _1: self._1 }
    }

    func hash(self, hasher: Hasher) -> void {
        hasher.write(self._0)
        hasher.write(self._1)
    }
}

// =============================================================================
// Tuple3 — triple
// =============================================================================

public struct Tuple3[A, B, C] {
    _0: A,
    _1: B,
    _2: C,
}

extend Tuple3[A, B, C] {
    func new(a: A, b: B, c: C) -> Tuple3[A, B, C] {
        Tuple3 { _0: a, _1: b, _2: c }
    }

    func first(self) -> A {
        self._0
    }

    func second(self) -> B {
        self._1
    }

    func third(self) -> C {
        self._2
    }

    func to_string(self) -> String {
        "("
            + __intrinsic_to_string(self._0) + ", "
            + __intrinsic_to_string(self._1) + ", "
            + __intrinsic_to_string(self._2)
            + ")"
    }

    func eq(self, other: Tuple3[A, B, C]) -> bool {
        self._0 == other._0 & self._1 == other._1 & self._2 == other._2
    }

    func copy(self) -> Tuple3[A, B, C] {
        Tuple3 { _0: self._0, _1: self._1, _2: self._2 }
    }
}

// =============================================================================
// Tuple4 — quadruple
// =============================================================================

public struct Tuple4[A, B, C, D] {
    _0: A,
    _1: B,
    _2: C,
    _3: D,
}

extend Tuple4[A, B, C, D] {
    func new(a: A, b: B, c: C, d: D) -> Tuple4[A, B, C, D] {
        Tuple4 { _0: a, _1: b, _2: c, _3: d }
    }

    func first(self) -> A {
        self._0
    }

    func second(self) -> B {
        self._1
    }

    func third(self) -> C {
        self._2
    }

    func fourth(self) -> D {
        self._3
    }

    func to_string(self) -> String {
        "("
            + __intrinsic_to_string(self._0) + ", "
            + __intrinsic_to_string(self._1) + ", "
            + __intrinsic_to_string(self._2) + ", "
            + __intrinsic_to_string(self._3)
            + ")"
    }

    func eq(self, other: Tuple4[A, B, C, D]) -> bool {
        self._0 == other._0 & self._1 == other._1
            & self._2 == other._2 & self._3 == other._3
    }

    func copy(self) -> Tuple4[A, B, C, D] {
        Tuple4 { _0: self._0, _1: self._1, _2: self._2, _3: self._3 }
    }
}

// =============================================================================
// Tuple5
// =============================================================================

public struct Tuple5[A, B, C, D, E] {
    _0: A,
    _1: B,
    _2: C,
    _3: D,
    _4: E,
}

extend Tuple5[A, B, C, D, E] {
    func new(a: A, b: B, c: C, d: D, e: E) -> Tuple5[A, B, C, D, E] {
        Tuple5 { _0: a, _1: b, _2: c, _3: d, _4: e }
    }

    func first(self) -> A {
        self._0
    }

    func second(self) -> B {
        self._1
    }

    func third(self) -> C {
        self._2
    }

    func fourth(self) -> D {
        self._3
    }

    func fifth(self) -> E {
        self._4
    }

    func to_string(self) -> String {
        "("
            + __intrinsic_to_string(self._0) + ", "
            + __intrinsic_to_string(self._1) + ", "
            + __intrinsic_to_string(self._2) + ", "
            + __intrinsic_to_string(self._3) + ", "
            + __intrinsic_to_string(self._4)
            + ")"
    }

    func eq(self, other: Tuple5[A, B, C, D, E]) -> bool {
        self._0 == other._0 & self._1 == other._1
            & self._2 == other._2 & self._3 == other._3
            & self._4 == other._4
    }

    func copy(self) -> Tuple5[A, B, C, D, E] {
        Tuple5 {
            _0: self._0, _1: self._1, _2: self._2, _3: self._3, _4: self._4,
        }
    }
}

// =============================================================================
// Tuple6
// =============================================================================

public struct Tuple6[A, B, C, D, E, F] {
    _0: A,
    _1: B,
    _2: C,
    _3: D,
    _4: E,
    _5: F,
}

extend Tuple6[A, B, C, D, E, F] {
    func new(a: A, b: B, c: C, d: D, e: E, f: F) -> Tuple6[A, B, C, D, E, F] {
        Tuple6 { _0: a, _1: b, _2: c, _3: d, _4: e, _5: f }
    }

    func first(self) -> A {
        self._0
    }

    func second(self) -> B {
        self._1
    }

    func third(self) -> C {
        self._2
    }

    func fourth(self) -> D {
        self._3
    }

    func fifth(self) -> E {
        self._4
    }

    func sixth(self) -> F {
        self._5
    }

    func to_string(self) -> String {
        "("
            + __intrinsic_to_string(self._0) + ", "
            + __intrinsic_to_string(self._1) + ", "
            + __intrinsic_to_string(self._2) + ", "
            + __intrinsic_to_string(self._3) + ", "
            + __intrinsic_to_string(self._4) + ", "
            + __intrinsic_to_string(self._5)
            + ")"
    }

    func eq(self, other: Tuple6[A, B, C, D, E, F]) -> bool {
        self._0 == other._0 & self._1 == other._1
            & self._2 == other._2 & self._3 == other._3
            & self._4 == other._4 & self._5 == other._5
    }

    func copy(self) -> Tuple6[A, B, C, D, E, F] {
        Tuple6 {
            _0: self._0, _1: self._1, _2: self._2,
            _3: self._3, _4: self._4, _5: self._5,
        }
    }
}

// =============================================================================
// Tuple7
// =============================================================================

public struct Tuple7[A, B, C, D, E, F, G] {
    _0: A, _1: B, _2: C, _3: D, _4: E, _5: F, _6: G,
}

extend Tuple7[A, B, C, D, E, F, G] {
    func new(a: A, b: B, c: C, d: D, e: E, f: F, g: G) -> Tuple7[A, B, C, D, E, F, G] {
        Tuple7 { _0: a, _1: b, _2: c, _3: d, _4: e, _5: f, _6: g }
    }

    func to_string(self) -> String {
        "("
            + __intrinsic_to_string(self._0) + ", "
            + __intrinsic_to_string(self._1) + ", "
            + __intrinsic_to_string(self._2) + ", "
            + __intrinsic_to_string(self._3) + ", "
            + __intrinsic_to_string(self._4) + ", "
            + __intrinsic_to_string(self._5) + ", "
            + __intrinsic_to_string(self._6)
            + ")"
    }
}

// =============================================================================
// Tuple8
// =============================================================================

public struct Tuple8[A, B, C, D, E, F, G, H] {
    _0: A, _1: B, _2: C, _3: D, _4: E, _5: F, _6: G, _7: H,
}

extend Tuple8[A, B, C, D, E, F, G, H] {
    func new(a: A, b: B, c: C, d: D, e: E, f: F, g: G, h: H) -> Tuple8[A, B, C, D, E, F, G, H] {
        Tuple8 { _0: a, _1: b, _2: c, _3: d, _4: e, _5: f, _6: g, _7: h }
    }

    func to_string(self) -> String {
        "("
            + __intrinsic_to_string(self._0) + ", "
            + __intrinsic_to_string(self._1) + ", "
            + __intrinsic_to_string(self._2) + ", "
            + __intrinsic_to_string(self._3) + ", "
            + __intrinsic_to_string(self._4) + ", "
            + __intrinsic_to_string(self._5) + ", "
            + __intrinsic_to_string(self._6) + ", "
            + __intrinsic_to_string(self._7)
            + ")"
    }
}

// =============================================================================
// Free-standing helpers
// =============================================================================

// Create a Tuple2 from positional arguments.
public func tuple2[A, B](a: A, b: B) -> Tuple2[A, B] {
    Tuple2.new(a, b)
}

// Create a Tuple3 from positional arguments.
public func tuple3[A, B, C](a: A, b: B, c: C) -> Tuple3[A, B, C] {
    Tuple3.new(a, b, c)
}

// Create a Tuple4 from positional arguments.
public func tuple4[A, B, C, D](a: A, b: B, c: C, d: D) -> Tuple4[A, B, C, D] {
    Tuple4.new(a, b, c, d)
}

// Zip two slices into an array of Tuple2 pairs.
// Stops at the shorter slice's length.
public func zip[A, B](a: Slice[A], b: Slice[B]) -> Array[Tuple2[A, B]] {
    var min_len = a.len()
    if b.len() < min_len {
        min_len = b.len()
    }
    let result = Array.with_capacity(min_len)
    var i: usize = 0
    while i < min_len {
        result.push(Tuple2.new(a.get(i), b.get(i)))
        i = i + 1
    }
    result
}
