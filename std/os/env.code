// std/os/env.code
// Environment variable access for Codira.
// Provides functions to get, set, and unset environment variables via
// the platform runtime.

// ---------------------------------------------------------------------------
// getenv
// Returns the value of the environment variable `name`, or `default_value`
// if the variable is not set.
// ---------------------------------------------------------------------------
public func getenv(name: String, default_value: String) -> String {
    let result: String = _platform_getenv(name);
    if result.len() == 0 && !_platform_env_exists(name) {
        return default_value;
    }
    return result;
}

// Overload that returns an empty string when the variable is absent.
public func getenv(name: String) -> String {
    return getenv(name, "");
}

// ---------------------------------------------------------------------------
// getenv_optional
// Returns an Optional<String> – Some(value) if the environment variable
// exists, None otherwise.
// ---------------------------------------------------------------------------
public func getenv_optional(name: String) -> Optional[String] {
    if _platform_env_exists(name) {
        return some(_platform_getenv(name));
    }
    return none();
}

// ---------------------------------------------------------------------------
// setenv
// Sets the environment variable `name` to `value`.
// If `overwrite` is false and the variable already exists, the call is
// a no-op and returns false.
// ---------------------------------------------------------------------------
public func setenv(name: String, value: String, overwrite: bool) -> bool {
    if !overwrite && _platform_env_exists(name) {
        return false;
    }
    return _platform_setenv(name, value);
}

// Convenience overload that always overwrites.
public func setenv(name: String, value: String) -> bool {
    return setenv(name, value, true);
}

// ---------------------------------------------------------------------------
// unsetenv
// Removes the environment variable `name`.
// Returns true if the variable was removed, false if it did not exist.
// ---------------------------------------------------------------------------
public func unsetenv(name: String) -> bool {
    if !_platform_env_exists(name) {
        return false;
    }
    return _platform_unsetenv(name);
}

// ---------------------------------------------------------------------------
// environ
// Returns all environment variables as an array of key-value pairs.
// ---------------------------------------------------------------------------
public struct EnvEntry {
    key: String,
    value: String,
}

public func environ() -> Array[EnvEntry] {
    return _platform_environ();
}

// ---------------------------------------------------------------------------
// has_env
// Returns true if the environment variable `name` is set.
// ---------------------------------------------------------------------------
public func has_env(name: String) -> bool {
    return _platform_env_exists(name);
}

// ---------------------------------------------------------------------------
// Platform stubs (implemented by the runtime / compiler backend).
// ---------------------------------------------------------------------------
extern func _platform_getenv(name: String) -> String;
extern func _platform_setenv(name: String, value: String) -> bool;
extern func _platform_unsetenv(name: String) -> bool;
extern func _platform_env_exists(name: String) -> bool;
extern func _platform_environ() -> Array[EnvEntry];
