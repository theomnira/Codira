// =============================================================================
// std/json/json.code — JSON: a value, a strict parser, printers, streaming, typed decoding
// =============================================================================
//
//     import std.json.json.{Json, JsonObject, parse, to_string}
//
//     let doc = parse("{\"name\": \"ada\", \"langs\": [\"en\", \"fr\"]}")?
//     if let name = doc.get("name") { println(name.as_str()!) }
//     let o = JsonObject.new()
//     o.set("n", Json.Int(3));
//     println(to_string(Json.Obj(o)))        // {"n":3}
//
// The grammar is the one of ECMA-404 and IETF RFC 8259, and nothing more:
// no comments, no trailing commas, no single quotes, no leading zeros or
// `+` signs, no `NaN` or `Infinity`, no byte order mark. White space is
// space, tab, line feed and carriage return. Any value can be the top
// level, and only white space may follow it.
//
// Values. `Json` is an enum. Numbers keep the distinction the text makes:
// a number written without a fraction or an exponent that fits an `i64`
// is an `Int`, exact; every other number is a `Float`, the nearest `f64`
// (correctly rounded; an integer beyond the `i64` range too). `-0` is
// `Float(-0.0)`, so that the sign survives. A number too large for an
// `f64` (`1e400`) is an error rather than an infinity.
//
// Objects keep their members in the order they were written (or `set`):
// printing a parsed document gives its members back in the same order, so
// a round trip changes nothing a diff would see. A `JsonObject` is a class
// holding its members in one array, and a hash index once it has more
// than 8 members; a lookup is O(1) expected either way.
//
// Duplicate keys (`{"a": 1, "a": 2}`) are an error by default, because
// parsers that disagree about which one wins have been used to slip data
// past a check. `DuplicateKeys.KeepLast` keeps the last value, at the
// position of the first occurrence (what JavaScript's `JSON.parse` and
// Rust's `serde_json` do).
//
// Strings. The parser's input is a `String`, so it is valid UTF-8 already
// (`parse_bytes` checks bytes first). Escapes include `\uXXXX` surrogate
// pairs; a lone surrogate, an unknown escape and an unescaped control
// character (U+0000..U+001F) are errors. A string without escapes is a
// view of the input text: nothing is copied, and the value keeps the
// input's buffer alive (copy it, `f"{s}"`, to let the buffer go).
//
// Limits. Arrays and objects may nest `max_depth` deep (128 by default,
// at most `MAX_DEPTH_LIMIT()`), so hostile input cannot exhaust the stack.
// The parser never panics: every input gives a value or a `JsonError`
// with the byte offset, the line and column (1-based; the column counts
// characters), and the reason.
//
// Printing. `to_string` is compact, `to_pretty_string` indents by two
// spaces (`to_pretty_string_with` takes the width); `to_bytes_into` and
// `to_pretty_bytes_into` append the text to a `[u8]` the caller reuses.
// Strings escape `"`, `\` and the control characters, and nothing else:
// every other character is written as itself, in UTF-8. Floats are written
// in the shortest form that reads back as the same `f64` (the runtime's
// `ryu`), always with a `.` or an exponent, so they read back as a
// `Float`; a NaN or an infinity, which JSON cannot express, is written as
// `null`. For every value without one, `parse(to_string(v))` equals `v`.
// The text is built in one byte array (`push_str`, `push_int`,
// `push_json_float`) and handed to the `String` without a copy
// (`string_take_utf8`).
//
// Streaming. `JsonWriter` writes one document token by token, into a buffer
// or a file (std.fs), checking what the parser checks and keeping the first
// call that does not fit. `JsonReader` reads one document event by event
// (`next_event`, `peek`), building no tree: it is the parser run one token
// at a time, so it accepts the same texts and stops at the same first
// error.
//
// Typed decoding. There is no derive: a program writes a decoder per type
// over `JsonReader` (`begin_object`/`next_key`, `begin_array`/
// `next_element`, `read_i64`, `read_string`, `read_if_null`, `skip`, ...),
// and an encoder over `JsonWriter`. A `DecodeError` names the value by its
// JSONPath (`$.statuses[3].user.id`) and its byte offset, line and column:
//
//     func decode_point(r: JsonReader) -> Result[Point, DecodeError] {
//         var x: i64 = 0
//         var y = 0.0
//         r.begin_object()?
//         while let key = r.next_key()? {
//             if key == "x" {
//                 x = r.read_i64()?
//             } else if key == "y" {
//                 y = r.read_f64()?
//             } else {
//                 r.skip()?
//             }
//         }
//         Result.Ok(Point { x: x, y: y })
//     }
//
// Equality (`equals`, `a.equals(b)`) is structural: arrays element by
// element, objects as sets of members (order ignored), numbers by kind and
// value (`Int(1)` and `Float(1.0)` differ, as their texts do).
//
// NOT DoS-RESISTANT in one respect: object keys are indexed with an
// unseeded hash (FNV-1a), so whoever writes a large object can make its
// keys collide and parsing it quadratic. Depth is limited; size is not.
// =============================================================================

import root.result.result.{Result};
import root.fs.fs.{fs_write_all};

extern "codira-intrinsic" {
    func stack_alloc(size: usize, align: usize) -> usize;
    func store_u8(addr: usize, value: u8);
}

// ── The value ───────────────────────────────────────────────────────────────

public enum Json {
    Null
    Bool(bool)
    // A number without a fraction or exponent, in the `i64` range.
    Int(i64)
    // Every other number.
    Float(f64)
    Str(String)
    Arr([Json])
    Obj(JsonObject)
}

// One member of an object: its key, the key's `hash()`, and its value.
struct Member {
    key: String,
    hash: u64,
    value: Json,
}

// The members of an object, in insertion order. A class: copies share it.
public class JsonObject {
    entries: [Member],
    // `nil` while there are at most `INDEX_FROM()` members (a scan of the
    // hashes is faster then); otherwise an open-addressing table of entry
    // index + 1 (0 is a free slot), a power of two at least twice the
    // number of entries.
    index: [u32]?,
}

// An object starts using its hash index above this many members.
func INDEX_FROM() -> usize { 8 }

// The table slot a key hash starts probing at (before masking).
func slot_of(hash: u64) -> usize {
    (hash ^ (hash >> 29)) as usize
}

// The position of `key` among `members[lo..hi]` (relative to `lo`), or
// `hi - lo`. `table`, when present, indexes exactly those members.
func find_member(members: [Member], lo: usize, hi: usize, table: [u32]?, key: String, hash: u64) -> usize {
    let n = hi - lo
    if let t = table {
        let mask = t.len() - 1
        var slot = slot_of(hash) & mask
        loop {
            let entry = t[slot] as usize
            if entry == 0 {
                return n
            }
            let m = members[lo + entry - 1]
            if m.hash == hash && m.key == key {
                return entry - 1
            }
            slot = (slot + 1) & mask
        }
    }
    var i = lo
    while i < hi {
        let m = members[i]
        if m.hash == hash && m.key == key {
            return i - lo
        }
        i += 1
    }
    n
}

// A fresh index of `members[lo..hi]`, with room for twice as many.
func build_index(members: [Member], lo: usize, hi: usize) -> [u32] {
    let n = hi - lo
    var size: usize = 16
    while size < n * 4 {
        size = size * 2
    }
    let table = array_filled(0u32, size)
    let mask = size - 1
    var i: usize = 0
    while i < n {
        var slot = slot_of(members[lo + i].hash) & mask
        while table[slot] != 0 {
            slot = (slot + 1) & mask
        }
        table[slot] = (i + 1) as u32
        i += 1
    }
    table
}

// The index of `members[lo..hi]` after entry `hi - 1 - lo` (whose hash is
// `hash`) was added, given the index before (`nil` while small).
func index_after_push(members: [Member], lo: usize, hi: usize, table: [u32]?, hash: u64) -> [u32]? {
    let n = hi - lo
    if n <= INDEX_FROM() {
        return nil
    }
    if let t = table {
        if n * 2 <= t.len() {
            let mask = t.len() - 1
            var slot = slot_of(hash) & mask
            while t[slot] != 0 {
                slot = (slot + 1) & mask
            }
            t[slot] = n as u32
            return t
        }
    }
    build_index(members, lo, hi)
}

extend JsonObject {
    // An empty object.
    public func new() -> JsonObject {
        JsonObject { entries: [], index: nil }
    }

    // The number of members.
    public func len(self) -> usize {
        self.entries.len()
    }

    public func is_empty(self) -> bool {
        self.entries.len() == 0
    }

    // The value of `key`, or `nil`.
    public func get(self, key: String) -> Json? {
        let n = self.entries.len()
        let at = find_member(self.entries, 0, n, self.index, key, key.hash())
        if at < n { self.entries[at].value } else { nil }
    }

    public func contains_key(self, key: String) -> bool {
        let n = self.entries.len()
        find_member(self.entries, 0, n, self.index, key, key.hash()) < n
    }

    // Sets `key` to `value`: in place when the key is there (its position
    // is kept; the old value is returned), at the end otherwise (`nil`).
    public func set(self, key: String, value: Json) -> Json? {
        let hash = key.hash()
        let n = self.entries.len()
        let at = find_member(self.entries, 0, n, self.index, key, hash)
        if at < n {
            let old = self.entries[at].value
            self.entries[at] = Member { key: key, hash: hash, value: value }
            return old
        }
        self.entries.push(Member { key: key, hash: hash, value: value })
        self.index = index_after_push(self.entries, 0, n + 1, self.index, hash)
        nil
    }

    // `set`, returning the object, for building one in an expression.
    public func with(self, key: String, value: Json) -> JsonObject {
        self.set(key, value);
        self
    }

    // Removes `key`, keeping the order of the others; returns its value.
    // O(n): the members after it move down.
    public func remove(self, key: String) -> Json? {
        let n = self.entries.len()
        let at = find_member(self.entries, 0, n, self.index, key, key.hash())
        if at >= n {
            return nil
        }
        let old = self.entries.remove(at).value
        if n - 1 > INDEX_FROM() {
            self.index = build_index(self.entries, 0, n - 1)
        } else {
            self.index = nil
        }
        old
    }

    // The keys, in order (a new array).
    public func keys(self) -> [String] {
        self.entries.map(func(m) { m.key })
    }

    // The values, in the order of `keys()` (a new array).
    public func values(self) -> [Json] {
        self.entries.map(func(m) { m.value })
    }

    // The key of member `i` in order, or `nil` past the end.
    public func key_at(self, i: usize) -> String? {
        if i < self.entries.len() { self.entries[i].key } else { nil }
    }

    // The value of member `i` in order, or `nil` past the end.
    public func value_at(self, i: usize) -> Json? {
        if i < self.entries.len() { self.entries[i].value } else { nil }
    }
}

extend Json {
    // ── Construction ────────────────────────────────────────────────────────

    public func string(value: String) -> Json { Json.Str(value) }
    public func int(value: i64) -> Json { Json.Int(value) }
    public func float(value: f64) -> Json { Json.Float(value) }
    public func boolean(value: bool) -> Json { Json.Bool(value) }
    public func array(items: [Json]) -> Json { Json.Arr(items) }
    // An empty object value; reach its members with `as_object()`.
    public func object() -> Json { Json.Obj(JsonObject.new()) }

    // ── Queries ─────────────────────────────────────────────────────────────

    public func is_null(self) -> bool {
        match self { Json.Null -> true, _ -> false }
    }
    public func is_bool(self) -> bool {
        match self { Json.Bool(_) -> true, _ -> false }
    }
    // An `Int` or a `Float`.
    public func is_number(self) -> bool {
        match self { Json.Int(_) -> true, Json.Float(_) -> true, _ -> false }
    }
    public func is_int(self) -> bool {
        match self { Json.Int(_) -> true, _ -> false }
    }
    public func is_float(self) -> bool {
        match self { Json.Float(_) -> true, _ -> false }
    }
    public func is_string(self) -> bool {
        match self { Json.Str(_) -> true, _ -> false }
    }
    public func is_array(self) -> bool {
        match self { Json.Arr(_) -> true, _ -> false }
    }
    public func is_object(self) -> bool {
        match self { Json.Obj(_) -> true, _ -> false }
    }

    // "null", "bool", "int", "float", "string", "array" or "object".
    public func kind_name(self) -> str {
        match self {
            Json.Null -> "null",
            Json.Bool(_) -> "bool",
            Json.Int(_) -> "int",
            Json.Float(_) -> "float",
            Json.Str(_) -> "string",
            Json.Arr(_) -> "array",
            Json.Obj(_) -> "object",
        }
    }

    // ── Accessors: `nil` when the value is of another kind ──────────────────

    public func as_bool(self) -> bool? {
        match self { Json.Bool(b) -> b, _ -> nil }
    }

    // An `Int`'s value (a `Float` is `nil`, even an integral one).
    public func as_i64(self) -> i64? {
        match self { Json.Int(n) -> n, _ -> nil }
    }

    // A `Float`'s value, or an `Int`'s converted (rounded beyond 2^53).
    public func as_f64(self) -> f64? {
        match self {
            Json.Int(n) -> n as f64,
            Json.Float(x) -> x,
            _ -> nil,
        }
    }

    public func as_str(self) -> String? {
        match self { Json.Str(s) -> s, _ -> nil }
    }

    // The array itself (shared, not copied).
    public func as_array(self) -> [Json]? {
        match self { Json.Arr(items) -> items, _ -> nil }
    }

    // The object itself (shared, not copied).
    public func as_object(self) -> JsonObject? {
        match self { Json.Obj(o) -> o, _ -> nil }
    }

    // The member `key` of an object; `nil` when absent or not an object.
    public func get(self, key: String) -> Json? {
        match self { Json.Obj(o) -> o.get(key), _ -> nil }
    }

    // Element `index` of an array; `nil` when out of range or not an array.
    public func at(self, index: usize) -> Json? {
        match self {
            Json.Arr(items) -> if index < items.len() { items[index] } else { nil },
            _ -> nil,
        }
    }

    // The number of elements or members; 0 for anything else.
    public func len(self) -> usize {
        match self {
            Json.Arr(items) -> items.len(),
            Json.Obj(o) -> o.len(),
            _ -> 0,
        }
    }

    // Structural equality; see `equals`.
    public func equals(self, other: Json) -> bool {
        equals(self, other)
    }

    // The compact text, as `to_string(self)`.
    public func to_json(self) -> String {
        to_string(self)
    }
}

// Structural equality: the same kind and, for arrays, equal elements in
// order; for objects, the same keys with equal values in any order; for
// numbers, `Int`s or `Float`s (not one of each) equal as numbers (IEEE:
// `-0.0` equals `0.0`, a NaN equals nothing).
public func equals(a: Json, b: Json) -> bool {
    match a {
        Json.Null -> b.is_null(),
        Json.Bool(x) -> match b { Json.Bool(y) -> x == y, _ -> false },
        Json.Int(x) -> match b { Json.Int(y) -> x == y, _ -> false },
        Json.Float(x) -> match b { Json.Float(y) -> x == y, _ -> false },
        Json.Str(x) -> match b { Json.Str(y) -> x == y, _ -> false },
        Json.Arr(xs) -> match b { Json.Arr(ys) -> arrays_equal(xs, ys), _ -> false },
        Json.Obj(x) -> match b { Json.Obj(y) -> objects_equal(x, y), _ -> false },
    }
}

func arrays_equal(xs: [Json], ys: [Json]) -> bool {
    let n = xs.len()
    if n != ys.len() {
        return false
    }
    var i: usize = 0
    while i < n {
        if !equals(xs[i], ys[i]) {
            return false
        }
        i += 1
    }
    true
}

func objects_equal(x: JsonObject, y: JsonObject) -> bool {
    let n = x.entries.len()
    if n != y.entries.len() {
        return false
    }
    var i: usize = 0
    while i < n {
        let m = x.entries[i]
        let at = find_member(y.entries, 0, n, y.index, m.key, m.hash)
        if at >= n || !equals(m.value, y.entries[at].value) {
            return false
        }
        i += 1
    }
    true
}

// ── Errors ──────────────────────────────────────────────────────────────────

// Why a text is not JSON.
public enum JsonErrorKind {
    // The text ended where more was needed.
    UnexpectedEnd
    // A value was expected here (a byte that cannot start one).
    ExpectedValue
    // An object member's name must be a string.
    ExpectedKey
    // `:` must follow an object member's name.
    ExpectedColon
    // After an array element: `,` or `]`.
    ExpectedCommaOrBracket
    // After an object member: `,` or `}`.
    ExpectedCommaOrBrace
    // `,` right before `]` or `}`.
    TrailingComma
    // Something other than white space after the value.
    TrailingCharacters
    // A word that is not `true`, `false` or `null` (`NaN`, `tru`).
    InvalidLiteral
    // A malformed number: a leading zero, a missing digit.
    InvalidNumber
    // A number too large for an `f64`.
    NumberOutOfRange
    // A control character (U+0000..U+001F) written in a string unescaped.
    ControlCharacter
    // A `\` followed by something JSON does not define.
    InvalidEscape
    // A `\u` not followed by four hexadecimal digits.
    InvalidUnicodeEscape
    // A `\u` surrogate without its other half.
    LoneSurrogate
    // The text ended inside a string.
    UnterminatedString
    // A key an object already has (with `DuplicateKeys.Reject`).
    DuplicateKey
    // Arrays and objects nested deeper than `max_depth`.
    DepthLimit
    // `parse_bytes` only: the bytes are not UTF-8.
    InvalidUtf8
}

// Where and why parsing failed.
public struct JsonError {
    public kind: JsonErrorKind,
    // The byte offset in the text, 0-based.
    public offset: usize,
    // The line (1-based; lines end at line feeds).
    public line: usize,
    // The column, 1-based, in characters (code points).
    public column: usize,
}

extend JsonError {
    // The reason, as a phrase.
    public func reason(self) -> str {
        match self.kind {
            JsonErrorKind.UnexpectedEnd -> "unexpected end of input",
            JsonErrorKind.ExpectedValue -> "expected a value",
            JsonErrorKind.ExpectedKey -> "expected a string key",
            JsonErrorKind.ExpectedColon -> "expected `:` after an object key",
            JsonErrorKind.ExpectedCommaOrBracket -> "expected `,` or `]` after an array element",
            JsonErrorKind.ExpectedCommaOrBrace -> "expected `,` or `}` after an object member",
            JsonErrorKind.TrailingComma -> "trailing comma",
            JsonErrorKind.TrailingCharacters -> "trailing characters after the value",
            JsonErrorKind.InvalidLiteral -> "invalid literal (expected `true`, `false` or `null`)",
            JsonErrorKind.InvalidNumber -> "invalid number",
            JsonErrorKind.NumberOutOfRange -> "number out of range",
            JsonErrorKind.ControlCharacter -> "unescaped control character in a string",
            JsonErrorKind.InvalidEscape -> "invalid escape in a string",
            JsonErrorKind.InvalidUnicodeEscape -> "invalid `\\u` escape (expected four hexadecimal digits)",
            JsonErrorKind.LoneSurrogate -> "lone surrogate in a `\\u` escape",
            JsonErrorKind.UnterminatedString -> "unterminated string",
            JsonErrorKind.DuplicateKey -> "duplicate key in an object",
            JsonErrorKind.DepthLimit -> "arrays and objects nested deeper than the limit",
            JsonErrorKind.InvalidUtf8 -> "invalid UTF-8",
        }
    }

    // "<reason> at line L, column C (byte B)".
    public func message(self) -> String {
        let line = self.line
        let column = self.column
        let offset = self.offset
        self.reason().to_string() + f" at line {line}, column {column} (byte {offset})"
    }
}

// The error `kind` at byte `offset` of `text`, with its line and column.
func error_at(text: String, kind: JsonErrorKind, offset: usize) -> JsonError {
    var line: usize = 1
    var column: usize = 1
    var i: usize = 0
    let end = if offset < text.len() { offset } else { text.len() }
    while i < end {
        let b = text.byte_at(i)
        if b == 10 {
            line += 1
            column = 1
        } else if (b & 0xC0) != 0x80 {
            column += 1
        }
        i += 1
    }
    JsonError { kind: kind, offset: offset, line: line, column: column }
}

// ── Options ─────────────────────────────────────────────────────────────────

// What to do with a key an object already has.
public enum DuplicateKeys {
    // An error (`JsonErrorKind.DuplicateKey`), at the second key.
    Reject
    // The last value wins, at the position of the first occurrence.
    KeepLast
}

public struct ParseOptions {
    // How deep arrays and objects may nest: `[[1]]` is 2 deep. Clamped to
    // `MAX_DEPTH_LIMIT()`.
    public max_depth: usize,
    public duplicate_keys: DuplicateKeys,
}

// The default nesting limit, 128 (`serde_json`'s admits 127).
public func DEFAULT_MAX_DEPTH() -> usize { 128 }

// The largest nesting limit `parse_with` honours: a larger `max_depth` is
// this. A level of nesting takes up to about 900 bytes of stack in the
// parser (less in the printer and `equals`): parsing, printing and
// comparing 1000 levels runs in a 1 MiB stack (and not in 768 KiB). The
// main thread and Codira's task threads have 8 MiB.
public func MAX_DEPTH_LIMIT() -> usize { 1000 }

// 128 levels, duplicate keys rejected.
public func default_options() -> ParseOptions {
    ParseOptions { max_depth: DEFAULT_MAX_DEPTH(), duplicate_keys: DuplicateKeys.Reject }
}

// ── Parsing ─────────────────────────────────────────────────────────────────

// Parses `text` as one JSON value, with `default_options()`.
public func parse(text: String) -> Result[Json, JsonError] {
    parse_with(text, default_options())
}

// Parses `text` as one JSON value.
public func parse_with(text: String, options: ParseOptions) -> Result[Json, JsonError] {
    let limit = if options.max_depth < MAX_DEPTH_LIMIT() { options.max_depth } else { MAX_DEPTH_LIMIT() }
    let keep_last = match options.duplicate_keys {
        DuplicateKeys.KeepLast -> true,
        DuplicateKeys.Reject -> false,
    }
    let p = Parser {
        text: text,
        pos: 0,
        depth: 0,
        max_depth: limit,
        keep_last: keep_last,
        scratch: [],
        items: [],
        item_top: 0,
        members: [],
        member_top: 0,
    }
    let value = p.value()?
    p.skip_space()
    if p.pos < text.len() {
        return Result.Err(p.error(JsonErrorKind.TrailingCharacters, p.pos))
    }
    Result.Ok(value)
}

// Parses UTF-8 `bytes` (as `read_file` returns them), with
// `default_options()`. Bytes that are not UTF-8 are an `InvalidUtf8`
// error at the first bad byte.
public func parse_bytes(bytes: [u8]) -> Result[Json, JsonError] {
    parse_bytes_with(bytes, default_options())
}

public func parse_bytes_with(bytes: [u8], options: ParseOptions) -> Result[Json, JsonError] {
    if let text = string_from_utf8(bytes) {
        return parse_with(text, options)
    }
    let bad = first_invalid_utf8(bytes)
    // Line and column of the valid prefix.
    var line: usize = 1
    var column: usize = 1
    var i: usize = 0
    while i < bad {
        let b = bytes[i]
        if b == 10 {
            line += 1
            column = 1
        } else if (b & 0xC0) != 0x80 {
            column += 1
        }
        i += 1
    }
    Result.Err(JsonError { kind: JsonErrorKind.InvalidUtf8, offset: bad, line: line, column: column })
}

// The offset of the first byte of `bytes` that does not begin a valid
// UTF-8 sequence (the length when there is none). Only on the error path.
func first_invalid_utf8(bytes: [u8]) -> usize {
    let n = bytes.len()
    var i: usize = 0
    while i < n {
        let b = bytes[i]
        var width: usize = 0
        var low: u8 = 0x80
        var high: u8 = 0xBF
        if b < 0x80 {
            width = 1
        } else if b >= 0xC2 && b <= 0xDF {
            width = 2
        } else if b >= 0xE0 && b <= 0xEF {
            width = 3
            if b == 0xE0 { low = 0xA0 }
            if b == 0xED { high = 0x9F }
        } else if b >= 0xF0 && b <= 0xF4 {
            width = 4
            if b == 0xF0 { low = 0x90 }
            if b == 0xF4 { high = 0x8F }
        } else {
            return i
        }
        if i + width > n {
            return i
        }
        var k: usize = 1
        while k < width {
            let c = bytes[i + k]
            let lo = if k == 1 { low } else { 0x80 }
            let hi = if k == 1 { high } else { 0xBF }
            if c < lo || c > hi {
                return i
            }
            k += 1
        }
        i += width
    }
    n
}

// A recursive-descent parser over a `String`. Arrays and objects being
// parsed keep their elements on two stacks (`items`, `members`), so that
// each array or object is allocated once, at its exact size, when it ends:
// a growing array moves its elements out of its cell to a buffer of its
// own on every doubling, which is most of what building one costs.
class Parser {
    text: String,
    pos: usize,
    depth: usize,
    max_depth: usize,
    keep_last: bool,
    // Reused for the bytes of a `\u` escape.
    scratch: [u8],
    // `items[..item_top]`: the elements of the arrays being parsed, the
    // innermost last.
    items: [Json],
    item_top: usize,
    // `members[..member_top]`: the same for objects.
    members: [Member],
    member_top: usize,
}

func is_digit(b: u8) -> bool {
    b >= 48 && b <= 57
}

// The value of a hexadecimal digit, or 16.
func hex_value(b: u8) -> u32 {
    if b >= 48 && b <= 57 {
        return (b - 48) as u32
    }
    if b >= 97 && b <= 102 {
        return (b - 87) as u32
    }
    if b >= 65 && b <= 70 {
        return (b - 55) as u32
    }
    16
}

extend Parser {
    func error(self, kind: JsonErrorKind, at: usize) -> JsonError {
        error_at(self.text, kind, at)
    }

    func skip_space(self) {
        let text = self.text
        let n = text.len()
        var i = self.pos
        while i < n {
            let b = text.byte_at(i)
            if b == 32 || b == 10 || b == 13 || b == 9 {
                i += 1
            } else {
                break
            }
        }
        self.pos = i
    }

    // One value, after optional white space.
    func value(self) -> Result[Json, JsonError] {
        self.skip_space()
        let text = self.text
        let at = self.pos
        if at >= text.len() {
            return Result.Err(self.error(JsonErrorKind.UnexpectedEnd, at))
        }
        let b = text.byte_at(at)
        if b == 34 {
            let s = self.string()?
            return Result.Ok(Json.Str(s))
        }
        if b == 123 {
            return self.object()
        }
        if b == 91 {
            return self.array()
        }
        if b == 45 || is_digit(b) {
            return self.number()
        }
        if b == 116 {
            self.literal(114, 117, 101, 0)?
            return Result.Ok(Json.Bool(true))
        }
        if b == 102 {
            self.literal(97, 108, 115, 101)?
            return Result.Ok(Json.Bool(false))
        }
        if b == 110 {
            self.literal(117, 108, 108, 0)?
            return Result.Ok(Json.Null)
        }
        if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) {
            // `NaN`, `Infinity`, `True`, `undefined`...
            return Result.Err(self.error(JsonErrorKind.InvalidLiteral, at))
        }
        Result.Err(self.error(JsonErrorKind.ExpectedValue, at))
    }

    // The rest of a literal whose first byte is at `pos`: the bytes `b1`,
    // `b2`, `b3` and, unless it is 0, `b4`.
    func literal(self, b1: u8, b2: u8, b3: u8, b4: u8) -> Result[bool, JsonError] {
        let text = self.text
        let n = text.len()
        let start = self.pos
        let width: usize = if b4 == 0 { 4 } else { 5 }
        var i: usize = 1
        while i < width {
            let at = start + i
            if at >= n {
                return Result.Err(self.error(JsonErrorKind.UnexpectedEnd, at))
            }
            let want = if i == 1 { b1 } else if i == 2 { b2 } else if i == 3 { b3 } else { b4 }
            if text.byte_at(at) != want {
                return Result.Err(self.error(JsonErrorKind.InvalidLiteral, start))
            }
            i += 1
        }
        let end = start + width
        // `nullx`, `true1`: a literal runs into more letters or digits.
        if end < n {
            let next = text.byte_at(end)
            if (next >= 65 && next <= 90) || (next >= 97 && next <= 122) || is_digit(next) || next == 95 {
                return Result.Err(self.error(JsonErrorKind.InvalidLiteral, start))
            }
        }
        self.pos = end
        Result.Ok(true)
    }

    // A number starting at `pos` (a `-` or a digit).
    func number(self) -> Result[Json, JsonError] {
        let text = self.text
        let n = text.len()
        let start = self.pos
        var i = start
        let negative = text.byte_at(i) == 45
        if negative {
            i += 1
        }
        if i >= n {
            return Result.Err(self.error(JsonErrorKind.UnexpectedEnd, i))
        }
        let first = text.byte_at(i)
        let digits_start = i
        // The value of up to 18 digits, which cannot overflow.
        var value: i64 = 0
        if first == 48 {
            i += 1
            if i < n && is_digit(text.byte_at(i)) {
                return Result.Err(self.error(JsonErrorKind.InvalidNumber, i))
            }
        } else if is_digit(first) {
            while i < n {
                let d = text.byte_at(i)
                if !is_digit(d) {
                    break
                }
                value = value * 10 + (d - 48) as i64
                i += 1
            }
        } else {
            return Result.Err(self.error(JsonErrorKind.InvalidNumber, i))
        }
        let int_end = i
        var is_float = false
        if i < n && text.byte_at(i) == 46 {
            is_float = true
            i += 1
            let frac_start = i
            while i < n && is_digit(text.byte_at(i)) {
                i += 1
            }
            if i == frac_start {
                let kind = if i >= n { JsonErrorKind.UnexpectedEnd } else { JsonErrorKind.InvalidNumber }
                return Result.Err(self.error(kind, i))
            }
        }
        if i < n && (text.byte_at(i) == 101 || text.byte_at(i) == 69) {
            is_float = true
            i += 1
            if i < n && (text.byte_at(i) == 43 || text.byte_at(i) == 45) {
                i += 1
            }
            let exp_start = i
            while i < n && is_digit(text.byte_at(i)) {
                i += 1
            }
            if i == exp_start {
                let kind = if i >= n { JsonErrorKind.UnexpectedEnd } else { JsonErrorKind.InvalidNumber }
                return Result.Err(self.error(kind, i))
            }
        }
        self.pos = i
        if !is_float {
            if int_end - digits_start <= 18 {
                if negative {
                    if value == 0 {
                        return Result.Ok(Json.Float(-0.0))
                    }
                    return Result.Ok(Json.Int(-value))
                }
                return Result.Ok(Json.Int(value))
            }
            if let exact = text.slice(start, i).parse_i64() {
                return Result.Ok(Json.Int(exact))
            }
        }
        if let float = text.slice(start, i).parse_f64() {
            if float - float == 0.0 {
                return Result.Ok(Json.Float(float))
            }
            return Result.Err(self.error(JsonErrorKind.NumberOutOfRange, start))
        }
        Result.Err(self.error(JsonErrorKind.InvalidNumber, start))
    }

    // A string whose opening quote is at `pos`.
    func string(self) -> Result[String, JsonError] {
        let text = self.text
        let n = text.len()
        let start = self.pos + 1
        // The first quote, backslash or control character, 16 bytes at a
        // time.
        let i = text.find_json_escape(start)
        if i >= n {
            return Result.Err(self.error(JsonErrorKind.UnterminatedString, n))
        }
        let b = text.byte_at(i)
        if b == 34 {
            self.pos = i + 1
            return Result.Ok(text.slice(start, i))
        }
        if b == 92 {
            return self.escaped_string(start, i)
        }
        Result.Err(self.error(JsonErrorKind.ControlCharacter, i))
    }

    // The rest of a string from `start`, whose first escape is at `escape`.
    func escaped_string(self, start: usize, escape: usize) -> Result[String, JsonError] {
        let text = self.text
        let n = text.len()
        var out = "".to_string()
        out += text.slice(start, escape)
        var i = escape
        var run = escape
        while i < n {
            // Plain bytes are skipped 16 at a time.
            i = text.find_json_escape(i)
            if i >= n {
                break
            }
            let b = text.byte_at(i)
            if b == 34 {
                if run < i {
                    out += text.slice(run, i)
                }
                self.pos = i + 1
                return Result.Ok(out)
            }
            if b < 32 {
                return Result.Err(self.error(JsonErrorKind.ControlCharacter, i))
            }
            // A backslash.
            if run < i {
                out += text.slice(run, i)
            }
            if i + 1 >= n {
                return Result.Err(self.error(JsonErrorKind.UnterminatedString, n))
            }
            let e = text.byte_at(i + 1)
            var width: usize = 2
            if e == 34 {
                out += "\""
            } else if e == 92 {
                out += "\\"
            } else if e == 47 {
                out += "/"
            } else if e == 98 {
                out += "\x08"
            } else if e == 102 {
                out += "\x0c"
            } else if e == 110 {
                out += "\n"
            } else if e == 114 {
                out += "\r"
            } else if e == 116 {
                out += "\t"
            } else if e == 117 {
                let high = self.hex4(i + 2)?
                var cp = high
                width = 6
                if high >= 0xDC00 && high <= 0xDFFF {
                    return Result.Err(self.error(JsonErrorKind.LoneSurrogate, i))
                }
                if high >= 0xD800 && high <= 0xDBFF {
                    // A high surrogate: a `\u` low surrogate must follow.
                    if i + 7 >= n || text.byte_at(i + 6) != 92 || text.byte_at(i + 7) != 117 {
                        return Result.Err(self.error(JsonErrorKind.LoneSurrogate, i))
                    }
                    let low = self.hex4(i + 8)?
                    if low < 0xDC00 || low > 0xDFFF {
                        return Result.Err(self.error(JsonErrorKind.LoneSurrogate, i))
                    }
                    cp = 0x10000 + ((high - 0xD800) << 10) + (low - 0xDC00)
                    width = 12
                }
                out += self.code_point_text(cp)
            } else {
                return Result.Err(self.error(JsonErrorKind.InvalidEscape, i))
            }
            i += width
            run = i
        }
        Result.Err(self.error(JsonErrorKind.UnterminatedString, n))
    }

    // The four hexadecimal digits at `at`, as a number.
    func hex4(self, at: usize) -> Result[u32, JsonError] {
        let text = self.text
        let n = text.len()
        var value: u32 = 0
        var k: usize = 0
        while k < 4 {
            if at + k >= n {
                return Result.Err(self.error(JsonErrorKind.UnexpectedEnd, n))
            }
            let digit = hex_value(text.byte_at(at + k))
            if digit >= 16 {
                return Result.Err(self.error(JsonErrorKind.InvalidUnicodeEscape, at + k))
            }
            value = value * 16 + digit
            k += 1
        }
        Result.Ok(value)
    }

    // The UTF-8 text of a Unicode scalar value (not a surrogate).
    func code_point_text(self, cp: u32) -> String {
        let bytes = self.scratch
        bytes.clear()
        if cp < 0x80 {
            bytes.push(cp as u8)
        } else if cp < 0x800 {
            bytes.push((0xC0 | (cp >> 6)) as u8)
            bytes.push((0x80 | (cp & 0x3F)) as u8)
        } else if cp < 0x10000 {
            bytes.push((0xE0 | (cp >> 12)) as u8)
            bytes.push((0x80 | ((cp >> 6) & 0x3F)) as u8)
            bytes.push((0x80 | (cp & 0x3F)) as u8)
        } else {
            bytes.push((0xF0 | (cp >> 18)) as u8)
            bytes.push((0x80 | ((cp >> 12) & 0x3F)) as u8)
            bytes.push((0x80 | ((cp >> 6) & 0x3F)) as u8)
            bytes.push((0x80 | (cp & 0x3F)) as u8)
        }
        if let s = string_from_utf8(bytes) {
            return s
        }
        // Not reached: the bytes above are UTF-8 for every value the
        // caller passes. U+FFFD rather than a panic all the same.
        "�".to_string()
    }

    // One level deeper, at the `[` or `{` at `pos`.
    func enter(self) -> Result[bool, JsonError] {
        if self.depth >= self.max_depth {
            return Result.Err(self.error(JsonErrorKind.DepthLimit, self.pos))
        }
        self.depth += 1
        self.pos += 1
        Result.Ok(true)
    }

    // An array whose `[` is at `pos`.
    func array(self) -> Result[Json, JsonError] {
        self.enter()?
        let text = self.text
        let n = text.len()
        self.skip_space()
        if self.pos < n && text.byte_at(self.pos) == 93 {
            self.pos += 1
            self.depth -= 1
            let empty: [Json] = []
            return Result.Ok(Json.Arr(empty))
        }
        let lo = self.item_top
        loop {
            let item = self.value()?
            let top = self.item_top
            if top < self.items.len() {
                self.items[top] = item
            } else {
                self.items.push(item)
            }
            self.item_top = top + 1
            self.skip_space()
            if self.pos >= n {
                return Result.Err(self.error(JsonErrorKind.UnexpectedEnd, self.pos))
            }
            let b = text.byte_at(self.pos)
            if b == 44 {
                self.pos += 1
                self.skip_space()
                if self.pos < n && text.byte_at(self.pos) == 93 {
                    return Result.Err(self.error(JsonErrorKind.TrailingComma, self.pos))
                }
            } else if b == 93 {
                self.pos += 1
                break
            } else {
                return Result.Err(self.error(JsonErrorKind.ExpectedCommaOrBracket, self.pos))
            }
        }
        let items = self.items[lo..self.item_top]
        self.item_top = lo
        self.depth -= 1
        Result.Ok(Json.Arr(items))
    }

    // An object whose `{` is at `pos`.
    func object(self) -> Result[Json, JsonError] {
        self.enter()?
        let text = self.text
        let n = text.len()
        self.skip_space()
        if self.pos < n && text.byte_at(self.pos) == 125 {
            self.pos += 1
            self.depth -= 1
            return Result.Ok(Json.Obj(JsonObject.new()))
        }
        let lo = self.member_top
        var table: [u32]? = nil
        loop {
            // A key.
            if self.pos >= n {
                return Result.Err(self.error(JsonErrorKind.UnexpectedEnd, self.pos))
            }
            let key_at = self.pos
            if text.byte_at(key_at) != 34 {
                return Result.Err(self.error(JsonErrorKind.ExpectedKey, key_at))
            }
            let key = self.string()?
            let hash = key.hash()
            let top = self.member_top
            let existing = find_member(self.members, lo, top, table, key, hash)
            let fresh = existing == top - lo
            if !fresh && !self.keep_last {
                return Result.Err(self.error(JsonErrorKind.DuplicateKey, key_at))
            }
            // `:`.
            self.skip_space()
            if self.pos >= n {
                return Result.Err(self.error(JsonErrorKind.UnexpectedEnd, self.pos))
            }
            if text.byte_at(self.pos) != 58 {
                return Result.Err(self.error(JsonErrorKind.ExpectedColon, self.pos))
            }
            self.pos += 1
            let item = self.value()?
            let member = Member { key: key, hash: hash, value: item }
            if fresh {
                if top < self.members.len() {
                    self.members[top] = member
                } else {
                    self.members.push(member)
                }
                self.member_top = top + 1
                table = index_after_push(self.members, lo, top + 1, table, hash)
            } else {
                self.members[lo + existing] = member
            }
            // `,` or `}`.
            self.skip_space()
            if self.pos >= n {
                return Result.Err(self.error(JsonErrorKind.UnexpectedEnd, self.pos))
            }
            let b = text.byte_at(self.pos)
            if b == 44 {
                self.pos += 1
                self.skip_space()
                if self.pos < n && text.byte_at(self.pos) == 125 {
                    return Result.Err(self.error(JsonErrorKind.TrailingComma, self.pos))
                }
            } else if b == 125 {
                self.pos += 1
                break
            } else {
                return Result.Err(self.error(JsonErrorKind.ExpectedCommaOrBrace, self.pos))
            }
        }
        let entries = self.members[lo..self.member_top]
        self.member_top = lo
        self.depth -= 1
        Result.Ok(Json.Obj(JsonObject { entries: entries, index: table }))
    }
}

// ── Printing ────────────────────────────────────────────────────────────────

// The compact text of `value`: no white space between tokens.
public func to_string(value: Json) -> String {
    let w = new_writer(new_buffer(), 0, false)
    w.value(value, 0)
    w.finish()
}

// The text of `value` with each element and member on a line of its own,
// indented by two spaces per level (the layout of `serde_json`'s
// `to_string_pretty`).
public func to_pretty_string(value: Json) -> String {
    to_pretty_string_with(value, 2)
}

// As `to_pretty_string`, indented by `indent` spaces per level (0 puts
// every element on a line of its own, unindented).
public func to_pretty_string_with(value: Json, indent: usize) -> String {
    let w = new_writer(new_buffer(), indent, true)
    w.value(value, 0)
    w.finish()
}

// Appends the compact text of `value` to `dest`, as UTF-8, and returns the
// number of bytes appended. Nothing else is allocated once `dest` has room:
// a program writing many documents keeps one array, `clear()`s it between
// them (the capacity stays) and writes its bytes where they go.
public func to_bytes_into(value: Json, dest: [u8]) -> usize {
    let before = dest.len()
    new_writer(dest, 0, false).value(value, 0)
    dest.len() - before
}

// As `to_bytes_into`, in the layout of `to_pretty_string_with`.
public func to_pretty_bytes_into(value: Json, indent: usize, dest: [u8]) -> usize {
    let before = dest.len()
    new_writer(dest, indent, true).value(value, 0)
    dest.len() - before
}

// The text is written into one growable byte array: punctuation with
// `push`, strings and the runs between their escapes with `push_str` (one
// copy each), numbers with `push_int` and `push_json_float`, which format
// straight into the array's spare capacity. `finish` checks the bytes are
// UTF-8 and hands them to the `String` without a copy
// (`string_take_utf8`).
class Writer {
    buf: [u8],
    indent: usize,
    pretty: bool,
    // At least as many spaces as the deepest indentation written so far;
    // a line's indentation is one `push_str` of a view of it.
    spaces: String,
}

func new_buffer() -> [u8] {
    let buf: [u8] = []
    buf.reserve(4096)
    buf
}

func new_writer(buf: [u8], indent: usize, pretty: bool) -> Writer {
    Writer { buf: buf, indent: indent, pretty: pretty, spaces: "".to_string() }
}

func hex_digit(d: u8) -> u8 {
    if d < 10 { 48 + d } else { 87 + d }
}

// Whether the byte `b` must be escaped in a JSON string: `"`, `\` and the
// control characters U+0000..U+001F.
func needs_escape(b: u8) -> bool {
    b < 32 || b == 34 || b == 92
}

extend Writer {
    // The text written, as a `String`.
    func finish(self) -> String {
        if let text = string_take_utf8(self.buf) {
            return text
        }
        // Not reached: every byte written comes from a `String` (whole) or
        // is ASCII.
        "".to_string()
    }

    // A line break and the indentation of `level`.
    func newline(self, level: usize) {
        self.buf.push(10)
        let n = level * self.indent
        if n == 0 {
            return
        }
        if self.spaces.len() < n {
            let more = if n < 64 { 64 } else { n * 2 }
            self.spaces = " ".repeat(more as i64)
        }
        self.buf.push_str(self.spaces.slice(0, n))
    }

    func value(self, value: Json, level: usize) {
        match value {
            Json.Null -> self.buf.push_str("null"),
            Json.Bool(b) -> {
                if b { self.buf.push_str("true") } else { self.buf.push_str("false") }
            },
            Json.Int(n) -> self.buf.push_int(n),
            Json.Float(x) -> self.buf.push_json_float(x),
            Json.Str(s) -> self.string(s),
            Json.Arr(items) -> self.array(items, level),
            Json.Obj(o) -> self.object(o, level),
        }
    }

    // A string, quoted, with the runs between escapes copied whole.
    func string(self, s: String) {
        let buf = self.buf
        buf.push(34)
        let n = s.len()
        var run: usize = 0
        var i = s.find_json_escape(0)
        while i < n {
            if run < i {
                buf.push_str(s.slice(run, i))
            }
            self.escape(s.byte_at(i))
            run = i + 1
            i = s.find_json_escape(run)
        }
        if run == 0 {
            buf.push_str(s)
        } else if run < n {
            buf.push_str(s.slice(run, n))
        }
        buf.push(34)
    }

    // The escape of a byte `needs_escape` accepts.
    func escape(self, b: u8) {
        let buf = self.buf
        buf.push(92)
        if b == 34 || b == 92 {
            buf.push(b)
        } else if b == 10 {
            buf.push(110)
        } else if b == 13 {
            buf.push(114)
        } else if b == 9 {
            buf.push(116)
        } else if b == 8 {
            buf.push(98)
        } else if b == 12 {
            buf.push(102)
        } else {
            buf.push(117)
            buf.push(48)
            buf.push(48)
            buf.push(hex_digit(b >> 4))
            buf.push(hex_digit(b & 15))
        }
    }

    func array(self, items: [Json], level: usize) {
        let buf = self.buf
        let n = items.len()
        buf.push(91)
        if n == 0 {
            buf.push(93)
            return
        }
        var i: usize = 0
        while i < n {
            if i > 0 {
                buf.push(44)
            }
            if self.pretty {
                self.newline(level + 1)
            }
            self.value(items[i], level + 1)
            i += 1
        }
        if self.pretty {
            self.newline(level)
        }
        buf.push(93)
    }

    func object(self, o: JsonObject, level: usize) {
        let buf = self.buf
        let entries = o.entries
        let n = entries.len()
        buf.push(123)
        if n == 0 {
            buf.push(125)
            return
        }
        var i: usize = 0
        while i < n {
            if i > 0 {
                buf.push(44)
            }
            if self.pretty {
                self.newline(level + 1)
            }
            let m = entries[i]
            self.string(m.key)
            buf.push(58)
            if self.pretty {
                buf.push(32)
            }
            self.value(m.value, level + 1)
            i += 1
        }
        if self.pretty {
            self.newline(level)
        }
        buf.push(125)
    }
}

// ── Streaming output ───────────────────────────────────────────────────────

// Why a `JsonWriter` refused a call. The first refusal is kept, and every
// later call does nothing: the text written so far stays valid up to it.
public enum JsonWriteErrorKind {
    // A value (or `begin_*`) inside an object where a `key` must come.
    ExpectedKey
    // A `key` outside an object, or right after another key.
    UnexpectedKey
    // An `end_array` or `end_object` that does not close what is open.
    MismatchedEnd
    // A second value at the top level (a document is one value).
    ValueAfterEnd
    // `finish` with arrays or objects still open, a key without its value,
    // or nothing written.
    Unfinished
    // A key an object being written already has.
    DuplicateKey
    // Arrays and objects nested deeper than the writer's `max_depth`.
    DepthLimit
    // Writing to the file failed with this FS_ERR_* code (std.fs.fs).
    Io(i64)
}

// Where and why: the refused call's position among the writer's calls
// (0-based) and the number of bytes of valid text before it.
public struct JsonWriteError {
    public kind: JsonWriteErrorKind,
    public call: usize,
    public offset: usize,
}

extend JsonWriteError {
    public func reason(self) -> str {
        match self.kind {
            JsonWriteErrorKind.ExpectedKey -> "a value where an object key must come",
            JsonWriteErrorKind.UnexpectedKey -> "a key outside an object or after another key",
            JsonWriteErrorKind.MismatchedEnd -> "an end that does not close the open array or object",
            JsonWriteErrorKind.ValueAfterEnd -> "a second value after the document's one value",
            JsonWriteErrorKind.Unfinished -> "the document is not complete",
            JsonWriteErrorKind.DuplicateKey -> "duplicate key in an object",
            JsonWriteErrorKind.DepthLimit -> "arrays and objects nested deeper than the limit",
            JsonWriteErrorKind.Io(_) -> "writing the file failed",
        }
    }

    // "<reason> (call C, byte B)", with the FS_ERR_* code of an `Io` error.
    public func message(self) -> String {
        let call = self.call
        let offset = self.offset
        let text = self.reason().to_string() + f" (call {call}, byte {offset})"
        match self.kind {
            JsonWriteErrorKind.Io(code) -> text + f": error {code}",
            _ -> text,
        }
    }
}

// A frame of an open array or object.
func FRAME_ARRAY() -> u8 { 1 }
func FRAME_OBJECT() -> u8 { 2 }

// When a file writer's buffer holds this many bytes, they go to the file.
func FLUSH_AT() -> usize { 65536 }

// A writer of one JSON document, token by token, without a tree: into a
// byte buffer, or through it into a file (`JsonWriter.to_file`).
//
//     let w = JsonWriter.new()
//     w.begin_object()
//     w.key("ids")
//     w.begin_array()
//     for id in ids { w.int(id) }
//     w.end_array()
//     w.end_object()
//     let text = w.finish()?
//
// The writer checks what the parser checks, so what it writes `parse`
// reads with the default options: every call must fit where it is made
// (a key before each member's value, ends that match, one top-level
// value), keys are not repeated within an object, and nesting stops at
// `max_depth` (128). The first call that does not fit is recorded with
// its position and nothing is written from then on (`error()`, and
// `finish` returns it). Strings are escaped, floats written as the tree
// printer writes them (a NaN or an infinity as `null`).
public class JsonWriter {
    w: Writer,
    // The open arrays and objects, innermost last (`FRAME_*`).
    frames: [u8],
    // Whether the innermost frame has an element or member yet.
    has_items: bool,
    // Inside an object: a key was written, its value comes next.
    after_key: bool,
    // The top-level value is complete.
    done: bool,
    max_depth: usize,
    calls: usize,
    failure: JsonWriteError?,
    // The keys of the open objects, as the parser keeps them, to refuse a
    // repeated one: `keys[key_lo[k]..]` are those of open object `k`.
    keys: [Member],
    key_lo: [usize],
    key_tables: [[u32]?],
    // A file handle (std.fs.fs) the bytes go to, or -1.
    fd: i64,
    written: usize,
}

extend JsonWriter {
    // A compact writer into a buffer.
    public func new() -> JsonWriter {
        new_json_writer(0, false, -1)
    }

    // A writer into a buffer in `to_pretty_string_with`'s layout.
    public func pretty(indent: usize) -> JsonWriter {
        new_json_writer(indent, true, -1)
    }

    // A compact writer whose bytes go to the open file `fd` (from
    // std.fs.fs's `fs_open` with `FS_WRITE()`), 64 KiB at a time; call
    // `finish_file` at the end. The writer does not close `fd`.
    public func to_file(fd: i64) -> JsonWriter {
        new_json_writer(0, false, fd)
    }

    // A pretty writer into the open file `fd`.
    public func pretty_to_file(fd: i64, indent: usize) -> JsonWriter {
        new_json_writer(indent, true, fd)
    }

    // Changes the nesting limit (clamped to `MAX_DEPTH_LIMIT()`); before
    // anything is written.
    public func set_max_depth(self, depth: usize) {
        self.max_depth = if depth < MAX_DEPTH_LIMIT() { depth } else { MAX_DEPTH_LIMIT() }
    }

    // The first refused call, or `nil`.
    public func error(self) -> JsonWriteError? {
        self.failure
    }

    // The bytes written and not yet handed out or sent to the file.
    public func buffered(self) -> usize {
        self.w.buf.len()
    }

    public func null(self) {
        if self.before_value() {
            self.w.buf.push_str("null")
            self.after_value()
        }
    }

    public func bool(self, b: bool) {
        if self.before_value() {
            if b { self.w.buf.push_str("true") } else { self.w.buf.push_str("false") }
            self.after_value()
        }
    }

    public func int(self, n: i64) {
        if self.before_value() {
            self.w.buf.push_int(n)
            self.after_value()
        }
    }

    public func float(self, x: f64) {
        if self.before_value() {
            self.w.buf.push_json_float(x)
            self.after_value()
        }
    }

    public func string(self, s: String) {
        if self.before_value() {
            self.w.string(s)
            self.after_value()
        }
    }

    // A whole tree value, as `to_string` (or the pretty printer, at this
    // depth) writes it.
    public func value(self, v: Json) {
        if self.before_value() {
            self.w.value(v, self.frames.len())
            self.after_value()
        }
    }

    public func begin_array(self) {
        self.begin(FRAME_ARRAY(), 91)
    }

    public func end_array(self) {
        self.end(FRAME_ARRAY(), 93)
    }

    public func begin_object(self) {
        self.begin(FRAME_OBJECT(), 123)
    }

    public func end_object(self) {
        self.end(FRAME_OBJECT(), 125)
    }

    // The key of the next member of the innermost object.
    public func key(self, k: String) {
        if !self.start_call() {
            return
        }
        let depth = self.frames.len()
        if depth == 0 || self.frames[depth - 1] != FRAME_OBJECT() || self.after_key {
            self.fail(JsonWriteErrorKind.UnexpectedKey)
            return
        }
        let hash = k.hash()
        // The innermost frame is an object, so its keys are the last set.
        let object = self.key_lo.len() - 1
        let lo = self.key_lo[object]
        let top = self.keys.len()
        let table = self.key_tables[object]
        if find_member(self.keys, lo, top, table, k, hash) < top - lo {
            self.fail(JsonWriteErrorKind.DuplicateKey)
            return
        }
        self.keys.push(Member { key: k, hash: hash, value: Json.Null })
        self.key_tables[object] = index_after_push(self.keys, lo, top + 1, table, hash)
        let buf = self.w.buf
        if self.has_items {
            buf.push(44)
        }
        if self.w.pretty {
            self.w.newline(depth)
        }
        self.w.string(k)
        buf.push(58)
        if self.w.pretty {
            buf.push(32)
        }
        self.after_key = true
    }

    // The text written, as a `String`; the writer is then empty and may
    // write another document. An error if a call was refused or the
    // document is not complete (the writer is then emptied too).
    public func finish(self) -> Result[String, JsonWriteError] {
        self.check_finished()?
        let text = self.w.finish()
        self.reset()
        Result.Ok(text)
    }

    // The bytes written are appended to `dest` (no `String` is made); the
    // writer is then empty, its buffer kept for the next document.
    public func finish_into(self, dest: [u8]) -> Result[usize, JsonWriteError] {
        self.check_finished()?
        let buf = self.w.buf
        let n = buf.len()
        var i: usize = 0
        while i < n {
            dest.push(buf[i])
            i += 1
        }
        buf.clear()
        self.reset()
        Result.Ok(n)
    }

    // For a writer made by `to_file`: sends the rest of the bytes to the
    // file and returns how many bytes the document took. An error if a call
    // was refused, the document is not complete, or the file refused the
    // bytes.
    public func finish_file(self) -> Result[usize, JsonWriteError] {
        self.check_finished()?
        self.flush()
        if let e = self.failure {
            self.reset()
            return Result.Err(e)
        }
        let total = self.written
        self.reset()
        Result.Ok(total)
    }

    // ── Internals ───────────────────────────────────────────────────────────

    // Counts a call; false once a call has been refused.
    func start_call(self) -> bool {
        self.calls += 1
        self.failure == nil
    }

    func fail(self, kind: JsonWriteErrorKind) {
        self.failure = JsonWriteError { kind: kind, call: self.calls - 1, offset: self.written + self.w.buf.len() }
    }

    // Before a value or a `begin_*`: false (refused or failed before) or
    // true with the separator and indentation written.
    func before_value(self) -> bool {
        if !self.start_call() {
            return false
        }
        if self.done {
            self.fail(JsonWriteErrorKind.ValueAfterEnd)
            return false
        }
        let depth = self.frames.len()
        if depth == 0 {
            return true
        }
        if self.frames[depth - 1] == FRAME_OBJECT() {
            if !self.after_key {
                self.fail(JsonWriteErrorKind.ExpectedKey)
                return false
            }
            return true
        }
        if self.has_items {
            self.w.buf.push(44)
        }
        if self.w.pretty {
            self.w.newline(depth)
        }
        true
    }

    // After a value (or an `end_*`) at the current depth.
    func after_value(self) {
        self.after_key = false
        if self.frames.len() == 0 {
            self.done = true
        } else {
            self.has_items = true
        }
        if self.fd >= 0 && self.w.buf.len() >= FLUSH_AT() {
            self.flush()
        }
    }

    func begin(self, kind: u8, open: u8) {
        if !self.before_value() {
            return
        }
        if self.frames.len() >= self.max_depth {
            self.fail(JsonWriteErrorKind.DepthLimit)
            return
        }
        self.w.buf.push(open)
        self.frames.push(kind)
        if kind == FRAME_OBJECT() {
            self.key_lo.push(self.keys.len())
            self.key_tables.push(nil)
        }
        self.has_items = false
        self.after_key = false
    }

    func end(self, kind: u8, close: u8) {
        if !self.start_call() {
            return
        }
        let depth = self.frames.len()
        if depth == 0 || self.frames[depth - 1] != kind || self.after_key {
            self.fail(JsonWriteErrorKind.MismatchedEnd)
            return
        }
        if self.has_items && self.w.pretty {
            self.w.newline(depth - 1)
        }
        self.w.buf.push(close)
        self.frames.pop();
        if kind == FRAME_OBJECT() {
            if let lo = self.key_lo.pop() {
                while self.keys.len() > lo {
                    self.keys.pop();
                }
            }
            self.key_tables.pop();
        }
        self.after_value()
    }

    // Ok when the document is complete and no call was refused; otherwise
    // the error, and the writer is reset for the next document.
    func check_finished(self) -> Result[bool, JsonWriteError] {
        if self.failure == nil && !self.done {
            self.calls += 1
            self.fail(JsonWriteErrorKind.Unfinished)
        }
        if let e = self.failure {
            self.reset()
            return Result.Err(e)
        }
        Result.Ok(true)
    }

    // Sends the buffered bytes to the file, through a buffer on the stack.
    func flush(self) {
        if self.fd < 0 || self.failure != nil {
            return
        }
        let buf = self.w.buf
        let n = buf.len()
        let chunk: usize = 4096
        let tmp = stack_alloc(chunk, 8)
        var at: usize = 0
        while at < n {
            let count = if n - at < chunk { n - at } else { chunk }
            var i: usize = 0
            while i < count {
                store_u8(tmp + i, buf[at + i])
                i += 1
            }
            let put = fs_write_all(self.fd, tmp, count)
            if put < 0 {
                self.failure = JsonWriteError { kind: JsonWriteErrorKind.Io(put), call: self.calls, offset: self.written + at }
                return
            }
            at += count
        }
        self.written += n
        buf.clear()
    }

    // Ready for another document (the buffer and the stacks keep their
    // capacity).
    func reset(self) {
        self.frames.clear()
        self.keys.clear()
        self.key_lo.clear()
        self.key_tables.clear()
        self.has_items = false
        self.after_key = false
        self.done = false
        self.calls = 0
        self.written = 0
        self.failure = nil
        if self.w.buf.len() > 0 {
            self.w.buf.clear()
        }
        // `finish` gave the buffer to the string it made.
        if self.w.buf.capacity() == 0 {
            self.w.buf.reserve(4096)
        }
    }
}

func new_json_writer(indent: usize, pretty: bool, fd: i64) -> JsonWriter {
    let frames: [u8] = []
    let keys: [Member] = []
    let key_lo: [usize] = []
    let key_tables: [[u32]?] = []
    JsonWriter {
        w: new_writer(new_buffer(), indent, pretty),
        frames: frames,
        has_items: false,
        after_key: false,
        done: false,
        max_depth: DEFAULT_MAX_DEPTH(),
        calls: 0,
        failure: nil,
        keys: keys,
        key_lo: key_lo,
        key_tables: key_tables,
        fd: fd,
        written: 0,
    }
}

// ── Streaming input ─────────────────────────────────────────────────────────

// One token of a document, as `JsonReader.next_event` reads them.
public enum JsonEvent {
    BeginObject
    EndObject
    BeginArray
    EndArray
    // An object member's name; its value's events follow.
    Key(String)
    Null
    Bool(bool)
    Int(i64)
    Float(f64)
    Str(String)
    // The document's one value is complete and only white space follows.
    // Every later call returns `End` again.
    End
}

// What the reader expects next.
func READ_VALUE() -> u8 { 0 }
func READ_FIRST_ELEMENT() -> u8 { 1 }
func READ_AFTER_ELEMENT() -> u8 { 2 }
func READ_FIRST_KEY() -> u8 { 3 }
func READ_KEY() -> u8 { 4 }
func READ_COLON() -> u8 { 5 }
func READ_AFTER_MEMBER() -> u8 { 6 }
func READ_AFTER_DOCUMENT() -> u8 { 7 }
func READ_DONE() -> u8 { 8 }

// A pull parser: the events of one document, one call at a time, with no
// tree built.
//
//     let r = JsonReader.new(text)
//     loop {
//         match r.next_event()? {
//             JsonEvent.Key(k) -> ..,
//             JsonEvent.Int(n) -> ..,
//             JsonEvent.End -> break,
//             _ -> {},
//         }
//     }
//
// It is the tree parser run one token at a time -- the same scanning code
// for strings, numbers and literals -- so it accepts exactly the texts
// `parse_with` accepts with the same options, reports the same first error
// (kind, offset, line and column) for every text it rejects, and limits
// nesting the same way. Duplicate keys are refused as there (an object's
// keys are remembered while it is open); with `DuplicateKeys.KeepLast`
// both members are read, in order, and the consumer decides. Strings
// without escapes are views of the text, as in the tree. After an error
// every call returns that error again.
//
// For typed decoding it also knows where it is: `path()` names the value
// read last (`$.statuses[3].user.id`), and the `read_*`, `begin_*`,
// `next_key` and `next_element` methods give a `DecodeError` with that
// path and the byte offset when the text holds something else.
public class JsonReader {
    p: Parser,
    state: u8,
    // `failure` holds the first error once `failed` is set.
    failed: bool,
    failure: JsonError,
    // The open arrays and objects (`FRAME_*`), innermost last, and per
    // frame: the next element's index (arrays) or the current key
    // (objects), for `path()`.
    frames: [u8],
    indices: [usize],
    keys: [String],
    // The keys of the open objects, as the tree parser keeps them.
    key_lo: [usize],
    key_tables: [[u32]?],
    // An event read ahead by `peek` (when `has_peeked`), and its start.
    has_peeked: bool,
    peeked: JsonEvent,
    peeked_at: usize,
    // Where the last event returned starts.
    start: usize,
    // The key of a frame before its first member (one string for all).
    blank: String,
}

extend JsonReader {
    // A reader of `text` with `default_options()`.
    public func new(text: String) -> JsonReader {
        JsonReader.with_options(text, default_options())
    }

    public func with_options(text: String, options: ParseOptions) -> JsonReader {
        let limit = if options.max_depth < MAX_DEPTH_LIMIT() { options.max_depth } else { MAX_DEPTH_LIMIT() }
        let keep_last = match options.duplicate_keys {
            DuplicateKeys.KeepLast -> true,
            DuplicateKeys.Reject -> false,
        }
        let frames: [u8] = []
        let indices: [usize] = []
        let keys: [String] = []
        let key_lo: [usize] = []
        let key_tables: [[u32]?] = []
        JsonReader {
            p: Parser {
                text: text,
                pos: 0,
                depth: 0,
                max_depth: limit,
                keep_last: keep_last,
                scratch: [],
                items: [],
                item_top: 0,
                members: [],
                member_top: 0,
            },
            state: READ_VALUE(),
            failed: false,
            failure: JsonError { kind: JsonErrorKind.UnexpectedEnd, offset: 0, line: 1, column: 1 },
            frames: frames,
            indices: indices,
            keys: keys,
            key_lo: key_lo,
            key_tables: key_tables,
            has_peeked: false,
            peeked: JsonEvent.End,
            peeked_at: 0,
            start: 0,
            blank: "".to_string(),
        }
    }

    // A reader of UTF-8 `bytes`: an `InvalidUtf8` error at the first bad
    // byte, as `parse_bytes` reports it, when they are not UTF-8. The
    // bytes are copied once (the events' strings are views of the copy).
    public func from_bytes(bytes: [u8], options: ParseOptions) -> Result[JsonReader, JsonError] {
        if let text = string_from_utf8(bytes) {
            return Result.Ok(JsonReader.with_options(text, options))
        }
        match parse_bytes_with(bytes, options) {
            Result.Err(e) -> Result.Err(e),
            // Not reached: the bytes are not UTF-8, so parsing fails.
            Result.Ok(_) -> Result.Err(JsonError { kind: JsonErrorKind.InvalidUtf8, offset: 0, line: 1, column: 1 }),
        }
    }

    // The byte offset where the last event read starts (its first byte:
    // a quote, a digit, a bracket...).
    public func offset(self) -> usize {
        self.start
    }

    // How deep the reader is: the number of arrays and objects open.
    public func depth(self) -> usize {
        self.frames.len()
    }

    // The next event, or the first error.
    public func next_event(self) -> Result[JsonEvent, JsonError] {
        if self.has_peeked {
            self.has_peeked = false
            self.start = self.peeked_at
            return Result.Ok(self.peeked)
        }
        if self.failed {
            return Result.Err(self.failure)
        }
        self.step()
    }

    // The next event without consuming it: the following `next_event`
    // returns it.
    public func peek(self) -> Result[JsonEvent, JsonError] {
        if self.has_peeked {
            return Result.Ok(self.peeked)
        }
        if self.failed {
            return Result.Err(self.failure)
        }
        let before = self.start
        match self.step() {
            Result.Ok(e) -> {
                self.has_peeked = true
                self.peeked = e
                self.peeked_at = self.start
                self.start = before
                Result.Ok(e)
            },
            Result.Err(f) -> Result.Err(f),
        }
    }

    // Records the first error and returns it.
    func fail(self, e: JsonError) -> Result[JsonEvent, JsonError] {
        self.failed = true
        self.failure = e
        Result.Err(e)
    }

    // Reads one event: the state machine over the tree parser's code.
    func step(self) -> Result[JsonEvent, JsonError] {
        let p = self.p
        let text = p.text
        let n = text.len()
        loop {
            let state = self.state
            if state == READ_DONE() {
                self.start = n
                return Result.Ok(JsonEvent.End)
            }
            if state == READ_AFTER_DOCUMENT() {
                p.skip_space()
                if p.pos < n {
                    return self.fail(p.error(JsonErrorKind.TrailingCharacters, p.pos))
                }
                self.state = READ_DONE()
                continue
            }
            if state == READ_VALUE() {
                return self.value()
            }
            if state == READ_FIRST_ELEMENT() {
                p.skip_space()
                if p.pos < n && text.byte_at(p.pos) == 93 {
                    return Result.Ok(self.close(FRAME_ARRAY()))
                }
                return self.value()
            }
            if state == READ_AFTER_ELEMENT() {
                p.skip_space()
                if p.pos >= n {
                    return self.fail(p.error(JsonErrorKind.UnexpectedEnd, p.pos))
                }
                let b = text.byte_at(p.pos)
                if b == 44 {
                    p.pos += 1
                    p.skip_space()
                    if p.pos < n && text.byte_at(p.pos) == 93 {
                        return self.fail(p.error(JsonErrorKind.TrailingComma, p.pos))
                    }
                    return self.value()
                }
                if b == 93 {
                    return Result.Ok(self.close(FRAME_ARRAY()))
                }
                return self.fail(p.error(JsonErrorKind.ExpectedCommaOrBracket, p.pos))
            }
            if state == READ_FIRST_KEY() {
                p.skip_space()
                if p.pos < n && text.byte_at(p.pos) == 125 {
                    return Result.Ok(self.close(FRAME_OBJECT()))
                }
                return self.key()
            }
            if state == READ_KEY() {
                return self.key()
            }
            if state == READ_COLON() {
                p.skip_space()
                if p.pos >= n {
                    return self.fail(p.error(JsonErrorKind.UnexpectedEnd, p.pos))
                }
                if text.byte_at(p.pos) != 58 {
                    return self.fail(p.error(JsonErrorKind.ExpectedColon, p.pos))
                }
                p.pos += 1
                return self.value()
            }
            // READ_AFTER_MEMBER
            p.skip_space()
            if p.pos >= n {
                return self.fail(p.error(JsonErrorKind.UnexpectedEnd, p.pos))
            }
            let b = text.byte_at(p.pos)
            if b == 44 {
                p.pos += 1
                p.skip_space()
                if p.pos < n && text.byte_at(p.pos) == 125 {
                    return self.fail(p.error(JsonErrorKind.TrailingComma, p.pos))
                }
                return self.key()
            }
            if b == 125 {
                return Result.Ok(self.close(FRAME_OBJECT()))
            }
            return self.fail(p.error(JsonErrorKind.ExpectedCommaOrBrace, p.pos))
        }
    }

    // The state after a complete value at the current depth.
    func value_done(self) {
        let depth = self.frames.len()
        if depth == 0 {
            self.state = READ_AFTER_DOCUMENT()
        } else if self.frames[depth - 1] == FRAME_ARRAY() {
            self.state = READ_AFTER_ELEMENT()
        } else {
            self.state = READ_AFTER_MEMBER()
        }
    }

    // A value starting at the next non-space byte (`Parser.value` up to
    // the first token).
    func value(self) -> Result[JsonEvent, JsonError] {
        let p = self.p
        // An array's index counts the elements started.
        let depth = self.frames.len()
        if depth > 0 && self.frames[depth - 1] == FRAME_ARRAY() {
            self.indices[depth - 1] += 1
        }
        p.skip_space()
        let text = p.text
        let at = p.pos
        self.start = at
        if at >= text.len() {
            return self.fail(p.error(JsonErrorKind.UnexpectedEnd, at))
        }
        let b = text.byte_at(at)
        if b == 34 {
            return match p.string() {
                Result.Ok(s) -> {
                    self.value_done()
                    Result.Ok(JsonEvent.Str(s))
                },
                Result.Err(e) -> self.fail(e),
            }
        }
        if b == 123 || b == 91 {
            // `Parser.enter`.
            if p.depth >= p.max_depth {
                return self.fail(p.error(JsonErrorKind.DepthLimit, at))
            }
            p.depth += 1
            p.pos += 1
            let kind = if b == 123 { FRAME_OBJECT() } else { FRAME_ARRAY() }
            self.frames.push(kind)
            self.indices.push(0)
            self.keys.push(self.blank)
            if b == 123 {
                self.key_lo.push(p.member_top)
                self.key_tables.push(nil)
                self.state = READ_FIRST_KEY()
                return Result.Ok(JsonEvent.BeginObject)
            }
            self.state = READ_FIRST_ELEMENT()
            return Result.Ok(JsonEvent.BeginArray)
        }
        if b == 45 || is_digit(b) {
            return match p.number() {
                Result.Ok(number) -> {
                    self.value_done()
                    match number {
                        Json.Int(v) -> Result.Ok(JsonEvent.Int(v)),
                        Json.Float(x) -> Result.Ok(JsonEvent.Float(x)),
                        // Not reached: `number` makes only numbers.
                        _ -> Result.Ok(JsonEvent.Null),
                    }
                },
                Result.Err(e) -> self.fail(e),
            }
        }
        if b == 116 {
            if let e = p.literal(114, 117, 101, 0).err() {
                return self.fail(e)
            }
            self.value_done()
            return Result.Ok(JsonEvent.Bool(true))
        }
        if b == 102 {
            if let e = p.literal(97, 108, 115, 101).err() {
                return self.fail(e)
            }
            self.value_done()
            return Result.Ok(JsonEvent.Bool(false))
        }
        if b == 110 {
            if let e = p.literal(117, 108, 108, 0).err() {
                return self.fail(e)
            }
            self.value_done()
            return Result.Ok(JsonEvent.Null)
        }
        if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) {
            return self.fail(p.error(JsonErrorKind.InvalidLiteral, at))
        }
        self.fail(p.error(JsonErrorKind.ExpectedValue, at))
    }

    // An object member's key at the current position (white space skipped
    // already), checked against the object's keys so far.
    func key(self) -> Result[JsonEvent, JsonError] {
        let p = self.p
        let text = p.text
        if p.pos >= text.len() {
            return self.fail(p.error(JsonErrorKind.UnexpectedEnd, p.pos))
        }
        let key_at = p.pos
        self.start = key_at
        if text.byte_at(key_at) != 34 {
            return self.fail(p.error(JsonErrorKind.ExpectedKey, key_at))
        }
        let key = match p.string() {
            Result.Ok(k) -> k,
            Result.Err(e) -> return self.fail(e),
        }
        let hash = key.hash()
        let depth = self.frames.len()
        let lo = self.key_lo[self.key_lo.len() - 1]
        let top = p.member_top
        let table = self.key_tables[self.key_tables.len() - 1]
        let existing = find_member(p.members, lo, top, table, key, hash)
        if existing < top - lo {
            if !p.keep_last {
                return self.fail(p.error(JsonErrorKind.DuplicateKey, key_at))
            }
        } else {
            let member = Member { key: key, hash: hash, value: Json.Null }
            if top < p.members.len() {
                p.members[top] = member
            } else {
                p.members.push(member)
            }
            p.member_top = top + 1
            self.key_tables[self.key_tables.len() - 1] = index_after_push(p.members, lo, top + 1, table, hash)
        }
        if depth > 0 {
            self.indices[depth - 1] += 1
            self.keys[depth - 1] = key
        }
        self.state = READ_COLON()
        Result.Ok(JsonEvent.Key(key))
    }

    // The `]` or `}` at the current position closes the innermost frame.
    func close(self, kind: u8) -> JsonEvent {
        let p = self.p
        self.start = p.pos
        p.pos += 1
        p.depth -= 1
        self.frames.pop();
        self.indices.pop();
        self.keys.pop();
        if kind == FRAME_OBJECT() {
            if let lo = self.key_lo.pop() {
                p.member_top = lo
            }
            self.key_tables.pop();
        }
        self.value_done()
        if kind == FRAME_OBJECT() { JsonEvent.EndObject } else { JsonEvent.EndArray }
    }

    // ── Typed decoding ──────────────────────────────────────────────────────

    // Where the reader is, as a JSONPath: `$` for the document, then
    // `.name` (or `["na me"]` for a key that is not an identifier) for
    // each member and `[i]` for each element, down to the value read last
    // or the array or object being read.
    public func path(self) -> String {
        var out = "$".to_string()
        var k: usize = 0
        let depth = self.frames.len()
        while k < depth {
            if self.frames[k] == FRAME_ARRAY() {
                let i = self.indices[k]
                // The element being read (none yet right after `[`).
                if i > 0 {
                    let at = i - 1
                    out += f"[{at}]"
                }
            } else {
                let key = self.keys[k]
                if self.indices[k] > 0 {
                    out += path_key(key)
                }
            }
            k += 1
        }
        out
    }

    // A `DecodeError` of `kind` here: at the last event's offset and the
    // current path.
    public func error_here(self, kind: DecodeErrorKind) -> DecodeError {
        let e = error_at(self.p.text, JsonErrorKind.ExpectedValue, self.start)
        DecodeError { kind: kind, path: self.path(), offset: e.offset, line: e.line, column: e.column }
    }

    // A syntax error as a `DecodeError`, at its own place.
    func syntax(self, e: JsonError) -> DecodeError {
        DecodeError { kind: DecodeErrorKind.Syntax(e.kind), path: self.path(), offset: e.offset, line: e.line, column: e.column }
    }

    // The next event, its syntax error as a `DecodeError`.
    func event(self) -> Result[JsonEvent, DecodeError] {
        match self.next_event() {
            Result.Ok(e) -> Result.Ok(e),
            Result.Err(e) -> Result.Err(self.syntax(e)),
        }
    }

    func wrong(self, expected: str, found: JsonEvent) -> DecodeError {
        self.error_here(DecodeErrorKind.WrongType(expected, event_kind(found)))
    }

    public func read_null(self) -> Result[(), DecodeError] {
        match self.event()? {
            JsonEvent.Null -> Result.Ok(()),
            e -> Result.Err(self.wrong("null", e)),
        }
    }

    public func read_bool(self) -> Result[bool, DecodeError] {
        match self.event()? {
            JsonEvent.Bool(b) -> Result.Ok(b),
            e -> Result.Err(self.wrong("a boolean", e)),
        }
    }

    // An integer written without a fraction or an exponent, in the `i64`
    // range.
    public func read_i64(self) -> Result[i64, DecodeError] {
        match self.event()? {
            JsonEvent.Int(n) -> Result.Ok(n),
            e -> Result.Err(self.wrong("an integer", e)),
        }
    }

    // An integer in `lo..=hi` (for a narrower field: `0..=255` for a
    // `u8`); `OutOfRange` otherwise.
    public func read_int_in(self, lo: i64, hi: i64) -> Result[i64, DecodeError] {
        let n = self.read_i64()?
        if n < lo || n > hi {
            return Result.Err(self.error_here(DecodeErrorKind.OutOfRange))
        }
        Result.Ok(n)
    }

    // Any number, an integer converted.
    public func read_f64(self) -> Result[f64, DecodeError] {
        match self.event()? {
            JsonEvent.Float(x) -> Result.Ok(x),
            JsonEvent.Int(n) -> Result.Ok(n as f64),
            e -> Result.Err(self.wrong("a number", e)),
        }
    }

    public func read_string(self) -> Result[String, DecodeError] {
        match self.event()? {
            JsonEvent.Str(s) -> Result.Ok(s),
            e -> Result.Err(self.wrong("a string", e)),
        }
    }

    // Whether the next value is `null`, which is then read (for an
    // optional field: `if r.read_if_null()? { nil } else { r.read_i64()? }`).
    public func read_if_null(self) -> Result[bool, DecodeError] {
        let next = match self.peek() {
            Result.Ok(e) -> e,
            Result.Err(e) -> return Result.Err(self.syntax(e)),
        }
        match next {
            JsonEvent.Null -> {
                self.event()?
                Result.Ok(true)
            },
            _ -> Result.Ok(false),
        }
    }

    // The `{` of an object.
    public func begin_object(self) -> Result[(), DecodeError] {
        match self.event()? {
            JsonEvent.BeginObject -> Result.Ok(()),
            e -> Result.Err(self.wrong("an object", e)),
        }
    }

    // The next member's key, or `nil` at the end of the object (its `}`
    // is read).
    public func next_key(self) -> Result[String?, DecodeError] {
        match self.event()? {
            JsonEvent.Key(k) -> Result.Ok(k),
            JsonEvent.EndObject -> Result.Ok(nil),
            // Not reached: inside an object the reader gives only these.
            e -> Result.Err(self.wrong("a key", e)),
        }
    }

    // The `[` of an array.
    public func begin_array(self) -> Result[(), DecodeError] {
        match self.event()? {
            JsonEvent.BeginArray -> Result.Ok(()),
            e -> Result.Err(self.wrong("an array", e)),
        }
    }

    // Whether the array has another element (then read it), or ended (its
    // `]` is read).
    public func next_element(self) -> Result[bool, DecodeError] {
        let next = match self.peek() {
            Result.Ok(e) -> e,
            Result.Err(e) -> return Result.Err(self.syntax(e)),
        }
        match next {
            JsonEvent.EndArray -> {
                self.event()?
                Result.Ok(false)
            },
            _ -> Result.Ok(true),
        }
    }

    // Skips the next value, however deep (an unknown field's).
    public func skip(self) -> Result[(), DecodeError] {
        var open: usize = 0
        loop {
            match self.event()? {
                JsonEvent.BeginObject -> { open += 1 },
                JsonEvent.BeginArray -> { open += 1 },
                JsonEvent.EndObject -> { open -= 1 },
                JsonEvent.EndArray -> { open -= 1 },
                JsonEvent.Key(_) -> {},
                _ -> {},
            }
            if open == 0 {
                return Result.Ok(())
            }
        }
    }

    // The next value as a tree (for a field of any shape).
    public func read_value(self) -> Result[Json, DecodeError] {
        let first = self.event()?
        self.tree(first)
    }

    func tree(self, first: JsonEvent) -> Result[Json, DecodeError] {
        match first {
            JsonEvent.Null -> Result.Ok(Json.Null),
            JsonEvent.Bool(b) -> Result.Ok(Json.Bool(b)),
            JsonEvent.Int(n) -> Result.Ok(Json.Int(n)),
            JsonEvent.Float(x) -> Result.Ok(Json.Float(x)),
            JsonEvent.Str(s) -> Result.Ok(Json.Str(s)),
            JsonEvent.BeginArray -> {
                let items: [Json] = []
                loop {
                    let e = self.event()?
                    match e {
                        JsonEvent.EndArray -> return Result.Ok(Json.Arr(items)),
                        _ -> items.push(self.tree(e)?),
                    }
                }
            },
            JsonEvent.BeginObject -> {
                let o = JsonObject.new()
                loop {
                    match self.event()? {
                        JsonEvent.EndObject -> return Result.Ok(Json.Obj(o)),
                        JsonEvent.Key(k) -> {
                            let e = self.event()?
                            o.set(k, self.tree(e)?);
                        },
                        e -> return Result.Err(self.wrong("a key", e)),
                    }
                }
            },
            e -> Result.Err(self.wrong("a value", e)),
        }
    }

    // The end of the document: only white space after its value.
    public func finish(self) -> Result[(), DecodeError] {
        match self.event()? {
            JsonEvent.End -> Result.Ok(()),
            e -> Result.Err(self.wrong("the end of the document", e)),
        }
    }

    // A member the decoder needs was not in the object just read
    // (`r.missing_field("id")`), reported at the object's end.
    public func missing_field(self, name: str) -> DecodeError {
        self.error_here(DecodeErrorKind.MissingField(name.to_string()))
    }

    // A member the decoder does not know (for a strict decoder; a lenient
    // one calls `skip`).
    public func unknown_field(self, name: String) -> DecodeError {
        self.error_here(DecodeErrorKind.UnknownField(name))
    }
}

// The kind of a value an event starts, for an error.
func event_kind(e: JsonEvent) -> str {
    match e {
        JsonEvent.BeginObject -> "an object",
        JsonEvent.EndObject -> "the end of an object",
        JsonEvent.BeginArray -> "an array",
        JsonEvent.EndArray -> "the end of an array",
        JsonEvent.Key(_) -> "a key",
        JsonEvent.Null -> "null",
        JsonEvent.Bool(_) -> "a boolean",
        JsonEvent.Int(_) -> "an integer",
        JsonEvent.Float(_) -> "a float",
        JsonEvent.Str(_) -> "a string",
        JsonEvent.End -> "the end of the document",
    }
}

// `.key`, or `["key"]` (escaped as JSON) when `key` is not an identifier.
func path_key(key: String) -> String {
    let n = key.len()
    var plain = n > 0
    var i: usize = 0
    while i < n && plain {
        let b = key.byte_at(i)
        let letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
        plain = letter || (i > 0 && is_digit(b))
        i += 1
    }
    if plain {
        return ".".to_string() + key
    }
    "[".to_string() + to_string(Json.Str(key)) + "]"
}

// Why a typed decoder could not make its value.
public enum DecodeErrorKind {
    // The text is not JSON.
    Syntax(JsonErrorKind)
    // The value is of another kind: what was expected, what was found.
    WrongType(str, str)
    // An object lacks a member the type needs.
    MissingField(String)
    // An object has a member the type does not know (strict decoders).
    UnknownField(String)
    // A number outside the range of the field's type.
    OutOfRange
    // The decoder's own reason.
    Custom(String)
}

// Where and why typed decoding failed: the JSONPath of the value (see
// `JsonReader.path`) and the byte offset, line and column where it starts
// (for a syntax error: where the text goes wrong).
public struct DecodeError {
    public kind: DecodeErrorKind,
    public path: String,
    public offset: usize,
    public line: usize,
    public column: usize,
}

extend DecodeError {
    // "<reason> at <path>, line L, column C (byte B)".
    public func message(self) -> String {
        let reason = match self.kind {
            DecodeErrorKind.Syntax(kind) -> JsonError { kind: kind, offset: 0, line: 0, column: 0 }.reason().to_string(),
            DecodeErrorKind.WrongType(expected, found) -> "expected ".to_string() + expected + ", found " + found,
            DecodeErrorKind.MissingField(name) -> f"missing field `{name}`",
            DecodeErrorKind.UnknownField(name) -> f"unknown field `{name}`",
            DecodeErrorKind.OutOfRange -> "number out of range".to_string(),
            DecodeErrorKind.Custom(text) -> text,
        }
        let path = self.path
        let line = self.line
        let column = self.column
        let offset = self.offset
        reason + f" at {path}, line {line}, column {column} (byte {offset})"
    }
}
