// std/collections/set.code
// Hash set — an unordered collection of unique elements.
// Implemented as a thin wrapper around Dict[T, bool].

// ─────────────────────────────────────────────────────────────────────────────
// SetEntry — internal bucket for the hash set.
// ─────────────────────────────────────────────────────────────────────────────

struct SetEntry[T] {
    value: T,
    hash:  u64,
    state: u8,   // 0 = empty, 1 = occupied, 2 = tombstone
}

let SET_EMPTY:     u8 = 0;
let SET_OCCUPIED:  u8 = 1;
let SET_TOMBSTONE: u8 = 2;

// ─────────────────────────────────────────────────────────────────────────────
// Set[T] — generic hash set.
// ─────────────────────────────────────────────────────────────────────────────

class Set[T] {
    buckets:    Pointer[SetEntry[T]],
    num_buckets: usize,
    len:         usize,
    load_max:    f64,
}

// ── Construction ─────────────────────────────────────────────────────────────

/// Creates an empty set with a default initial capacity of 16.
public func set_new[T]() -> Set[T] {
    return set_with_capacity[T](16);
}

/// Creates an empty set pre-allocated for at least `cap` elements.
public func set_with_capacity[T](cap: usize) -> Set[T] {
    let num = next_power_of_two(cap);
    let buckets = heap_alloc[SetEntry[T]](num);
    let i: usize = 0;
    while i < num {
        raw_store(buckets, i, SetEntry[T] { value: zero_value[T](), hash: 0, state: SET_EMPTY });
        i = i + 1;
    }
    return Set[T] { buckets: buckets, num_buckets: num, len: 0, load_max: 0.75 };
}

/// Creates a set from a list of elements.
public func set_from_list[T](items: List[T]) -> Set[T] {
    let s = set_with_capacity[T](items.len);
    let i: usize = 0;
    while i < items.len {
        s = add(s, get(items, i));
        i = i + 1;
    }
    return s;
}

// ── Internal ─────────────────────────────────────────────────────────────────

func set_rehash[T](self: Set[T]) -> Set[T] {
    let new_num = self.num_buckets * 2;
    let new_buckets = heap_alloc[SetEntry[T]](new_num);
    let i: usize = 0;
    while i < new_num {
        raw_store(new_buckets, i, SetEntry[T] { value: zero_value[T](), hash: 0, state: SET_EMPTY });
        i = i + 1;
    }
    i = 0;
    while i < self.num_buckets {
        let e = raw_load(self.buckets, i);
        if e.state == SET_OCCUPIED {
            let idx = (e.hash as usize) & (new_num - 1);
            while raw_load(new_buckets, idx).state == SET_OCCUPIED {
                idx = (idx + 1) & (new_num - 1);
            }
            raw_store(new_buckets, idx, e);
        }
        i = i + 1;
    }
    heap_free(self.buckets);
    return Set[T] { buckets: new_buckets, num_buckets: new_num, len: self.len, load_max: self.load_max };
}

// ── Core API ─────────────────────────────────────────────────────────────────

/// Number of elements in the set.
public func len[T](self: Set[T]) -> usize {
    return self.len;
}

/// Returns true if the set has no elements.
public func is_empty[T](self: Set[T]) -> bool {
    return self.len == 0;
}

/// Adds `value` to the set. No-op if already present.
public func add[T](self: Set[T], value: T) -> Set[T] {
    let out = self;
    let load = (out.len + 1) as f64 / out.num_buckets as f64;
    if load > out.load_max {
        out = set_rehash[T](out);
    }
    let h = hash_of(value);
    let idx = (h as usize) & (out.num_buckets - 1);
    while true {
        let e = raw_load(out.buckets, idx);
        if e.state == SET_EMPTY || e.state == SET_TOMBSTONE {
            raw_store(out.buckets, idx, SetEntry[T] { value: value, hash: h, state: SET_OCCUPIED });
            out.len = out.len + 1;
            return out;
        }
        if e.state == SET_OCCUPIED && e.hash == h && e.value == value {
            return out; // already present
        }
        idx = (idx + 1) & (out.num_buckets - 1);
    }
    return out;
}

/// Removes `value` from the set. Returns (set, true) if it was present.
public func remove[T](self: Set[T], value: T) -> (Set[T], bool) {
    let h = hash_of(value);
    let idx = (h as usize) & (self.num_buckets - 1);
    while true {
        let e = raw_load(self.buckets, idx);
        if e.state == SET_EMPTY {
            return (self, false);
        }
        if e.state == SET_OCCUPIED && e.hash == h && e.value == value {
            raw_store(self.buckets, idx, SetEntry[T] { value: e.value, hash: 0, state: SET_TOMBSTONE });
            let out = self;
            out.len = out.len - 1;
            return (out, true);
        }
        idx = (idx + 1) & (self.num_buckets - 1);
    }
    return (self, false);
}

/// Returns true if `value` is in the set.
public func contains[T](self: Set[T], value: T) -> bool {
    let h = hash_of(value);
    let idx = (h as usize) & (self.num_buckets - 1);
    while true {
        let e = raw_load(self.buckets, idx);
        if e.state == SET_EMPTY {
            return false;
        }
        if e.state == SET_OCCUPIED && e.hash == h && e.value == value {
            return true;
        }
        idx = (idx + 1) & (self.num_buckets - 1);
    }
    return false;
}

/// Removes all elements.
public func clear[T](self: Set[T]) -> Set[T] {
    let i: usize = 0;
    while i < self.num_buckets {
        raw_store(self.buckets, i, SetEntry[T] { value: zero_value[T](), hash: 0, state: SET_EMPTY });
        i = i + 1;
    }
    let out = self;
    out.len = 0;
    return out;
}

// ── Set operations ───────────────────────────────────────────────────────────

/// Returns a new set containing all elements in either `a` or `b`.
public func union[T](a: Set[T], b: Set[T]) -> Set[T] {
    let out = set_with_capacity[T](a.len + b.len);
    let i: usize = 0;
    while i < a.num_buckets {
        let e = raw_load(a.buckets, i);
        if e.state == SET_OCCUPIED {
            out = add(out, e.value);
        }
        i = i + 1;
    }
    i = 0;
    while i < b.num_buckets {
        let e = raw_load(b.buckets, i);
        if e.state == SET_OCCUPIED {
            out = add(out, e.value);
        }
        i = i + 1;
    }
    return out;
}

/// Returns a new set containing only elements in both `a` and `b`.
public func intersection[T](a: Set[T], b: Set[T]) -> Set[T] {
    let out = set_new[T]();
    // Iterate over the smaller set for efficiency
    let i: usize = 0;
    while i < a.num_buckets {
        let e = raw_load(a.buckets, i);
        if e.state == SET_OCCUPIED {
            if contains(b, e.value) {
                out = add(out, e.value);
            }
        }
        i = i + 1;
    }
    return out;
}

/// Returns a new set containing elements in `a` but not in `b`.
public func difference[T](a: Set[T], b: Set[T]) -> Set[T] {
    let out = set_new[T]();
    let i: usize = 0;
    while i < a.num_buckets {
        let e = raw_load(a.buckets, i);
        if e.state == SET_OCCUPIED {
            if !contains(b, e.value) {
                out = add(out, e.value);
            }
        }
        i = i + 1;
    }
    return out;
}

/// Returns elements in either `a` or `b` but not both.
public func symmetric_difference[T](a: Set[T], b: Set[T]) -> Set[T] {
    let out = set_new[T]();
    let i: usize = 0;
    while i < a.num_buckets {
        let e = raw_load(a.buckets, i);
        if e.state == SET_OCCUPIED {
            if !contains(b, e.value) {
                out = add(out, e.value);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < b.num_buckets {
        let e = raw_load(b.buckets, i);
        if e.state == SET_OCCUPIED {
            if !contains(a, e.value) {
                out = add(out, e.value);
            }
        }
        i = i + 1;
    }
    return out;
}

/// Returns true if every element of `a` is also in `b`.
public func is_subset[T](a: Set[T], b: Set[T]) -> bool {
    if a.len > b.len {
        return false;
    }
    let i: usize = 0;
    while i < a.num_buckets {
        let e = raw_load(a.buckets, i);
        if e.state == SET_OCCUPIED {
            if !contains(b, e.value) {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

/// Returns true if every element of `b` is also in `a`.
public func is_superset[T](a: Set[T], b: Set[T]) -> bool {
    return is_subset(b, a);
}

/// Returns true if `a` and `b` share no elements.
public func is_disjoint[T](a: Set[T], b: Set[T]) -> bool {
    let i: usize = 0;
    while i < a.num_buckets {
        let e = raw_load(a.buckets, i);
        if e.state == SET_OCCUPIED {
            if contains(b, e.value) {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

// ── Conversion ───────────────────────────────────────────────────────────────

/// Returns a List of all elements in the set (unordered).
public func to_list[T](self: Set[T]) -> List[T] {
    let out = list_with_capacity[T](self.len);
    let i: usize = 0;
    while i < self.num_buckets {
        let e = raw_load(self.buckets, i);
        if e.state == SET_OCCUPIED {
            out = push(out, e.value);
        }
        i = i + 1;
    }
    return out;
}

// ── Iteration ────────────────────────────────────────────────────────────────

struct SetIter[T] {
    set: Set[T],
    pos: usize,
}

/// Returns an iterator over the set elements.
public func iter[T](self: Set[T]) -> SetIter[T] {
    return SetIter[T] { set: self, pos: 0 };
}

/// Advances the iterator.
public func iter_next[T](it: SetIter[T]) -> (SetIter[T], Optional[T]) {
    let pos = it.pos;
    while pos < it.set.num_buckets {
        let e = raw_load(it.set.buckets, pos);
        if e.state == SET_OCCUPIED {
            let next = SetIter[T] { set: it.set, pos: pos + 1 };
            return (next, some(e.value));
        }
        pos = pos + 1;
    }
    let done = SetIter[T] { set: it.set, pos: pos };
    return (done, none[T]());
}

// ── Cleanup ──────────────────────────────────────────────────────────────────

public func drop[T](self: Set[T]) {
    if self.num_buckets > 0 {
        heap_free(self.buckets);
    }
}
