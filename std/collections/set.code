// std/collections/set.code
// Set[T]: a hash set, on `Map[T, bool]` (std.collections.map).
//
//     import std.collections.set.{Set}
//
//     let seen: Set[i64] = Set.new()
//     if seen.insert(7) { println("new") }
//     println(seen.contains(7))
//
// Elements need `Hashable` (std.hashlib.hash) and `Eq` (std.cmp.cmp); every
// integer and float type, `bool` and `str` have both. Expected O(1)
// insertion, lookup and removal.
//
// NOT DoS-RESISTANT, like `Map`: whoever chooses the elements can make
// them collide.

import root.hashlib.hash.{Hashable};
import root.cmp.cmp.{Eq};
import root.collections.map.{Map};

public class Set[T] {
    entries: Map[T, bool],
}

extend Set[T: Hashable + Eq] {
    // An empty set.
    public func new() -> Set[T] {
        Set { entries: Map.new() }
    }

    // A set of the elements of `items`.
    public func from_array(items: [T]) -> Set[T] {
        let set: Set[T] = Set.new()
        for item in items {
            set.entries.insert(item, true);
        }
        set
    }

    // The number of elements.
    public func len(self) -> usize {
        self.entries.len()
    }

    public func is_empty(self) -> bool {
        self.entries.len() == 0
    }

    // Adds `value`; returns whether it was not in the set yet.
    public func insert(self, value: T) -> bool {
        self.entries.insert(value, true) == nil
    }

    public func contains(self, value: T) -> bool {
        self.entries.contains_key(value)
    }

    // Removes `value`; returns whether it was in the set.
    public func remove(self, value: T) -> bool {
        self.entries.remove(value) != nil
    }

    public func clear(self) {
        self.entries.clear()
    }

    // Every element, in table order (which is not insertion order).
    public func to_array(self) -> [T] {
        self.entries.keys()
    }

    // The elements in `self`, in `other`, or in both.
    public func union(self, other: Set[T]) -> Set[T] {
        let out = Set.from_array(self.to_array())
        for value in other.to_array() {
            out.entries.insert(value, true);
        }
        out
    }

    // The elements in both `self` and `other`.
    public func intersection(self, other: Set[T]) -> Set[T] {
        let out: Set[T] = Set.new()
        for value in self.to_array() {
            if other.contains(value) {
                out.entries.insert(value, true);
            }
        }
        out
    }

    // The elements in `self` but not in `other`.
    public func difference(self, other: Set[T]) -> Set[T] {
        let out: Set[T] = Set.new()
        for value in self.to_array() {
            if !other.contains(value) {
                out.entries.insert(value, true);
            }
        }
        out
    }

    // Whether every element of `self` is in `other`.
    public func is_subset(self, other: Set[T]) -> bool {
        self.to_array().all(func(value) { other.contains(value) })
    }
}
