// std/collections/span.code
// Span[T] — a non-owning, read-only view over contiguous memory.
// Zero-cost abstraction: just a pointer and a length on the stack.
// Does NOT own the underlying data — the caller must ensure the data outlives the span.

// ─────────────────────────────────────────────────────────────────────────────
// Span[T] — immutable view.
// ─────────────────────────────────────────────────────────────────────────────

struct Span[T] {
    ptr: Pointer[T],
    len: usize,
}

// ─────────────────────────────────────────────────────────────────────────────
// MutableSpan[T] — mutable view.
// ─────────────────────────────────────────────────────────────────────────────

struct MutableSpan[T] {
    ptr: Pointer[T],
    len: usize,
}

// ── Construction ─────────────────────────────────────────────────────────────

/// Creates a Span from a raw pointer and length.
public func span_from_raw[T](ptr: Pointer[T], len: usize) -> Span[T] {
    return Span[T] { ptr: ptr, len: len };
}

/// Creates a Span over an entire List (borrows, does not copy).
public func span_from_list[T](list: List[T]) -> Span[T] {
    return Span[T] { ptr: list.buf.ptr, len: list.len };
}

/// Creates a MutableSpan from a raw pointer and length.
public func mutable_span_from_raw[T](ptr: Pointer[T], len: usize) -> MutableSpan[T] {
    return MutableSpan[T] { ptr: ptr, len: len };
}

/// Creates an empty span.
public func span_empty[T]() -> Span[T] {
    return Span[T] { ptr: null_ptr(), len: 0 };
}

// ── Core API (immutable) ─────────────────────────────────────────────────────

/// Returns the number of elements in the span.
public func span_len[T](this: Span[T]) -> usize {
    return this.len;
}

/// Returns true if the span has zero elements.
public func span_is_empty[T](this: Span[T]) -> bool {
    return this.len == 0;
}

/// Returns the element at `index`. Panics if out of bounds.
public func span_get[T](this: Span[T], index: usize) -> T {
    if index >= this.len {
        panic("Span.get: index out of bounds");
    }
    return raw_load(this.ptr, index);
}

/// Returns the first element. Panics if empty.
public func span_first[T](this: Span[T]) -> T {
    return span_get(this, 0);
}

/// Returns the last element. Panics if empty.
public func span_last[T](this: Span[T]) -> T {
    return span_get(this, this.len - 1);
}

// ── Slicing ──────────────────────────────────────────────────────────────────

/// Returns a sub-span from `start` (inclusive) to `end` (exclusive).
public func span_slice[T](this: Span[T], start: usize, end: usize) -> Span[T] {
    if start > end {
        panic("Span.slice: start > end");
    }
    if end > this.len {
        panic("Span.slice: end out of bounds");
    }
    return Span[T] { ptr: ptr_offset(this.ptr, start), len: end - start };
}

/// Returns a sub-span from `start` to the end.
public func span_slice_from[T](this: Span[T], start: usize) -> Span[T] {
    return span_slice(this, start, this.len);
}

/// Returns a sub-span from the beginning up to `end` (exclusive).
public func span_slice_to[T](this: Span[T], end: usize) -> Span[T] {
    return span_slice(this, 0, end);
}

// ── Core API (mutable) ──────────────────────────────────────────────────────

/// Returns the number of elements in the mutable span.
public func mspan_len[T](this: MutableSpan[T]) -> usize {
    return this.len;
}

/// Returns the element at `index`.
public func mspan_get[T](this: MutableSpan[T], index: usize) -> T {
    if index >= this.len {
        panic("MutableSpan.get: index out of bounds");
    }
    return raw_load(this.ptr, index);
}

/// Sets the element at `index`.
public func mspan_set[T](this: MutableSpan[T], index: usize, value: T) {
    if index >= this.len {
        panic("MutableSpan.set: index out of bounds");
    }
    raw_store(this.ptr, index, value);
}

/// Returns a sub-slice of the mutable span.
public func mspan_slice[T](this: MutableSpan[T], start: usize, end: usize) -> MutableSpan[T] {
    if start > end || end > this.len {
        panic("MutableSpan.slice: invalid range");
    }
    return MutableSpan[T] { ptr: ptr_offset(this.ptr, start), len: end - start };
}

/// Fills the entire mutable span with `value`.
public func mspan_fill[T](this: MutableSpan[T], value: T) {
    let i: usize = 0;
    while i < this.len {
        raw_store(this.ptr, i, value);
        i = i + 1;
    }
}

// ── Searching ────────────────────────────────────────────────────────────────

/// Returns true if any element in the span equals `value`.
public func span_contains[T](this: Span[T], value: T) -> bool {
    let i: usize = 0;
    while i < this.len {
        if raw_load(this.ptr, i) == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Returns the index of `value` in the span, or -1 if not found.
public func span_index_of[T](this: Span[T], value: T) -> isize {
    let i: usize = 0;
    while i < this.len {
        if raw_load(this.ptr, i) == value {
            return i as isize;
        }
        i = i + 1;
    }
    return -1;
}

// ── Copying ──────────────────────────────────────────────────────────────────

/// Copies elements from `src` into `dst`. Both must have the same length.
public func span_copy_into[T](src: Span[T], dst: MutableSpan[T]) {
    if src.len != dst.len {
        panic("span_copy_into: length mismatch");
    }
    let i: usize = 0;
    while i < src.len {
        raw_store(dst.ptr, i, raw_load(src.ptr, i));
        i = i + 1;
    }
}

// ── Iteration ────────────────────────────────────────────────────────────────

struct SpanIter[T] {
    span: Span[T],
    pos:  usize,
}

/// Returns a forward iterator over the span.
public func span_iter[T](this: Span[T]) -> SpanIter[T] {
    return SpanIter[T] { span: this, pos: 0 };
}

/// Advances the iterator, returning the next element or none.
public func span_iter_next[T](it: SpanIter[T]) -> (SpanIter[T], Optional[T]) {
    if it.pos >= it.span.len {
        return (it, none());
    }
    let val = raw_load(it.span.ptr, it.pos);
    let next = SpanIter[T] { span: it.span, pos: it.pos + 1 };
    return (next, some(val));
}

// ── Comparison ───────────────────────────────────────────────────────────────

/// Returns true if two spans have identical contents.
public func span_equals[T](a: Span[T], b: Span[T]) -> bool {
    if a.len != b.len {
        return false;
    }
    let i: usize = 0;
    while i < a.len {
        if raw_load(a.ptr, i) != raw_load(b.ptr, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Returns true if `self` begins with the elements from `prefix`.
public func span_starts_with[T](this: Span[T], prefix: Span[T]) -> bool {
    if prefix.len > this.len {
        return false;
    }
    return span_equals(span_slice_to(this, prefix.len), prefix);
}

/// Returns true if `self` ends with the elements from `suffix`.
public func span_ends_with[T](this: Span[T], suffix: Span[T]) -> bool {
    if suffix.len > this.len {
        return false;
    }
    return span_equals(span_slice_from(this, this.len - suffix.len), suffix);
}
