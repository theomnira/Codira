// std/collections/string.code
// Helpers on top of `String`, the language's own string type.
//
// `String` itself is built into the compiler and the runtime: every program
// has it without an import, with its methods (`len`, `find`, `split`,
// `trim`, `slice`, `replace`, `parse_i64`, ...), its operators (`+`, `+=`,
// `==`, `<`) and `to_string()` on the primitive types. This module adds
// what is written in Codira on top of those: joining, inserting, removing,
// reversing, counting and making a string from code points or bytes.
//
// Every function returns valid UTF-8 and checks every index it is given.

// ---------------------------------------------------------------------------
// Construction
// ---------------------------------------------------------------------------

// A new, empty string.
public func string_new() -> String {
    return "".to_string();
}

// The string the bytes spell, or `nil` when they are not valid UTF-8. The
// bytes are copied: the array stays the caller's to change.
public func string_from_bytes(bytes: [u8]) -> String? {
    return string_from_utf8(bytes);
}

// The one-character string of a Unicode scalar value, or `nil` for a
// surrogate (U+D800..U+DFFF) or a value above U+10FFFF.
public func string_from_code_point(cp: u32) -> String? {
    if cp < 0x80 {
        return string_from_utf8([cp as u8]);
    }
    if cp < 0x800 {
        return string_from_utf8([(0xC0 | (cp >> 6)) as u8, (0x80 | (cp & 0x3F)) as u8]);
    }
    if cp < 0x10000 {
        return string_from_utf8([
            (0xE0 | (cp >> 12)) as u8,
            (0x80 | ((cp >> 6) & 0x3F)) as u8,
            (0x80 | (cp & 0x3F)) as u8,
        ]);
    }
    return string_from_utf8([
        (0xF0 | (cp >> 18)) as u8,
        (0x80 | ((cp >> 12) & 0x3F)) as u8,
        (0x80 | ((cp >> 6) & 0x3F)) as u8,
        (0x80 | (cp & 0x3F)) as u8,
    ]);
}

// The string of the code points in `cps`, or `nil` if one is not a Unicode
// scalar value.
public func string_from_code_points(cps: [u32]) -> String? {
    var out = "".to_string();
    for cp in cps {
        if let piece = string_from_code_point(cp) {
            out += piece;
        } else {
            return nil;
        }
    }
    return out;
}

// ---------------------------------------------------------------------------
// Combining
// ---------------------------------------------------------------------------

// The parts with `separator` between each two.
public func join(separator: String, parts: [String]) -> String {
    var out = "".to_string();
    var i: usize = 0;
    while i < parts.len() {
        if i > 0 {
            out += separator;
        }
        out += parts[i];
        i += 1;
    }
    return out;
}

// `s` with `other` inserted at byte `index`, which must be a character
// boundary in `0..=s.len()` (or the program panics, as `slice` does).
public func insert(s: String, index: usize, other: String) -> String {
    return s.slice(0, index) + other + s.slice(index, s.len());
}

// `s` without the bytes `start..end`, which must be a valid slice.
public func remove(s: String, start: usize, end: usize) -> String {
    return s.slice(0, start) + s.slice(end, s.len());
}

// The bytes `start..end` of `s` (a view, as `s.slice(start, end)`).
public func substring(s: String, start: usize, end: usize) -> String {
    return s.slice(start, end);
}

// `s` with its characters (code points) in reverse order.
public func reverse(s: String) -> String {
    let cps = s.chars();
    var out = "".to_string();
    var i = cps.len();
    while i > 0 {
        i -= 1;
        out += string_from_code_point(cps[i])!;
    }
    return out;
}

// ---------------------------------------------------------------------------
// Inspecting
// ---------------------------------------------------------------------------

// How many times `needle` occurs in `s`, without overlaps. An empty needle
// occurs between every two characters and at both ends.
public func count(s: String, needle: String) -> usize {
    if needle.is_empty() {
        return s.char_count() + 1;
    }
    return s.split(needle).len() - 1;
}

// -1, 0 or 1 as `a` sorts before, equal to or after `b` (by bytes, which
// for UTF-8 is by code points).
public func compare(a: String, b: String) -> i32 {
    if a < b {
        return -1;
    }
    if a == b {
        return 0;
    }
    return 1;
}

// Whether the two strings are equal.
public func equals(a: String, b: String) -> bool {
    return a == b;
}

// The pieces of `s` between runs of ASCII white space (space, tab, line
// feed, carriage return), with no empty pieces. The pieces share `s`'s
// buffer.
public func split_whitespace(s: String) -> [String] {
    let starts = array_filled(0usize, s.len() / 2 + 1);
    let ends = array_filled(0usize, s.len() / 2 + 1);
    var n: usize = 0;
    var i: usize = 0;
    while i < s.len() {
        while i < s.len() && is_ascii_space(s.byte_at(i)) {
            i += 1;
        }
        if i == s.len() {
            break;
        }
        let start = i;
        while i < s.len() && !is_ascii_space(s.byte_at(i)) {
            i += 1;
        }
        starts[n] = start;
        ends[n] = i;
        n += 1;
    }
    if n == 0 {
        return "".to_string().lines();
    }
    // A `[String]` of `n` elements, overwritten below: there is no array
    // constructor for strings, and the pieces of `n - 1` commas are `n`.
    let pieces = ",".repeat(n - 1).split(",");
    var k: usize = 0;
    while k < n {
        pieces[k] = s.slice(starts[k], ends[k]);
        k += 1;
    }
    return pieces;
}

func is_ascii_space(b: u8) -> bool {
    return b == 32u8 || b == 9u8 || b == 10u8 || b == 13u8;
}
