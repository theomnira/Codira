// std/collections/array.code
// InlineArray[T, N] — fixed-size, stack-allocated array.
// Size is known at compile time. No heap allocation.
// Analogous to [T; N] in Rust or std::array in C++.

// ─────────────────────────────────────────────────────────────────────────────
// InlineArray[T, N] — value-semantic, fixed-size array.
// N is a compile-time constant representing the number of elements.
// ─────────────────────────────────────────────────────────────────────────────

public struct InlineArray[T, N: usize] {
    data: FixedBuf[T, N],   // compiler-intrinsic fixed buffer
}

// ── Construction ─────────────────────────────────────────────────────────────

/// Creates a new InlineArray with all elements set to `value`.
public func inline_array_new[T, N: usize](value: T) -> InlineArray[T, N] {
    let arr = InlineArray[T, N] { data: uninit_fixed_buf() };
    let i: usize = 0;
    while i < N {
        fixed_buf_store(arr.data, i, value);
        i = i + 1;
    }
    return arr;
}

/// Creates an InlineArray with every element set to the zero/default value.
public func inline_array_zeroed[T, N: usize]() -> InlineArray[T, N] {
    return inline_array_new(zero_value());
}

// ── Core API ─────────────────────────────────────────────────────────────────

/// Returns the compile-time length of the array.
public func len[T, N: usize](this: InlineArray[T, N]) -> usize {
    return N;
}

/// Returns true if the array has zero elements (only when N == 0).
public func is_empty[T, N: usize](this: InlineArray[T, N]) -> bool {
    return N == 0;
}

/// Returns the element at `index`. Panics if out of bounds.
public func get[T, N: usize](this: InlineArray[T, N], index: usize) -> T {
    if index >= N {
        panic("InlineArray.get: index out of bounds");
    }
    return fixed_buf_load(this.data, index);
}

/// Sets the element at `index` to `value`. Panics if out of bounds.
public func set[T, N: usize](this: InlineArray[T, N], index: usize, value: T) -> InlineArray[T, N] {
    if index >= N {
        panic("InlineArray.set: index out of bounds");
    }
    let out = this;
    fixed_buf_store(out.data, index, value);
    return out;
}

/// Returns the first element. Panics if N == 0.
public func first[T, N: usize](this: InlineArray[T, N]) -> T {
    return get(this, 0);
}

/// Returns the last element. Panics if N == 0.
public func last[T, N: usize](this: InlineArray[T, N]) -> T {
    return get(this, N - 1);
}

// ── Fill ─────────────────────────────────────────────────────────────────────

/// Sets every element to `value`.
public func fill[T, N: usize](this: InlineArray[T, N], value: T) -> InlineArray[T, N] {
    let out = this;
    let i: usize = 0;
    while i < N {
        fixed_buf_store(out.data, i, value);
        i = i + 1;
    }
    return out;
}

/// Sets every element using a generator function: `f(index)`.
public func fill_with[T, N: usize](this: InlineArray[T, N], f: func(usize) -> T) -> InlineArray[T, N] {
    let out = this;
    let i: usize = 0;
    while i < N {
        fixed_buf_store(out.data, i, f(i));
        i = i + 1;
    }
    return out;
}

// ── Search ───────────────────────────────────────────────────────────────────

/// Returns true if any element equals `value`.
public func contains[T, N: usize](this: InlineArray[T, N], value: T) -> bool {
    let i: usize = 0;
    while i < N {
        if fixed_buf_load(this.data, i) == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Returns the index of the first occurrence of `value`, or -1.
public func index_of[T, N: usize](this: InlineArray[T, N], value: T) -> isize {
    let i: usize = 0;
    while i < N {
        if fixed_buf_load(this.data, i) == value {
            return i as isize;
        }
        i = i + 1;
    }
    return -1;
}

// ── Functional ───────────────────────────────────────────────────────────────

/// Applies `f` to every element in-place.
public func map_in_place[T, N: usize](this: InlineArray[T, N], f: func(T) -> T) -> InlineArray[T, N] {
    let out = this;
    let i: usize = 0;
    while i < N {
        fixed_buf_store(out.data, i, f(fixed_buf_load(out.data, i)));
        i = i + 1;
    }
    return out;
}

/// Reduces all elements into a single value.
public func reduce[T, U, N: usize](this: InlineArray[T, N], init: U, f: func(U, T) -> U) -> U {
    let acc = init;
    let i: usize = 0;
    while i < N {
        acc = f(acc, fixed_buf_load(this.data, i));
        i = i + 1;
    }
    return acc;
}

// ── Iteration ────────────────────────────────────────────────────────────────

public struct InlineArrayIter[T, N: usize] {
    arr: InlineArray[T, N],
    pos: usize,
}

/// Returns a forward iterator.
public func iter[T, N: usize](this: InlineArray[T, N]) -> InlineArrayIter[T, N] {
    return InlineArrayIter[T, N] { arr: this, pos: 0 };
}

/// Advances the iterator.
public func iter_next[T, N: usize](it: InlineArrayIter[T, N]) -> (InlineArrayIter[T, N], Optional[T]) {
    if it.pos >= N {
        return (it, none());
    }
    let val = fixed_buf_load(it.arr.data, it.pos);
    let next = InlineArrayIter[T, N] { arr: it.arr, pos: it.pos + 1 };
    return (next, some(val));
}

// ── Conversion ───────────────────────────────────────────────────────────────

/// Copies the array into a new List[T].
public func to_list[T, N: usize](this: InlineArray[T, N]) -> List[T] {
    let out = list_with_capacity(N);
    let i: usize = 0;
    while i < N {
        out = push(out, fixed_buf_load(this.data, i));
        i = i + 1;
    }
    return out;
}

/// Returns a Span[T] view over the array.
public func as_span[T, N: usize](this: InlineArray[T, N]) -> Span[T] {
    return span_from_raw(fixed_buf_ptr(this.data), N);
}

// ── Comparison ───────────────────────────────────────────────────────────────

/// Returns true if two arrays have identical elements.
public func array_equals[T, N: usize](a: InlineArray[T, N], b: InlineArray[T, N]) -> bool {
    let i: usize = 0;
    while i < N {
        if fixed_buf_load(a.data, i) != fixed_buf_load(b.data, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ── Swap ─────────────────────────────────────────────────────────────────────

/// Swaps the elements at indices `i` and `j`.
public func swap[T, N: usize](this: InlineArray[T, N], i: usize, j: usize) -> InlineArray[T, N] {
    if i >= N || j >= N {
        panic("InlineArray.swap: index out of bounds");
    }
    let out = this;
    let tmp = fixed_buf_load(out.data, i);
    fixed_buf_store(out.data, i, fixed_buf_load(out.data, j));
    fixed_buf_store(out.data, j, tmp);
    return out;
}

/// Reverses the array in-place.
public func reverse[T, N: usize](this: InlineArray[T, N]) -> InlineArray[T, N] {
    let out = this;
    let lo: usize = 0;
    let hi: usize = N;
    if hi == 0 {
        return out;
    }
    hi = hi - 1;
    while lo < hi {
        let tmp = fixed_buf_load(out.data, lo);
        fixed_buf_store(out.data, lo, fixed_buf_load(out.data, hi));
        fixed_buf_store(out.data, hi, tmp);
        lo = lo + 1;
        hi = hi - 1;
    }
    return out;
}
