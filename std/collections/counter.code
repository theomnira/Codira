// std/collections/counter.code
// Counter[T]: counts occurrences of values (a multiset), on
// `Map[T, usize]` (std.collections.map). Like Python's
// `collections.Counter`.
//
//     import std.collections.counter.{Counter}
//
//     let words = Counter.from_array(["a", "b", "a"])
//     println(words.count("a"))        // 2
//
// Values need `Hashable` (std.hashlib.hash) and `Eq` (std.cmp.cmp). NOT
// DoS-RESISTANT, like `Map`.

import root.hashlib.hash.{Hashable};
import root.cmp.cmp.{Eq};
import root.collections.map.{Map};

public class Counter[T] {
    counts: Map[T, usize],
    counted: usize,
}

extend Counter[T: Hashable + Eq] {
    // An empty counter.
    public func new() -> Counter[T] {
        Counter { counts: Map.new(), counted: 0 }
    }

    // A counter of every element of `items`.
    public func from_array(items: [T]) -> Counter[T] {
        let counter: Counter[T] = Counter.new()
        for item in items {
            counter.add(item)
        }
        counter
    }

    // Counts `value` once more.
    public func add(self, value: T) {
        self.add_many(value, 1)
    }

    // Counts `value` `times` more times.
    public func add_many(self, value: T, times: usize) {
        let now = self.counts.get_or(value, 0) + times
        self.counts.insert(value, now);
        self.counted += times
    }

    // Counts `value` once less; returns whether it was counted at all.
    public func subtract(self, value: T) -> bool {
        let now = self.counts.get_or(value, 0)
        if now == 0 {
            return false
        }
        if now == 1 {
            self.counts.remove(value);
        } else {
            self.counts.insert(value, now - 1);
        }
        self.counted -= 1
        true
    }

    // How many times `value` was counted (0 when never).
    public func count(self, value: T) -> usize {
        self.counts.get_or(value, 0)
    }

    // The number of distinct values counted.
    public func len(self) -> usize {
        self.counts.len()
    }

    // The sum of every count.
    public func total(self) -> usize {
        self.counted
    }

    // The distinct values counted, in no particular order.
    public func values(self) -> [T] {
        self.counts.keys()
    }

    // A value counted most often (any one of them on a tie), or `nil` when
    // nothing was counted.
    public func most_common(self) -> T? {
        let values = self.counts.keys()
        if values.is_empty() {
            return nil
        }
        var best = values[0]
        var best_count = self.count(best)
        for value in values {
            let n = self.count(value)
            if n > best_count {
                best = value
                best_count = n
            }
        }
        best
    }

    public func clear(self) {
        self.counts.clear()
        self.counted = 0
    }
}
