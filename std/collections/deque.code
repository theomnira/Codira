// std/collections/deque.code
// Deque[T] — double-ended queue backed by a circular (ring) buffer.
// Supports O(1) amortised push/pop at both front and back.

// ─────────────────────────────────────────────────────────────────────────────
// Deque[T]
// ─────────────────────────────────────────────────────────────────────────────

class Deque[T] {
    buf:   Pointer[T],
    cap:   usize,
    head:  usize,   // index of the front element
    tail:  usize,   // index *after* the last element
    len:   usize,
}

// ── Construction ─────────────────────────────────────────────────────────────

/// Creates an empty deque with default capacity (8).
public func deque_new[T]() -> Deque[T] {
    return deque_with_capacity[T](8);
}

/// Creates an empty deque with at least `cap` slots.
public func deque_with_capacity[T](cap: usize) -> Deque[T] {
    let real_cap = next_power_of_two_deque(cap);
    let buf = heap_alloc[T](real_cap);
    return Deque[T] { buf: buf, cap: real_cap, head: 0, tail: 0, len: 0 };
}

func next_power_of_two_deque(n: usize) -> usize {
    let p: usize = 1;
    while p < n {
        p = p * 2;
    }
    return p;
}

// ── Internal ─────────────────────────────────────────────────────────────────

/// Wraps an index within the circular buffer capacity.
func wrap(index: usize, cap: usize) -> usize {
    return index & (cap - 1);
}

/// Grows the ring buffer to double its current capacity, reordering elements.
func deque_grow[T](self: Deque[T]) -> Deque[T] {
    let new_cap = self.cap * 2;
    let new_buf = heap_alloc[T](new_cap);
    // Linearise the old circular buffer into the new buffer
    let i: usize = 0;
    while i < self.len {
        let src_idx = wrap(self.head + i, self.cap);
        raw_store(new_buf, i, raw_load(self.buf, src_idx));
        i = i + 1;
    }
    heap_free(self.buf);
    return Deque[T] { buf: new_buf, cap: new_cap, head: 0, tail: self.len, len: self.len };
}

// ── Core API ─────────────────────────────────────────────────────────────────

/// Returns the number of elements.
public func len[T](self: Deque[T]) -> usize {
    return self.len;
}

/// Returns true if the deque is empty.
public func is_empty[T](self: Deque[T]) -> bool {
    return self.len == 0;
}

/// Returns the front element without removing it. Panics if empty.
public func front[T](self: Deque[T]) -> T {
    if self.len == 0 {
        panic("Deque.front: deque is empty");
    }
    return raw_load(self.buf, self.head);
}

/// Returns the back element without removing it. Panics if empty.
public func back[T](self: Deque[T]) -> T {
    if self.len == 0 {
        panic("Deque.back: deque is empty");
    }
    let idx = wrap(self.tail - 1 + self.cap, self.cap);
    return raw_load(self.buf, idx);
}

// ── Push / Pop ───────────────────────────────────────────────────────────────

/// Pushes an element to the back.
public func push_back[T](self: Deque[T], value: T) -> Deque[T] {
    let out = self;
    if out.len == out.cap {
        out = deque_grow[T](out);
    }
    raw_store(out.buf, out.tail, value);
    out.tail = wrap(out.tail + 1, out.cap);
    out.len = out.len + 1;
    return out;
}

/// Pushes an element to the front.
public func push_front[T](self: Deque[T], value: T) -> Deque[T] {
    let out = self;
    if out.len == out.cap {
        out = deque_grow[T](out);
    }
    out.head = wrap(out.head - 1 + out.cap, out.cap);
    raw_store(out.buf, out.head, value);
    out.len = out.len + 1;
    return out;
}

/// Removes and returns the front element. Panics if empty.
public func pop_front[T](self: Deque[T]) -> (Deque[T], T) {
    if self.len == 0 {
        panic("Deque.pop_front: deque is empty");
    }
    let val = raw_load(self.buf, self.head);
    let out = self;
    out.head = wrap(out.head + 1, out.cap);
    out.len = out.len - 1;
    return (out, val);
}

/// Removes and returns the back element. Panics if empty.
public func pop_back[T](self: Deque[T]) -> (Deque[T], T) {
    if self.len == 0 {
        panic("Deque.pop_back: deque is empty");
    }
    let out = self;
    out.tail = wrap(out.tail - 1 + out.cap, out.cap);
    let val = raw_load(out.buf, out.tail);
    out.len = out.len - 1;
    return (out, val);
}

// ── Element access ───────────────────────────────────────────────────────────

/// Returns the element at logical index `i` (0 = front). Panics if out of bounds.
public func deque_get[T](self: Deque[T], i: usize) -> T {
    if i >= self.len {
        panic("Deque.get: index out of bounds");
    }
    let physical = wrap(self.head + i, self.cap);
    return raw_load(self.buf, physical);
}

/// Sets the element at logical index `i`. Panics if out of bounds.
public func deque_set[T](self: Deque[T], i: usize, value: T) -> Deque[T] {
    if i >= self.len {
        panic("Deque.set: index out of bounds");
    }
    let physical = wrap(self.head + i, self.cap);
    raw_store(self.buf, physical, value);
    return self;
}

// ── Bulk ─────────────────────────────────────────────────────────────────────

/// Removes all elements without freeing the backing buffer.
public func clear[T](self: Deque[T]) -> Deque[T] {
    let out = self;
    out.head = 0;
    out.tail = 0;
    out.len  = 0;
    return out;
}

/// Converts the deque into a List[T] (front-to-back order).
public func deque_to_list[T](self: Deque[T]) -> List[T] {
    let out = list_with_capacity[T](self.len);
    let i: usize = 0;
    while i < self.len {
        out = push(out, deque_get(self, i));
        i = i + 1;
    }
    return out;
}

// ── Iteration ────────────────────────────────────────────────────────────────

struct DequeIter[T] {
    deque: Deque[T],
    pos:   usize,
}

/// Returns a front-to-back iterator.
public func iter[T](self: Deque[T]) -> DequeIter[T] {
    return DequeIter[T] { deque: self, pos: 0 };
}

/// Advances the iterator.
public func iter_next[T](it: DequeIter[T]) -> (DequeIter[T], Optional[T]) {
    if it.pos >= it.deque.len {
        return (it, none[T]());
    }
    let val = deque_get(it.deque, it.pos);
    let next = DequeIter[T] { deque: it.deque, pos: it.pos + 1 };
    return (next, some(val));
}

// ── Cleanup ──────────────────────────────────────────────────────────────────

public func drop[T](self: Deque[T]) {
    if self.cap > 0 {
        heap_free(self.buf);
    }
}
