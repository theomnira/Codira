// std/collections/deque.code
// Deque[T]: a double-ended queue, a ring buffer on a growable array.
//
//     import std.collections.deque.{Deque}
//
//     let q: Deque[i64] = Deque.new()
//     q.push_back(1)
//     q.push_front(0)
//     while let x = q.pop_front() { println(x) }
//
// `push_front`, `push_back`, `pop_front` and `pop_back` are O(1) (amortized:
// a full buffer doubles), `get` is O(1). A `Deque` is a class: assigning or
// passing it shares the one queue.

import root.sys.terminate.{panic};

public class Deque[T] {
    // The ring: element `i` of the queue is `buffer[(head + i) & mask]`.
    // Its length is the capacity, 0 or a power of two; the slots that hold
    // no element hold a copy of one, which is never read (a type parameter
    // has no default value to fill them with).
    buffer: [T],
    head: usize,
    count: usize,
}

extend Deque[T] {
    // An empty queue. It allocates nothing until the first push.
    public func new() -> Deque[T] {
        Deque { buffer: [], head: 0, count: 0 }
    }

    // A queue of the elements of `items`, first to last.
    public func from_array(items: [T]) -> Deque[T] {
        let q: Deque[T] = Deque.new()
        for item in items {
            q.push_back(item)
        }
        q
    }

    // The number of elements.
    public func len(self) -> usize {
        self.count
    }

    public func is_empty(self) -> bool {
        self.count == 0
    }

    // Adds `value` after the last element.
    public func push_back(self, value: T) {
        if self.count == self.buffer.len() {
            self.grow(value)
        }
        let mask = self.buffer.len() - 1
        self.buffer[(self.head + self.count) & mask] = value
        self.count += 1
    }

    // Adds `value` before the first element.
    public func push_front(self, value: T) {
        if self.count == self.buffer.len() {
            self.grow(value)
        }
        let mask = self.buffer.len() - 1
        self.head = (self.head + mask) & mask
        self.buffer[self.head] = value
        self.count += 1
    }

    // Removes and returns the first element, or `nil` when empty.
    public func pop_front(self) -> T? {
        if self.count == 0 {
            return nil
        }
        let value = self.buffer[self.head]
        self.head = (self.head + 1) & (self.buffer.len() - 1)
        self.count -= 1
        value
    }

    // Removes and returns the last element, or `nil` when empty.
    public func pop_back(self) -> T? {
        if self.count == 0 {
            return nil
        }
        self.count -= 1
        self.buffer[(self.head + self.count) & (self.buffer.len() - 1)]
    }

    // The first element, or `nil` when empty.
    public func front(self) -> T? {
        if self.count == 0 { nil } else { self.buffer[self.head] }
    }

    // The last element, or `nil` when empty.
    public func back(self) -> T? {
        if self.count == 0 {
            nil
        } else {
            self.buffer[(self.head + self.count - 1) & (self.buffer.len() - 1)]
        }
    }

    // Element `index` from the front. Panics unless `index < len()`.
    public func get(self, index: usize) -> T {
        if index >= self.count {
            panic("Deque.get: index out of bounds")
        }
        self.buffer[(self.head + index) & (self.buffer.len() - 1)]
    }

    // Replaces element `index` from the front. Panics unless
    // `index < len()`.
    public func set(self, index: usize, value: T) {
        if index >= self.count {
            panic("Deque.set: index out of bounds")
        }
        self.buffer[(self.head + index) & (self.buffer.len() - 1)] = value
    }

    // Removes every element, keeping the buffer.
    public func clear(self) {
        self.head = 0
        self.count = 0
    }

    // The elements, first to last, in a new array.
    public func to_array(self) -> [T] {
        let out: [T] = []
        out.reserve(self.count)
        for index in 0..self.count {
            out.push(self.buffer[(self.head + index) & (self.buffer.len() - 1)])
        }
        out
    }

    // Moves the elements to a buffer twice the size (at least 4), first
    // element first; `filler` fills the free slots.
    func grow(self, filler: T) {
        var size = self.buffer.len() * 2
        if size < 4 {
            size = 4
        }
        let buffer: [T] = []
        buffer.reserve(size)
        for index in 0..self.count {
            buffer.push(self.buffer[(self.head + index) & (self.buffer.len() - 1)])
        }
        while buffer.len() < size {
            buffer.push(filler)
        }
        self.buffer = buffer
        self.head = 0
    }
}
