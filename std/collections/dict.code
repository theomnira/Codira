// std/collections/dict.code
// Hash map (dictionary) — key-value associative container.
// Uses open addressing with linear probing for collision resolution.

// ─────────────────────────────────────────────────────────────────────────────
// Bucket states
// ─────────────────────────────────────────────────────────────────────────────

// Each bucket is either empty, occupied, or a tombstone (deleted).
struct BucketState {
    value: u8,  // 0 = empty, 1 = occupied, 2 = tombstone
}

let BUCKET_EMPTY:     u8 = 0;
let BUCKET_OCCUPIED:  u8 = 1;
let BUCKET_TOMBSTONE: u8 = 2;

// ─────────────────────────────────────────────────────────────────────────────
// Entry — a single key-value pair stored in a bucket.
// ─────────────────────────────────────────────────────────────────────────────

struct Entry[K, V] {
    key:   K,
    value: V,
    state: u8,
    hash:  u64,
}

// ─────────────────────────────────────────────────────────────────────────────
// Dict[K, V] — a generic hash map.
// ─────────────────────────────────────────────────────────────────────────────

class Dict[K, V] {
    buckets:    Pointer[Entry[K, V]],
    num_buckets: usize,
    len:         usize,
    load_max:    f64,   // rehash threshold (default 0.75)
}

// ── Construction ─────────────────────────────────────────────────────────────

/// Creates an empty dictionary with a default initial capacity of 16 buckets.
public func dict_new[K, V]() -> Dict[K, V] {
    return dict_with_capacity(16);
}

/// Creates an empty dictionary pre-allocated for at least `cap` entries.
public func dict_with_capacity[K, V](cap: usize) -> Dict[K, V] {
    let num_buckets = next_power_of_two(cap);
    let buckets = heap_alloc(num_buckets);
    // Mark every bucket as empty
    let i: usize = 0;
    while i < num_buckets {
        let empty_entry = Entry[K, V] { key: zero_value(), value: zero_value(), state: BUCKET_EMPTY, hash: 0 };
        raw_store(buckets, i, empty_entry);
        i = i + 1;
    }
    return Dict[K, V] {
        buckets:     buckets,
        num_buckets: num_buckets,
        len:         0,
        load_max:    0.75,
    };
}

// ── Internal helpers ─────────────────────────────────────────────────────────

/// Returns the smallest power of two >= n.
func next_power_of_two(n: usize) -> usize {
    let p: usize = 1;
    while p < n {
        p = p * 2;
    }
    return p;
}

/// Computes the bucket index for a given hash.
func bucket_index(hash: u64, num_buckets: usize) -> usize {
    return (hash as usize) & (num_buckets - 1);
}

/// Generic hash function stub — delegates to the type's hash implementation.
func compute_hash[K](key: K) -> u64 {
    return hash_of(key);
}

/// Rehashes all entries into a table with double the bucket count.
func dict_rehash[K, V](this: Dict[K, V]) -> Dict[K, V] {
    let new_num = this.num_buckets * 2;
    let new_buckets = heap_alloc(new_num);
    let i: usize = 0;
    while i < new_num {
        let empty_entry = Entry[K, V] { key: zero_value(), value: zero_value(), state: BUCKET_EMPTY, hash: 0 };
        raw_store(new_buckets, i, empty_entry);
        i = i + 1;
    }
    // Reinsert occupied buckets
    i = 0;
    while i < this.num_buckets {
        let e = raw_load(this.buckets, i);
        if e.state == BUCKET_OCCUPIED {
            let idx = bucket_index(e.hash, new_num);
            while raw_load(new_buckets, idx).state == BUCKET_OCCUPIED {
                idx = (idx + 1) & (new_num - 1);
            }
            raw_store(new_buckets, idx, e);
        }
        i = i + 1;
    }
    heap_free(this.buckets);
    return Dict[K, V] {
        buckets:     new_buckets,
        num_buckets: new_num,
        len:         this.len,
        load_max:    this.load_max,
    };
}

// ── Core API ─────────────────────────────────────────────────────────────────

/// Returns the number of key-value pairs stored.
public func len[K, V](this: Dict[K, V]) -> usize {
    return this.len;
}

/// Returns true when the dictionary has no entries.
public func is_empty[K, V](this: Dict[K, V]) -> bool {
    return this.len == 0;
}

/// Inserts or updates the value associated with `key`.
/// Returns the updated dictionary.
public func set[K, V](this: Dict[K, V], key: K, value: V) -> Dict[K, V] {
    let out = this;
    // Check load factor and rehash if necessary
    let load = (out.len + 1) as f64 / out.num_buckets as f64;
    if load > out.load_max {
        out = dict_rehash(out);
    }
    let h = compute_hash(key);
    let idx = bucket_index(h, out.num_buckets);
    // Linear probe
    while true {
        let e = raw_load(out.buckets, idx);
        if e.state == BUCKET_EMPTY || e.state == BUCKET_TOMBSTONE {
            // Insert new entry
            let new_entry = Entry[K, V] { key: key, value: value, state: BUCKET_OCCUPIED, hash: h };
            raw_store(out.buckets, idx, new_entry);
            out.len = out.len + 1;
            return out;
        }
        if e.state == BUCKET_OCCUPIED && e.hash == h && e.key == key {
            // Update existing entry
            let updated = Entry[K, V] { key: key, value: value, state: BUCKET_OCCUPIED, hash: h };
            raw_store(out.buckets, idx, updated);
            return out;
        }
        idx = (idx + 1) & (out.num_buckets - 1);
    }
    return out; // unreachable
}

/// Retrieves the value associated with `key`, or panics if not found.
public func get[K, V](this: Dict[K, V], key: K) -> V {
    let h = compute_hash(key);
    let idx = bucket_index(h, this.num_buckets);
    while true {
        let e = raw_load(this.buckets, idx);
        if e.state == BUCKET_EMPTY {
            panic("Dict.get: key not found");
        }
        if e.state == BUCKET_OCCUPIED && e.hash == h && e.key == key {
            return e.value;
        }
        idx = (idx + 1) & (this.num_buckets - 1);
    }
    panic("Dict.get: unreachable");
}

/// Retrieves the value associated with `key`, or returns `default` if absent.
public func get_or_default[K, V](this: Dict[K, V], key: K, default: V) -> V {
    let h = compute_hash(key);
    let idx = bucket_index(h, this.num_buckets);
    while true {
        let e = raw_load(this.buckets, idx);
        if e.state == BUCKET_EMPTY {
            return default;
        }
        if e.state == BUCKET_OCCUPIED && e.hash == h && e.key == key {
            return e.value;
        }
        idx = (idx + 1) & (this.num_buckets - 1);
    }
    return default; // unreachable
}

/// Returns an Optional[V] for the given key.
public func get_optional[K, V](this: Dict[K, V], key: K) -> Optional[V] {
    let h = compute_hash(key);
    let idx = bucket_index(h, this.num_buckets);
    while true {
        let e = raw_load(this.buckets, idx);
        if e.state == BUCKET_EMPTY {
            return none();
        }
        if e.state == BUCKET_OCCUPIED && e.hash == h && e.key == key {
            return some(e.value);
        }
        idx = (idx + 1) & (this.num_buckets - 1);
    }
    return none();
}

/// Removes the entry for `key`. Returns true if the key was present.
public func remove[K, V](this: Dict[K, V], key: K) -> (Dict[K, V], bool) {
    let h = compute_hash(key);
    let idx = bucket_index(h, this.num_buckets);
    while true {
        let e = raw_load(this.buckets, idx);
        if e.state == BUCKET_EMPTY {
            return (this, false);
        }
        if e.state == BUCKET_OCCUPIED && e.hash == h && e.key == key {
            // Replace with tombstone
            let tomb = Entry[K, V] { key: e.key, value: e.value, state: BUCKET_TOMBSTONE, hash: 0 };
            raw_store(this.buckets, idx, tomb);
            let out = this;
            out.len = out.len - 1;
            return (out, true);
        }
        idx = (idx + 1) & (this.num_buckets - 1);
    }
    return (this, false);
}

/// Returns `true` if the dictionary contains `key`.
public func contains_key[K, V](this: Dict[K, V], key: K) -> bool {
    let h = compute_hash(key);
    let idx = bucket_index(h, this.num_buckets);
    while true {
        let e = raw_load(this.buckets, idx);
        if e.state == BUCKET_EMPTY {
            return false;
        }
        if e.state == BUCKET_OCCUPIED && e.hash == h && e.key == key {
            return true;
        }
        idx = (idx + 1) & (this.num_buckets - 1);
    }
    return false;
}

// ── Bulk access ──────────────────────────────────────────────────────────────

/// Returns a List of all keys.
public func keys[K, V](this: Dict[K, V]) -> List[K] {
    let out = list_with_capacity(this.len);
    let i: usize = 0;
    while i < this.num_buckets {
        let e = raw_load(this.buckets, i);
        if e.state == BUCKET_OCCUPIED {
            out = push(out, e.key);
        }
        i = i + 1;
    }
    return out;
}

/// Returns a List of all values.
public func values[K, V](this: Dict[K, V]) -> List[V] {
    let out = list_with_capacity(this.len);
    let i: usize = 0;
    while i < this.num_buckets {
        let e = raw_load(this.buckets, i);
        if e.state == BUCKET_OCCUPIED {
            out = push(out, e.value);
        }
        i = i + 1;
    }
    return out;
}

/// Returns a List of (key, value) tuples.
public func items[K, V](this: Dict[K, V]) -> List[(K, V)] {
    let out = list_with_capacity(this.len);
    let i: usize = 0;
    while i < this.num_buckets {
        let e = raw_load(this.buckets, i);
        if e.state == BUCKET_OCCUPIED {
            out = push(out, (e.key, e.value));
        }
        i = i + 1;
    }
    return out;
}

/// Merges all entries from `other` into `self`. Existing keys are overwritten.
public func update[K, V](this: Dict[K, V], other: Dict[K, V]) -> Dict[K, V] {
    let out = this;
    let i: usize = 0;
    while i < other.num_buckets {
        let e = raw_load(other.buckets, i);
        if e.state == BUCKET_OCCUPIED {
            out = set(out, e.key, e.value);
        }
        i = i + 1;
    }
    return out;
}

/// Removes all entries, keeping the backing storage allocated.
public func clear[K, V](this: Dict[K, V]) -> Dict[K, V] {
    let i: usize = 0;
    while i < this.num_buckets {
        let empty_entry = Entry[K, V] { key: zero_value(), value: zero_value(), state: BUCKET_EMPTY, hash: 0 };
        raw_store(this.buckets, i, empty_entry);
        i = i + 1;
    }
    let out = this;
    out.len = 0;
    return out;
}

// ── Iteration ────────────────────────────────────────────────────────────────

/// Iterator state for Dict[K, V].
struct DictIter[K, V] {
    dict: Dict[K, V],
    pos:  usize,
}

/// Returns an iterator over (key, value) pairs.
public func iter[K, V](this: Dict[K, V]) -> DictIter[K, V] {
    return DictIter[K, V] { dict: this, pos: 0 };
}

/// Advances the iterator, returning the next (key, value) pair or none.
public func iter_next[K, V](it: DictIter[K, V]) -> (DictIter[K, V], Optional[(K, V)]) {
    let pos = it.pos;
    while pos < it.dict.num_buckets {
        let e = raw_load(it.dict.buckets, pos);
        if e.state == BUCKET_OCCUPIED {
            let next_it = DictIter[K, V] { dict: it.dict, pos: pos + 1 };
            return (next_it, some((e.key, e.value)));
        }
        pos = pos + 1;
    }
    let done_it = DictIter[K, V] { dict: it.dict, pos: pos };
    return (done_it, none());
}

// ── Cleanup ──────────────────────────────────────────────────────────────────

/// Frees the backing bucket storage.
public func drop[K, V](this: Dict[K, V]) {
    if this.num_buckets > 0 {
        heap_free(this.buckets);
    }
}
