// std/collections/binary_heap.code
// BinaryHeap[T]: a priority queue, a binary max-heap on a growable array.
//
//     import std.collections.binary_heap.{BinaryHeap}
//
//     let h: BinaryHeap[i64] = BinaryHeap.new()
//     h.push(3)
//     h.push(7)
//     println(h.pop()!)        // 7: the largest first
//
// `push` and `pop` are O(log n), `peek` O(1). Elements need `Ord`
// (std.cmp.cmp): every integer and float type, `bool` and `str` have it; a
// min-heap is a heap of a type whose `lt` is reversed. A `BinaryHeap` is a
// class: assigning or passing it shares the one heap.

import root.cmp.cmp.{Ord};

public class BinaryHeap[T] {
    // A complete binary tree in level order: the children of `i` are
    // `2i + 1` and `2i + 2`, and no child is greater than its parent.
    items: [T],
}

extend BinaryHeap[T: Ord] {
    // An empty heap.
    public func new() -> BinaryHeap[T] {
        BinaryHeap { items: [] }
    }

    // A heap of the elements of `items` (O(n)).
    public func from_array(items: [T]) -> BinaryHeap[T] {
        let heap = BinaryHeap { items: items.copy() }
        let n = heap.items.len()
        var i = n / 2
        while i > 0 {
            i -= 1
            heap.sift_down(i)
        }
        heap
    }

    // The number of elements.
    public func len(self) -> usize {
        self.items.len()
    }

    public func is_empty(self) -> bool {
        self.items.is_empty()
    }

    // The largest element, or `nil` when empty.
    public func peek(self) -> T? {
        if self.items.is_empty() { nil } else { self.items[0] }
    }

    // Adds `value`.
    public func push(self, value: T) {
        self.items.push(value)
        var child = self.items.len() - 1
        while child > 0 {
            let parent = (child - 1) / 2
            if !self.items[parent].lt(self.items[child]) {
                break
            }
            self.swap(parent, child)
            child = parent
        }
    }

    // Removes and returns the largest element, or `nil` when empty.
    public func pop(self) -> T? {
        if self.items.is_empty() {
            return nil
        }
        let top = self.items[0]
        let last = self.items.pop()!
        if !self.items.is_empty() {
            self.items[0] = last
            self.sift_down(0)
        }
        top
    }

    public func clear(self) {
        self.items.clear()
    }

    // The elements in no particular order (the heap's own), copied.
    public func to_array(self) -> [T] {
        self.items.copy()
    }

    // The elements from smallest to largest, in a new array; the heap is
    // left as it was (O(n log n)).
    public func to_sorted_array(self) -> [T] {
        let copy = BinaryHeap { items: self.items.copy() }
        let out: [T] = []
        out.reserve(copy.items.len())
        while let value = copy.pop() {
            out.push(value)
        }
        out.reverse()
        out
    }

    func sift_down(self, start: usize) {
        let n = self.items.len()
        var parent = start
        loop {
            let left = 2 * parent + 1
            if left >= n {
                break
            }
            var largest = left
            let right = left + 1
            if right < n && self.items[left].lt(self.items[right]) {
                largest = right
            }
            if !self.items[parent].lt(self.items[largest]) {
                break
            }
            self.swap(parent, largest)
            parent = largest
        }
    }

    func swap(self, a: usize, b: usize) {
        let x = self.items[a]
        self.items[a] = self.items[b]
        self.items[b] = x
    }
}
