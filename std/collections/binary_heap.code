// std/collections/binary_heap.code
// BinaryHeap[T] — a max-heap (priority queue).
// The largest element is always at the top. Uses a dynamic array as storage.
// Push and pop are O(log n); peek is O(1).

// ─────────────────────────────────────────────────────────────────────────────
// BinaryHeap[T]
// ─────────────────────────────────────────────────────────────────────────────

public class BinaryHeap[T] {
    data: Pointer[T],
    len:  usize,
    cap:  usize,
}

// ── Construction ─────────────────────────────────────────────────────────────

/// Creates a new, empty max-heap.
public func heap_new[T]() -> BinaryHeap[T] {
    return heap_with_capacity(8);
}

/// Creates a new max-heap pre-allocated for `cap` elements.
public func heap_with_capacity[T](cap: usize) -> BinaryHeap[T] {
    let ptr = heap_alloc(cap);
    return BinaryHeap[T] { data: ptr, len: 0, cap: cap };
}

/// Creates a max-heap from a List[T] using Floyd's algorithm (O(n)).
public func heap_from_list[T](items: List[T]) -> BinaryHeap[T] {
    let h = heap_with_capacity(items.len);
    // Copy elements
    let i: usize = 0;
    while i < items.len {
        raw_store(h.data, i, get(items, i));
        i = i + 1;
    }
    h.len = items.len;
    // Heapify from the last internal node down to root
    if h.len > 1 {
        let idx: isize = ((h.len / 2) as isize) - 1;
        while idx >= 0 {
            h = sift_down(h, idx as usize);
            idx = idx - 1;
        }
    }
    return h;
}

// ── Internal helpers ─────────────────────────────────────────────────────────

func parent_index(i: usize) -> usize {
    return (i - 1) / 2;
}

func left_child(i: usize) -> usize {
    return 2 * i + 1;
}

func right_child(i: usize) -> usize {
    return 2 * i + 2;
}

func heap_grow[T](this: BinaryHeap[T]) -> BinaryHeap[T] {
    let new_cap = this.cap * 2;
    if new_cap == 0 {
        new_cap = 8;
    }
    let new_data = heap_alloc(new_cap);
    let i: usize = 0;
    while i < this.len {
        raw_store(new_data, i, raw_load(this.data, i));
        i = i + 1;
    }
    heap_free(this.data);
    return BinaryHeap[T] { data: new_data, len: this.len, cap: new_cap };
}

/// Restores the heap property by moving element at `idx` upward.
func sift_up[T](this: BinaryHeap[T], idx: usize) -> BinaryHeap[T] {
    let i = idx;
    while i > 0 {
        let p = parent_index(i);
        if raw_load(this.data, i) > raw_load(this.data, p) {
            // Swap
            let tmp = raw_load(this.data, i);
            raw_store(this.data, i, raw_load(this.data, p));
            raw_store(this.data, p, tmp);
            i = p;
        } else {
            break;
        }
    }
    return this;
}

/// Restores the heap property by moving element at `idx` downward.
func sift_down[T](this: BinaryHeap[T], idx: usize) -> BinaryHeap[T] {
    let i = idx;
    while true {
        let largest = i;
        let l = left_child(i);
        let r = right_child(i);
        if l < this.len && raw_load(this.data, l) > raw_load(this.data, largest) {
            largest = l;
        }
        if r < this.len && raw_load(this.data, r) > raw_load(this.data, largest) {
            largest = r;
        }
        if largest == i {
            break;
        }
        // Swap
        let tmp = raw_load(this.data, i);
        raw_store(this.data, i, raw_load(this.data, largest));
        raw_store(this.data, largest, tmp);
        i = largest;
    }
    return this;
}

// ── Core API ─────────────────────────────────────────────────────────────────

/// Returns the number of elements in the heap.
public func len[T](this: BinaryHeap[T]) -> usize {
    return this.len;
}

/// Returns true if the heap is empty.
public func is_empty[T](this: BinaryHeap[T]) -> bool {
    return this.len == 0;
}

/// Returns the largest element without removing it. Panics if empty.
public func peek[T](this: BinaryHeap[T]) -> T {
    if this.len == 0 {
        panic("BinaryHeap.peek: heap is empty");
    }
    return raw_load(this.data, 0);
}

/// Pushes `value` into the heap, maintaining the max-heap property.
public func push[T](this: BinaryHeap[T], value: T) -> BinaryHeap[T] {
    let out = this;
    if out.len == out.cap {
        out = heap_grow(out);
    }
    raw_store(out.data, out.len, value);
    out.len = out.len + 1;
    out = sift_up(out, out.len - 1);
    return out;
}

/// Removes and returns the largest element. Panics if empty.
public func pop[T](this: BinaryHeap[T]) -> (BinaryHeap[T], T) {
    if this.len == 0 {
        panic("BinaryHeap.pop: heap is empty");
    }
    let val = raw_load(this.data, 0);
    let out = this;
    out.len = out.len - 1;
    if out.len > 0 {
        // Move last element to root and sift down
        raw_store(out.data, 0, raw_load(out.data, out.len));
        out = sift_down(out, 0);
    }
    return (out, val);
}

/// Pushes `value` then pops the max. More efficient than push + pop separately.
public func push_pop[T](this: BinaryHeap[T], value: T) -> (BinaryHeap[T], T) {
    if this.len == 0 || value >= raw_load(this.data, 0) {
        return (this, value);
    }
    let out_val = raw_load(this.data, 0);
    raw_store(this.data, 0, value);
    let out = sift_down(this, 0);
    return (out, out_val);
}

/// Replaces the top element with `value` and returns the old top.
public func replace_top[T](this: BinaryHeap[T], value: T) -> (BinaryHeap[T], T) {
    if this.len == 0 {
        panic("BinaryHeap.replace_top: heap is empty");
    }
    let old = raw_load(this.data, 0);
    raw_store(this.data, 0, value);
    let out = sift_down(this, 0);
    return (out, old);
}

// ── Bulk ─────────────────────────────────────────────────────────────────────

/// Removes all elements.
public func clear[T](this: BinaryHeap[T]) -> BinaryHeap[T] {
    let out = this;
    out.len = 0;
    return out;
}

/// Returns a sorted List[T] in descending order (drains the heap).
public func into_sorted_list[T](this: BinaryHeap[T]) -> List[T] {
    let out = list_with_capacity(this.len);
    let h = this;
    while h.len > 0 {
        let result = pop(h);
        h = result.0;
        out = push(out, result.1);
    }
    return out;
}

/// Extends the heap with elements from a List[T].
public func extend[T](this: BinaryHeap[T], items: List[T]) -> BinaryHeap[T] {
    let out = this;
    let i: usize = 0;
    while i < items.len {
        out = push(out, get(items, i));
        i = i + 1;
    }
    return out;
}

// ── Iteration (unordered) ────────────────────────────────────────────────────

public struct BinaryHeapIter[T] {
    heap: BinaryHeap[T],
    pos:  usize,
}

/// Returns an iterator over heap elements (NOT in sorted order).
public func iter[T](this: BinaryHeap[T]) -> BinaryHeapIter[T] {
    return BinaryHeapIter[T] { heap: this, pos: 0 };
}

/// Advances the iterator.
public func iter_next[T](it: BinaryHeapIter[T]) -> (BinaryHeapIter[T], Optional[T]) {
    if it.pos >= it.heap.len {
        return (it, none());
    }
    let val = raw_load(it.heap.data, it.pos);
    let next = BinaryHeapIter[T] { heap: it.heap, pos: it.pos + 1 };
    return (next, some(val));
}

// ── Cleanup ──────────────────────────────────────────────────────────────────

public func drop[T](this: BinaryHeap[T]) {
    if this.cap > 0 {
        heap_free(this.data);
    }
}
