source_filename = "mod"

%DispatchTable = type { ptr }

@dispatchTable = external local_unnamed_addr global %DispatchTable
@codira.str = private unnamed_addr constant [26 x i8] c"attempt to divide by zero\00"
@codira.str.2 = private unnamed_addr constant [32 x i8] c"attempt to divide with overflow\00"
@codira.str.3 = private unnamed_addr constant [9 x i8] c"mod.code\00"

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define range(i64 -922337203685477586, 922337203685477587) i64 @by_literal(i64 %0) local_unnamed_addr #0 {
body:
  %div = sdiv i64 %0, 10
  %rem = srem i64 %0, 7
  %add = add nsw i64 %div, %rem
  ret i64 %add
}

define i16 @by_param(i16 %0, i16 %1) local_unnamed_addr {
body:
  %div.zero = icmp eq i16 %1, 0
  br i1 %div.zero, label %div.by_zero, label %div.nonzero

div.by_zero:                                      ; preds = %body
  %codira.panic_ptr = load ptr, ptr @dispatchTable, align 8
  tail call void %codira.panic_ptr(ptr nonnull @codira.str, i64 25, ptr nonnull @codira.str.3, i64 8, i32 5, i32 5)
  unreachable

div.nonzero:                                      ; preds = %body
  %div.min = icmp eq i16 %0, -32768
  %div.minus_one = icmp eq i16 %1, -1
  %div.overflow = and i1 %div.min, %div.minus_one
  br i1 %div.overflow, label %div.overflow3, label %div.ok

div.overflow3:                                    ; preds = %div.nonzero
  %codira.panic_ptr4 = load ptr, ptr @dispatchTable, align 8
  tail call void %codira.panic_ptr4(ptr nonnull @codira.str.2, i64 31, ptr nonnull @codira.str.3, i64 8, i32 5, i32 5)
  unreachable

div.ok:                                           ; preds = %div.nonzero
  %div = sdiv i16 %0, %1
  ret i16 %div
}

attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(none) }

