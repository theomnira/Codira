define i64 @copy_and_call(i64 %0, i64 %1, i64 %2) {
body:
  %n = alloca i64, align 8
  store i64 %2, ptr %n, align 4
  %dst = alloca i64, align 8
  store i64 %1, ptr %dst, align 4
  %src = alloca i64, align 8
  store i64 %0, ptr %src, align 4
  %dst1 = load i64, ptr %dst, align 4
  %src2 = load i64, ptr %src, align 4
  %intrinsic.addr = inttoptr i64 %src2 to ptr
  %intrinsic.load = load i32, ptr %intrinsic.addr, align 4
  %intrinsic.addr3 = inttoptr i64 %dst1 to ptr
  store i32 %intrinsic.load, ptr %intrinsic.addr3, align 4
  %n4 = load i64, ptr %n, align 4
  %real_external_symbol_ptr = load ptr, ptr @dispatchTable, align 8
  %real_external_symbol = call i64 %real_external_symbol_ptr(i64 %n4)
  ret i64 %real_external_symbol
}

