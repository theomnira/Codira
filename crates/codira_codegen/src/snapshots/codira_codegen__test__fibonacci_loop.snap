expression: "\n    public func fibonacci(n:i32) -> i32 {\n        var a = 0;\n        var b = 1;\n        var i = 1;\n        loop {\n            if i > n {\n                return a\n            }\n            let sum = a + b;\n            a = b;\n            b = sum;\n            i += 1;\n        }\n    }\n    "
