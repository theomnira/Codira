body:
  %greater12 = icmp slt i32 %0, 1
  br i1 %greater12, label %then, label %if_merge

then:                                             ; preds = %if_merge, %body
  %a.0.lcssa = phi i32 [ 0, %body ], [ %b.013, %if_merge ]
  ret i32 %a.0.lcssa

if_merge:                                         ; preds = %body, %if_merge
  %i.015 = phi i32 [ %add8, %if_merge ], [ 1, %body ]
  %a.014 = phi i32 [ %b.013, %if_merge ], [ 0, %body ]
  %b.013 = phi i32 [ %add, %if_merge ], [ 1, %body ]
  %add = add i32 %a.014, %b.013
  %add8 = add i32 %i.015, 1
  %greater = icmp sgt i32 %add8, %0
  br i1 %greater, label %then, label %if_merge
}

