@codira.str.2 = private unnamed_addr constant [32 x i8] c"attempt to divide with overflow\00"
@codira.str.3 = private unnamed_addr constant [9 x i8] c"mod.code\00"

define { i32, i32 } @divmod(i32 %0, i32 %1) local_unnamed_addr {
body:
  %div.zero = icmp eq i32 %1, 0
  br i1 %div.zero, label %div.by_zero, label %div.nonzero

div.by_zero:                                      ; preds = %body
  %codira.panic_ptr = load ptr, ptr @dispatchTable, align 8
  tail call void %codira.panic_ptr(ptr nonnull @codira.str, i64 25, ptr nonnull @codira.str.3, i64 8, i32 2, i32 6)
  unreachable

div.nonzero:                                      ; preds = %body
  %div.min = icmp eq i32 %0, -2147483648
  %div.minus_one = icmp eq i32 %1, -1
  %div.overflow = and i1 %div.min, %div.minus_one
  br i1 %div.overflow, label %div.overflow3, label %div.ok15

div.overflow3:                                    ; preds = %div.nonzero
  %codira.panic_ptr4 = load ptr, ptr @dispatchTable, align 8
  tail call void %codira.panic_ptr4(ptr nonnull @codira.str.2, i64 31, ptr nonnull @codira.str.3, i64 8, i32 2, i32 6)
  unreachable

div.ok15:                                         ; preds = %div.nonzero
  %div = sdiv i32 %0, %1
  %tuple_init = insertvalue { i32, i32 } undef, i32 %div, 0
  %rem = srem i32 %0, %1
  %tuple_init17 = insertvalue { i32, i32 } %tuple_init, i32 %rem, 1
  ret { i32, i32 } %tuple_init17
}

