define i128 @assign_leftshift(i128 %0, i128 %1) local_unnamed_addr #0 {
body:
  %shift.amount = and i128 %1, 127
  %left_shift = shl i128 %0, %shift.amount
  ret i128 %left_shift
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define i128 @assign_rightshift(i128 %0, i128 %1) local_unnamed_addr #0 {
body:
  %shift.amount = and i128 %1, 127
  %right_shift = lshr i128 %0, %shift.amount
  ret i128 %right_shift
}

