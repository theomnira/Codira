---
source: crates/codira_codegen/src/test.rs
expression: "\n    public func f(a: bool, b: bool, c: bool) -> i32 {\n        var n = 0\n        if a {\n            n = 1\n        } else {\n            if b {\n                if c {\n                    n = 2\n                } else {\n                    n = 3\n                }\n            }\n        }\n        n\n    }\n    "
snapshot_kind: text
---
; == FILE IR (mod) =====================================
; ModuleID = 'mod'
source_filename = "mod"

@global_type_lookup_table = external global [2 x ptr]

define i32 @f(i1 %0, i1 %1, i1 %2) {
body:
  %n = alloca i32, align 4
  %c = alloca i1, align 1
  store i1 %2, ptr %c, align 1
  %b = alloca i1, align 1
  store i1 %1, ptr %b, align 1
  %a = alloca i1, align 1
  store i1 %0, ptr %a, align 1
  store i32 0, ptr %n, align 4
  %a1 = load i1, ptr %a, align 1
  br i1 %a1, label %then, label %else

then:                                             ; preds = %body
  store i32 1, ptr %n, align 4
  br label %if_merge

else:                                             ; preds = %body
  %b2 = load i1, ptr %b, align 1
  br i1 %b2, label %then3, label %if_merge4

then3:                                            ; preds = %else
  %c5 = load i1, ptr %c, align 1
  br i1 %c5, label %then6, label %else7

then6:                                            ; preds = %then3
  store i32 2, ptr %n, align 4
  br label %if_merge8

else7:                                            ; preds = %then3
  store i32 3, ptr %n, align 4
  br label %if_merge8

if_merge8:                                        ; preds = %else7, %then6
  br label %if_merge4

if_merge4:                                        ; preds = %if_merge8, %else
  br label %if_merge

if_merge:                                         ; preds = %if_merge4, %then
  %n9 = load i32, ptr %n, align 4
  ret i32 %n9
}

