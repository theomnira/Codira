define double @mix(double %0, float %1) {
body:
  %y = alloca float, align 4
  store float %1, ptr %y, align 4
  %x = alloca double, align 8
  store double %0, ptr %x, align 8
  %x1 = load double, ptr %x, align 8
  %intrinsic.math = call double @llvm.sqrt.f64(double %x1)
  %x2 = load double, ptr %x, align 8
  %x3 = load double, ptr %x, align 8
  %intrinsic.math4 = call double @llvm.pow.f64(double %x2, double %x3)
  %add = fadd double %intrinsic.math, %intrinsic.math4
  %x5 = load double, ptr %x, align 8
  %x6 = load double, ptr %x, align 8
  %x7 = load double, ptr %x, align 8
  %intrinsic.math8 = call double @llvm.fma.f64(double %x5, double %x6, double %x7)
  %add9 = fadd double %add, %intrinsic.math8
  ret double %add9
}

define float @narrow(float %0) {
body:
  %y = alloca float, align 4
  store float %0, ptr %y, align 4
  %y1 = load float, ptr %y, align 4
  %intrinsic.math = call float @llvm.sqrt.f32(float %y1)
  %y2 = load float, ptr %y, align 4
  %intrinsic.math3 = call float @llvm.floor.f32(float %y2)
  %add = fadd float %intrinsic.math, %intrinsic.math3
  ret float %add
}

