// Stores definitions which must be used in multiple places
// See `cargo gen-syntax` (defined in crates/tools/src/main.rs)
Grammar(
    single_char_tokens: [
        ["&", "AMP"],
        ["|", "PIPE"],
        ["+", "PLUS"],
        ["-", "MINUS"],
        ["*", "STAR"],
        ["/", "SLASH"],
        ["%", "PERCENT"],
        ["^", "CARET"],
        ["#", "HASH"],
        [".", "DOT"],
        ["<", "LT"],
        [">", "GT"],
        ["=", "EQ"],
        ["(", "L_PAREN"],
        [")", "R_PAREN"],
        ["{", "L_CURLY"],
        ["}", "R_CURLY"],
        ["[", "L_BRACKET"],
        ["]", "R_BRACKET"],
        [";", "SEMI"],
        [":", "COLON"],
        [",", "COMMA"],
        ["!", "EXCLAMATION"],
        ["?", "QUESTION"],
        ["@", "AT"],
        ["~", "TILDE"],

        // Extended symbols
        ["_", "UNDERSCORE"],
    ],
    // Tokens for which the longest match must be chosen (e.g. `..` is a DOTDOT, but `.` is a DOT)
    multi_char_tokens: [
        // Original Lua symbols
        ["==", "EQEQ"],
        // Not equals differs from Lua in that != is used.
        ["!=", "NEQ"], //["~= ", ""]
        ["<=", "LTEQ"],
        [">=", "GTEQ"],
        ["..", "DOTDOT"],
        ["...", "DOTDOTDOT"],

        // Extended symbols
        ["+=", "PLUSEQ"],
        ["-=", "MINUSEQ"],
        ["*=", "STAREQ"],
        ["/=", "SLASHEQ"],
        ["%=", "PERCENTEQ"],
        ["<<=", "SHLEQ"],
        [">>=", "SHREQ"],
        ["&=", "AMPEQ"],
        ["|=", "PIPEEQ"],
        ["^=", "CARETEQ"],
        ["..=", "DOTDOTEQ"],
        ["->", "THIN_ARROW"],
        ["<-", "LARROW"],

        ["&&", "AMPAMP"],
        ["||", "PIPEPIPE"],
        ["<<", "SHL"],
        [">>", "SHR"],
    ],
    keywords: [
        "break",
        "do",
        "else",
        "false",
        "for",
        "func",
        "if",
        "in",
        "as",
        "import",
        "nil",
        "return",
        "true",
        "while",
        "loop",

        // Bindings & members
        "let",
        "var",
        "static",
        "init",
        "override",

        // Types & OOP
        "class",
        "struct",
        "trait",
        "extend",
        "enum",
        "never",
        "type",
        "where",

        // Visibility & modules
        "public",
        "internal",
        "root",
        "super",
        "self",

        // Control flow additions
        "match",

        // Compile-time & metaprogramming
        "comptime",
        "macro",

        // Effects
        "effect",
        "uses",
        "perform",
        "handle",
        "resume",

        // Interop
        "extern",

        // Fault-tolerance / self-healing (see spec/self_healing_programming_language.md)
        "supervisor",
        "child",

        // Go-style lightweight concurrency (see spec/LANGUAGE_SPEC.md
        // section 14) -- parse-level scaffolding only, not yet backed by a
        // scheduler.
        "spawn",
    ],
    // Keywords that are only treated as keywords in specific positions. The
    // lexer emits an ordinary `IDENT` for these (so names like `out`, `read`
    // and `mut` remain usable in paths and bindings), and the parser promotes
    // them to keyword tokens with `Parser::bump_remap` where their meaning
    // applies. See spec/LANGUAGE_SPEC.md section 14.
    //
    //   - Parameter ownership conventions (mutually exclusive): `consuming`,
    //     `borrowing`, `inout`, `read`, `out`, `mut`.
    //   - Mojo-style dynamic (duck-typed) `def` function declarations, Python
    //     `def` style, alongside the statically-typed `func`.
    //   - `data`, a Kotlin-style modifier on `struct`/`class` that derives
    //     structural equality/hash/description (see spec/LANGUAGE_SPEC.md
    //     section 15). Only promoted to a keyword when immediately followed
    //     by `struct`/`class`, so `data` remains usable as an ordinary
    //     identifier (a field or binding named `data`) everywhere else.
    //
    // Parse-level scaffolding only -- none of these are enforced yet.
    contextual_keywords: [
        "consuming",
        "borrowing",
        "inout",
        "read",
        "out",
        "mut",
        "def",
        "data",
        // Verification contracts (see `codira_hir`'s `verify` module):
        // `requires`/`ensures` after a function signature, `invariant`/
        // `decreases` after a `while` condition or `loop`, and `ghost`
        // before a `let`. Each is promoted only in that position, so all
        // five stay ordinary identifiers everywhere else.
        "requires",
        "ensures",
        "invariant",
        "decreases",
        "ghost",
        // Information flow (see `codira_hir`'s `verify::flow`): `secret` as a
        // type qualifier, `oblivious` before `func`.
        "secret",
        "oblivious",
        // `scope { .. }`: a structured-concurrency scope -- every task
        // `spawn`ed inside it is joined before it is left. Promoted only
        // when directly followed by `{` where a block may start, so `scope`
        // stays an ordinary identifier everywhere else (`if scope { .. }`
        // still tests a variable named `scope`).
        "scope",
        // `select { .. }`: waits on several channel operations and performs
        // exactly one. Promoted only when directly followed by `{` where a
        // block may start, like `scope`; `default` only at the start of a
        // `select` arm, before `->`.
        "select",
        "default",
        // Session types (see `codira_hir`'s `session` module): `session` at
        // the start of a declaration followed by a name and `{`; `send`,
        // `recv`, `offer` and `or` inside a session declaration; `dual`
        // before a type; `offer ep { .. } or { .. }` as an expression.
        "session",
        "send",
        "recv",
        "offer",
        "or",
        "dual",
        // Synthesis: `choose x where pred` (see `codira_hir`'s
        // `verify::synth`). `??`, the other synthesis hole, is two `?`
        // tokens and needs no keyword.
        "choose",
        // `continue`, promoted only where it stands alone as an expression
        // (followed by `}`, `;`, a line break or the end of input), so a
        // binding named `continue` is still an ordinary identifier.
        "continue",
        // Units of measure: `f64 unit(m / s)` (see `codira_hir`'s
        // `verify::units`). Promoted only directly after a type and before
        // `(`.
        "unit",
    ],
    literals: [
        "INT_NUMBER",
        "FLOAT_NUMBER",
        "STRING",
    ],
    tokens: [
        "ERROR",
        "IDENT",
        "INDEX",
        "WHITESPACE",
        "COMMENT",
    ],
    nodes: [
        "SOURCE_FILE",

        "ATTRIBUTE_LIST",
        "ATTRIBUTE",

        "FUNCTION_DEF",
        "EXTERN",
        "RET_TYPE",
        "VISIBILITY",
        "USES_CLAUSE",
        "REQUIRES_CLAUSE",
        "ENSURES_CLAUSE",
        "INVARIANT_CLAUSE",
        "DECREASES_CLAUSE",

        "PARAM_LIST",
        "PARAM",
        "SELF_PARAM",

        "GENERIC_PARAM_LIST",
        "GENERIC_PARAM",
        "GENERIC_ARG_LIST",
        "WHERE_CLAUSE",
        "WHERE_PRED",
        "INHERITANCE_LIST",

        "STRUCT_DEF",
        "TYPE_ALIAS_DEF",
        "CONST_DEF",
        "RECORD_FIELD_DEF_LIST",
        "RECORD_FIELD_DEF",
        "TUPLE_FIELD_DEF_LIST",
        "TUPLE_FIELD_DEF",

        "TRAIT_DEF",

        "ENUM_DEF",
        "ENUM_VARIANT_LIST",
        "ENUM_VARIANT",

        "EFFECT_DEF",
        "EFFECT_OP_LIST",
        "EFFECT_OP",

        "MACRO_DEF",

        "PATH_TYPE",
        "ARRAY_TYPE",
        "TUPLE_TYPE",
        "PAREN_TYPE",
        "REFERENCE_TYPE",
        "FUNCTION_TYPE",
        "VARIADIC_TYPE",
        "NEVER_TYPE",
        "OPTIONAL_TYPE",
        "REFINEMENT_TYPE",
        "SECRET_TYPE",
        "UNIT_TYPE",

        "SUPERVISOR_DEF",
        "SUPERVISOR_ITEM_LIST",
        "SUPERVISOR_ENTRY",
        "CHILD_DEF",

        "LET_STMT",
        "EXPR_STMT",

        "PATH_EXPR",
        "PREFIX_EXPR",
        "LITERAL",
        "BIN_EXPR",
        "CAST_EXPR",
        "PAREN_EXPR",
        "CALL_EXPR",
        "METHOD_CALL_EXPR",
        "FIELD_EXPR",
        "IF_EXPR",
        "INDEX_EXPR",
        "BLOCK_EXPR",
        "RETURN_EXPR",
        "WHILE_EXPR",
        "LOOP_EXPR",
        "BREAK_EXPR",
        "FOR_EXPR",
        "CONTINUE_EXPR",
        "RANGE_EXPR",
        "ARRAY_EXPR",
        "TUPLE_EXPR",
        "CLOSURE_EXPR",
        "CONDITION",
        "COMPTIME_EXPR",
        "MATCH_EXPR",
        "MATCH_ARM_LIST",
        "MATCH_ARM",
        "PERFORM_EXPR",
        "SPAWN_EXPR",
        "SCOPE_EXPR",
        "SELECT_EXPR",
        "SELECT_ARM_LIST",
        "SELECT_ARM",
        "SESSION_DEF",
        "SESSION_PROTOCOL",
        "SESSION_STEP",
        "DUAL_TYPE",
        "OFFER_EXPR",
        "HANDLE_EXPR",
        "HANDLER_ARM_LIST",
        "HANDLER_ARM",
        "TRY_EXPR",
        "PROPAGATE_EXPR",
        "HOLE_EXPR",
        "CHOOSE_EXPR",

        "TRANSFER_EXPR",
        "CHANNEL_RECV_EXPR",
        "CHANNEL_SEND_EXPR",

        "BIND_PAT",
        "PLACEHOLDER_PAT",
        "LITERAL_PAT",
        "PATH_PAT",
        "TUPLE_STRUCT_PAT",
        "TUPLE_PAT",
        "PAREN_PAT",

        "ARG_LIST",

        "NAME",
        "NAME_REF",

        "PATH",
        "PATH_SEGMENT",

        "RECORD_LIT",
        "RECORD_FIELD_LIST",
        "RECORD_FIELD",

        "USE",
        "USE_TREE",
        "USE_TREE_LIST",
        "RENAME",

        "EXTEND",
        "EXTEND_ITEM_LIST",
        "EXTEND_ITEM",

        "EXTERN_BLOCK",
        "EXTERN_ITEM_LIST",
        "EXTERN_ITEM",
    ],
    ast: {
        "SourceFile": (
            traits: [ "ModuleItemOwner", "FunctionDefOwner" ],
        ),
        "ModuleItem": (
            enum: ["Use", "FunctionDef", "StructDef", "TypeAliasDef", "ConstDef", "TraitDef", "EnumDef", "EffectDef", "MacroDef", "Extend", "ExternBlock", "SupervisorDef", "SessionDef"]
        ),
        "Visibility": (),
        "AttributeList": (collections: [("attributes", "Attribute")]),
        "Attribute": (options: ["Path", "ArgList"]),
        "UsesClause": (collections: [("effects", "Path")]),
        "FunctionDef": (
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "ExternOwner",
                "AttributeOwner",
                "GenericParamsOwner",
            ],
            options: [ "ParamList", ["body", "BlockExpr"], "RetType", "UsesClause" ],
            collections: [
                ("requires_clauses", "RequiresClause"),
                ("ensures_clauses", "EnsuresClause"),
            ],
        ),
        // `requires <expr>` / `ensures <expr>` -- a function contract clause.
        // Inside `ensures`, `result` names the return value.
        "RequiresClause": (options: ["Expr"]),
        "EnsuresClause": (options: ["Expr"]),
        // `invariant <expr>` / `decreases <expr>` -- a loop contract clause,
        // written between a `while` condition (or `loop`) and the body.
        "InvariantClause": (options: ["Expr"]),
        "DecreasesClause": (options: ["Expr"]),
        "RetType": (options: ["TypeRef"]),
        "GenericParamList": (collections: [("generic_params", "GenericParam")]),
        "GenericParam": (
            traits: ["NameOwner"],
            options: [["bound", "TypeRef"]],
        ),
        "GenericArgList": (collections: [("generic_args", "TypeRef")]),
        "WhereClause": (collections: [("predicates", "WherePred")]),
        "WherePred": (options: [["type_ref", "TypeRef"], ["bound", "TypeRef"]]),
        "InheritanceList": (collections: [("bounds", "TypeRef")]),
        "ParamList": (
            options: [ "SelfParam" ],
            collections: [
                ["params", "Param"]
            ]
        ),
        "Param": (
            options: [ "Pat" ],
            traits: [
                "TypeAscriptionOwner"
            ],
        ),
        "SelfParam": (
            traits: [
                "TypeAscriptionOwner",
            ]
        ),
        "StructDef": (
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "AttributeOwner",
                "GenericParamsOwner",
            ],
            options: ["InheritanceList", "WhereClause"],
        ),
        "TraitDef": (
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "AttributeOwner",
                "GenericParamsOwner",
            ],
            options: ["InheritanceList", "ExtendItemList"],
        ),
        "EnumDef": (
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "AttributeOwner",
                "GenericParamsOwner",
            ],
            options: ["EnumVariantList"],
        ),
        "EnumVariantList": (collections: [("variants", "EnumVariant")]),
        "EnumVariant": (
            traits: ["NameOwner", "DocCommentsOwner"],
            options: ["RecordFieldDefList", "TupleFieldDefList"],
        ),
        "EffectDef": (
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "AttributeOwner",
            ],
            options: ["EffectOpList"],
        ),
        "EffectOpList": (collections: [("ops", "EffectOp")]),
        // `session Name { send T; recv T; choose { .. } or { .. } }`.
        "SessionDef": (
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "AttributeOwner",
            ],
            options: [["protocol", "SessionProtocol"]],
        ),
        "SessionProtocol": (collections: [("steps", "SessionStep")]),
        // `send T`, `recv T`, `choose { .. } or { .. }` or
        // `offer { .. } or { .. }`; the keyword says which.
        "SessionStep": (
            options: ["TypeRef"],
            collections: [("branches", "SessionProtocol")],
        ),
        "EffectOp": (
            traits: ["NameOwner"],
            options: ["ParamList", "RetType"],
        ),
        "MacroDef": (
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "AttributeOwner",
            ],
            options: [ "ParamList", ["body", "BlockExpr"], "RetType" ],
        ),
        "ConstDef": (
            options: ["TypeRef", ["initializer", "Expr"]],
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "AttributeOwner",
            ]
        ),
        "TypeAliasDef": (
            options: ["TypeRef"],
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "AttributeOwner",
            ]
        ),
        "RecordFieldDefList": (collections: [("fields", "RecordFieldDef")]),
        "RecordFieldDef": (
            traits: [
                "NameOwner",
                "VisibilityOwner",
                "DocCommentsOwner",
                "TypeAscriptionOwner",
                "AttributeOwner"
            ]
        ),
        "TupleFieldDefList": (collections: [("fields", "TupleFieldDef")]),
        "TupleFieldDef": (
            options: [
                "TypeRef",
            ],
            traits: [
                "VisibilityOwner",
            ]
        ),
        "LetStmt": (
            options: [
                ["pat", "Pat"],
                ["initializer", "Expr"],
            ],
            traits: [
                "TypeAscriptionOwner",
            ]
        ),
        "Condition": (
            options: [ "Pat", "Expr" ]
        ),

        "ExprStmt": (
            options: [ ["expr", "Expr"] ]
        ),
        "Stmt": (
            enum: ["LetStmt", "ExprStmt"]
        ),

        "LoopExpr": (
            traits: ["LoopBodyOwner"],
            options: [ "DecreasesClause" ],
            collections: [ ("invariant_clauses", "InvariantClause") ],
        ),

        "WhileExpr": (
            traits: ["LoopBodyOwner"],
            options: [ "Condition", "DecreasesClause" ],
            collections: [ ("invariant_clauses", "InvariantClause") ],
        ),

        "PathExpr": (options: ["Path"]),
        "PrefixExpr": (options: ["Expr"]),
        "BinExpr": (),
        // `expr as Type` -- an explicit primitive numeric conversion. The
        // operand is the sole child `Expr`; the conversion target is the sole
        // child `TypeRef`, so `expr()` and `type_ref()` never collide (no
        // expression node kind is also a type node kind).
        "CastExpr": (options: [["expr", "Expr"], ["type_ref", "TypeRef"]]),
        "Literal": (),
        "ParenExpr": (options: ["Expr"]),
        "CallExpr": (
            traits: ["ArgListOwner"],
            options: [ "Expr" ],
        ),
        "MethodCallExpr": (
            traits: ["ArgListOwner"],
            options: [ "Expr", "NameRef" ],
        ),
        "IndexExpr": (
        ),
        "FieldExpr": (
            options: ["Expr", "NameRef"]
        ),
        "IfExpr": (
            options: [ "Condition" ]
        ),
        "BreakExpr": (options: ["Expr"]),
        // `for pat in iterable { .. }`. The iterable is the first `Expr`
        // child and the body the `BlockExpr` that follows it.
        "ForExpr": (
            traits: ["LoopBodyOwner"],
            options: [ "Pat", ["iterable", "Expr"] ],
        ),
        "ContinueExpr": (),
        // `a..b` (half-open) or `a..=b` (inclusive). The operands are read
        // with `start`/`end` in `expr_extensions`, like `BinExpr`'s.
        "RangeExpr": (),
        "ArrayExpr": (
            collections: [
                [ "exprs", "Expr" ]
            ]
        ),
        // `(a, b, c)` -- a tuple literal, and `()` -- the unit value. A
        // parenthesised expression with no comma stays a `ParenExpr`, so
        // `(a)` and `(a,)` are deliberately different nodes.
        "TupleExpr": (
            collections: [
                [ "exprs", "Expr" ]
            ]
        ),
        // `func(a: T, b: T) -> R { .. }` -- a closure literal; parameter
        // types may be omitted (see `expressions::closure_expr`).
        "ClosureExpr": (
            traits: ["ArgListOwner"],
            options: ["ParamList", ["ret_type", "RetType"], ["body", "BlockExpr"]],
        ),
        "ArgList": (
            collections: [
                ["args", "Expr"]
            ]
        ),
        "ComptimeExpr": (options: [["body", "BlockExpr"]]),
        "MatchExpr": (
            options: [ ["expr", "Expr"], "MatchArmList" ]
        ),
        "MatchArmList": (collections: [("arms", "MatchArm")]),
        "MatchArm": (
            options: [ "Pat", ["expr", "Expr"] ]
        ),
        "PerformExpr": (
            traits: ["ArgListOwner"],
            options: [ "Path" ],
        ),
        "SpawnExpr": (
            options: [ ["expr", "Expr"] ]
        ),
        "TransferExpr": (
            options: [ ["expr", "Expr"] ]
        ),
        "ScopeExpr": (
            options: [ ["body", "BlockExpr"] ]
        ),
        "ChannelRecvExpr": (
            options: [ ["expr", "Expr"] ]
        ),
        "ChannelSendExpr": (),
        // `select { v = <-ch -> body, ch <- x -> body, default -> body }`.
        "SelectExpr": (
            options: [ "SelectArmList" ]
        ),
        "SelectArmList": (collections: [("arms", "SelectArm")]),
        // The binding is the `Pat`; the operation and the body are the
        // arm's expression children, read in `expr_extensions`.
        "SelectArm": (
            options: [ "Pat" ]
        ),
        // `offer ep { .. } or { .. }`: the endpoint and the branches are the
        // node's expression children, read in `expr_extensions`.
        "OfferExpr": (),
        "HandleExpr": (
            options: [ ["expr", "Expr"], "HandlerArmList" ]
        ),
        "HandlerArmList": (collections: [("arms", "HandlerArm")]),
        "HandlerArm": (
            options: [ "Path", "ParamList", ["body", "Expr"] ]
        ),
        "TryExpr": (options: ["Expr"]),
        // `expr?` -- error propagation: the `Ok` payload of a `Result`, or
        // the value inside an optional, else an early return.
        "PropagateExpr": (options: ["Expr"]),
        // `??` -- a hole `codira synth` fills with an expression proven to
        // meet the function's contract.
        "HoleExpr": (),
        // `choose x where pred` -- a value `codira synth` replaces with an
        // expression proven to satisfy `pred`.
        "ChooseExpr": (
            traits: ["NameOwner"],
            options: [["predicate", "Expr"]],
        ),

        "Expr": (
            enum: [
                "Literal",
                "PrefixExpr",
                "PathExpr",
                "BinExpr",
                "CastExpr",
                "ParenExpr",
                "CallExpr",
                "MethodCallExpr",
                "FieldExpr",
                "IfExpr",
                "LoopExpr",
                "WhileExpr",
                "ReturnExpr",
                "BreakExpr",
                "ForExpr",
                "ContinueExpr",
                "RangeExpr",
                "BlockExpr",
                "ArrayExpr",
                "TupleExpr",
                "ClosureExpr",
                "IndexExpr",
                "RecordLit",
                "ComptimeExpr",
                "MatchExpr",
                "PerformExpr",
                "SpawnExpr",
                "ScopeExpr",
                "HandleExpr",
                "TryExpr",
                "PropagateExpr",
                "TransferExpr",

                "ChannelRecvExpr",
                "ChannelSendExpr",
                "SelectExpr",
                "OfferExpr",
                "HoleExpr",
                "ChooseExpr",
            ]
        ),

        "Name": (),
        "NameRef": (),
        "PathType": (options: ["Path", "GenericArgList"]),
        "ArrayType": (options: ["TypeRef"]),
        // `(A, B)` -- a tuple type, and `()` -- the unit type. A
        // parenthesised type with no comma is just that type (no node is
        // introduced), so `(A)` is `A` while `(A,)` is a 1-tuple.
        "TupleType": (
            collections: [
                [ "fields", "TypeRef" ]
            ]
        ),
        // `(A)` -- grouping only, the exact type analogue of `ParenExpr`.
        // Lowers transparently to its inner type.
        "ParenType": (options: ["TypeRef"]),
        // `&T`, `&mut T`, `mut T` -- a borrowed or in-place-mutable
        // reference. Parse-level scaffolding: lowers transparently to `T`,
        // exactly as the parameter ownership keywords do (LANGUAGE_SPEC
        // section 14), since there is no borrow model to enforce yet.
        "ReferenceType": (options: ["TypeRef"]),
        // `func(A, B) -> R` -- the type of a function value.
        "FunctionType": (
            collections: [("params", "TypeRef")],
            options: [["ret_type", "RetType"]],
        ),
        // `...` -- a variadic parameter's type. Parse-level only: there is
        // no argument-pack model, so this records that a parameter is
        // variadic without claiming anything can be done with it.
        "VariadicType": (),
        "NeverType": (),
        "OptionalType": (options: ["TypeRef"]),
        "RefinementType": (options: [["base", "TypeRef"], ["binder", "NameRef"], ["predicate", "Expr"]]),
        // `secret T` -- the information-flow qualifier. Erases to `T`
        // everywhere except the flow checker.
        "SecretType": (options: ["TypeRef"]),
        // `dual S`: the other endpoint's view of session `S`.
        "DualType": (options: ["TypeRef"]),
        // `T unit(<dimension>)` -- a unit of measure on a numeric type.
        // Erases to `T` everywhere except the dimension checker.
        "UnitType": (options: [["base", "TypeRef"], ["dimension", "Expr"]]),
        "TypeRef": (
            enum: [
                "PathType",
                "ArrayType",
                "TupleType",
                "ParenType",
                "ReferenceType",
                "FunctionType",
                "VariadicType",
                "NeverType",
                "OptionalType",
                "RefinementType",
                "SecretType",
                "DualType",
                "UnitType",
            ]
        ),

        "SupervisorDef": (
            traits: ["NameOwner", "VisibilityOwner", "DocCommentsOwner", "AttributeOwner"],
            options: ["SupervisorItemList"],
        ),
        "SupervisorItemList": (
            collections: [ ("items", "SupervisorItem") ],
        ),
        "SupervisorItem": (
            enum: ["SupervisorEntry", "ChildDef"]
        ),
        "SupervisorEntry": (
            traits: ["NameOwner"],
            options: [["value", "Expr"]],
        ),
        "ChildDef": (
            traits: ["NameOwner"],
            options: ["SupervisorItemList"],
        ),
        "ReturnExpr": (options: ["Expr"]),
        "BlockExpr": (
            options: [ "Expr" ],
            collections: [
                ["statements", "Stmt"],
            ],
        ),
        "Path": (
            options: [
                ["segment", "PathSegment"],
                ["qualifier", "Path"],
            ]
        ),
        "PathSegment": (
            options: [ "NameRef" ]
        ),

        "BindPat": (
            options: [ "Pat" ],
            traits: ["NameOwner"]
        ),
        "PlaceholderPat": (),
        "LiteralPat": (options: ["Literal"]),
        "PathPat": (options: ["Path"]),
        "TupleStructPat": (
            options: ["Path"],
            collections: [("args", "Pat")],
        ),
        // `(a, b)` -- destructures a tuple. Unlike `TupleStructPat` there is
        // no path, and unlike every other pattern here it is irrefutable, so
        // it is legal wherever a binding is (`let`, a parameter).
        "TuplePat": (
            collections: [("args", "Pat")],
        ),
        // `(a)` -- grouping only, the pattern analogue of `ParenType` and
        // `ParenExpr`. Lowers transparently to the inner pattern, which is
        // what keeps `(a,)` (a genuine 1-tuple) distinguishable from it.
        "ParenPat": (options: ["Pat"]),
        "Pat": (
            enum: [
                "BindPat",
                "PlaceholderPat",
                "LiteralPat",
                "PathPat",
                "TupleStructPat",
                "TuplePat",
                "ParenPat",
            ],
        ),

        "RecordLit": (options: ["TypeRef", "RecordFieldList"]),
        "RecordFieldList": (
            collections: [ ("fields", "RecordField") ],
            options: [["spread", "Expr"]]
        ),
        "RecordField": (options: ["NameRef", "Expr"]),

        "Use": (
            options: [["use_tree", "UseTree"]],
            traits: ("VisibilityOwner")
        ),

        "UseTree": (
            options: [
                ["use_tree_list", "UseTreeList"],
                ["path", "Path"],
                ["rename", "Rename"]
            ]
        ),
        "UseTreeList": (
            collections: [ ("use_trees", "UseTree") ]
        ),

        "Rename": (
            traits: ("NameOwner")
        ),

        "Extend": (
            options: ["ExtendItemList", ["type_ref", "TypeRef"], "InheritanceList"],
            traits: ["VisibilityOwner", "DocCommentsOwner", "AttributeOwner"]
        ),
        "ExtendItemList": (
            collections: [ ("extend_items", "ExtendItem") ]
        ),
        "ExtendItem": (
            enum: ["FunctionDef"]
        ),

        "ExternBlock": (
            options: [ "ExternItemList" ],
            traits: ["AttributeOwner"],
        ),
        "ExternItemList": (
            collections: [ ("extern_items", "ExternItem") ]
        ),
        "ExternItem": (
            enum: ["FunctionDef"]
        ),
    }
)
