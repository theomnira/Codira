// The cost of passing an error on: `?` wrapping a `ParseError` in an enum
// variant (no allocation), `?` converting it to an `AnyError` through its
// `@error_conversion`, and the same with a `context` added. Each is timed
// on 1M calls that succeed and 1M that fail. Then a tight loop of `?`:
// examples/results' loop (`next_word`, `parse_i64` and `?` per word) over
// 1M words in memory. Each benchmark runs 7 times and the line printed is
// `<name> <median nanoseconds> <check value>`: the nanoseconds of 1M
// calls (or words), so a millionth of it per call. Run with a release
// `codira`:
//
//     codira run -O 3 --manifest-path examples/error_bench/codira.toml
//
// `error_rust.rs` is the same work in Rust (`rustc -C opt-level=3
// error_rust.rs`), printing the same check values.

import std.error.error.{AnyError}
import std.result.result.{Result}
import std.text.ascii.{next_word, parse_i64, ParseError}

extern "C" {
    func codira_time_monotonic_ns() -> u64;
}

enum Problem { Parse(ParseError) }

// `bytes[0..end]`: "42" parses, "42x" does not.
func wrapped(bytes: [u8], end: usize) -> Result[i64, Problem] {
    let v = parse_i64(bytes, 0, end)?
    Result.Ok(v + 1)
}

func converted(bytes: [u8], end: usize) -> Result[i64, AnyError] {
    let v = parse_i64(bytes, 0, end)?
    Result.Ok(v + 1)
}

func with_context(bytes: [u8], end: usize) -> Result[i64, AnyError] {
    let v = parse_i64(bytes, 0, end).context("parsing the answer")?
    Result.Ok(v + 1)
}

// The sum of the whitespace-separated integers in `bytes`, or the first
// word that is not one.
func sum_words(bytes: [u8]) -> Result[i64, Problem] {
    var total: i64 = 0
    var at: usize = 0
    while let (start, end) = next_word(bytes, at) {
        total += parse_i64(bytes, start, end)?
        at = end
    }
    Result.Ok(total)
}

// `count` words of up to six digits, some negative, each followed by a
// space (a seeded xorshift, as the Rust side writes them).
func words(count: i64) -> [u8] {
    let text: [u8] = []
    var x: u64 = 88172645463325252
    for _ in 0..count {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        let n = (x % 1000000) as i64 - 500000
        for b in f"{n} ".bytes() { text.push(b) }
    }
    text
}

func median(times: [u64]) -> u64 {
    times.sort()
    times[3]
}

public func main() {
    let bytes = "42x".bytes()
    let count = 1000000
    for end in [2, 3] {
        let outcome = if end == 2 { "ok" } else { "err" }
        // The end of each call's word, read from memory, so that the
        // optimizer cannot compute a call once for the whole loop.
        let ends = array_filled(end as usize, 1024)
        var times: [u64] = []
        var check: u64 = 0
        for run in 0..7 {
            check = 0
            let start = codira_time_monotonic_ns()
            var i = 0
            while i < count {
                match wrapped(bytes, ends[(i & 1023) as usize]) {
                    Result.Ok(v) -> check += v as u64,
                    Result.Err(_) -> check += 1,
                }
                i += 1
            }
            times.push(codira_time_monotonic_ns() - start)
        }
        println("wrapped_", outcome, " ", median(times), " ", check)

        times = []
        for run in 0..7 {
            check = 0
            let start = codira_time_monotonic_ns()
            var i = 0
            while i < count {
                match converted(bytes, ends[(i & 1023) as usize]) {
                    Result.Ok(v) -> check += v as u64,
                    Result.Err(e) -> check += e.root_cause().len() as u64,
                }
                i += 1
            }
            times.push(codira_time_monotonic_ns() - start)
        }
        println("converted_", outcome, " ", median(times), " ", check)

        times = []
        for run in 0..7 {
            check = 0
            let start = codira_time_monotonic_ns()
            var i = 0
            while i < count {
                match with_context(bytes, ends[(i & 1023) as usize]) {
                    Result.Ok(v) -> check += v as u64,
                    Result.Err(e) -> check += e.root_cause().len() as u64,
                }
                i += 1
            }
            times.push(codira_time_monotonic_ns() - start)
        }
        println("context_", outcome, " ", median(times), " ", check)
    }

    let text = words(1000000)
    var times: [u64] = []
    var check: i64 = 0
    for run in 0..7 {
        let start = codira_time_monotonic_ns()
        match sum_words(text) {
            Result.Ok(v) -> check = v,
            Result.Err(_) -> check = -1,
        }
        times.push(codira_time_monotonic_ns() - start)
    }
    println("sum_words ", median(times), " ", check)
}
