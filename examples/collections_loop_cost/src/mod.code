// `for x in xs` now also tests the current length on every iteration; the
// old lowering read the length once. `old_*` spell the old lowering out
// (the length once, then unchecked loads through the handle).
extern "C" {
    func codira_time_monotonic_ns() -> u64;
}

class Acc { total: i64 }

func new_store(xs: [i64], acc: Acc) {
    for x in xs { acc.total += x }
}

func old_store(xs: [i64], acc: Acc) {
    let n = xs.len()
    var i: usize = 0
    while i < n { acc.total += xs.unchecked_get(i); i += 1 }
}

func new_copy(xs: [i64], ys: [i64]) {
    var k: usize = 0
    for x in xs { ys[k] = x + 1; k += 1 }
}

func old_copy(xs: [i64], ys: [i64]) {
    let n = xs.len()
    var i: usize = 0
    while i < n { ys[i] = xs.unchecked_get(i) + 1; i += 1 }
}

func new_sum(xs: [i64]) -> i64 {
    var t: i64 = 0
    for x in xs { t += x }
    t
}

func old_sum(xs: [i64]) -> i64 {
    let n = xs.len()
    var t: i64 = 0
    var i: usize = 0
    while i < n { t += xs.unchecked_get(i); i += 1 }
    t
}

func ms(start: u64) -> f64 { (codira_time_monotonic_ns() - start) as f64 / 1000000.0 }

public func main() {
    let n: usize = 10000000
    let xs = array_filled(3i64, n)
    let ys = array_filled(0i64, n)
    let acc = Acc { total: 0 }
    for round in 0..5 {
        var t = codira_time_monotonic_ns()
        new_store(xs, acc)
        let a = ms(t)
        t = codira_time_monotonic_ns()
        old_store(xs, acc)
        let b = ms(t)
        t = codira_time_monotonic_ns()
        new_copy(xs, ys)
        let c = ms(t)
        t = codira_time_monotonic_ns()
        old_copy(xs, ys)
        let d = ms(t)
        t = codira_time_monotonic_ns()
        let s1 = new_sum(xs)
        let e = ms(t)
        t = codira_time_monotonic_ns()
        let s2 = old_sum(xs)
        let f = ms(t)
        println("store new ", a, " old ", b, " | copy new ", c, " old ", d, " | sum new ", e, " old ", f, " (", acc.total + s1 + s2 + ys[7], ")")
    }
}
