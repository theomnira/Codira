// The JSON benchmarks: parse, print and pretty-print the three inputs of
// `gen_inputs.py` with `std.json.json`, timed with the runtime's monotonic
// clock. `rust/src/main.rs` does the same with `serde_json::Value`.
//
// Run from the directory holding `data/`, as `bench.py` does. Each input is
// parsed, printed and pretty-printed `RUNS()` times; each line printed is
//
//     <input> <phase> <median nanoseconds> <check value>
//
// The check value of `parse` is the node count, the bytes of strings and
// keys, the wrapping sum of the integers (`true` counts 1) and the wrapping
// sum of the floats' bit patterns: sums, so that the order of an object's
// members does not change them. That of `print` and `pretty` is the
// length of the text. Both programs print the same check values.
//
// `stream` computes the parse check value from `JsonReader`'s events,
// building no tree (Rust: a `serde` visitor over `serde_json`'s
// deserializer). `typed` (twitter only) decodes the statuses into structs
// with hand-written decoders over `JsonReader` (Rust: `#[derive(Deserialize)]`
// structs); its check value sums fields of every struct.

import std.json.json.{Json, JsonObject, JsonReader, JsonEvent, DecodeError, parse, to_string, to_pretty_string}
import std.fs.file.{read_file}
import std.result.result.{Result}

extern "C" {
    func codira_time_monotonic_ns() -> u64;
}

extern "codira-intrinsic" {
    func __intrinsic_bitcast_f64_u64(value: f64) -> u64;
}

func RUNS() -> usize { 11 }

class Sums {
    nodes: u64,
    strings: u64,
    ints: u64,
    floats: u64,
}

func walk(v: Json, s: Sums) {
    s.nodes += 1
    match v {
        Json.Null -> {},
        Json.Bool(b) -> {
            if b { s.ints += 1 }
        },
        Json.Int(n) -> { s.ints += n as u64 },
        Json.Float(x) -> { s.floats += __intrinsic_bitcast_f64_u64(x) },
        Json.Str(t) -> { s.strings += t.len() as u64 },
        Json.Arr(items) -> {
            for item in items { walk(item, s) }
        },
        Json.Obj(o) -> {
            var i: usize = 0
            while i < o.len() {
                if let k = o.key_at(i) { s.strings += k.len() as u64 }
                if let item = o.value_at(i) { walk(item, s) }
                i += 1
            }
        },
    }
}

// The parse check value from the reader's events.
func stream_sums(text: String) -> Sums {
    let s = Sums { nodes: 0, strings: 0, ints: 0, floats: 0 }
    let r = JsonReader.new(text)
    loop {
        match r.next_event() {
            Result.Ok(e) -> {
                match e {
                    JsonEvent.End -> return s,
                    JsonEvent.Key(k) -> { s.strings += k.len() as u64 },
                    JsonEvent.EndArray -> {},
                    JsonEvent.EndObject -> {},
                    JsonEvent.BeginArray -> { s.nodes += 1 },
                    JsonEvent.BeginObject -> { s.nodes += 1 },
                    JsonEvent.Null -> { s.nodes += 1 },
                    JsonEvent.Bool(b) -> {
                        s.nodes += 1
                        if b { s.ints += 1 }
                    },
                    JsonEvent.Int(n) -> {
                        s.nodes += 1
                        s.ints += n as u64
                    },
                    JsonEvent.Float(x) -> {
                        s.nodes += 1
                        s.floats += __intrinsic_bitcast_f64_u64(x)
                    },
                    JsonEvent.Str(t) -> {
                        s.nodes += 1
                        s.strings += t.len() as u64
                    },
                }
            },
            Result.Err(e) -> {
                println("stream error: ", e.message())
                return s
            },
        }
    }
}

// ── Typed decoding (twitter) ────────────────────────────────────────────────

struct User {
    id: i64,
    name: String,
    screen_name: String,
    location: String?,
    followers_count: i64,
    verified: bool,
}

struct Hashtag {
    text: String,
    indices: [i64],
}

struct Status {
    id: i64,
    text: String,
    truncated: bool,
    in_reply_to_status_id: i64?,
    user: User,
    retweet_count: i64,
    favorite_count: i64,
    hashtags: [Hashtag],
    lang: String,
    score: f64,
}

func decode_user(r: JsonReader) -> Result[User, DecodeError] {
    var id: i64 = 0
    var name = "".to_string()
    var screen_name = "".to_string()
    var location: String? = nil
    var followers_count: i64 = 0
    var verified = false
    r.begin_object()?
    while let key = r.next_key()? {
        if key == "id" {
            id = r.read_i64()?
        } else if key == "name" {
            name = r.read_string()?
        } else if key == "screen_name" {
            screen_name = r.read_string()?
        } else if key == "location" {
            location = if r.read_if_null()? { nil } else { r.read_string()? }
        } else if key == "followers_count" {
            followers_count = r.read_i64()?
        } else if key == "verified" {
            verified = r.read_bool()?
        } else {
            r.skip()?
        }
    }
    Result.Ok(User { id: id, name: name, screen_name: screen_name, location: location, followers_count: followers_count, verified: verified })
}

func decode_hashtag(r: JsonReader) -> Result[Hashtag, DecodeError] {
    var text = "".to_string()
    let indices: [i64] = []
    r.begin_object()?
    while let key = r.next_key()? {
        if key == "text" {
            text = r.read_string()?
        } else if key == "indices" {
            r.begin_array()?
            while r.next_element()? {
                indices.push(r.read_i64()?)
            }
        } else {
            r.skip()?
        }
    }
    Result.Ok(Hashtag { text: text, indices: indices })
}

func decode_status(r: JsonReader) -> Result[Status, DecodeError] {
    var id: i64 = 0
    var text = "".to_string()
    var truncated = false
    var reply: i64? = nil
    var user: User? = nil
    var retweet_count: i64 = 0
    var favorite_count: i64 = 0
    let hashtags: [Hashtag] = []
    var lang = "".to_string()
    var score = 0.0
    r.begin_object()?
    while let key = r.next_key()? {
        if key == "id" {
            id = r.read_i64()?
        } else if key == "text" {
            text = r.read_string()?
        } else if key == "truncated" {
            truncated = r.read_bool()?
        } else if key == "in_reply_to_status_id" {
            reply = if r.read_if_null()? { nil } else { r.read_i64()? }
        } else if key == "user" {
            user = decode_user(r)?
        } else if key == "retweet_count" {
            retweet_count = r.read_i64()?
        } else if key == "favorite_count" {
            favorite_count = r.read_i64()?
        } else if key == "entities" {
            r.begin_object()?
            while let inner = r.next_key()? {
                if inner == "hashtags" {
                    r.begin_array()?
                    while r.next_element()? {
                        hashtags.push(decode_hashtag(r)?)
                    }
                } else {
                    r.skip()?
                }
            }
        } else if key == "lang" {
            lang = r.read_string()?
        } else if key == "score" {
            score = r.read_f64()?
        } else {
            r.skip()?
        }
    }
    if user == nil {
        return Result.Err(r.missing_field("user"))
    }
    Result.Ok(Status { id: id, text: text, truncated: truncated, in_reply_to_status_id: reply, user: user!, retweet_count: retweet_count, favorite_count: favorite_count, hashtags: hashtags, lang: lang, score: score })
}

func decode_twitter(text: String) -> Result[[Status], DecodeError] {
    let r = JsonReader.new(text)
    let statuses: [Status] = []
    r.begin_object()?
    while let key = r.next_key()? {
        if key == "statuses" {
            r.begin_array()?
            while r.next_element()? {
                statuses.push(decode_status(r)?)
            }
        } else {
            r.skip()?
        }
    }
    r.finish()?
    Result.Ok(statuses)
}

// The typed check value: the count, then wrapping sums of the numbers
// (booleans count 1, the score's bits), and of the strings' bytes.
func typed_check(statuses: [Status]) -> String {
    var numbers: u64 = 0
    var bytes: u64 = 0
    for s in statuses {
        numbers += s.id as u64 + s.retweet_count as u64 + s.favorite_count as u64
        numbers += __intrinsic_bitcast_f64_u64(s.score)
        if s.truncated { numbers += 1 }
        if let n = s.in_reply_to_status_id { numbers += n as u64 }
        let u = s.user
        numbers += u.id as u64 + u.followers_count as u64
        if u.verified { numbers += 1 }
        bytes += (s.text.len() + s.lang.len() + u.name.len() + u.screen_name.len()) as u64
        if let place = u.location { bytes += place.len() as u64 }
        for h in s.hashtags {
            bytes += h.text.len() as u64
            for i in h.indices { numbers += i as u64 }
        }
    }
    let count = statuses.len()
    f"{count}/{numbers}/{bytes}"
}

func bench_streaming(name: str, text: String) {
    let times: [u64] = []
    var check = "".to_string()
    var run: usize = 0
    while run < RUNS() {
        let t0 = codira_time_monotonic_ns()
        let s = stream_sums(text)
        let t1 = codira_time_monotonic_ns()
        times.push(t1 - t0)
        let nodes = s.nodes
        let strings = s.strings
        let ints = s.ints
        let floats = s.floats
        check = f"{nodes}/{strings}/{ints}/{floats}"
        run += 1
    }
    println(name, " stream ", median(times), " ", check)
}

func bench_typed(name: str, text: String) {
    let times: [u64] = []
    var check = "".to_string()
    var run: usize = 0
    while run < RUNS() {
        let t0 = codira_time_monotonic_ns()
        let decoded = decode_twitter(text)
        let t1 = codira_time_monotonic_ns()
        times.push(t1 - t0)
        match decoded {
            Result.Ok(statuses) -> { check = typed_check(statuses) },
            Result.Err(e) -> {
                println(name, " typed error: ", e.message())
                return
            },
        }
        run += 1
    }
    println(name, " typed ", median(times), " ", check)
}

func median(times: [u64]) -> u64 {
    times.sort()
    times[times.len() / 2]
}

func bench(name: str, text: String) {
    let parse_times: [u64] = []
    let print_times: [u64] = []
    let pretty_times: [u64] = []
    var value = Json.Null
    var compact: usize = 0
    var pretty: usize = 0
    var run: usize = 0
    while run < RUNS() {
        let t0 = codira_time_monotonic_ns()
        let parsed = parse(text)
        let t1 = codira_time_monotonic_ns()
        parse_times.push(t1 - t0)
        match parsed {
            Result.Ok(v) -> { value = v },
            Result.Err(e) -> {
                println(name, " parse error: ", e.message())
                return
            },
        }
        let t2 = codira_time_monotonic_ns()
        compact = to_string(value).len()
        let t3 = codira_time_monotonic_ns()
        pretty = to_pretty_string(value).len()
        let t4 = codira_time_monotonic_ns()
        print_times.push(t3 - t2)
        pretty_times.push(t4 - t3)
        run += 1
    }
    let s = Sums { nodes: 0, strings: 0, ints: 0, floats: 0 }
    walk(value, s)
    let nodes = s.nodes
    let strings = s.strings
    let ints = s.ints
    let floats = s.floats
    println(name, " parse ", median(parse_times), " ", f"{nodes}/{strings}/{ints}/{floats}")
    println(name, " print ", median(print_times), " ", compact)
    println(name, " pretty ", median(pretty_times), " ", pretty)
}

func load(path: str) -> String {
    match read_file(path) {
        Result.Ok(bytes) -> {
            if let text = string_from_utf8(bytes) { text } else { "".to_string() }
        },
        Result.Err(_) -> "".to_string(),
    }
}

public func main() {
    let twitter = load("data/twitter.json")
    let canada = load("data/canada.json")
    let deep = load("data/deep.json")
    bench("twitter", twitter)
    bench("canada", canada)
    bench("deep", deep)
    bench_streaming("twitter", twitter)
    bench_streaming("canada", canada)
    bench_streaming("deep", deep)
    bench_typed("twitter", twitter)
}
