// The cost of a format spec: `f"{x:>10.3}"` on 1M floats, against Rust's
// `format!("{:>10.3}", x)` in `format_rust.rs`, which formats the same
// values in the same order. Each benchmark runs 7 times; the line printed is
// `<name> <median nanoseconds> <check value>`, and the check values of the
// two programs are equal. Run with a release `codira`:
//
//     codira run -O 3 --manifest-path examples/format_bench/codira.toml
//     rustc -C opt-level=3 -o /tmp/format_rust examples/format_bench/format_rust.rs
//     /tmp/format_rust

extern "C" {
    func codira_time_monotonic_ns() -> u64;
}

struct Point { x: i64, y: f64 }

// The value formatted at step `i`: both signs, three to six digits before
// the point, and digits after it that the precision rounds.
func value(i: i64) -> f64 {
    ((i * 7919) % 1000003) as f64 / 997.0 - 300.0
}

// The median of seven times.
func median(times: [u64]) -> u64 {
    times.sort()
    times[3]
}

// A check value for one formatted string: its length and its last byte.
func check(s: String) -> u64 {
    s.len() as u64 + s.byte_at(s.len() - 1) as u64
}

public func main() {
    let count = 1000000

    // `{x:>10.3}`: a float right-aligned in 10 characters, 3 digits after
    // the point.
    var times: [u64] = []
    var sum: u64 = 0
    for run in 0..7 {
        sum = 0
        let start = codira_time_monotonic_ns()
        var i = 0
        while i < count {
            let x = value(i)
            sum += check(f"{x:>10.3}")
            i += 1
        }
        times.push(codira_time_monotonic_ns() - start)
    }
    println("float_right_10_3 ", median(times), " ", sum)

    // `{n:08}`: an integer zero-padded to 8 digits.
    times = []
    for run in 0..7 {
        sum = 0
        let start = codira_time_monotonic_ns()
        var i = 0
        while i < count {
            let n = (i * 7919) % 1000003 - 500000
            sum += check(f"{n:08}")
            i += 1
        }
        times.push(codira_time_monotonic_ns() - start)
    }
    println("int_zero_8 ", median(times), " ", sum)

    // `{p:?}`: the debug form of a small struct, generated per type.
    times = []
    for run in 0..7 {
        sum = 0
        let start = codira_time_monotonic_ns()
        var i = 0
        while i < count {
            let p = Point { x: i, y: value(i) }
            sum += check(f"{p:?}")
            i += 1
        }
        times.push(codira_time_monotonic_ns() - start)
    }
    println("debug_struct ", median(times), " ", sum)
}
