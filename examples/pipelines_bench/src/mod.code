// Benchmarks of lazy pipelines against Rust's iterators
// (`../pipelines_rust.rs` is the same work in Rust). Each line printed is a
// name, the milliseconds it took and a checksum both programs agree on.
//
//     codira build -O 2 && codira start target/mod.codiralib main
//     rustc -C opt-level=3 pipelines_rust.rs && ./pipelines_rust
//
// Results are recorded in agents/USING_CODIRA.md, "Lazy pipelines".

extern "C" {
    func codira_time_monotonic_ns() -> u64;
}

func now() -> u64 { codira_time_monotonic_ns() }

func report(name: str, start: u64, check: i64) {
    let ms = (now() - start) as f64 / 1000000.0
    println(name, " ", ms, " ms (", check, ")")
}

class Rng { s: u64 }

func next(r: Rng) -> u64 {
    var x = r.s
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    r.s = x
    x
}

public func main() {
    let n: i64 = 10000000

    // The input of the earlier eager measurement: 0, 1, .., n - 1.
    let xs: [i64] = []
    for i in 0..n { xs.push(i) }
    // Random values below 1000, and random floats in [0, 1).
    let r = Rng { s: 0x9E3779B97F4A7C15 }
    let rs: [i64] = []
    let fs: [f64] = []
    let gs: [f64] = []
    for _ in 0..n {
        rs.push((next(r) % 1000) as i64)
        fs.push((next(r) >> 11) as f64 / 9007199254740992.0)
        gs.push((next(r) >> 11) as f64 / 9007199254740992.0)
    }

    // 1. map, filter, sum: lazy, eager, and the same as one fold.
    var t = now()
    let a1 = xs.iter().map(func(x) { x * 2 }).filter(func(x) { x % 3 == 0 }).sum()
    report("map_filter_sum_lazy", t, a1)
    t = now()
    let a2 = xs.map(func(x) { x * 2 }).filter(func(x) { x % 3 == 0 }).sum()
    report("map_filter_sum_eager", t, a2)
    t = now()
    let a3 = xs.fold(0, func(acc, x) { if (x * 2) % 3 == 0 { acc + x * 2 } else { acc } })
    report("map_filter_sum_fold", t, a3)

    // 2. enumerate, filter, count (random data: the filter is unpredictable).
    t = now()
    let b = rs.iter().enumerate().filter(func(p) { (p.0 as i64 + p.1) % 5 == 0 }).count()
    report("enumerate_filter_count", t, b as i64)

    // 3. a dot product: zip, fold.
    t = now()
    let c = fs.iter().zip(gs).fold(0.0, func(acc, p) { acc + p.0 * p.1 })
    report("zip_fold_dot", t, (c * 1000.0) as i64)

    // 4. take_while: stops after all but the last 1000 elements.
    t = now()
    let d = xs.iter().take_while(func(x) { x < n - 1000 }).sum()
    report("take_while_sum", t, d)

    // 5. collect: a mapped array (the length is known), a filtered one (it
    // is not).
    t = now()
    let e = xs.iter().map(func(x) { x * 3 + 1 }).collect()
    report("map_collect", t, e[e.len() / 2] + e.len() as i64)
    t = now()
    let f = rs.iter().filter(func(x) { x % 3 == 0 }).collect()
    report("filter_collect", t, f[f.len() / 2] + f.len() as i64)

    // 6. a range source, and a chain of two arrays.
    t = now()
    let g = (0..n).filter(func(i) { i % 3 == 0 }).map(func(i) { i ^ (i >> 3) }).sum()
    report("range_filter_map_sum", t, g)
    t = now()
    let h = xs.iter().chain(rs).filter(func(x) { x % 7 == 1 }).count()
    report("chain_filter_count", t, h as i64)
}
