// Benchmarks of growable arrays and `Map` against Rust's `Vec` and
// `HashMap` (`../collections_rust.rs` is the same work in Rust). Each line
// printed is a name, the milliseconds it took, and a checksum both
// programs agree on; a map line also gives nanoseconds per operation.
//
//     codira build -O 2 && codira start target/mod.codiralib main
//     rustc -C opt-level=3 collections_rust.rs && ./collections_rust
//
// `scripts/collections_bench.py` runs both alternately and prints the
// medians. Results are recorded in agents/USING_CODIRA.md, "Growable
// arrays and collections".
//
// The map benchmarks run every operation -- insert into a new map (no
// `reserve`), look up every key (hit), look up as many absent keys (miss),
// iterate over the entries, remove every key -- at 1K, 100K and 1M keys,
// with `i64` and `String` keys, under two hashers, which are compared
// separately and never against each other:
//
//   - `secure`: the DoS-resistant default on both sides, SipHash-1-3 under
//     a random key (`Map.new()`, Rust's `HashMap::new()`);
//   - `fast`: the same unkeyed hash on both sides: the MurmurHash3
//     finalizer for integers, FNV-1a over the bytes for strings
//     (`Map.unkeyed()`, Rust with a `BuildHasher` computing the same).
//
// The 1K and 100K sizes repeat the operation (1000 and 10 times) on fresh
// maps, so every measurement does at least a million operations.

import std.collections.map.{Map}

extern "C" {
    func codira_time_monotonic_ns() -> u64;
}

func now() -> u64 { codira_time_monotonic_ns() }

func report(name: str, start: u64, check: i64) {
    let ms = (now() - start) as f64 / 1000000.0
    println(name, " ", ms, " ms (", check, ")")
}

// A map line: the total milliseconds of `ns` nanoseconds over `ops`
// operations, and the nanoseconds per operation.
func report_map(name: String, ns: u64, ops: i64, check: i64) {
    let ms = ns as f64 / 1000000.0
    let per = ns as f64 / ops as f64
    println(name, " ", ms, " ms ", per, " ns/op (", check, ")")
}

class Rng { s: u64 }

func next(r: Rng) -> u64 {
    var x = r.s
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    r.s = x
    x
}

// The keys of a run: `hits` are in the map, `misses` are not (even and odd
// numbers).
func int_keys(r: Rng, n: i64) -> [i64] {
    let out: [i64] = []
    for _ in 0..n { out.push(((next(r) >> 2) * 2) as i64) }
    out
}

func int_misses(r: Rng, n: i64) -> [i64] {
    let out: [i64] = []
    for _ in 0..n { out.push(((next(r) >> 2) * 2 + 1) as i64) }
    out
}

func string_keys(keys: [i64]) -> [String] {
    let out: [String] = []
    for k in keys { out.push(f"key-{k}") }
    out
}

func new_int_map(secure: bool) -> Map[i64, i64] {
    if secure { Map.new() } else { Map.unkeyed() }
}

func new_string_map(secure: bool) -> Map[String, i64] {
    if secure { Map.new() } else { Map.unkeyed() }
}

func bench_int(label: String, secure: bool, keys: [i64], misses: [i64], reps: i64) {
    let n = keys.len() as i64
    let ops = n * reps
    // insert
    var ns: u64 = 0
    var check: i64 = 0
    var m = new_int_map(secure)
    for _ in 0..reps {
        let t = now()
        m = new_int_map(secure)
        for k in keys { m.insert(k, k ^ 5); }
        ns += now() - t
        check += m.len() as i64
    }
    report_map(f"map_{label}_insert", ns, ops, check)
    // lookup hit
    var t = now()
    check = 0
    for _ in 0..reps {
        for k in keys {
            if let v = m.get(k) { check += v & 1 }
        }
    }
    report_map(f"map_{label}_hit", now() - t, ops, check)
    // lookup miss
    t = now()
    check = 0
    for _ in 0..reps {
        for k in misses {
            if m.contains_key(k) { check += 1 }
        }
    }
    report_map(f"map_{label}_miss", now() - t, ops, check)
    // iterate
    t = now()
    check = 0
    for _ in 0..reps {
        for (k, v) in m.iter() { check += (k ^ v) & 7 }
    }
    report_map(f"map_{label}_iter", now() - t, ops, check)
    // remove (refilled between repetitions, outside the timing)
    ns = 0
    check = 0
    for rep in 0..reps {
        if rep > 0 {
            for k in keys { m.insert(k, k ^ 5); }
        }
        let t2 = now()
        for k in keys {
            if let v = m.remove(k) { check += v & 1 }
        }
        ns += now() - t2
    }
    report_map(f"map_{label}_remove", ns, ops, check + m.len() as i64)
}

func bench_string(label: String, secure: bool, keys: [String], misses: [String], reps: i64) {
    let n = keys.len() as i64
    let ops = n * reps
    var ns: u64 = 0
    var check: i64 = 0
    var m = new_string_map(secure)
    for _ in 0..reps {
        let t = now()
        m = new_string_map(secure)
        var i: i64 = 0
        for k in keys { m.insert(k, i); i += 1 }
        ns += now() - t
        check += m.len() as i64
    }
    report_map(f"map_{label}_insert", ns, ops, check)
    var t = now()
    check = 0
    for _ in 0..reps {
        for k in keys {
            if let v = m.get(k) { check += v & 1 }
        }
    }
    report_map(f"map_{label}_hit", now() - t, ops, check)
    t = now()
    check = 0
    for _ in 0..reps {
        for k in misses {
            if m.contains_key(k) { check += 1 }
        }
    }
    report_map(f"map_{label}_miss", now() - t, ops, check)
    t = now()
    check = 0
    for _ in 0..reps {
        for (k, v) in m.iter() { check += (k.len() as i64 + v) & 7 }
    }
    report_map(f"map_{label}_iter", now() - t, ops, check)
    ns = 0
    check = 0
    for rep in 0..reps {
        if rep > 0 {
            var i: i64 = 0
            for k in keys { m.insert(k, i); i += 1 }
        }
        let t2 = now()
        for k in keys {
            if let v = m.remove(k) { check += v & 1 }
        }
        ns += now() - t2
    }
    report_map(f"map_{label}_remove", ns, ops, check + m.len() as i64)
}

// 1M lookups in a map of 5 integer keys, and 200K maps of 5 entries built:
// small maps, where Codira compares instead of hashing.
func bench_small(secure: bool) {
    let name = if secure { "secure" } else { "fast" }
    let keys: [i64] = [17, 4242, -9, 123456789, 77]
    var t = now()
    var check: i64 = 0
    for _ in 0..200000 {
        let m = new_int_map(secure)
        for k in keys { m.insert(k, k ^ 5); }
        check += m.len() as i64
    }
    report_map(f"map_small5_{name}_build", now() - t, 1000000, check)
    let m = new_int_map(secure)
    for k in keys { m.insert(k, k ^ 5); }
    t = now()
    check = 0
    var i: i64 = 0
    while i < 1000000 {
        let k = keys[(i % 8) as usize % 5] + (i & 8)
        if let v = m.get(k) { check += v & 3 }
        i += 1
    }
    report_map(f"map_small5_{name}_get", now() - t, 1000000, check)
}

public func main() {
    let n: i64 = 10000000

    // 1. push 10M i64 into an empty array (no reserve)
    var t = now()
    let xs: [i64] = []
    for i in 0..n { xs.push(i) }
    report("push_10m", t, xs.len() as i64)

    // 2. sum: builtin, fold with a closure, a hand-written loop, a chain
    t = now()
    let s1 = xs.sum()
    report("sum_builtin", t, s1)
    t = now()
    let s2 = xs.fold(0, func(acc, x) { acc + x })
    report("sum_fold_closure", t, s2)
    t = now()
    var s3: i64 = 0
    for x in xs { s3 += x }
    report("sum_for_loop", t, s3)
    t = now()
    var s4: i64 = 0
    var i: usize = 0
    while i < xs.len() { s4 += xs[i]; i += 1 }
    report("sum_indexed_while", t, s4)
    t = now()
    let s5 = xs.map(func(x) { x * 2 }).filter(func(x) { x % 3 == 0 }).sum()
    report("map_filter_sum", t, s5)
    t = now()
    let s6 = xs.fold(0, func(acc, x) { if (x * 2) % 3 == 0 { acc + x * 2 } else { acc } })
    report("map_filter_sum_fused_fold", t, s6)

    // 3. sort 1M random i64
    let r = Rng { s: 0x9E3779B97F4A7C15 }
    let ys: [i64] = []
    for _ in 0..1000000 { ys.push((next(r) >> 1) as i64) }
    t = now()
    ys.sort()
    report("sort_1m", t, ys[500000])

    // 4. maps: 1K, 100K and 1M keys, i64 and String, secure and fast.
    for size in [1000, 100000, 1000000] {
        let reps: i64 = 1000000 / size
        let keys = int_keys(r, size)
        let misses = int_misses(r, size)
        let skeys = string_keys(keys)
        let smisses = string_keys(misses)
        let tag = if size == 1000 { "1k" } else if size == 100000 { "100k" } else { "1m" }
        bench_int(f"int_{tag}_secure", true, keys, misses, reps)
        bench_int(f"int_{tag}_fast", false, keys, misses, reps)
        bench_string(f"str_{tag}_secure", true, skeys, smisses, reps)
        bench_string(f"str_{tag}_fast", false, skeys, smisses, reps)
    }
    bench_small(true)
    bench_small(false)
}
