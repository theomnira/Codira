// The String benchmarks: the same algorithms as `strings.rs`, timed
// with the runtime's monotonic clock. Each line printed is
// `<name> <nanoseconds> <check value>`; the check value keeps the work from
// being optimized away and is compared with the Rust program's.

extern "C" {
    func codira_time_monotonic_ns() -> u64;
}

func now() -> u64 {
    codira_time_monotonic_ns()
}

func report(name: str, start: u64, check: u64) {
    println(name, " ", now() - start, " ", check)
}

public func main() {
    // 1. Concatenating 1M short strings, appending in place.
    var start = now()
    var words = "".to_string()
    var i = 0
    while i < 1000000 {
        words += "word "
        i += 1
    }
    report("concat_1m_short", start, words.len() as u64)

    // The same with numbers formatted on the way (and the text the parse
    // benchmark reads).
    start = now()
    var numbers = "".to_string()
    i = 0
    while i < 1000000 {
        numbers += i.to_string()
        numbers += "\n"
        i += 1
    }
    report("concat_1m_numbers", start, numbers.len() as u64)

    // 2. Splitting a 10 MB text into lines.
    let text = "the quick brown fox jumps over the lazy dog 012345\n".repeat(205600)
    start = now()
    let lines = text.lines()
    report("split_10mb_lines", start, lines.len() as u64)

    // 2b. The same lines read lazily: no array, the bytes of every line
    // summed (`for line in text.lines()`).
    start = now()
    var line_bytes = 0
    for line in text.lines() {
        line_bytes += line.len()
    }
    report("lines_10mb_lazy", start, line_bytes as u64)

    // 2c. A 10 MB text split at commas lazily, the long fields counted
    // (`split(",").filter(..).count()`).
    let fields_text = "the,quick,brown,fox,jumps,over,the,lazy,dog,012345\n".repeat(205600)
    start = now()
    let long_fields = fields_text.split(",").filter(func(w) { w.len() > 3 }).count()
    report("split_10mb_lazy_count", start, long_fields as u64)

    // 3. `find` on a long haystack: 10 MB of "ab", the needle at the end.
    let hay = "ab".repeat(5000000) + "needle"
    start = now()
    let at = hay.find("needle")!
    report("find_10mb", start, at as u64)

    // 4. Parsing 1M integers.
    let fields = numbers.lines()
    start = now()
    var sum = 0i64
    for field in fields {
        sum += field.parse_i64()!
    }
    report("parse_1m_i64", start, sum as u64)
}
