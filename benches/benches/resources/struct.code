public class GcParent {
    child: GcChild
}

public class ValueParent {
    child: ValueChild
}

public class GcChild(f32, f32, f32, f32);
public struct ValueChild(f32, f32, f32, f32);

public func make_gc_parent() -> GcParent {
    GcParent {
        child: GcChild(-2.0, -1.0, 1.0, 2.0),
    }
}

public func make_value_parent() -> ValueParent {
    ValueParent {
        child: ValueChild(-2.0, -1.0, 1.0, 2.0),
    }
}
