// AURORA: task groups. `group { .. }` spawns tasks that return values and
// joins them: 64 tasks of real work each (`fib(24)`), against Rust's
// `std::thread::scope` and C++'s `std::async`, a thread per task, which is
// what their standard libraries offer; and 100k tasks of almost no work,
// the per-task cost of spawning and joining, which has no comparable
// standard-library baseline (a thread per task is not one).

extern "C" {
    func codira_time_monotonic_ns() -> u64;
}

func now() -> u64 { codira_time_monotonic_ns() }

func report(start: u64, check: u64) {
    let ns = now() - start
    println("@@ ns=", ns, " check=", check)
}

func fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

func fib_task(i: i64) -> i64 { fib(24 + (i & 1)) }

func tiny_task(i: i64) -> i64 { (i * 7) ^ 3 }

// 10 rounds of a group of 64 tasks, each computing fib(24) or fib(25).
public func fib_64() {
    let start = now()
    var check: i64 = 0
    var round = 0
    while round < 10 {
        let results = group {
            var i: i64 = 0
            while i < 64 { spawn fib_task(i); i += 1 }
        }
        for r in results { check += r }
        round += 1
    }
    report(start, check as u64)
}

// 10 groups of 10,000 tasks of a few instructions each.
public func tiny_100k() {
    let start = now()
    var check: i64 = 0
    var round = 0
    while round < 10 {
        let results = group {
            var i: i64 = 0
            while i < 10000 { spawn tiny_task(i); i += 1 }
        }
        for r in results { check += r }
        round += 1
    }
    report(start, check as u64)
}
